+// Brain Engine 0048: a buffer type that is base in every way (its name, so the backend takes it as its own, alignment,
+// sizes) except that its buffers come from alloc(user_data, size)
+struct ggml_backend_buft_alloc_from {
+    struct ggml_backend_buffer_type buft;
+    ggml_backend_buft_alloc_fn      alloc;
+    void *                          user_data;
+};
+
+static ggml_backend_buffer_t ggml_backend_buft_alloc_from_alloc(ggml_backend_buffer_type_t buft, size_t size) {
+    ggml_backend_buft_alloc_from * w = (ggml_backend_buft_alloc_from *) buft;
+    return w->alloc(w->user_data, size);
+}
+
+ggml_backend_buffer_type_t ggml_backend_buft_new_alloc_from(ggml_backend_buffer_type_t base, ggml_backend_buft_alloc_fn alloc, void * user_data) {
+    GGML_ASSERT(base && alloc);
+    ggml_backend_buft_alloc_from * w = new ggml_backend_buft_alloc_from;
+    w->buft = *base;
+    w->buft.iface.alloc_buffer   = ggml_backend_buft_alloc_from_alloc;
+    w->buft.iface.alloc_buffer_n = NULL;
+    w->alloc     = alloc;
+    w->user_data = user_data;
+    return &w->buft;
+}
+
+void ggml_backend_buft_free_alloc_from(ggml_backend_buffer_type_t buft) {
+    delete (ggml_backend_buft_alloc_from *) buft;
+}
+
+// Brain Engine 0048: the bytes of the backend's compute buffer the current graph uses, from its start
+size_t ggml_backend_sched_get_plan_size(ggml_backend_sched_t sched, ggml_backend_t backend) {
+    GGML_ASSERT(sched);
+    int backend_index = ggml_backend_sched_backend_id(sched, backend);
+    GGML_ASSERT(backend_index >= 0 && backend_index < sched->n_backends);
+
+    return ggml_gallocr_get_plan_size(sched->galloc, backend_index);
+}
