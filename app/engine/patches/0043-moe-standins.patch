+    // Brain Engine 0043 (LLAMA_MOE_STANDIN): while writing (one-word batches), a picked expert that is not on the card
+    // can be played by one that is, instead of being copied in (or computed on the processor). It changes the words, so
+    // it is off unless the key is set, and Bob only sets it in Turbo mode. The ways (after Strata-HotRod, MIT):
+    //   rank  the cached expert the router scored best for this word, that the word didn't pick (what HotRod does)
+    //   near  the cached expert whose router column is most like the missed one's (cosine, worked out once at load)
+    //   drop  no stand-in: the missed expert counts for nothing
+    // The stand-in counts with its own router score, then the kept weights are scaled back to the word's total (for
+    // drop: the hits share the missed one's part). At most LLAMA_MOE_STANDIN_MAX (default 2) misses a layer a word get
+    // one, the lightest first, never the word's top pick; the others are copied in as before. Long reads never use it.
+    enum sp_way { SP_OFF, SP_DROP, SP_NEAR, SP_RANK };
+    int     sp_mode = SP_OFF;
+    int32_t sp_max  = 2;
+    int64_t sp_word = 0;       // one-word batches seen, for the log
+    int32_t sp_last = -1;      // the layer of the last one-word lookup
+    size_t  sp_n = 0, sp_words = 0, sp_copied = 0;
+    struct sp_pair { int32_t pick; int32_t miss; int32_t standin; };
+    std::vector<sp_pair> sp_pairs;
+    std::vector<int32_t> sp_orig;  // the word's picks as the router made them
+
+    static const char * sp_name(int m) {
+        return m == SP_DROP ? "drop" : m == SP_NEAR ? "near" : m == SP_RANK ? "rank" : "off";
+    }
+
+    void sp_init(bool no_alloc) {
+        const char * v = getenv("LLAMA_MOE_STANDIN");
+        if (no_alloc || v == nullptr || *v == '\0' || strcmp(v, "0") == 0 || strcmp(v, "off") == 0) {
+            return;
+        }
+        sp_mode = strcmp(v, "drop") == 0 ? SP_DROP : strcmp(v, "near") == 0 ? SP_NEAR : strcmp(v, "rank") == 0 ? SP_RANK : SP_OFF;
+        if (sp_mode == SP_OFF) {
+            LLAMA_LOG_WARN("%s: !!! LLAMA_MOE_STANDIN=%s NOT USED: it must be rank, near or drop\n", __func__, v);
+            return;
+        }
+        if (const char * k = getenv("LLAMA_MOE_STANDIN_MAX"); k != nullptr && *k != '\0') {
+            sp_max = atoi(k);
+        }
+        sp_max = std::clamp<int32_t>(sp_max, 1, std::max<int32_t>(1, n_expert_used - 1));
+        LLAMA_LOG_WARN("%s: !!! MoE stand-ins ON (LLAMA_MOE_STANDIN=%s): while writing, up to %d missed experts a layer a word "
+                       "are played by experts already on the card. The words change: this is an experiment.\n", __func__, sp_name(sp_mode), sp_max);
+        if (db_on) {
+            // Brain Engine 0042: a word written through the doorbell plans on the card, with no copy callback to stand in
+            LLAMA_LOG_WARN("%s: !!! MoE stand-ins are off while the doorbell (LLAMA_MOE_DOORBELL) runs: only the words written "
+                           "the usual way (before the cache is full, or where the doorbell can't ring) get stand-ins\n", __func__);
+        }
+    }
+
+    // after the buffers are made: every factor 1, and for near the likeness of the router columns
+    void sp_load(const llama_model & model) {
+        if (sp_mode == SP_OFF) {
+            return;
+        }
+        for (layer & l : layers) {
+            if (l.sp_scale == nullptr) {
+                continue;
+            }
+            l.sp_scale_host.assign(l.sp_scale->ne[1], 1.0f);
+            ggml_backend_tensor_set(l.sp_scale, l.sp_scale_host.data(), 0, ggml_nbytes(l.sp_scale));
+            l.sp_score.assign(l.sp_scores->ne[0], 0.0f);
+        }
+        if (sp_mode != SP_NEAR) {
+            return;
+        }
+        const int64_t t0 = ggml_time_us();
+        std::atomic<size_t> n_done{0};
+        std::atomic<size_t> next{0};
+        std::mutex read_mutex;
+        // the layers are spread over a few threads: a big brain has tens of layers of hundreds of experts
+        auto work = [&]() {
+        for (size_t il = next++; il < layers.size(); il = next++) {
+            layer & l = layers[il];
+            const ggml_tensor * gi = model.layers[il].ffn_gate_inp;
+            if (l.sp_scale == nullptr || gi == nullptr || gi->ne[1] != l.sp_scores->ne[0] || gi->ne[1] > 65535) {
+                continue;
+            }
+            const int64_t n_embd = gi->ne[0];
+            const int64_t n_exp  = gi->ne[1];
+            const auto * tt = ggml_get_type_traits(gi->type);
+            if (gi->type != GGML_TYPE_F32 && tt->to_float == nullptr) {
+                continue;
+            }
+            std::vector<uint8_t> raw(ggml_nbytes(gi));
+            {
+                std::lock_guard<std::mutex> lock(read_mutex); // one read at a time: a backend (RPC) may not take two at once
+                ggml_backend_tensor_get(gi, raw.data(), 0, raw.size());
+            }
+            std::vector<float> col((size_t) n_embd*n_exp);
+            for (int64_t e = 0; e < n_exp; ++e) {
+                const uint8_t * row = raw.data() + e*gi->nb[1];
+                float * out = col.data() + e*n_embd;
+                if (gi->type == GGML_TYPE_F32) {
+                    memcpy(out, row, n_embd*sizeof(float));
+                } else {
+                    tt->to_float(row, out, n_embd);
+                }
+                double norm = 0.0;
+                for (int64_t i = 0; i < n_embd; ++i) {
+                    norm += (double) out[i]*out[i];
+                }
+                const float inv = norm > 0.0 ? (float) (1.0/std::sqrt(norm)) : 0.0f;
+                for (int64_t i = 0; i < n_embd; ++i) {
+                    out[i] *= inv;
+                }
+            }
+            const int32_t nn = (int32_t) std::min<int64_t>(64, n_exp - 1);
+            l.sp_near.assign((size_t) n_exp*nn, 0);
+            std::vector<std::pair<float, int32_t>> sim(n_exp);
+            for (int64_t a = 0; a < n_exp; ++a) {
+                for (int64_t b = 0; b < n_exp; ++b) {
+                    float d = 0.0f;
+                    const float * x = col.data() + a*n_embd;
+                    const float * y = col.data() + b*n_embd;
+                    for (int64_t i = 0; i < n_embd; ++i) {
+                        d += x[i]*y[i];
+                    }
+                    sim[b] = { b == a ? -2.0f : d, (int32_t) b };
+                }
+                std::partial_sort(sim.begin(), sim.begin() + nn, sim.end(), [](const auto & x, const auto & y) {
+                    return x.first != y.first ? x.first > y.first : x.second < y.second;
+                });
+                for (int32_t k = 0; k < nn; ++k) {
+                    l.sp_near[a*nn + k] = (uint16_t) sim[k].second;
+                }
+            }
+            l.sp_nn = nn;
+            n_done++;
+        }
+        };
+        const unsigned n_threads = std::clamp(std::thread::hardware_concurrency(), 1u, 8u);
+        std::vector<std::thread> pool;
+        for (unsigned i = 1; i < n_threads; ++i) {
+            pool.emplace_back(work);
+        }
+        work();
+        for (std::thread & t : pool) {
+            t.join();
+        }
+        LLAMA_LOG_INFO("%s: MoE stand-ins: router likeness of %zu layers worked out in %.1f s\n", __func__, n_done.load(), (ggml_time_us() - t0)/1e6);
+    }
+
+    // the graph of a one-word batch copies the router scores here and applies sp_scale; sigmoid: the router's gating
+    ggml_tensor * get_standin_scores(int32_t il, int64_t n_tokens, bool sigmoid) const {
+        if (sp_mode == SP_OFF || n_tokens != 1 || il < 0 || il >= (int32_t) layers.size() || layers[il].ig < 0 ||
+                layers[il].sp_scores == nullptr || reading || lent || filling) {
+            return nullptr;
+        }
+        if (sp_mode == SP_NEAR && layers[il].sp_near.empty()) {
+            return nullptr;
+        }
+        layers[il].sp_hooked  = true;
+        layers[il].sp_sigmoid = sigmoid;
+        return layers[il].sp_scores;
+    }
+
+    ggml_tensor * get_standin_scale(int32_t il) const {
+        return sp_mode == SP_OFF || il < 0 || il >= (int32_t) layers.size() ? nullptr : layers[il].sp_scale;
+    }
+
+    // the router weight of an expert, up to a factor shared by the word (enough for ratios)
+    float sp_weight(const layer & l, int32_t e, float top) const {
+        const float x = l.sp_score[e];
+        return l.sp_sigmoid ? 1.0f/(1.0f + std::exp(-x)) : std::exp(x - top);
+    }
+
+    // before the plan: pick the stand-ins of one word's misses and put them in the ids in place of the misses
+    int32_t sp_choose(int32_t il, layer & l, const group & g, int32_t n_used) {
+        sp_pairs.clear();
+        sp_orig.assign(ids.begin(), ids.end());
+        const int32_t * slots = g.lru.slot_map[il];
+        const int32_t n_exp = (int32_t) l.sp_score.size();
+        auto picked = [&](int32_t e) {
+            for (int32_t k = 0; k < n_used; ++k) {
+                if (ids[k] == e) {
+                    return true;
+                }
+            }
+            return false;
+        };
+        // the picks, lightest first; the top pick is never stood in for
+        std::vector<int32_t> order(n_used);
+        for (int32_t k = 0; k < n_used; ++k) {
+            order[k] = k;
+        }
+        std::sort(order.begin(), order.end(), [&](int32_t a, int32_t b) {
+            const float sa = l.sp_score[ids[a]], sb = l.sp_score[ids[b]];
+            return sa != sb ? sa < sb : a > b;
+        });
+        size_t n_miss = 0;
+        for (int32_t k = 0; k < n_used; ++k) {
+            n_miss += slots[ids[k]] >= g.n_slots;
+        }
+        for (int32_t oi = 0; oi + 1 < n_used && (int32_t) sp_pairs.size() < sp_max; ++oi) {
+            const int32_t k = order[oi];
+            const int32_t m = ids[k];
+            if (slots[m] < g.n_slots) {
+                continue; // a hit
+            }
+            int32_t r = -1;
+            if (sp_mode == SP_NEAR) {
+                for (int32_t j = 0; j < l.sp_nn && r < 0; ++j) {
+                    const int32_t e = l.sp_near[(size_t) m*l.sp_nn + j];
+                    if (slots[e] < g.n_slots && !picked(e)) {
+                        r = e;
+                    }
+                }
+            } else {
+                float best = -INFINITY;
+                for (int32_t e = 0; e < n_exp; ++e) {
+                    if (slots[e] < g.n_slots && l.sp_score[e] > best && !picked(e)) {
+                        best = l.sp_score[e];
+                        r    = e;
+                    }
+                }
+                if (r >= 0 && !(best > -INFINITY)) {
+                    r = -1; // an expert that is off
+                }
+            }
+            if (r < 0) {
+                continue; // nothing on the card to play it: copied in as before
+            }
+            sp_pairs.push_back({ k, m, r });
+            ids[k] = r; // the plan sees the stand-in as this word's pick (a hit): the miss isn't copied in
+        }
+        sp_copied += n_miss - sp_pairs.size();
+        return (int32_t) sp_pairs.size();
+    }
+
+    // after the plan: the factors of the word's picks and the slot map the device reads, with the stand-ins in place of
+    // the misses (the cache's own slot map is unchanged: a missed expert is still not on the card)
+    const int32_t * sp_apply(int32_t il, layer & l, const group & g, ggml_backend_t backend, int32_t n_used) {
+        // the factors left from the last stand-in of this layer go back to 1
+        for (int32_t s : l.sp_dirty) {
+            l.sp_scale_host[s] = 1.0f;
+            ggml_backend_tensor_set_async(backend, l.sp_scale, &l.sp_scale_host[s], (size_t) s*sizeof(float), sizeof(float));
+        }
+        l.sp_dirty.clear();
+        if (sp_pairs.empty()) {
+            return nullptr;
+        }
+        const int32_t * slots = g.lru.slot_map[il];
+        float top = -INFINITY;
+        for (int32_t k = 0; k < n_used; ++k) {
+            top = std::max(top, l.sp_score[sp_orig[k]]);
+        }
+        std::vector<float> w_orig(n_used), w_used(n_used);
+        double sum_orig = 0.0, sum_used = 0.0;
+        for (int32_t k = 0; k < n_used; ++k) {
+            w_orig[k] = sp_weight(l, sp_orig[k], top);
+            w_used[k] = w_orig[k];
+        }
+        for (const sp_pair & p : sp_pairs) {
+            w_used[p.pick] = sp_mode == SP_DROP ? 0.0f : sp_weight(l, p.standin, top);
+        }
+        for (int32_t k = 0; k < n_used; ++k) {
+            sum_orig += w_orig[k];
+            sum_used += w_used[k];
+        }
+        const double back = sum_used > 0.0 ? sum_orig/sum_used : 1.0;
+        l.sp_map.assign(slots, slots + l.slot_map->ne[1]);
+        for (const sp_pair & p : sp_pairs) {
+            l.sp_map[p.miss] = slots[p.standin];
+        }
+        for (int32_t k = 0; k < n_used; ++k) {
+            const int32_t s = l.sp_map[sp_orig[k]];
+            GGML_ASSERT(s >= 0 && s < (int32_t) l.sp_scale_host.size());
+            l.sp_scale_host[s] = w_orig[k] > 0.0f ? (float) (w_used[k]/w_orig[k]*back) : 0.0f;
+            l.sp_dirty.push_back(s);
+            ggml_backend_tensor_set_async(backend, l.sp_scale, &l.sp_scale_host[s], (size_t) s*sizeof(float), sizeof(float));
+        }
+        sp_n += sp_pairs.size();
+        sp_cur_n += (int32_t) sp_pairs.size();
+        sp_cur_layer = std::max(sp_cur_layer, (int32_t) sp_pairs.size());
+        std::string list;
+        for (const sp_pair & p : sp_pairs) {
+            char buf[48];
+            snprintf(buf, sizeof(buf), "%s%d->%d", list.empty() ? "" : " ", p.miss, sp_mode == SP_DROP ? -1 : p.standin);
+            list += buf;
+        }
+        LLAMA_LOG_DEBUG("llama_moe_cache: stand-ins: word %lld layer %d: %zu (%s)\n", (long long) sp_word, il, sp_pairs.size(), list.c_str());
+        return l.sp_map.data();
+    }
+    // the stand-ins of the word being written, and of the last words (one -lv 4 line every 64 words)
+    int32_t sp_cur_n = 0, sp_cur_layer = 0;
+    int64_t sp_win_words = 0, sp_win_n = 0;
+    int32_t sp_win_word = 0, sp_win_layer = 0, sp_most_layer = 0;
+
+    void sp_end_word() {
+        sp_words      += sp_cur_n > 0;
+        sp_win_words++;
+        sp_win_n      += sp_cur_n;
+        sp_win_word    = std::max(sp_win_word, sp_cur_n);
+        sp_win_layer   = std::max(sp_win_layer, sp_cur_layer);
+        sp_most_layer  = std::max(sp_most_layer, sp_cur_layer);
+        sp_cur_n = sp_cur_layer = 0;
+        sp_word++;
+        if (sp_win_words >= 64) {
+            LLAMA_LOG_INFO("llama_moe_cache: stand-ins, words %lld-%lld: %lld, %.2f a word, most %d in a word, most %d in a layer for a word (at most %d)\n",
+                (long long) (sp_word - sp_win_words), (long long) sp_word - 1, (long long) sp_win_n, (double) sp_win_n/sp_win_words,
