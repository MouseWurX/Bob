+// dials
+
+bool llama_adapter_dials::init(const llama_model & model) {
+    const auto & hparams = model.hparams;
+
+    GGML_ASSERT(attn.empty());
+
+    std::map<ggml_backend_buffer_type_t, ggml_context *> ctx_map;
+    auto ctx_for_buft = [&](ggml_backend_buffer_type_t buft) -> ggml_context * {
+        auto it = ctx_map.find(buft);
+        if (it != ctx_map.end()) {
+            return it->second;
+        }
+
+        ggml_init_params params = {
+            /*.mem_size   =*/ 4*hparams.n_layer()*ggml_tensor_overhead(),
+            /*.mem_buffer =*/ NULL,
+            /*.no_alloc   =*/ true,
+        };
+
+        ggml_context * ctx = ggml_init(params);
+        if (ctx) {
+            ctx_map[buft] = ctx;
+            ctxs.emplace_back(ctx);
+        }
+
+        return ctx;
+    };
+
+    for (size_t il = 0; il < hparams.n_layer(); il++) {
+        ggml_context * ctx = ctx_for_buft(model.select_buft(il));
+        if (!ctx) {
+            LLAMA_LOG_ERROR("%s: failed to allocate context for the dials\n", __func__);
+            return false;
+        }
+        expert.push_back(hparams.n_expert > 0 ? ggml_new_tensor_3d(ctx, GGML_TYPE_F32, 1, hparams.n_expert, 1) : nullptr);
+        head  .push_back(ggml_new_tensor_3d(ctx, GGML_TYPE_F32, 1, std::max<uint32_t>(1, hparams.n_head(il)), 1));
+        attn  .push_back(ggml_new_tensor_1d(ctx, GGML_TYPE_F32, 1));
+        ffn   .push_back(ggml_new_tensor_1d(ctx, GGML_TYPE_F32, 1));
+    }
+
+    for (auto it : ctx_map) {
+        ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors_from_buft(it.second, it.first);
+        if (!buf) {
+            LLAMA_LOG_ERROR("%s: failed to allocate buffer for the dials\n", __func__);
+            return false;
+        }
+        bufs.emplace_back(buf);
+    }
+
+    return true;
+}
+
+bool llama_adapter_dials::apply(const llama_model & model, const struct llama_dial * dials, size_t n) {
+    const auto & hparams = model.hparams;
+
+    const size_t n_layer  = hparams.n_layer();
+    const size_t n_expert = hparams.n_expert;
+
+    if (dials == nullptr || n == 0) {
+        on_expert.assign(n_layer, 0);
+        on_head  .assign(n_layer, 0);
+        on_attn  .assign(n_layer, 0);
+        on_ffn   .assign(n_layer, 0);
+        return true;
+    }
+
+    for (size_t i = 0; i < n; i++) {
+        const auto & d = dials[i];
+        if (d.layer < 0 || (size_t) d.layer >= n_layer || !std::isfinite(d.scale)) {
+            LLAMA_LOG_ERROR("%s: dial %zu: bad layer or scale\n", __func__, i);
+            return false;
+        }
+        if (d.kind == LLAMA_DIAL_EXPERT && (d.index < 0 || (size_t) d.index >= n_expert)) {
+            LLAMA_LOG_ERROR("%s: dial %zu: the model has no expert %d\n", __func__, i, d.index);
+            return false;
+        }
+        if (d.kind == LLAMA_DIAL_HEAD && (d.index < 0 || (uint32_t) d.index >= hparams.n_head(d.layer))) {
+            LLAMA_LOG_ERROR("%s: dial %zu: layer %d has no head %d\n", __func__, i, d.layer, d.index);
+            return false;
+        }
+        if (d.kind < LLAMA_DIAL_EXPERT || d.kind > LLAMA_DIAL_FFN) {
+            LLAMA_LOG_ERROR("%s: dial %zu: unknown kind %d\n", __func__, i, d.kind);
+            return false;
+        }
+    }
+
+    if (attn.empty() && !init(model)) {
+        return false;
+    }
+
+    std::vector<std::vector<float>> v_expert(n_layer), v_head(n_layer);
+    std::vector<float> v_attn(n_layer, 1.0f), v_ffn(n_layer, 1.0f);
+    for (size_t il = 0; il < n_layer; il++) {
+        v_expert[il].assign(n_expert, 1.0f);
+        v_head[il].assign(std::max<uint32_t>(1, hparams.n_head(il)), 1.0f);
+    }
+    for (size_t i = 0; i < n; i++) {
+        const auto & d = dials[i];
+        switch (d.kind) {
+            case LLAMA_DIAL_EXPERT: v_expert[d.layer][d.index] = d.scale; break;
+            case LLAMA_DIAL_HEAD:   v_head  [d.layer][d.index] = d.scale; break;
+            case LLAMA_DIAL_ATTN:   v_attn  [d.layer]          = d.scale; break;
+            case LLAMA_DIAL_FFN:    v_ffn   [d.layer]          = d.scale; break;
+        }
+    }
+
+    auto any = [](const std::vector<float> & v) {
+        for (float x : v) {
+            if (x != 1.0f) {
+                return true;
+            }
+        }
+        return false;
+    };
+
+    on_expert.assign(n_layer, 0);
+    on_head  .assign(n_layer, 0);
+    on_attn  .assign(n_layer, 0);
+    on_ffn   .assign(n_layer, 0);
+    for (size_t il = 0; il < n_layer; il++) {
+        if (expert[il] && any(v_expert[il])) {
+            ggml_backend_tensor_set(expert[il], v_expert[il].data(), 0, v_expert[il].size()*sizeof(float));
+            on_expert[il] = 1;
+        }
+        if (any(v_head[il])) {
+            ggml_backend_tensor_set(head[il], v_head[il].data(), 0, v_head[il].size()*sizeof(float));
+            on_head[il] = 1;
+        }
+        if (v_attn[il] != 1.0f) {
+            ggml_backend_tensor_set(attn[il], &v_attn[il], 0, sizeof(float));
+            on_attn[il] = 1;
+        }
+        if (v_ffn[il] != 1.0f) {
+            ggml_backend_tensor_set(ffn[il], &v_ffn[il], 0, sizeof(float));
+            on_ffn[il] = 1;
+        }
+    }
+
+    return true;
+}
