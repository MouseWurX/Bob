{
 "name": "Brain Engine 19: short prompts read through the copy cache on the processor (0032), 2x4 at -ub 2048, 3 rounds",
 "method": "app/docs/test-results/2026-11-16-speed-test-method.md (addendum 54 (R))",
 "brain": "${BRAIN}",
 "engines": {
  "be19": {
   "exe": "${BE19_SERVER}"
  }
