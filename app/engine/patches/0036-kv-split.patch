+ggml_tensor * llama_kv_cache::get_v_hot(ggml_context * ctx, int32_t il, uint32_t n_kv) const {
+    const auto & l = layers[map_layer_ids.at(il)];
+    ggml_tensor * v = l.v_hot;
+    GGML_ASSERT(v != nullptr && n_kv <= split_hot && !v_trans);
+    return ggml_view_4d(ctx, v, hparams.n_embd_head_v(il), hparams.n_head_kv(il), n_kv, 1,
+            ggml_row_size(v->type, hparams.n_embd_head_v(il)), v->nb[1], v->nb[1]*v->ne[1], 0);
