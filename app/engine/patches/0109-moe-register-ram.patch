+
+// Brain Engine 0109: the brain map's experts in RAM registered with the card (LLAMA_MOE_REGISTER_RAM=1, off unless set).
+// The experts the card doesn't keep are uploaded from the brain's memory map, plain pageable memory: the driver copies
+// each upload through its own small pinned buffer and returns once the bytes are staged, so the copy is neither
+// asynchronous nor at the link's speed. 0057's ring stages long reads through pinned slots by hand. Avalon (freriadoc/
+// Avalon, MIT) registers the expert memory itself with the driver on Linux; this is our version of that, for every
+// upload from the map (the cache's fills, long reads, stream ahead, op offload). Registering pins the pages: they are
+// read in and stay in RAM, so only up to a budget is registered (half of free RAM at start, and at least
+// LLAMA_MOE_REGISTER_RAM_KEEP_MIB, default 4096, left free; or LLAMA_MOE_REGISTER_RAM_MIB), layer by layer from the first, and it is refused next to the drive tier
+// (0050), whose RAM floor (0054) has to give pages back. The driver refuses read-only file maps on Windows (Avalon #47):
+// then it says NOT USED and uploads go as before. Lossless: the map never changes, the same bytes go up.
+// LLAMA_MOE_REGISTER_RAM_TEST=1 (tests, the stand-in card has nothing to register with) runs the same bookkeeping
+// without the driver; LLAMA_MOE_REGISTER_RAM_TEST_FREE_MIB=N pretends N MiB of free RAM.
+namespace {
+struct rr_run {
+    uintptr_t begin, end;
+    bool own; // registered here (else the driver already had it: not unregistered here)
+};
+struct rr_brain {
+    int users = 0;
+    std::vector<rr_run> runs; // sorted, not overlapping
+    void (*unreg)(void *) = nullptr;
+};
+std::mutex rr_mutex;
+std::map<const llama_model *, rr_brain> rr_brains;
+std::atomic<int> rr_count{0};
+
+double rr_avail_mib() {
+#ifdef _WIN32
+    MEMORYSTATUSEX ms = {};
+    ms.dwLength = sizeof(ms);
+    return GlobalMemoryStatusEx(&ms) ? ms.ullAvailPhys/1048576.0 : -1.0;
+#elif defined(__linux__)
+    FILE * f = fopen("/proc/meminfo", "r");
+    if (f == nullptr) {
+        return -1.0;
+    }
+    char line[256];
+    double kb = -1.0;
+    while (fgets(line, sizeof(line), f)) {
+        if (strncmp(line, "MemAvailable:", 13) == 0) {
+            kb = atof(line + 13);
+            break;
+        }
+    }
+    fclose(f);
+    return kb >= 0 ? kb/1024.0 : -1.0;
+#elif defined(__APPLE__)
+    vm_statistics64_data_t vs;
+    mach_msg_type_number_t cnt = HOST_VM_INFO64_COUNT;
+    if (host_statistics64(mach_host_self(), HOST_VM_INFO64, (host_info64_t) &vs, &cnt) != KERN_SUCCESS) {
+        return -1.0;
+    }
+    return ((double) vs.free_count + vs.inactive_count + vs.purgeable_count)*(double) vm_page_size/1048576.0;
+#else
+    return -1.0;
+#endif
+}
+
+size_t rr_page() {
+#ifdef _WIN32
+    SYSTEM_INFO si;
+    GetSystemInfo(&si);
+    return si.dwPageSize;
+#else
+    const long p = sysconf(_SC_PAGESIZE);
+    return p > 0 ? (size_t) p : 4096;
+#endif
+}
+
+bool rr_flag(const char * name) {
+    const char * v = getenv(name);
+    return v != nullptr && atoi(v) > 0;
+}
+} // namespace
+
+void llama_ram_register_open(const llama_model & model, const std::vector<ggml_backend_t> & backends) {
+    if (!rr_flag("LLAMA_MOE_REGISTER_RAM") || model.no_alloc()) {
+        return;
+    }
+    const char * who = "llama_ram_register";
+    std::lock_guard<std::mutex> lock(rr_mutex);
+    if (auto it = rr_brains.find(&model); it != rr_brains.end()) {
+        it->second.users++; // another context of the same brain: the same registry
+        return;
+    }
+    if (rr_flag("LLAMA_MOE_DRIVE")) {
+        LLAMA_LOG_WARN("%s: !!! LLAMA_MOE_REGISTER_RAM NOT USED: not together with the drive tier (LLAMA_MOE_DRIVE), whose RAM floor gives pages back; registered pages can't go\n", who);
+        return;
+    }
+    const bool test = rr_flag("LLAMA_MOE_REGISTER_RAM_TEST");
+    using reg_t   = int  (*)(void *, size_t);
+    using unreg_t = void (*)(void *);
+    reg_t   reg   = nullptr;
+    unreg_t unreg = nullptr;
+    const char * card = nullptr;
+    for (ggml_backend_t be : backends) {
+        ggml_backend_dev_t dev = ggml_backend_get_device(be);
+        if (dev == nullptr || ggml_backend_dev_type(dev) == GGML_BACKEND_DEVICE_TYPE_CPU) {
+            continue;
+        }
+        card = card ? card : ggml_backend_dev_name(dev);
+        ggml_backend_reg_t breg = ggml_backend_dev_backend_reg(dev);
+        reg   = breg ? (reg_t)   ggml_backend_reg_get_proc_address(breg, "ggml_backend_cuda_host_register")   : nullptr;
+        unreg = breg ? (unreg_t) ggml_backend_reg_get_proc_address(breg, "ggml_backend_cuda_host_unregister") : nullptr;
+        if (reg && unreg) {
+            card = ggml_backend_dev_name(dev);
+            break;
+        }
+    }
+    if (card == nullptr) {
+        return; // no card: nothing is uploaded
+    }
+    if (!(reg && unreg) && !test) {
+        LLAMA_LOG_WARN("%s: !!! LLAMA_MOE_REGISTER_RAM NOT USED: %s can't register host memory\n", who, card);
+        return;
+    }
+    if (!(reg && unreg)) {
+        reg = nullptr; unreg = nullptr; // test mode on the stand-in card: the bookkeeping only
+    }
+
+    // the expert tensors left in RAM, in the brain's memory map, in the order of the file (about layer order)
+    const uintptr_t page = rr_page();
+    std::vector<rr_run> want;
+    size_t n_tensors = 0, n_bytes = 0;
+    for (const auto & [name, t] : model.tensors_by_name) {
+        if (t == nullptr || t->data == nullptr || t->buffer == nullptr || name.find("_exps") == std::string::npos ||
+                !ggml_backend_buffer_is_host(t->buffer) || strstr(ggml_backend_buffer_name(t->buffer), "Mapped") == nullptr) {
+            continue;
+        }
+        const uintptr_t b = (uintptr_t) t->data;
+        want.push_back({ b & ~(page - 1), (b + ggml_nbytes(t) + page - 1) & ~(page - 1), true });
+        n_tensors++;
+        n_bytes += ggml_nbytes(t);
+    }
+    if (want.empty()) {
+        LLAMA_LOG_WARN("%s: !!! LLAMA_MOE_REGISTER_RAM NOT USED: no expert tensor is read through the brain's memory map in RAM "
+            "(with --load-mode none they sit in the card's pinned host memory already)\n", who);
+        return;
+    }
+    std::sort(want.begin(), want.end(), [](const rr_run & a, const rr_run & b) { return a.begin < b.begin; });
+    std::vector<rr_run> merged;
+    for (const rr_run & r : want) {
+        if (!merged.empty() && r.begin <= merged.back().end) {
+            merged.back().end = std::max(merged.back().end, r.end); // touching or sharing a page: one run
+        } else {
+            merged.push_back(r);
+        }
+    }
+
+    // the budget
+    size_t budget = SIZE_MAX;
+    const char * cap = getenv("LLAMA_MOE_REGISTER_RAM_MIB");
+    if (cap != nullptr && atoll(cap) > 0) {
+        budget = (size_t) atoll(cap) << 20;
+    } else {
+        const char * tf = getenv("LLAMA_MOE_REGISTER_RAM_TEST_FREE_MIB");
+        const double avail = tf != nullptr ? atof(tf) : rr_avail_mib();
+        const char * kv = getenv("LLAMA_MOE_REGISTER_RAM_KEEP_MIB");
+        const double keep = kv != nullptr && atof(kv) >= 0 ? atof(kv) : 4096.0;
+        if (avail < 0) {
+            LLAMA_LOG_WARN("%s: !!! LLAMA_MOE_REGISTER_RAM NOT USED: free RAM is unknown here; set LLAMA_MOE_REGISTER_RAM_MIB\n", who);
+            return;
+        }
+        const double mib = std::min(avail/2.0, avail - keep); // half of free RAM at most, and at least keep stays free
+        budget = mib > 0 ? (size_t) (mib*1048576.0) & ~(page - 1) : 0;
+    }
+
+    const int64_t t0 = ggml_time_us();
+    rr_brain br;
+    br.users = 1;
+    br.unreg = unreg;
+    size_t done = 0, already = 0;
+    bool refused = false, capped = false;
+    for (rr_run r : merged) {
+        if (done >= budget) {
+            capped = true;
+            break;
+        }
+        if (r.end - r.begin > budget - done) {
+            r.end = r.begin + ((budget - done) & ~(page - 1)); // the part that fits
+            capped = true;
+            if (r.end <= r.begin) {
+                break;
+            }
+        }
+        const int rc = reg ? reg((void *) r.begin, r.end - r.begin) : 0;
+        if (rc < 0) {
+            refused = true;
+            break;
+        }
+        r.own = rc == 0;
+        already += rc == 1 ? r.end - r.begin : 0;
+        br.runs.push_back(r);
+        done += r.end - r.begin;
+        if (capped) {
+            break;
+        }
+    }
+    const double secs = (ggml_time_us() - t0)/1e6;
+    if (br.runs.empty()) {
+        if (refused) {
+            LLAMA_LOG_WARN("%s: !!! LLAMA_MOE_REGISTER_RAM NOT USED: the driver refused to register the brain's memory map"
+#ifdef _WIN32
+                " (Windows refuses read-only file maps; --load-mode none puts the experts in pinned memory instead, if RAM holds them)"
+#endif
+                "\n", who);
+        } else {
+            LLAMA_LOG_WARN("%s: !!! LLAMA_MOE_REGISTER_RAM NOT USED: no room in its RAM budget (%.0f MiB)\n", who, budget/1048576.0);
+        }
+        return;
+    }
+    LLAMA_LOG_INFO("%s: %.0f of %.0f MiB of experts in RAM (%zu tensors) registered with %s%s in %zu runs, %.1f s%s%s%s\n",
+        who, done/1048576.0, n_bytes/1048576.0, n_tensors, card, reg ? "" : " (test: bookkeeping only)", br.runs.size(), secs,
+        capped ? ", the rest is over the RAM budget" : "", refused ? ", the driver refused the rest" : "",
+        already ? " (some were registered already)" : "");
+    rr_brains.emplace(&model, std::move(br));
+    rr_count++;
+}
+
+void llama_ram_register_close(const llama_model & model, const std::vector<ggml_backend_t> & backends) {
+    std::lock_guard<std::mutex> lock(rr_mutex);
+    auto it = rr_brains.find(&model);
+    if (it == rr_brains.end() || --it->second.users > 0) {
+        return;
+    }
+    for (ggml_backend_t be : backends) {
+        ggml_backend_synchronize(be); // no copy from these pages is still running
+    }
+    if (it->second.unreg) {
+        for (const rr_run & r : it->second.runs) {
+            if (r.own) {
+                it->second.unreg((void *) r.begin);
+            }
+        }
+    }
+    rr_brains.erase(it);
+    rr_count--;
+}
+
+bool llama_ram_registered(const void * p, size_t n) {
+    if (rr_count.load(std::memory_order_relaxed) == 0) {
+        return false;
+    }
+    const uintptr_t b = (uintptr_t) p, e = b + n;
+    std::lock_guard<std::mutex> lock(rr_mutex);
+    for (const auto & [m, br] : rr_brains) {
+        auto it = std::upper_bound(br.runs.begin(), br.runs.end(), b, [](uintptr_t x, const rr_run & r) { return x < r.begin; });
+        if (it != br.runs.begin() && b >= std::prev(it)->begin && e <= std::prev(it)->end) {
+            return true;
+        }
+    }
+    return false;
+}
