diff --git a/src/models/inkling2-loop.cpp b/src/models/inkling2-loop.cpp
index 8366a11..5293962 100644
--- a/src/models/inkling2-loop.cpp
+++ b/src/models/inkling2-loop.cpp
@@ -113,3 +113,20 @@ llama_model_inkling2_loop::graph::graph(const llm_graph_params & params) : llama
     }
     build_output(cur, blocks);
 }
+
+// Brain Engine 0091: the prelude, each pass over the core (pass 0 in the physical layers, then the cache slots), the coda
+std::vector<int32_t> llama_model_inkling2_loop::layer_run_order() const {
+    std::vector<int32_t> res;
+    for (int il = 0; il < (int) core_start; ++il) {
+        res.push_back(il);
+    }
+    for (uint32_t pass = 0; pass < n_passes; ++pass) {
+        for (int ip = core_start; ip < (int) core_end; ++ip) {
+            res.push_back(pass == 0 ? ip : n_phys + (pass - 1)*(core_end - core_start) + (ip - core_start));
+        }
+    }
+    for (int il = core_end; il < n_phys; ++il) {
+        res.push_back(il);
+    }
+    return res;
+}
