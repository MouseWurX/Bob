diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/trellis_cross.comp b/ggml/src/ggml-vulkan/vulkan-shaders/trellis_cross.comp
new file mode 100644
index 0000000..ff15b18
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/trellis_cross.comp
@@ -0,0 +1,40 @@
+#version 450
+
+// Lamplight 0136: H_m (Paley, m = 12, 20 or 68) across the m runs of each slice of a NariQ side, scratch to scratch.
+// mode bit 0: H^T (the output side's inverse). One invocation per (slice entry, slice, token).
+
+#extension GL_EXT_control_flow_attributes : require
+
+layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+
+#include "trellis_side.glsl"
+
+layout(binding = 0, std430) readonly buffer SRC { float data_src[]; };
+layout(binding = 1, std430) writeonly buffer DST { float data_dst[]; };
+
+bool trellis_residue(uint d) {
+    const uint w = d >> 5, b = d & 31u;
+    const uint word = w == 0u ? p.res0 : w == 1u ? p.res1 : p.res2;
+    return ((word >> b) & 1u) != 0u;
+}
+
+void main() {
+    const uint l = gl_GlobalInvocationID.x;
+    const uint slice = gl_GlobalInvocationID.y;
+    const uint t = gl_GlobalInvocationID.z;
+    if (l >= p.len) {
+        return;
+    }
+    const uint a = l / p.run, j = l % p.run;
+    const bool inverse = (p.mode & 1u) != 0u;
+    const uint q = p.m - 1u;
+    float sum = 0.0;
+    for (uint b = 0u; b < p.m; ++b) {
+        const uint r = inverse ? b : a, c = inverse ? a : b;
+        // H = I + S: S[0][c] = 1, S[r][0] = -1, S[r][c] = chi(c - r) (the quadratic character mod m - 1)
+        const bool plus = r == c || r == 0u || (c != 0u && trellis_residue((c + q - r) % q));
+        const float x = data_src[t * p.n + trellis_stored(b * p.run + j, slice)];
+        sum += plus ? x : -x;
+    }
+    data_dst[t * p.n + trellis_stored(l, slice)] = sum * p.scale;
+}
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/trellis_decode.glsl b/ggml/src/ggml-vulkan/vulkan-shaders/trellis_decode.glsl
new file mode 100644
index 0000000..531723e
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/trellis_decode.glsl
@@ -0,0 +1,34 @@
+// Lamplight 0136: decode of a NariQ trellis tile (GGML_TYPE_TRL1..6, nariq/FORMAT.md). A 16x16 tile is a circular
+// bitstream of 256 BITS-bit symbols in 8 BITS words; ring position p reads the 16-bit window ending at bit (p + 1) BITS,
+// stream bit q being bit 31 - q % 32 of word q / 32. Lane a of a 32-lane group decodes positions 8 a .. 8 a + 7, which
+// are rows a / 4 and a / 4 + 8 and columns 2 (a % 4) + {0, 1, 8, 9} of the tile (value j: row a / 4 + 8 (j / 4),
+// column 2 (a % 4) + j % 2 + 8 (j / 2 % 2)).
+
+// the INT8 grid: four six-bit fields of state * 0x83DCD12D summed without carries, minus 126
+float trellis_value(uint state) {
+    const uint h = state * 0x83DCD12Du;
+    return float(int((((h >> 2) & 0x3f3f3f3fu) * 0x01010101u) >> 24) - 126);
+}
+
+// the 16-bit state at bit o (0..31) of the 64-bit pair hi:lo
+uint trellis_state(uint hi, uint lo, uint o) {
+    // the top half of (hi:lo << o), branch-free; (lo >> 1) >> (31 - o) is lo >> (32 - o), and 0 at o = 0
+    return ((hi << o) | ((lo >> 1u) >> (31u - o))) >> 16u;
+}
+
+// tile: the tile's first word in data_q; values come out unscaled
+void trellis_decode8(uint tile, uint lane, out float v[8]) {
+    const uint NW = 8u * BITS, TOTAL = 256u * BITS;
+    const uint start = ((8u * lane + 1u) * BITS + TOTAL - 16u) % TOTAL;
+    const uint w = start >> 5, o = start & 31u;
+    // the eight windows span bits [start, start + 16 + 7 BITS) <= 58 bits past o <= 31: four words cover them
+    uint q[4];
+    [[unroll]] for (uint i = 0; i < 4u; ++i) {
+        q[i] = data_q[tile + (w + i) % NW];
+    }
+    [[unroll]] for (uint j = 0; j < 8u; ++j) {
+        const uint oj = o + j * BITS;
+        const uint wi = oj >> 5;
+        v[j] = trellis_value(trellis_state(q[wi], q[wi + 1u], oj & 31u));
+    }
+}
