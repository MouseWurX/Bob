+
+bool llama_context::ids_keep_ensure() {
+    const auto & hparams = model.hparams;
+    const uint32_t n_layer = hparams.n_layer();
+    auto & st = ids_keep;
+
+    // what each layer needs now: k picks (the live experts-per-word count, or the brain's own) for n_ubatch tokens
+    std::vector<int32_t> need(n_layer, 0);
+    bool remake = st.t.size() != n_layer || st.n_ubatch < cparams.n_ubatch;
+    for (uint32_t il = 0; il < n_layer; il++) {
+        if (model.layers[il].ffn_gate_inp == nullptr || hparams.n_expert_used(il) == 0) {
+            continue;
+        }
+        uint32_t k = hparams.n_expert_used(il);
+        if (cparams.expert_used && il < cparams.expert_used_n && cparams.expert_used[il] > 0) {
+            k = cparams.expert_used[il];
+        }
+        need[il] = (int32_t) k;
+        remake = remake || il >= st.k_alloc.size() || st.k_alloc[il] < (int32_t) k;
+    }
+    if (!remake) {
+        return true;
+    }
+
+    synchronize();
+    cparams.expert_ids_keep   = nullptr;
+    cparams.expert_ids_keep_n = 0;
+    cparams.expert_ids_keep_gen++;
+    sched_need_reserve = true;
+    st = {};
+    st.t.assign(n_layer, nullptr);
+    st.backend.assign(n_layer, nullptr);
+    st.k_alloc.assign(n_layer, 0);
+    st.host.assign(n_layer, {});
+    st.k.assign(n_layer, 0);
+    st.bad.assign(n_layer, 0);
+    st.n_ubatch = cparams.n_ubatch;
+
+    // one tensor per layer on the device that holds the layer's router, so the copy stays next to the picks
+    std::map<ggml_backend_buffer_type_t, ggml_context *> ctx_of;
+    std::map<ggml_backend_buffer_type_t, ggml_backend_t> backend_of;
+    for (uint32_t il = 0; il < n_layer; il++) {
+        if (need[il] == 0) {
+            continue;
+        }
+        const ggml_tensor * router = model.layers[il].ffn_gate_inp;
+        ggml_backend_dev_t dev = router->buffer ? ggml_backend_buft_get_device(ggml_backend_buffer_get_type(router->buffer)) : nullptr;
+        ggml_backend_t backend = nullptr;
+        for (auto & b : backends) {
+            if (dev && ggml_backend_get_device(b.get()) == dev) {
+                backend = b.get();
+                break;
+            }
+        }
+        if (!backend) {
+            backend = backend_cpu;
+            dev     = ggml_backend_get_device(backend_cpu);
+        }
+        ggml_backend_buffer_type_t buft = ggml_backend_dev_buffer_type(dev);
+        if (!ctx_of.count(buft)) {
+            ggml_init_params ip = { /*.mem_size =*/ ggml_tensor_overhead()*n_layer, /*.mem_buffer =*/ nullptr, /*.no_alloc =*/ true };
+            ggml_context * c = ggml_init(ip);
+            if (!c) {
+                LLAMA_LOG_ERROR("%s: could not make the kept expert picks\n", __func__);
+                st = {};
+                return false;
+            }
+            st.ctxs.emplace_back(c);
+            ctx_of[buft]     = c;
+            backend_of[buft] = backend;
+        }
+        ggml_tensor * t = ggml_new_tensor_2d(ctx_of[buft], GGML_TYPE_I32, need[il], cparams.n_ubatch);
+        ggml_format_name(t, "expert_ids_kept-%u", il);
+        st.t[il]       = t;
+        st.backend[il] = backend_of[buft];
+        st.k_alloc[il] = need[il];
+    }
+    for (auto & [buft, c] : ctx_of) {
+        ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors_from_buft(c, buft);
+        if (!buf) {
+            LLAMA_LOG_ERROR("%s: no room for the kept expert picks on %s\n", __func__, ggml_backend_buft_name(buft));
+            st = {};
+            return false;
+        }
+        ggml_backend_buffer_clear(buf, 0);
+        st.bufs.emplace_back(buf);
+    }
+    cparams.expert_ids_keep   = st.t.data();
+    cparams.expert_ids_keep_n = n_layer;
+    cparams.expert_ids_keep_gen++;
+    return true;
+}
+
+void llama_context::ids_keep_reserve(uint32_t n_tokens) {
+    auto & st = ids_keep;
+    bool grow = false;
+    for (size_t il = 0; il < st.t.size(); il++) {
+        if (st.t[il] && st.host[il].capacity() < st.host[il].size() + (size_t) n_tokens*st.k_alloc[il]) {
+            grow = true;
+        }
+    }
+    if (!grow) {
+        return;
+    }
+    // copies queued by an earlier decode may still be landing in these vectors: let them finish before they move
+    synchronize();
+    for (size_t il = 0; il < st.t.size(); il++) {
+        if (st.t[il]) {
+            st.host[il].reserve(std::max(2*st.host[il].capacity(), st.host[il].size() + (size_t) n_tokens*st.k_alloc[il]));
+        }
+    }
+}
+
+void llama_context::ids_keep_read(const llm_graph_result * res) {
+    auto & st = ids_keep;
+    for (const auto & [il, k, n] : res->ids_kept) {
+        if (il < 0 || (size_t) il >= st.t.size() || !st.t[il] || st.bad[il]) {
+            continue;
+        }
+        auto & h = st.host[il];
+        if ((st.k[il] != 0 && st.k[il] != k) || h.size() + (size_t) k*n > h.capacity()) {
+            st.bad[il] = 1; // a changed count within one read, or no room reserved (never moves a vector being written)
+            continue;
+        }
+        st.k[il] = k;
+        const size_t at = h.size();
+        h.resize(at + (size_t) k*n);
+        // queued on the stream that computed this micro-batch, so it lands before the next one writes the tensor again
+        ggml_backend_tensor_get_async(st.backend[il], st.t[il], h.data() + at, 0, (size_t) k*n*sizeof(int32_t));
+    }
+}
+
+int32_t llama_context::get_kept_expert_ids(int32_t il, const int32_t ** ids, int32_t * k) {
+    synchronize();
+    auto & st = ids_keep;
+    if (ids) {
+        *ids = nullptr;
+    }
+    if (k) {
+        *k = 0;
+    }
+    if (il < 0 || (size_t) il >= st.t.size() || !st.t[il]) {
+        return 0;
+    }
+    if (st.bad[il]) {
+        return -1;
+    }
+    if (st.k[il] == 0) {
+        return 0;
+    }
+    if (ids) {
+        *ids = st.host[il].data();
+    }
+    if (k) {
+        *k = st.k[il];
+    }
+    return (int32_t) (st.host[il].size()/st.k[il]);
+}
+
+void llama_context::clear_kept_expert_ids() {
+    synchronize();
+    auto & st = ids_keep;
+    for (size_t il = 0; il < st.host.size(); il++) {
+        st.host[il].clear();
+        st.k[il]   = 0;
+        st.bad[il] = 0;
+    }
 }
 
