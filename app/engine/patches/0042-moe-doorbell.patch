+    if (mode == 0) {
+        const ggml_tensor * cur = dst->src[0];
+        const ggml_tensor * ids = dst->src[1];
+        const ggml_tensor * map = dst->src[2];
+        GGML_ASSERT(ggml_is_contiguous(cur) && ggml_is_contiguous(ids) && ggml_is_contiguous(map) && ggml_is_contiguous(dst));
+        moe_doorbell_ring_kernel<<<1, 1024, 0, stream>>>(
+            (const float *) cur->data, (const int32_t *) ids->data, (const int32_t *) map->data, (int32_t *) dst->data, bell,
+            (int) cur->ne[0], (int) ids->ne[0], (int) ids->ne[1], n_slots, layer);
+    } else {
+        const ggml_tensor * cached = dst->src[0];
+        const ggml_tensor * slots  = dst->src[1];
+        GGML_ASSERT(cached->nb[0] == sizeof(float) && ggml_is_contiguous(slots));
+        moe_doorbell_wait_kernel<<<1, 1, 0, stream>>>(bell, layer, timeout_ms);
+        const int n_rows = (int) (cached->ne[1]*cached->ne[2]);
+        moe_doorbell_add_kernel<<<n_rows, 256, 0, stream>>>(
+            (const float *) cached->data, (const int32_t *) slots->data, bell, (float *) dst->data,
+            (int) cached->ne[0], (int) cached->ne[1], n_slots, (int64_t) ggml_moe_doorbell_off_out(cached->ne[0]),
+            (int64_t) (cached->nb[1]/sizeof(float)), (int64_t) (cached->nb[2]/sizeof(float)),
+            (int64_t) (dst->nb[1]/sizeof(float)),    (int64_t) (dst->nb[2]/sizeof(float)));
+    }
+#else
+    GGML_UNUSED(ctx);
+    GGML_UNUSED(dst);
+    GGML_ABORT("the MoE doorbell needs an NVIDIA card");
+#endif // GGML_CUDA_MOE_DOORBELL
+}
+
+void * ggml_cuda_moe_doorbell_alloc(size_t size, void ** dev) {
+    *dev = nullptr;
+#ifdef GGML_CUDA_MOE_DOORBELL
+    void * host = nullptr;
+    if (cudaHostAlloc(&host, size, cudaHostAllocPortable | cudaHostAllocMapped) != cudaSuccess) {
+        (void) cudaGetLastError();
+        return nullptr;
+    }
+    if (cudaHostGetDevicePointer(dev, host, 0) != cudaSuccess) {
+        (void) cudaGetLastError();
+        CUDA_CHECK(cudaFreeHost(host));
+        *dev = nullptr;
+        return nullptr;
+    }
+    memset(host, 0, size);
+    return host;
+#else
+    GGML_UNUSED(size);
+    return nullptr;
+#endif // GGML_CUDA_MOE_DOORBELL
+}
+
+void ggml_cuda_moe_doorbell_free(void * host) {
+#ifdef GGML_CUDA_MOE_DOORBELL
+    if (host != nullptr) {
+        CUDA_CHECK(cudaFreeHost(host));
+    }
+#else
+    GGML_UNUSED(host);
+#endif // GGML_CUDA_MOE_DOORBELL
+}
