+    result->op     = GGML_OP_TRELLIS;
+    result->src[0] = w;
+    result->src[1] = x;
+    result->src[2] = s16;
+    result->src[3] = pre;
+    result->src[4] = post;
+    result->src[5] = pin;
+    result->src[6] = pout;
