+// Brain Engine: the expert trace. While a request asks for it, an eval callback copies what every layer's router
+// picked (the "ffn_moe_topk-<layer>" node) for every token computed. Tokens are computed in the order they were
+// submitted, so the columns of each layer line up with `tags`, one entry per submitted token.
+struct server_expert_trace {
+    std::mutex mutex;
+    bool on  = false;
+    bool bad = false; // a decode failed or a layer was seen in a shape we don't follow: no trace for this run
+    int32_t n_used = 0;
+    std::vector<std::vector<int32_t>> cols; // per layer, n_used ids per token
+    std::vector<int32_t> n_cols;            // per layer, tokens seen
+    struct tag { int32_t id_slot; llama_token token; bool is_prompt; bool output; };
+    std::vector<tag> tags; // per submitted token
+    std::vector<int32_t> buf;
+
+    void clear(int32_t n_layer) {
+        bad = false;
+        n_used = 0;
+        cols.assign(n_layer, {});
+        n_cols.assign(n_layer, 0);
+        tags.clear();
+    }
+
+    static bool cb_eval(struct ggml_tensor * t, bool ask, void * user_data) {
+        auto * tr = (server_expert_trace *) user_data;
+        static const char prefix[] = "ffn_moe_topk-";
+        if (strncmp(t->name, prefix, sizeof(prefix) - 1) != 0) {
+            return ask ? false : true;
+        }
+        if (ask) {
+            return tr->on;
+        }
+        std::lock_guard<std::mutex> lock(tr->mutex);
+        if (!tr->on) {
+            return true;
+        }
+        const int il = atoi(t->name + sizeof(prefix) - 1);
+        // the node is a view of the first k rows of the argsort, [k, n_tokens] over [n_expert, n_tokens]
+        const struct ggml_tensor * src = t->view_src ? t->view_src : t;
+        const int64_t k = t->ne[0], n_tok = t->ne[1], stride = src->ne[0];
+        if (il < 0 || il >= (int) tr->cols.size() || t->type != GGML_TYPE_I32 || src->type != GGML_TYPE_I32 ||
+                k <= 0 || stride < k || src->ne[1] != n_tok || t->ne[2] != 1 || t->ne[3] != 1 || t->view_offs != 0 ||
+                (tr->n_used != 0 && tr->n_used != k)) {
+            tr->bad = true;
+            return true;
+        }
+        tr->n_used = (int32_t) k;
+        tr->buf.resize(stride*n_tok);
+        ggml_backend_tensor_get(src, tr->buf.data(), 0, tr->buf.size()*sizeof(int32_t));
+        auto & out = tr->cols[il];
+        for (int64_t i = 0; i < n_tok; i++) {
+            out.insert(out.end(), tr->buf.begin() + i*stride, tr->buf.begin() + i*stride + k);
+        }
+        tr->n_cols[il] += (int32_t) n_tok;
+        return true;
+    }
+};
