     LLAMA_API void llama_set_eval_callback(struct llama_context * ctx, ggml_backend_sched_eval_callback cb_eval, void * cb_eval_user_data);
 
+    // Brain Engine: keep every layer's expert picks ("ffn_moe_topk-<layer>" and the node it views) alive until the
+    // step ends, so an eval callback can read them all once, at the last layer, instead of stopping at every layer.
+    // Changing it rebuilds the graph. Waits for pending work first.
+    LLAMA_API void llama_set_keep_expert_ids(struct llama_context * ctx, bool keep);
+
+    // Brain Engine: copy n tensors of the step being computed (from inside an eval callback) to host memory, queued
+    // together and waited for once. sizes[i] bytes from the start of ts[i] go to dsts[i].
+    LLAMA_API void llama_get_tensors(struct llama_context * ctx, struct ggml_tensor * const * ts, void * const * dsts, const size_t * sizes, int32_t n);
