+    // the workers read a batch of jobs into their places; returns when every read is done
+    void dr_read(const std::vector<dr_job> & batch) {
+        if (batch.empty()) {
+            return;
+        }
+        {
+            std::lock_guard<std::mutex> lock(dr_mutex);
