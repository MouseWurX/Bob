+    // Brain Engine: the prompt's own odds (prompt_odds). Every prompt token from `from` on gets the log-probability the
+    // model gave it after reading the tokens before it (teacher forcing), and the k likeliest tokens at that place.
+    void prompt_odds_begin(server_slot & slot) {
+        slot.podds.clear();
+        const auto & p = slot.task->params;
+        if (p.prompt_odds <= 0 || !slot.task->need_sampling()) {
+            return;
+        }
+        const int32_t n_prompt = slot.task->n_tokens();
+        slot.podds.k    = std::min(p.prompt_odds, llama_vocab_n_tokens(vocab));
+        slot.podds.from = p.prompt_odds_from;
+        slot.podds.n    = std::max(0, n_prompt - p.prompt_odds_from);
+        const size_t n = slot.podds.n, k = slot.podds.k;
+        slot.podds.ids.resize(n);
+        slot.podds.own.resize(n);
+        slot.podds.top_ids.resize(n*k);
+        slot.podds.top.resize(n*k);
+        slot.podds.have.assign(n, 0);
+        for (size_t r = 0; r < n; r++) {
+            slot.podds.ids[r] = slot.task->tokens[slot.podds.from + r];
+        }
+        if (slot.podds.n == 0) {
+            slot.podds.k = -1; // asked for, nothing to score: answer with no rows and add no outputs
+        }
+    }
+
+    // does reading prompt token `idx` give odds we keep (those of token idx + 1)?
+    static bool prompt_odds_wants(const server_slot & slot, int32_t idx) {
+        const int32_t r = idx + 1 - slot.podds.from;
+        return slot.podds.k > 0 && r >= 0 && r < slot.podds.n;
+    }
+
+    // one place: the k likeliest tokens (by logit, the same order as by odds) and the log of the softmax's sum
+    static void prompt_odds_row(const float * lg, int32_t n_vocab, int32_t k, llama_token own,
+                                int32_t * top_ids, float * top, float * own_lp) {
+        std::vector<std::pair<float, int32_t>> heap;
+        heap.reserve(k + 1);
+        float mx = -INFINITY;
+        for (int32_t v = 0; v < n_vocab; v++) {
+            const float x = lg[v];
+            mx = std::max(mx, x);
+            if ((int32_t) heap.size() < k) {
+                heap.emplace_back(x, v);
+                std::push_heap(heap.begin(), heap.end(), std::greater<>());
+            } else if (x > heap.front().first) {
+                std::pop_heap(heap.begin(), heap.end(), std::greater<>());
+                heap.back() = { x, v };
+                std::push_heap(heap.begin(), heap.end(), std::greater<>());
+            }
+        }
+        double sum = 0.0;
+        for (int32_t v = 0; v < n_vocab; v++) {
+            sum += std::exp((double) (lg[v] - mx));
+        }
+        const float lse = mx + (float) std::log(sum);
+        std::sort_heap(heap.begin(), heap.end(), std::greater<>()); // most likely first
+        for (int32_t i = 0; i < k; i++) {
+            top_ids[i] = heap[i].second;
+            top[i]     = heap[i].first - lse;
+        }
+        *own_lp = lg[own] - lse;
+    }
+
+    // after a sub-batch: the rows its outputs give, worked out over a few threads (a big vocab is ~250k floats a row)
+    void prompt_odds_read(server_slot & slot, const common_batch & view, int32_t n_view) {
+        auto & o = slot.podds;
+        std::vector<std::pair<const float *, int32_t>> todo; // (logits, row)
+        for (int32_t j = 0; j < n_view && j < view.size(); j++) {
+            const auto & t = view.tokens[j];
+            if (!t.output || t.seq_id != slot.id) {
+                continue;
+            }
+            const int32_t r = t.pos[0] + 1 - o.from;
+            if (r < 0 || r >= o.n || o.have[r]) {
+                continue;
+            }
+            const float * lg = llama_get_logits_ith(slot.ctx_tgt, j);
+            if (lg != nullptr) {
+                todo.emplace_back(lg, r);
+            }
+        }
+        if (todo.empty()) {
+            return;
+        }
+        const int32_t n_vocab = llama_vocab_n_tokens(vocab);
+        const int32_t k = o.k;
+        auto work = [&](size_t first, size_t step) {
+            for (size_t i = first; i < todo.size(); i += step) {
+                const int32_t r = todo[i].second;
+                prompt_odds_row(todo[i].first, n_vocab, k, o.ids[r], &o.top_ids[(size_t) r*k], &o.top[(size_t) r*k], &o.own[r]);
+            }
+        };
+        const size_t n_thr = std::min<size_t>({ (size_t) std::max(1, params_base.cpuparams.n_threads), (size_t) 16, (todo.size() + 7) / 8 });
+        std::vector<std::thread> pool;
+        for (size_t t = 1; t < n_thr; t++) {
+            pool.emplace_back(work, t, n_thr);
+        }
+        work(0, n_thr);
+        for (auto & th : pool) {
+            th.join();
+        }
+        for (const auto & d : todo) {
+            o.have[d.second] = 1;
+        }
+        o.got += (int32_t) todo.size();
+    }
+
+    // {from, n, k, ids, own, top_ids, top, missing}: row r is prompt token from + r. missing counts rows never read
+    // (should be 0); a row that was missed has own 0 and no top tokens.
+    json prompt_odds_end(server_slot & slot) {
+        auto & o = slot.podds;
+        if (o.k == 0) {
+            return nullptr;
+        }
+        const int32_t k = std::max(0, o.k);
+        json top_ids = json::array(), top = json::array();
+        for (int32_t r = 0; r < o.n; r++) {
+            if (!o.have[r]) {
+                top_ids.push_back(json::array());
+                top.push_back(json::array());
+                continue;
+            }
+            top_ids.push_back(std::vector<int32_t>(o.top_ids.begin() + (size_t) r*k, o.top_ids.begin() + (size_t) (r + 1)*k));
+            top.push_back(std::vector<float>(o.top.begin() + (size_t) r*k, o.top.begin() + (size_t) (r + 1)*k));
+        }
+        json out = {
+            { "from",    o.from },
+            { "n",       o.n },
+            { "k",       k },
+            { "ids",     o.ids },
+            { "own",     o.own },
+            { "top_ids", std::move(top_ids) },
+            { "top",     std::move(top) },
+            { "missing", o.n - o.got },
+        };
+        o.clear();
+        return out;
+    }
