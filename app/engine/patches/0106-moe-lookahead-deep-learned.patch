+        for (int32_t e = 0; e < n_exp; ++e) {
+            const float * b = p.B.data() + (size_t) e*r;
+            for (int32_t j = 0; j < r; ++j) {
+                pred[e] += b[j]*u[j];
+            }
+        }
+        // the contest is scored before this word is learned from
+        const size_t h_plain = hits(s.plain, s.picks, order);
+        const size_t h_learn = hits(pred, s.picks, order);
+        p.hp = decay*p.hp + h_plain;
+        p.hl = decay*p.hl + h_learn;
+        p.n_plain += h_plain;
+        p.n_learn += h_learn;
+        p.n_card  += p.lead ? h_learn : h_plain;
+        p.n_picks += s.picks.size();
+        p.n_words++;
+        // a softmax over the guess's scores, towards the picks
+        float mx = -INFINITY;
+        for (float v : pred) {
+            mx = std::max(mx, v);
+        }
+        double z = 0.0;
+        for (int32_t e = 0; e < n_exp; ++e) {
+            g[e] = std::exp(pred[e] - mx);
+            z += g[e];
+        }
+        for (int32_t e = 0; e < n_exp; ++e) {
+            g[e] = (float) (g[e]/z);
+        }
+        for (int32_t e : s.picks) {
+            if (e >= 0 && e < n_exp) {
+                g[e] -= 1.0f/(float) s.picks.size();
+            }
+        }
+        for (int32_t e = 0; e < n_exp; ++e) {
+            const float * b = p.B.data() + (size_t) e*r;
+            float * gb = gB.data() + (size_t) e*r;
+            for (int32_t j = 0; j < r; ++j) {
+                gb[j] = g[e]*u[j];
+                du[j] += b[j]*g[e];
+            }
+        }
+        for (int32_t j = 0; j < r; ++j) {
+            float * ga = gA.data() + (size_t) j*n_embd;
+            for (int32_t h = 0; h < n_embd; ++h) {
+                ga[h] = du[j]*s.x[h];
+            }
+        }
+        p.t++;
+        const float c1 = 1.0f - std::pow(b1, (float) p.t), c2 = 1.0f - std::pow(b2, (float) p.t);
+        adam(p.A, p.mA, p.vA, gA, c1, c2);
+        adam(p.B, p.mB, p.vB, gB, c1, c2);
+        // the card's guess follows the contest's winner
+        const bool lead = p.t >= min_words && (p.lead ? p.hl >= p.hp : p.hl > 1.01*p.hp);
+        if (lead != p.lead || (lead && p.t % every == 0)) {
+            p.lead  = lead;
+            p.rA    = p.A;
+            p.rB    = lead ? p.B : std::vector<float>(p.B.size(), 0.0f);
+            p.ready = true;
+        }
+    }
+
+    void run() {
+        for (;;) {
+            sample s;
+            {
+                std::unique_lock<std::mutex> lock(qm);
+                cv.wait(lock, [&] { return stop || !q.empty(); });
+                if (stop) {
+                    return;
+                }
+                s = std::move(q.front());
+                q.pop_front();
+            }
+            learn(s);
+        }
+    }
+
+    // a snapshot for source s, depth di, if one waits and the learner is not busy with it (never waits)
+    bool take(int32_t s, int32_t di, const float ** a, const float ** b) {
+        std::unique_lock<std::mutex> lock(sm, std::try_to_lock);
+        if (!lock.owns_lock()) {
+            return false;
+        }
+        pair & p = st[(size_t) s*nd + di];
+        if (!p.ready) {
+            return false;
+        }
+        p.upA.swap(p.rA);
+        p.upB.swap(p.rB);
+        p.ready = false;
+        *a = p.upA.data();
+        *b = p.upB.data();
+        return true;
+    }
+};
+
+size_t llama_moe_cache::impl::ll_bytes(const llama_model & model, const group & g, ggml_backend_buffer_type_t buft) const {
+    const size_t al = ggml_backend_buft_get_alignment(buft);
+    const size_t n_embd = model.hparams.n_embd, n_exp = g.ref[0]->ne[2];
+    const size_t per = la_nd*(GGML_PAD(n_embd*ll_rank*4, al) + GGML_PAD(ll_rank*n_exp*4, al) + GGML_PAD(n_exp*4, al)) + GGML_PAD(n_embd*4, al);
+    return per*g.layers.size();
+}
+
+void llama_moe_cache::impl::ll_init(const llama_model & model) {
+    int32_t n_exp = 0;
+    for (const group & g : groups) {
+        if (g.n_slots > 0) {
+            n_exp = std::max<int32_t>(n_exp, (int32_t) g.ref[0]->ne[2]);
+        }
+    }
+    if (n_exp == 0) {
+        return;
+    }
+    ll = new la_learner();
+    ll->n_embd  = (int32_t) model.hparams.n_embd;
+    ll->n_exp   = n_exp;
+    ll->r       = ll_rank;
+    ll->nd      = la_nd;
+    ll->n_layer = (int32_t) layers.size();
+    for (int32_t di = 0; di < la_nd; ++di) {
+        ll->depth[di] = la_depth[di];
+    }
+    if (const char * mw = getenv("LLAMA_MOE_LOOKAHEAD_LEARN_MIN"); mw != nullptr && atoi(mw) > 0) {
+        ll->min_words = atoi(mw);
+        ll->every     = std::max<int64_t>(1, std::min<int64_t>(32, ll->min_words/4));
+    }
+    ll->init();
+    ll_srcs.assign(layers.size(), ll_src());
+    LLAMA_LOG_INFO("llama_moe_cache: the look-ahead learns while writing (rank %d, %.2f MiB on the card): each guess is the router plus a correction learned from the picks, used where it guesses better\n",
+        ll_rank, [&] { size_t b = 0; for (const group & g : groups) { if (g.n_slots > 0) b += ll_bytes(model, g, devices[g.id].buft); } return b/1048576.0; }());
+}
+
+void llama_moe_cache::impl::ll_stop() {
+    if (ll != nullptr) {
+        ll->shutdown();
+    }
+}
+
+void llama_moe_cache::impl::ll_shutdown() {
+    if (ll != nullptr) {
+        ll->shutdown();
+        delete ll;
+        ll = nullptr;
+    }
+}
+
+// in layer il's copy callback, before the sync: what layer il's graph copied for the learner (one-word batches only)
+void llama_moe_cache::impl::ll_read(ggml_backend_t backend, int32_t il, int64_t n_tok) {
+    if (n_tok != 1 || il < 0 || il >= (int32_t) ll_srcs.size()) {
+        return;
+    }
+    if (il <= ll_last_il) {
+        ll_word++;
+    }
+    ll_last_il = il;
+    ll_src & s = ll_srcs[il];
+    s.word = ll_word;
+    bool any = false;
+    for (int32_t di = 0; di < la_nd; ++di) {
+        s.valid[di] = false;
+        llama_moe_cache::guess_learn gl;
+        if (get_guess_learn(il, di, 1, &gl) && gl.plain != nullptr && gl.x != nullptr && la_next(il, backend, di) >= 0) {
+            s.plain[di].resize(ggml_nelements(gl.plain));
+            ggml_backend_tensor_get_async(backend, gl.plain, s.plain[di].data(), 0, ggml_nbytes(gl.plain));
+            s.valid[di] = true;
+            any = true;
+        }
+    }
+    if (any) {
+        s.x.resize(ggml_nelements(layers[il].ll_x));
+        ggml_backend_tensor_get_async(backend, layers[il].ll_x, s.x.data(), 0, ggml_nbytes(layers[il].ll_x));
+    }
+}
+
+// after the sync: layer il's picks finish the samples of the layers that guessed it, and layer il's new corrections go up
+void llama_moe_cache::impl::ll_after_sync(ggml_backend_t backend, int32_t il, int64_t n_tok, const int32_t * picks, int32_t n_used) {
+    if (n_tok != 1 || il < 0 || il >= (int32_t) ll_srcs.size()) {
+        return;
+    }
+    for (int32_t di = 0; di < la_nd; ++di) {
+        const int32_t s = il - la_depth[di];
+        if (s < 0 || ll_srcs[s].word != ll_word || !ll_srcs[s].valid[di] || (int32_t) ll_srcs[s].plain[di].size() != ll->n_exp) {
+            continue;
+        }
+        ll_srcs[s].valid[di] = false;
+        la_learner::sample smp;
+        smp.s = s;
+        smp.di = di;
+        smp.x = ll_srcs[s].x;
+        smp.plain = ll_srcs[s].plain[di];
+        smp.picks.assign(picks, picks + n_used);
+        ll->push(std::move(smp));
+    }
+    // the card read this layer's corrections for this word already (they sit before the sync); the next word reads these
+    for (int32_t di = 0; di < la_nd; ++di) {
+        const float * a = nullptr;
+        const float * b = nullptr;
+        if (layers[il].ll_a[di] != nullptr && ll->take(il, di, &a, &b)) {
+            ggml_backend_tensor_set_async(backend, layers[il].ll_a[di], a, 0, ggml_nbytes(layers[il].ll_a[di]));
+            ggml_backend_tensor_set_async(backend, layers[il].ll_b[di], b, 0, ggml_nbytes(layers[il].ll_b[di]));
+        }
+    }
+}
+
+void llama_moe_cache::impl::ll_log() const {
+    if (ll == nullptr) {
+        return;
+    }
+    std::lock_guard<std::mutex> lock(ll->sm);
+    for (int32_t di = 0; di < la_nd; ++di) {
+        size_t np = 0, nl = 0, nc = 0, nk = 0, nw = 0, n_lead = 0, n_pairs = 0;
+        for (int32_t s = 0; s < ll->n_layer; ++s) {
+            const la_learner::pair & p = ll->st[(size_t) s*la_nd + di];
+            if (p.n_words == 0) {
+                continue;
+            }
+            n_pairs++;
+            n_lead += p.lead;
+            np += p.n_plain; nl += p.n_learn; nc += p.n_card; nk += p.n_picks; nw += p.n_words;
+        }
+        if (nk == 0) {
+            continue;
+        }
+        LLAMA_LOG_INFO("llama_moe_cache: learned look-ahead %d layer(s): %zu words learned from, picks guessed: plain router %.1f%%, learned %.1f%%, on the card %.1f%%; learned leads in %zu of %zu layers\n",
+            la_depth[di], nw, 100.0*np/nk, 100.0*nl/nk, 100.0*nc/nk, n_lead, n_pairs);
+    }
+    if (ll->dropped > 0) {
+        LLAMA_LOG_INFO("llama_moe_cache: learned look-ahead: %zu words not learned from (the learner was behind)\n", ll->dropped);
+    }
+}
