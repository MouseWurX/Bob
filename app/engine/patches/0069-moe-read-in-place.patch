+    // the copy callback of a long read's slot lookup: hits keep their slots, misses go up into the zone
+    bool ip_copy(ggml_backend_t backend, int32_t il, layer & l, group & g, const ggml_tensor * sel, ggml_tensor * dst) {
+        if (!ip_active) {
+            ip_begin();
+        }
+        ids.resize(ggml_nelements(sel));
+        ggml_backend_tensor_get_async(backend, sel, ids.data(), 0, ggml_nbytes(sel));
+        ggml_backend_synchronize(backend); // also: the layer before is done with the zone
+        if (rf_on) {
+            rf_tick();
+        }
+        rc_gen++;
+        if (ids_sink != nullptr) {
+            ids_sink(ids_sink_ud, il, ids.data(), ids.size(), (int32_t) sel->src[0]->ne[0]);
+        }
+        const int32_t n_exp = (int32_t) l.slot_map->ne[1];
+        const int32_t * slots = g.lru.slot_map[il];
+        const std::vector<int32_t> & zone = ip_zone[l.ig];
+        ip_seen.assign(n_exp, 0);
+        ip_map.assign(n_exp, 0);
+        ip_fills.clear();
+        size_t hits = 0;
+        for (int32_t e : ids) {
+            if (e < 0 || e >= n_exp || ip_seen[e]) {
+                continue;
+            }
+            ip_seen[e] = 1;
+        }
+        size_t zi = 0;
+        for (int32_t e = 0; e < n_exp; ++e) { // ascending, so consecutive misses land in consecutive zone slots
+            if (!ip_seen[e]) {
+                continue;
+            }
+            if (slots[e] < g.n_slots) {
+                ip_map[e] = slots[e];
+                hits++;
+            } else {
+                GGML_ASSERT(zi < zone.size() && "a long read missed more experts than its zone holds");
+                ip_map[e] = zone[zi];
+                ip_fills.push_back({ e, zone[zi] });
+                zi++;
+            }
+        }
+        const size_t bytes = upload_fills(backend, l, g, ip_fills);
+        ip_hits   += hits;
+        ip_misses += ip_fills.size();
+        ip_bytes  += bytes;
+        // the next call synchronizes the backend before ip_map changes again
+        ggml_backend_tensor_set_async(backend, dst, ip_map.data(), 0, ggml_nbytes(l.slot_map));
+        return true;
+    }
