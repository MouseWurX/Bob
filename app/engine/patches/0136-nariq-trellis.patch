+    const uint32_t mvq_nt = ids ? (ids->ne[1] == 1 ? 1u : 8u) : 0u;
+    const uint32_t max_runs = ids ? CEIL_DIV(Tc, std::max(mvq_nt, 1u)) + std::min(E, Tc) : 0u;
+    const uint64_t szQ = mvq ? ROUNDUP_POW2((uint64_t) Tc * K, align) : 0;
+    const uint64_t szS = mvq ? ROUNDUP_POW2((uint64_t) Tc * (K / 16) * sizeof(float), align) : 0;
+    const uint64_t szP = mvq && ids ? ROUNDUP_POW2(((uint64_t) Tc + 3ull * max_runs) * sizeof(uint32_t), align) : 0;
