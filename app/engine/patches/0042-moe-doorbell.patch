+            struct ggml_tensor       * ids,
+            struct ggml_tensor       * slot_map,
+            int32_t                    n_slots,
+            int32_t                    layer,
+            struct ggml_moe_doorbell * bell,
+            void                     * bell_dev);
+
+    // join: waits for the processor's answer to the last ring, then res = cached + out where slots has a zero slot,
+    // cached + 0 elsewhere (cached: f32 [n_embd, n_used, n_tokens], slots: the ring's result)
+    GGML_API struct ggml_tensor * ggml_moe_doorbell_join(
+            struct ggml_context      * ctx,
+            struct ggml_tensor       * cached,
+            struct ggml_tensor       * slots,
+            int32_t                    n_slots,
+            int32_t                    layer,
+            int32_t                    timeout_ms,
+            struct ggml_moe_doorbell * bell,
+            void                     * bell_dev);
