+// Brain Engine 0044: q3_0's 2-bit low parts and 1-bit high parts spread into bytes with a few masks and shifts, instead
+// of one value at a time (the same codes, checked for every input; writing long chats read the K/V cache this way)
+static __device__ __forceinline__ int q3_0_spread_lo(int x) {
+    x &= 0xFF;
+    x = (x | (x << 12)) & 0x000F000F;
+    return (x | (x << 6)) & 0x03030303;
+}
+static __device__ __forceinline__ int q3_0_spread_hi(int x) {
+    x &= 0xF;
+    x = (x | (x << 14)) & 0x00030003;
+    return (x | (x << 7)) & 0x01010101;
+}
