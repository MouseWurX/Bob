+size_t ggml_metal_op_trellis_extra(const ggml_tensor * op) {
+    const size_t batch = std::min<int64_t>(ggml_nrows(op->src[1]), GGML_METAL_TRELLIS_BATCH);
+    return 2*batch*(op->src[0]->ne[0] + op->src[0]->ne[1])*sizeof(float);
+}
