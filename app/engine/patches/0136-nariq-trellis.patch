+static bool ggml_vk_trellis_shape(int64_t n, int kind, int block, int shards, ggml_vk_trellis_side_shape & s) {
+    s = { kind, 0, 0, 1, 1 };
+    if (kind == 1) {
+        s.len = block;
+        s.run = block;
+        s.shards = (uint32_t) (n / block);
+    } else if (kind == 2) {
+        s.len = (uint32_t) (n / shards);
+        s.m = (uint32_t) ggml_trellis_hadfull_m(s.len);
+        if (s.m == 0) {
+            return false;
+        }
+        s.run = s.len / s.m;
+        s.shards = shards;
+    }
+    return true;
