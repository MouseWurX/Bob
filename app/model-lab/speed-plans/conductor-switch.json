  "--jinja",
  "-np",
  "1",
  "--no-webui",
  "-fa",
  "on",
  "-c",
  "49152",
  "-b",
  "4096",
  "-ub",
  "4096",
  "--fit",
  "off",
  "-ngl",
  "99",
