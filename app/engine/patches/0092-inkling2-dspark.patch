+// Brain Engine 0092: Inkling 2 DSpark (upstream #32773): the block runs once, then the rnn head draws each token, on the
+// card (backend sampling) or step by step on the host. Used only when the target is Inkling 2 (is_inkling2).
+
+// softmax probability of id under the raw logits of output i, used as the draft confidence
+static float inkling2_draft_token_prob(llama_context * ctx, int32_t i, llama_token id) {
+    const float * logits = llama_get_logits_ith(ctx, i);
+    if (logits == nullptr) {
+        return 1.0f;
+    }
+    const int n_vocab = llama_vocab_n_tokens(llama_model_get_vocab(llama_get_model(ctx)));
+    const float lmax = *std::max_element(logits, logits + n_vocab);
+    double sum = 0.0;
+    for (int k = 0; k < n_vocab; ++k) {
+        sum += std::exp(logits[k] - lmax);
+    }
+    return (float) (std::exp(logits[id] - lmax) / sum);
+}
