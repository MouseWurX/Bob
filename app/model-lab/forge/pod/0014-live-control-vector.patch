+    // Brain Engine live control vector (activation steering without a reload): added to the stream after each layer in range.
+    // body: {} or {"clear": true} = none;
+    //   {"file": "<cvector .gguf>", "scale": s, "start": 1, "end": n_layer - 1} = a whole direction, times s;
+    //   {"entries": [{"layer": l, "index": i, "value": v}, ...], "start": .., "end": ..} = single stream neurons only (the rest 0)
+    // Every call replaces the whole vector (layers it doesn't name are 0), so nothing is left over from the call before.
+    std::string set_cvec(const json & body) {
+        if (!body.is_object()) {
+            return "body must be an object";
+        }
+        for (const auto & slot : slots) {
+            if (slot.is_processing()) {
+                return "a slot is busy, set the control vector when the server is idle";
+            }
+        }
+        const int32_t n_layer = llama_model_n_layer(model_tgt);
+        const int32_t n_embd  = llama_model_n_embd(model_tgt);
+        const bool clear = body.empty() || (body.contains("clear") && body.at("clear").is_boolean() && body.at("clear").get<bool>());
+        int32_t start = body.contains("start") && body.at("start").is_number_integer() ? body.at("start").get<int32_t>() : 1;
+        int32_t end   = body.contains("end")   && body.at("end").is_number_integer()   ? body.at("end").get<int32_t>()   : n_layer - 1;
+        if (!clear && (start < 1 || end >= n_layer || start > end)) {
+            return "\"start\" and \"end\" must be layers 1 to n_layer - 1, start <= end";
+        }
+        std::vector<float> data;
+        json kept = nullptr;
+        if (!clear) {
+            data.assign((size_t) n_embd * (n_layer - 1), 0.0f);
+            if (body.contains("file")) {
+                if (!body.at("file").is_string()) {
+                    return "\"file\" must be a path";
+                }
+                const float scale = body.contains("scale") && body.at("scale").is_number() ? body.at("scale").get<float>() : 1.0f;
+                if (!std::isfinite(scale) || std::fabs(scale) > 1000.0f) {
+                    return "\"scale\" must be a number from -1000 to 1000";
+                }
+                common_control_vector_load_info info;
+                info.strength = scale;
+                info.fname    = body.at("file").get<std::string>();
+                const auto cv = common_control_vector_load({ info }, n_layer);
+                if (cv.n_embd == -1) {
+                    return "the control vector file could not be read";
+                }
+                if (cv.n_embd != n_embd) {
+                    return "the control vector was made for another model (n_embd differs)";
+                }
+                for (size_t i = 0; i < data.size() && i < cv.data.size(); i++) {
+                    data[i] = cv.data[i];
+                }
+                kept = json {{"file", info.fname}, {"scale", scale}, {"start", start}, {"end", end}};
+            } else if (body.contains("entries") && body.at("entries").is_array()) {
+                size_t n = 0;
+                for (const auto & e : body.at("entries")) {
+                    if (!e.is_object() || !e.contains("layer") || !e.at("layer").is_number_integer() || !e.contains("index") || !e.at("index").is_number_integer() || !e.contains("value") || !e.at("value").is_number()) {
+                        return "each entry needs \"layer\", \"index\" and \"value\"";
+                    }
+                    const int32_t l = e.at("layer").get<int32_t>(), i = e.at("index").get<int32_t>();
+                    const float   v = e.at("value").get<float>();
+                    if (l < 1 || l >= n_layer || i < 0 || i >= n_embd || !std::isfinite(v)) {
+                        return "an entry names a layer or neuron the model does not have";
+                    }
+                    data[(size_t) n_embd * (l - 1) + i] += v;
+                    n++;
+                }
+                kept = json {{"entries", n}, {"start", start}, {"end", end}};
+            } else {
+                return "give \"file\" (with \"scale\") or \"entries\", or {} to clear";
+            }
+        }
+        if (llama_set_adapter_cvec(ctx_tgt, clear ? nullptr : data.data(), data.size(), n_embd, clear ? -1 : start, clear ? -1 : end) != 0) {
+            return "the engine refused the control vector";
+        }
+        cvec_now = std::move(kept);
+        // cached prompts were computed with the old vector
+        for (auto & slot : slots) {
+            slot.prompt_clear();
+        }
+        if (prompt_cache) {
+            prompt_cache->states.clear();
+        }
+        SRV_INF("control vector %s\n", clear ? "cleared" : "set");
+        return "";
+    }
