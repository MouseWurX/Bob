diff --git a/ggml/src/ggml-cpu/ops.cpp b/ggml/src/ggml-cpu/ops.cpp
index 3c711ed..0870fa0 100644
--- a/ggml/src/ggml-cpu/ops.cpp
+++ b/ggml/src/ggml-cpu/ops.cpp
@@ -9,8 +9,10 @@
 #include "vec.h"
 
 #include <algorithm>
+#include <atomic>
 #include <cfloat>
 #include <cmath>
+#include <thread>
 
 // ggml_compute_forward_dup
 
@@ -12430,3 +12432,110 @@ void ggml_compute_forward_lightning_indexer(
         }
     }
 }
+
+// ggml_compute_forward_moe_doorbell (Brain Engine 0042)
+// The processor's own version of the doorbell, for cards that can't ring it themselves: the same steps as the card's
+// kernels, in plain memory. One thread does it all, the sizes are small (at most 8 tokens).
+
+static ggml_moe_doorbell * ggml_moe_doorbell_of(const ggml_tensor * dst) {
+    int64_t host = 0;
+    memcpy(&host, dst->op_params + 4, sizeof(host));
+    return (ggml_moe_doorbell *) (intptr_t) host;
+}
+
+static void ggml_compute_forward_moe_doorbell_ring(ggml_tensor * dst) {
+    const ggml_tensor * cur = dst->src[0];
+    const ggml_tensor * ids = dst->src[1];
+    const ggml_tensor * map = dst->src[2];
+    const int32_t n_slots = ggml_get_op_params_i32(dst, 1);
+    const int32_t layer   = ggml_get_op_params_i32(dst, 2);
+    ggml_moe_doorbell * bell = ggml_moe_doorbell_of(dst);
+    volatile ggml_moe_doorbell * vb = bell;
+
+    const int64_t n_used = ids->ne[0];
+    const int64_t n_tok  = ids->ne[1];
+    const int64_t n_embd = cur->ne[0];
+    const int64_t n_exp  = ggml_nelements(map);
+
+    const int32_t * pid  = (const int32_t *) ids->data;
+    const int32_t * pmap = (const int32_t *) map->data;
+    int32_t * slots = (int32_t *) dst->data;
+    int32_t * b_ids = (int32_t *) ((char *) bell + GGML_MOE_DOORBELL_OFF_IDS);
+    float   * b_cur = (float   *) ((char *) bell + GGML_MOE_DOORBELL_OFF_CUR);
+
+    for (int64_t i = 0; i < n_used*n_tok; ++i) {
+        const int32_t e = pid[i];
+        GGML_ASSERT(e >= 0 && e < n_exp);
+        const int32_t s = pmap[e];
+        // a miss reads zero slot k of the card's banks: distinct for the picks of one token
+        slots[i] = s < n_slots ? s : n_slots + (int32_t) (i % n_used);
+        b_ids[i] = e;
+    }
+    memcpy(b_cur, cur->data, n_embd*n_tok*sizeof(float));
+
+    vb->layer    = layer;
+    vb->n_tokens = (int32_t) n_tok;
+    vb->n_used   = (int32_t) n_used;
+    vb->n_embd   = (int32_t) n_embd;
+    // everything above is visible before the new seq is
+    std::atomic_thread_fence(std::memory_order_release);
+    vb->seq = vb->seq + 1;
+}
+
+static void ggml_compute_forward_moe_doorbell_join(ggml_tensor * dst) {
+    const ggml_tensor * cached = dst->src[0];
+    const ggml_tensor * slots  = dst->src[1];
+    const int32_t n_slots    = ggml_get_op_params_i32(dst, 1);
+    const int32_t layer      = ggml_get_op_params_i32(dst, 2);
+    const int32_t timeout_ms = ggml_get_op_params_i32(dst, 3);
+    ggml_moe_doorbell * bell = ggml_moe_doorbell_of(dst);
+    volatile ggml_moe_doorbell * vb = bell;
+
+    // wait for the processor's thread to answer the last ring: a short spin, then yield, never past the timeout
+    const uint32_t seq = vb->seq;
+    const int64_t t0 = ggml_time_ms();
+    for (int spin = 0; vb->done != seq; ++spin) {
+        if (spin < 4096) {
+            continue;
+        }
+        if (ggml_time_ms() - t0 > timeout_ms) {
+            vb->err_layer = layer;
+            vb->err_ms    = timeout_ms;
+            vb->err       = 1;
+            GGML_ABORT("MoE doorbell (LLAMA_MOE_DOORBELL): layer %d waited %d ms for the processor's part of its experts "
+                       "and gave up: the processor's thread did not answer. Unset LLAMA_MOE_DOORBELL to use the old path, "
+                       "or raise LLAMA_MOE_DOORBELL_TIMEOUT_MS", layer, timeout_ms);
+        }
+        std::this_thread::yield();
+    }
+    std::atomic_thread_fence(std::memory_order_acquire);
+
+    const int64_t n_embd = cached->ne[0];
+    const int64_t n_used = cached->ne[1];
+    const int64_t n_tok  = cached->ne[2];
+    const int32_t * ps  = (const int32_t *) slots->data;
+    const float   * out = (const float *) ((const char *) bell + ggml_moe_doorbell_off_out(n_embd));
+    for (int64_t t = 0; t < n_tok; ++t) {
+        for (int64_t k = 0; k < n_used; ++k) {
+            const bool    miss = ps[t*n_used + k] >= n_slots;
+            const float * c = (const float *) ((const char *) cached->data + k*cached->nb[1] + t*cached->nb[2]);
+            const float * o = out + (t*n_used + k)*n_embd;
+            float       * d = (float *) ((char *) dst->data + k*dst->nb[1] + t*dst->nb[2]);
+            // the same sum as the old path's add: the processor's part is +0 for the experts the card has
+            for (int64_t i = 0; i < n_embd; ++i) {
+                d[i] = c[i] + (miss ? o[i] : 0.0f);
+            }
+        }
+    }
+}
+
+void ggml_compute_forward_moe_doorbell(const ggml_compute_params * params, ggml_tensor * dst) {
+    if (params->ith != 0) {
+        return;
+    }
+    if (ggml_get_op_params_i32(dst, 0) == 0) {
+        ggml_compute_forward_moe_doorbell_ring(dst);
+    } else {
+        ggml_compute_forward_moe_doorbell_join(dst);
+    }
+}
