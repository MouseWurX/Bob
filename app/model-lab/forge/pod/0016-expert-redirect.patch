+ggml_tensor * llama_adapter_emask::redirect_for(int il) const {
+    if (!active || !ractive || il < 0 || (size_t) il >= rtensors.size()) {
+        return nullptr;
+    }
+
+    return rtensors[il];
+}
+
+bool llama_adapter_emask::apply_redirect(const llama_model & model, const int32_t * to, size_t len) {
+    const auto & hparams = model.hparams;
+
+    if (to == nullptr) {
+        ractive = false;
+        return true;
+    }
+
+    const size_t n_expert = hparams.n_expert;
+    const size_t n_layer  = hparams.n_layer();
+
+    if (!active || keep_now.size() != n_layer*n_expert) {
+        LLAMA_LOG_ERROR("%s: set the expert mask first, the redirect pairs off experts with kept ones\n", __func__);
+        return false;
+    }
+    if (len != n_layer*n_expert) {
+        LLAMA_LOG_ERROR("%s: redirect has %zu values, expected %zu (n_layer x n_expert)\n", __func__, len, n_layer*n_expert);
+        return false;
+    }
+    for (size_t il = 0; il < n_layer; il++) {
+        for (size_t e = 0; e < n_expert; e++) {
+            const int32_t t = to[il*n_expert + e];
+            const bool kept = keep_now[il*n_expert + e] != 0;
+            if (t < 0 || (size_t) t >= n_expert || !keep_now[il*n_expert + t] || (kept && (size_t) t != e)) {
+                LLAMA_LOG_ERROR("%s: layer %zu expert %zu: a kept expert maps to itself, an expert that is off maps to a kept one (got %d)\n", __func__, il, e, t);
+                return false;
+            }
+        }
+    }
+
+    if (rtensors.empty()) {
+        std::map<ggml_backend_buffer_type_t, ggml_context *> ctx_map;
+        for (size_t il = 0; il < n_layer; il++) {
+            ggml_backend_buffer_type_t buft = model.select_buft(il);
+            auto it = ctx_map.find(buft);
+            ggml_context * ctx = nullptr;
+            if (it != ctx_map.end()) {
+                ctx = it->second;
+            } else {
+                ggml_init_params params = {
+                    /*.mem_size   =*/ n_layer*ggml_tensor_overhead(),
+                    /*.mem_buffer =*/ NULL,
+                    /*.no_alloc   =*/ true,
+                };
+                ctx = ggml_init(params);
+                if (!ctx) {
+                    LLAMA_LOG_ERROR("%s: failed to allocate context for the expert redirect\n", __func__);
+                    return false;
+                }
+                ctx_map[buft] = ctx;
+                rctxs.emplace_back(ctx);
+            }
+            rtensors.push_back(ggml_new_tensor_2d(ctx, GGML_TYPE_F32, n_expert, n_expert));
+        }
+        for (auto it : ctx_map) {
+            ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors_from_buft(it.second, it.first);
+            if (!buf) {
+                LLAMA_LOG_ERROR("%s: failed to allocate buffer for the expert redirect\n", __func__);
+                rtensors.clear();
+                rctxs.clear();
+                return false;
+            }
+            rbufs.emplace_back(buf);
+        }
+    }
+
+    // m[from + to*n_expert] = 1: ggml_mul_mat(m, probs) gives each kept expert its own share plus its partners'
+    std::vector<float> m(n_expert*n_expert);
+    for (size_t il = 0; il < n_layer; il++) {
+        std::fill(m.begin(), m.end(), 0.0f);
+        for (size_t e = 0; e < n_expert; e++) {
+            m[e + (size_t) to[il*n_expert + e]*n_expert] = 1.0f;
+        }
+        ggml_backend_tensor_set(rtensors[il], m.data(), 0, m.size()*sizeof(float));
+    }
+
+    ractive = true;
+
+    return true;
+}
