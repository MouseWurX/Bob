+        base.x_nb1 = x->ne[1] == 1 ? 0 : (uint32_t) (x->nb[1] / sizeof(float));
+        base.x_ne2 = (uint32_t) ids->ne[1];
+        base.x_nb2 = (uint32_t) (x->nb[2] / sizeof(float));
+        base.x_nb3 = 0;
+        base.e_used = (uint32_t) ids->ne[0];
