+// Brain Engine 0046: plain C on every processor, as q3_0's: (2c - 3) against q8_0, times d/2
+void ggml_vec_dot_q2_kv_q8_0(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx, const void * GGML_RESTRICT vy, size_t by, int nrc) {
+    const int qk = QK8_0;
+    const int nb = n / qk;
+
+    assert(n % qk == 0);
+    assert(nrc == 1);
+    UNUSED(nrc);
+    UNUSED(bx);
+    UNUSED(by);
+    UNUSED(bs);
+
+    const block_q2_kv * GGML_RESTRICT x = vx;
+    const block_q8_0  * GGML_RESTRICT y = vy;
+
+    float sumf = 0;
+    for (int ib = 0; ib < nb; ++ib) {
+        int sumi = 0;
+        for (int j = 0; j < qk; ++j) {
+            const int c = (x[ib].qs[j/4] >> (2*(j%4))) & 3;
+            sumi += (2*c - 3) * y[ib].qs[j];
+        }
+        sumf += sumi*(0.5f*GGML_CPU_FP16_TO_FP32(x[ib].d))*GGML_CPU_FP16_TO_FP32(y[ib].d);
+    }
+
+    *s = sumf;
+}
