diff --git a/src/llama-moe-cache.cpp b/src/llama-moe-cache.cpp
index fd1d499..2aaee0e 100644
--- a/src/llama-moe-cache.cpp
+++ b/src/llama-moe-cache.cpp
@@ -3809,6 +3809,7 @@ struct llama_moe_cache::impl {
     size_t        bw_lend   = 0;   // bytes after bw_own it may borrow: the slots of group bw_g's first bank
     size_t        bw_step   = 0;   // the measured working memory of the reading step: a read lends that much at once
     size_t        bw_cur_peak = 0; // 0063: the working memory of the graph about to run (rewarm waits while it is lent)
+    size_t        bw_small  = 0;   // 0065: graphs up to this much (the own step, borrowed) lend only what they need
     bw_from_ptr_t bw_from_ptr = nullptr;
     ggml_backend_buffer_type_t bw_buft = nullptr; // the card's buffer type, but its buffers come from bw_alloc
     ggml_context_ptr ctx_bw;       // a byte view of one slot, twice per bank of group bw_g, for the moves
@@ -4144,7 +4145,11 @@ struct llama_moe_cache::impl {
         }
         // lend what the reading step needs at its biggest right away (the attention grows as a read goes on), so the
         // experts move once per read, not a few more with every step
-        peak = std::max(peak, std::min(bw_step, bw_own + bw_lend));
+        // 0065: with borrowed writing, a short read (up to the own step) lends only what it needs, so a tool's answer of a
+        // few hundred tokens doesn't empty the slots of a whole reading step
+        if (bw_small == 0 || peak > bw_small) {
+            peak = std::max(peak, std::min(bw_step, bw_own + bw_lend));
+        }
