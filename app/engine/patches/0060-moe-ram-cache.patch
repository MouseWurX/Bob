+    // the start fill: the ranking's busiest experts the card doesn't hold, read from the drive, until the block is full
+    void rc_prefill(const std::string & path) {
+        FILE * f = fopen(path.c_str(), "r");
+        if (f == nullptr) {
+            return;
+        }
+        char magic[32] = {0}, stamp[256] = {0};
+        int version = 0;
+        unsigned long long fp = 0;
+        if (fscanf(f, "%31s %d %llx %255s", magic, &version, &fp, stamp) != 4 || strcmp(magic, "bob-moe-ranking") != 0 || version != 2 || (uint64_t) fp != fingerprint) {
+            fclose(f);
+            LLAMA_LOG_WARN("llama_moe_cache: !!! RAM cache start fill NOT USED: the ranking doesn't fit this brain (%s)\n", path.c_str());
+            return;
+        }
+        std::vector<std::tuple<double, int32_t, int32_t>> cand;
+        int il = 0, e = 0;
+        double count = 0;
+        while (fscanf(f, "%d %d %lf", &il, &e, &count) == 3) {
+            if (il >= 0 && (size_t) il < layers.size() && layers[il].ig >= 0 && e >= 0 && e < (int) n_expert_all && count > 0) {
+                cand.emplace_back(count, il, e);
+            }
+        }
+        fclose(f);
+        std::sort(cand.begin(), cand.end(), [](const auto & a, const auto & b) { return std::get<0>(a) > std::get<0>(b); });
+        const int64_t t0 = ggml_time_us();
+        std::vector<std::unique_ptr<llama_file>> files(dr_paths.size());
+        size_t n_full = 0, bytes = 0;
+        for (const auto & [cnt, cl, ce] : cand) {
+            if (rc_stop.load() || n_full == rc_classes.size()*4) {
+                break;
+            }
+            const layer & l = layers[cl];
+            {
+                // on the card already (the ranked fill put it there): skip
+                const group & g = groups[l.ig];
+                if (g.lru.slot_map[cl] != nullptr && g.lru.slot_map[cl][ce] != g.lru.empty) { // read without a lock: at worst one expert is read twice or skipped
+                    continue;
+                }
+            }
+            for (const ggml_tensor * w : l.experts) {
+                const auto it = rc_tensor.find(w);
+                if (it == rc_tensor.end()) {
+                    continue;
+                }
+                rc_class & c = rc_classes[it->second.first];
+                const int64_t key = rc_key(it->second.second, ce);
+                int32_t s = -1;
+                {
+                    std::lock_guard<std::mutex> lock(rc_mutex);
+                    if (c.slot_of.count(key)) {
+                        continue;
+                    }
+                    // only empty entries: the start fill never pushes out what the chat brought in
+                    for (auto r = c.lru.rbegin(); r != c.lru.rend(); ++r) {
+                        if (c.key_of[*r] < 0 && c.gen_of[*r] != UINT64_MAX) {
+                            s = *r;
+                            break;
+                        }
+                    }
+                    if (s < 0) {
+                        n_full++;
+                        continue;
+                    }
+                    c.gen_of[s] = UINT64_MAX;
+                }
+                const dr_src & src = dr_of.at(w);
+                bool ok = true;
+                try {
+                    if (!files[src.file]) {
+                        files[src.file] = std::make_unique<llama_file>(dr_paths[src.file].c_str(), "rb", /*use_direct_io =*/ true);
+                    }
+                    files[src.file]->seek(src.offs + (size_t) ce*w->nb[2], SEEK_SET);
+                    files[src.file]->read_raw(c.at[s], c.size);
+                } catch (const std::exception & ex) {
+                    LLAMA_LOG_WARN("llama_moe_cache: RAM cache start fill stopped: %s\n", ex.what());
+                    ok = false;
+                }
+                std::lock_guard<std::mutex> lock(rc_mutex);
+                c.gen_of[s] = 0;
+                if (ok && !c.slot_of.count(key)) {
+                    // behind what the chat used: a start-fill entry is the first to go when the chat needs room
+                    if (c.key_of[s] >= 0) {
+                        c.slot_of.erase(c.key_of[s]);
+                    }
+                    c.key_of[s] = key;
+                    c.slot_of[key] = s;
+                    rc_prefilled++;
+                    bytes += c.size;
+                }
+                if (!ok) {
+                    return;
+                }
+            }
+        }
+        LLAMA_LOG_INFO("llama_moe_cache: RAM cache start fill: %zu expert matrices (%.0f MiB) in %.1f s\n",
+            rc_prefilled, bytes/1048576.0, (ggml_time_us() - t0)/1e6);
+    }
+
+    void rc_shutdown() {
+        rc_stop = true;
+        if (rc_filler.joinable()) {
+            rc_filler.join();
+        }
+    }
