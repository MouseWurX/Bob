+bool ggml_cuda_trellis_supported(const ggml_tensor * op) {
+    GGML_UNUSED(op);
+    return false;
+}
+
+void ggml_cuda_op_trellis(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    GGML_UNUSED(ctx);
+    GGML_UNUSED(dst);
