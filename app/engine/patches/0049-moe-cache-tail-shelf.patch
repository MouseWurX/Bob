+
+const char * llama_kv_cache::tail_refuse() const {
+    bool v_rows = true;
+    for (const auto & l : layers) {
+        if (l.k == nullptr || l.k_hot != nullptr || !l.k_tier.empty()) {
+            v_rows = false;
+        }
+    }
+    return n_stream > 1 || n_seq_max > 1 ? "it works with one chat at a time (-np 1)" :
+        tail_share ? "this cache shares cells or tensors with another" : is_indexer ? "indexer caches stay as they are" :
+        swa_type != LLAMA_SWA_TYPE_NONE ? "sliding-window caches are small already" : hparams.is_mla() ? "MLA brains keep a different cache" :
+        split_hot > 0 || !tiers.empty() || !v_rows ? "not together with LLAMA_KV_SPLIT or LLAMA_KV_TIERS" :
+        layers.empty() ? "no layer keeps chat memory" : nullptr;
+}
+
+std::vector<ggml_tensor *> llama_kv_cache::tail_tensors() const {
+    std::vector<ggml_tensor *> res;
+    for (const auto & l : layers) {
+        res.push_back(l.k);
+        if (l.v != nullptr && !v_trans) {
+            res.push_back(l.v); // a transposed V keeps a cell's values apart, one per row of the tensor
+        }
+    }
+    return res;
+}
+
+void llama_kv_cache::tail_lend(uint32_t keep, uint32_t step, tail_hooks hooks) {
+    tail_keep = std::min(get_size(), GGML_PAD(std::max<uint32_t>(keep, 256), 256u));
+    tail_step = GGML_PAD(std::max<uint32_t>(step, 256), 256u);
+    tail_cb   = std::move(hooks);
+    uint32_t used = 0;
+    for (uint32_t s = 0; s < n_stream; ++s) {
+        used = std::max(used, v_cells[s].used_max_p1());
+    }
+    tail_lim = std::max(tail_keep, std::min(get_size(), GGML_PAD(used, 256u)));
+}
+
+bool llama_kv_cache::tail_grow(uint32_t need) {
+    if (tail_lim == 0 || tail_lim >= get_size() || need <= tail_lim) {
+        return false;
+    }
+    const uint32_t to = std::min(get_size(), GGML_PAD(need, 256u));
+    LLAMA_LOG_INFO("%s: chat memory takes back cells %u to %u from the MoE cache (%u of %u now the chat's)\n", __func__,
+            tail_lim, to, to, get_size());
+    if (tail_cb.take) {
+        tail_cb.take(tail_lim, to);
+    }
+    tail_lim = to;
+    return true;
+}
