{
 "name": "Progressive Memory (0039) on Brain Engine 26 (0045 rework): perplexity/KLD of 3-step, 2-step and 8+3 against f16, with q8_0/q4_0/q3_0 baselines, 16K x 2 (windows scaled to a quarter so the tiers engage); plus 8+3 with the old pass forced",
 "method": "app/docs/test-results/2026-11-16-speed-test-method.md (addendum 73)",
 "brain": "${BRAIN}",
 "engines": {
  "be26": {
   "exe": "${BE26_PERPLEXITY}"
  }
 },
 "text": "long-text.md",
 "baseArgs": [
  "-fa",
  "on",
  "--fit",
  "on"
 ],
 "lock": "${LOCK}",
 "stopFile": "${STOP_FILE}",
 "rowTimeoutMs": 2700000,
 "groups": [
  {
   "id": "prog-16K",
   "about": "f16 base vs q8_0, q4_0, q3_0 and Progressive A (3-step), C (2-step), D (8+3) with windows a quarter of the 32K design so they engage at 16K (Addendum 71, rerun note)",
   "ctx": 16384,
   "chunks": 2,
   "needDiskGB": 12,
   "base": {
    "id": "f16",
    "engine": "be26",
    "args": [
     "-b",
     "2048",
     "-ub",
     "2048",
     "--moe-cache-mib",
     "4096",
     "--moe-cache-cpu-share",
     "0",
     "-ctk",
     "f16",
     "-ctv",
     "f16"
    ]
   },
   "rows": [
    {
     "id": "q8_0",
