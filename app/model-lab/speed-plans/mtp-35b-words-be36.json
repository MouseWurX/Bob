{
 "name": "MTP drafting words check on the 35B MTP file (Qwen3.6-35B-A3B-MTP-UD-Q4_K_XL) with Brain Engine 36: the 32K conductor-e2e job, temperature 0, plain vs --spec-type draft-mtp with 3 guesses. Same words = lossless here (then MTP can leave Turbo); different words = it stays behind Turbo. 2 rounds alternating, cool-down on.",
 "method": "app/docs/test-results/2026-11-16-speed-test-method.md (addendum 99)",
 "brain": "${BRAIN_MTP}",
 "engines": {
  "be36": {
   "exe": "${BE36_SERVER}",
   "env": {
    "GGML_CUDA_NO_PINNED": "1",
    "LLAMA_MOE_CACHE_LOG_EVERY": "2000"
   }
  }
 },
 "text": "long-text.md",
 "system": "You are a helpful assistant. Answer plainly.",
 "followUps": 5,
 "followTokens": 200,
 "replyTokens": 300,
 "retryOnce": true,
 "saveText": true,
 "spillCheck": true,
 "lock": "${LOCK}",
 "stopFile": "${STOP_FILE}",
 "textRepeat": 1,
 "bigRead": 12288,
 "rounds": 2,
 "alternate": true,
 "loadTimeoutMs": 900000,
 "wordsRef": "plain",
 "baseArgs": [
  "--jinja",
  "-np",
  "1",
  "--no-webui",
  "-fa",
  "on",
  "-c",
  "32768",
  "-ctk",
  "q4_0",
  "-ctv",
  "q4_0",
  "--fit",
  "on",
  "--fit-target",
  "512",
  "--moe-cache-mib",
  "4096",
  "-lv",
  "4"
 ],
 "ways": [
  {
   "id": "plain",
   "engine": "be36",
   "args": [
    "--moe-cache-cpu-share",
    "0"
   ]
  },
  {
   "id": "mtp-3",
   "engine": "be36",
   "args": [
    "--moe-cache-cpu-share",
    "0",
    "--spec-type",
    "draft-mtp",
    "--spec-draft-n-max",
    "3"
   ]
  }
 ]
}