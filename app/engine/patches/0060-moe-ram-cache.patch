+    // Brain Engine 0060 (LLAMA_MOE_RAM_CACHE_MIB=N, with the drive tier on): the RAM cache, Bob's own block of RAM for
+    // experts. Without it, a brain bigger than RAM leans on the system's file cache: the drive tier's reads skip it and are
+    // forgotten once uploaded, and the map's pages come and go as the system likes. With it, a fixed block (pinned where
+    // the card allows, in pieces of LLAMA_MOE_RAM_CACHE_CHUNK_MIB, default 256, so a partial refusal still leaves some)
+    // holds whole experts, one entry per expert matrix, least recently used out. A miss the RAM cache holds goes up from
+    // it; a miss it doesn't is read from the drive straight into an entry (or copied in from the map when its pages are in
+    // RAM) and goes up from there, so the next time it's a RAM hit. At start a thread fills it from the ranking
+    // (LLAMA_MOE_CACHE_RANKING or the saved hot set), busiest first, skipping what the card already holds.
+    // Entries are grouped by size (gate, up and down can be different types); each size gets its share of the block by
+    // how much of the brain's experts it makes up. An entry uploaded by this copy call is never replaced in the same call
+    // (the card may still be reading it); the next call starts after the card is done. The same bytes go up, so no word
+    // changes.
+    struct rc_class {
+        size_t size = 0, stride = 0;
+        std::vector<uint8_t *> at;
+        std::vector<int64_t>   key_of;  // -1 empty
+        std::vector<uint64_t>  gen_of;  // the copy call that last uploaded it; UINT64_MAX while the start fill reads it
+        std::list<int32_t>     lru;     // front = most recent
+        std::vector<std::list<int32_t>::iterator> pos;
+        std::unordered_map<int64_t, int32_t> slot_of;
+    };
+    bool rc_on = false, rc_pinned = false;
+    std::vector<rc_class> rc_classes;
+    std::unordered_map<const ggml_tensor *, std::pair<int32_t, int32_t>> rc_tensor; // -> (class, tensor id)
+    std::vector<const ggml_tensor *> rc_tensors;
+    std::vector<ggml_backend_buffer_ptr> rc_bufs;
+    std::vector<std::unique_ptr<uint8_t[]>> rc_plain;
+    std::mutex rc_mutex;
+    uint64_t rc_gen = 0;
+    std::thread rc_filler;
+    std::atomic<bool> rc_stop{false};
+    size_t rc_hits = 0, rc_from_map = 0, rc_from_drive = 0, rc_full = 0, rc_prefilled = 0, rc_hit_bytes = 0;
+    size_t rc_bytes = 0;
+
+    void rc_init(bool no_alloc) {
+        const char * m = getenv("LLAMA_MOE_RAM_CACHE_MIB");
+        if (no_alloc || m == nullptr || atof(m) <= 0) {
+            return;
+        }
+        if (!dr_on) {
+            LLAMA_LOG_WARN("llama_moe_cache: !!! LLAMA_MOE_RAM_CACHE_MIB NOT USED: it needs the drive tier (LLAMA_MOE_DRIVE=1)\n");
+            return;
+        }
+        const size_t want = (size_t) (atof(m)*1048576.0);
+        size_t chunk = 256*1048576ull;
+        if (const char * c = getenv("LLAMA_MOE_RAM_CACHE_CHUNK_MIB"); c != nullptr && atof(c) > 0) {
+            chunk = (size_t) (atof(c)*1048576.0);
+        }
+        // the classes: one per expert size, with the brain's bytes of that size
+        std::map<size_t, size_t> class_bytes;
+        for (const layer & l : layers) {
+            if (l.ig < 0) {
+                continue;
+            }
+            for (const ggml_tensor * w : l.experts) {
+                if (dr_of.count(w)) {
+                    class_bytes[(size_t) w->nb[2]] += (size_t) w->nb[2]*w->ne[2];
+                }
+            }
+        }
+        size_t all = 0;
+        for (auto & [sz, b] : class_bytes) {
+            all += b;
+        }
+        if (all == 0) {
+            LLAMA_LOG_WARN("llama_moe_cache: !!! LLAMA_MOE_RAM_CACHE_MIB NOT USED: no expert is read through the drive tier\n");
+            return;
+        }
+        ggml_backend_buffer_type_t host = nullptr;
+        for (const device & d : devices) {
+            if (!d.ctx) {
+                continue;
+            }
+            ggml_backend_dev_t dev = ggml_backend_buft_get_device(d.buft);
+            host = dev ? ggml_backend_dev_host_buffer_type(dev) : nullptr;
+            break;
+        }
+        bool pinned_ok = host != nullptr && !(getenv("LLAMA_MOE_RAM_CACHE_PLAIN") && atoi(getenv("LLAMA_MOE_RAM_CACHE_PLAIN")) > 0);
+        size_t n_pinned = 0, n_plain = 0;
+        std::map<size_t, int32_t> class_id;
+        for (auto & [sz, b] : class_bytes) {
+            rc_class c;
+            c.size   = sz;
+            c.stride = GGML_PAD(sz, 4096);
+            const size_t share = std::min(b + c.stride, (size_t) ((double) want*b/all));
+            const size_t per_chunk = std::max<size_t>(1, chunk/c.stride);
+            size_t n_slots = share/c.stride;
+            while (n_slots > 0) {
+                const size_t k = std::min(n_slots, per_chunk);
+                uint8_t * base = nullptr;
+                if (pinned_ok) {
+                    ggml_backend_buffer_ptr buf(ggml_backend_buft_alloc_buffer(host, k*c.stride));
+                    if (buf) {
+                        base = (uint8_t *) ggml_backend_buffer_get_base(buf.get());
+                        rc_bufs.push_back(std::move(buf));
+                        n_pinned += k*c.stride;
+                    } else {
+                        pinned_ok = false; // the system said no: the rest in plain memory
+                    }
+                }
+                if (base == nullptr) {
+                    std::unique_ptr<uint8_t[]> mem(new (std::nothrow) uint8_t[k*c.stride]);
+                    if (!mem) {
+                        break;
+                    }
+                    base = mem.get();
+                    rc_plain.push_back(std::move(mem));
+                    n_plain += k*c.stride;
+                }
+                for (size_t i = 0; i < k; ++i) {
+                    c.at.push_back(base + i*c.stride);
+                }
+                n_slots -= k;
+            }
+            const size_t n = c.at.size();
+            c.key_of.assign(n, -1);
+            c.gen_of.assign(n, 0);
+            c.pos.resize(n);
+            for (size_t i = 0; i < n; ++i) {
+                c.pos[i] = c.lru.insert(c.lru.end(), (int32_t) i);
+            }
+            class_id[sz] = (int32_t) rc_classes.size();
+            rc_classes.push_back(std::move(c));
+        }
+        for (const layer & l : layers) {
+            if (l.ig < 0) {
+                continue;
+            }
+            for (const ggml_tensor * w : l.experts) {
+                if (dr_of.count(w)) {
+                    rc_tensor[w] = { class_id.at((size_t) w->nb[2]), (int32_t) rc_tensors.size() };
+                    rc_tensors.push_back(w);
+                }
+            }
+        }
+        rc_bytes  = n_pinned + n_plain;
+        rc_pinned = n_plain == 0;
+        if (rc_bytes == 0) {
+            LLAMA_LOG_WARN("llama_moe_cache: !!! LLAMA_MOE_RAM_CACHE_MIB NOT USED: no memory could be had for it\n");
+            return;
+        }
+        rc_on = true;
+        size_t n_entries = 0;
+        for (const rc_class & c : rc_classes) {
+            n_entries += c.at.size();
+        }
+        LLAMA_LOG_INFO("llama_moe_cache: RAM cache on: %.0f MiB (%.0f MiB pinned, %.0f MiB plain), %zu expert entries in %zu size(s), %.1f%% of the brain's experts\n",
+            rc_bytes/1048576.0, n_pinned/1048576.0, n_plain/1048576.0, n_entries, rc_classes.size(), 100.0*rc_bytes/all);
+        const char * rank = getenv("LLAMA_MOE_CACHE_RANKING");
+        if (rank != nullptr && *rank != '\0' && !(getenv("LLAMA_MOE_RAM_CACHE_PREFILL") && atoi(getenv("LLAMA_MOE_RAM_CACHE_PREFILL")) == 0)) {
+            std::string path = rank;
+            rc_filler = std::thread([this, path] { rc_prefill(path); });
+        }
+    }
+
+    static int64_t rc_key(int32_t tid, int32_t e) {
+        return ((int64_t) tid << 32) | (uint32_t) e;
+    }
+
+    // the least recently used entry not uploaded by this call and not being filled, or -1; under rc_mutex
+    int32_t rc_victim(rc_class & c) {
+        for (auto it = c.lru.rbegin(); it != c.lru.rend(); ++it) {
+            const int32_t s = *it;
+            if (c.gen_of[s] != rc_gen && c.gen_of[s] != UINT64_MAX) {
+                return s;
+            }
+        }
+        return -1;
+    }
+
+    void rc_place(rc_class & c, int32_t s, int64_t key) {
+        if (c.key_of[s] >= 0) {
+            c.slot_of.erase(c.key_of[s]);
+        }
+        c.key_of[s] = key;
+        if (key >= 0) {
+            c.slot_of[key] = s;
+        }
+        c.lru.splice(c.lru.begin(), c.lru, c.pos[s]);
+    }
+
+    // one miss through the RAM cache: true when it was uploaded (now, or by the drive tier's next dr_upload)
+    bool rc_take(ggml_backend_t backend, const ggml_tensor * w, ggml_tensor * bank, int32_t e, size_t dst) {
+        const auto it = rc_tensor.find(w);
+        if (it == rc_tensor.end()) {
+            return false;
+        }
+        rc_class & c = rc_classes[it->second.first];
+        const int64_t key = rc_key(it->second.second, e);
+        const size_t  off = (size_t) e*w->nb[2];
+        const uint8_t * src = (const uint8_t *) w->data + off;
+        int32_t s = -1;
+        bool hit = false;
+        {
+            std::lock_guard<std::mutex> lock(rc_mutex);
+            const auto f = c.slot_of.find(key);
+            if (f != c.slot_of.end()) {
+                s   = f->second;
+                hit = true;
+                c.lru.splice(c.lru.begin(), c.lru, c.pos[s]);
+            } else {
+                s = rc_victim(c);
+                if (s < 0) {
+                    rc_full++;
+                    return false; // every entry is in use by this call: the drive tier's ring as before
+                }
+                rc_place(c, s, key);
+            }
+            c.gen_of[s] = rc_gen;
+        }
+        if (hit) {
+            ggml_backend_tensor_set_async(backend, bank, c.at[s], dst, c.size);
+            rc_hits++;
+            rc_hit_bytes += c.size;
+            return true;
+        }
+        if (!dr_all && dr_resident(src, c.size)) {
+            memcpy(c.at[s], src, c.size);
+            if (rf_on) {
+                rf_note(w, src, c.size);
+            }
+            ggml_backend_tensor_set_async(backend, bank, c.at[s], dst, c.size);
+            if (!rc_pinned) {
+                ggml_backend_synchronize(backend);
+            }
+            rc_from_map++;
+            return true;
+        }
+        dr_jobs.push_back({ w, bank, off, dst, c.size, c.at[s] });
+        rc_from_drive++;
+        return true;
+    }
+
+    // for other uploaders (0059's staging): the entry holding expert e of w, marked as used by this call, or nullptr
+    const void * rc_lookup(const ggml_tensor * w, int32_t e) {
+        if (!rc_on) {
+            return nullptr;
+        }
+        const auto it = rc_tensor.find(w);
+        if (it == rc_tensor.end()) {
+            return nullptr;
+        }
+        rc_class & c = rc_classes[it->second.first];
+        std::lock_guard<std::mutex> lock(rc_mutex);
+        const auto f = c.slot_of.find(rc_key(it->second.second, e));
+        if (f == c.slot_of.end()) {
+            return nullptr;
+        }
+        c.lru.splice(c.lru.begin(), c.lru, c.pos[f->second]);
+        c.gen_of[f->second] = rc_gen;
+        rc_hits++;
+        rc_hit_bytes += c.size;
+        return c.at[f->second];
+    }
