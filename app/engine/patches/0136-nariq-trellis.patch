@@ -134,6 +134,44 @@ if (CUDAToolkit_FOUND)
 
     target_link_libraries(ggml-cuda PRIVATE ${CMAKE_DL_LIBS})
 
+    # Build the vendored libtrellis, or the optional GGML_CUDA_TRELLIS_DIR override.
+    # Keep sm_80+ architectures; otherwise coded linears run on the CPU.
+    set(TRELLIS_DEFAULT_DIR "")
+    if (EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/libtrellis/include/libtrellis.h")
+        set(TRELLIS_DEFAULT_DIR "${CMAKE_CURRENT_SOURCE_DIR}/libtrellis")
+    endif()
+    set(GGML_CUDA_TRELLIS_DIR "${TRELLIS_DEFAULT_DIR}" CACHE PATH "trellis fork: the libtrellis folder (empty: no trellis support)")
+    set(TRELLIS_ARCHS "")
+    if (GGML_CUDA_TRELLIS_DIR)
+        file(GLOB TRELLIS_SOURCES "${GGML_CUDA_TRELLIS_DIR}/src/*.cu" "${GGML_CUDA_TRELLIS_DIR}/src/*.cpp")
+        set(TRELLIS_ARCH_LIST ${CMAKE_CUDA_ARCHITECTURES})
+        if ("native" IN_LIST TRELLIS_ARCH_LIST)
+            set(TRELLIS_ARCH_LIST ${CMAKE_CUDA_ARCHITECTURES_NATIVE})
+        elseif ("all" IN_LIST TRELLIS_ARCH_LIST)
+            set(TRELLIS_ARCH_LIST ${CMAKE_CUDA_ARCHITECTURES_ALL})
+        elseif ("all-major" IN_LIST TRELLIS_ARCH_LIST)
+            set(TRELLIS_ARCH_LIST ${CMAKE_CUDA_ARCHITECTURES_ALL_MAJOR})
+        endif()
+        foreach(ARCH IN LISTS TRELLIS_ARCH_LIST)
+            string(REGEX MATCH "^[0-9]+" ARCH_NUM "${ARCH}")
+            if (ARCH_NUM AND ARCH_NUM GREATER_EQUAL 80)
+                list(APPEND TRELLIS_ARCHS "${ARCH}")
+            endif()
+        endforeach()
+        if (NOT TRELLIS_ARCHS)
+            message(WARNING "trellis: no CUDA architecture of 80 or newer in ${TRELLIS_ARCH_LIST}; the coded linears run on the CPU")
+        endif()
+    endif()
+    if (TRELLIS_ARCHS)
+        add_library(ggml-trellis STATIC ${TRELLIS_SOURCES})
+        target_include_directories(ggml-trellis PUBLIC "${GGML_CUDA_TRELLIS_DIR}/include")
+        set_target_properties(ggml-trellis PROPERTIES POSITION_INDEPENDENT_CODE ON CUDA_ARCHITECTURES "${TRELLIS_ARCHS}")
+        target_compile_options(ggml-trellis PRIVATE $<$<COMPILE_LANGUAGE:CUDA>:--expt-relaxed-constexpr -O3>)
+        target_link_libraries(ggml-cuda PRIVATE ggml-trellis)
+        target_compile_definitions(ggml-cuda PRIVATE GGML_CUDA_TRELLIS)
+        message(STATUS "trellis: libtrellis from ${GGML_CUDA_TRELLIS_DIR} for ${TRELLIS_ARCHS}")
+    endif()
+
     if (GGML_CUDA_GRAPHS)
         add_compile_definitions(GGML_CUDA_USE_GRAPHS)
     endif()
