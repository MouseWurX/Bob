--- a/ggml/src/ggml-cpu/ggml-cpu.c
+++ b/ggml/src/ggml-cpu/ggml-cpu.c
@@ -1702,9 +1702,113 @@ void ggml_cpu_expert_read_whole(const struct ggml_tensor * src0, const int64_t *
     ggml_critical_section_end();
 }
 
+// Brain Engine 0040: an expert product the graph marked (op_params[0] == 1, the expert cache's CPU part) rounds its
+// input the way a CUDA card does: in blocks of 32 values with one scale each (q8_0, as the card's q8_1), instead of the
+// k-quants' blocks of 256 (q8_K). Each weight row is turned into floats once and dotted with every word routed to it.
+// The card's sums run in another order, so the last bits can still differ; the rounding, the main difference, is the same.
+static bool ggml_mul_mat_id_card_round(const struct ggml_tensor * dst) {
+    const struct ggml_tensor * src0 = dst->src[0];
+    const enum ggml_type t = src0->type;
+    return ggml_get_op_params_i32(dst, 0) == 1 && dst->src[1]->type == GGML_TYPE_F32 && ggml_is_quantized(t) &&
+           type_traits_cpu[t].vec_dot_type == GGML_TYPE_Q8_K && ggml_get_type_traits(t)->to_float != NULL &&
+           src0->ne[0] % QK8_0 == 0 && src0->ne[0] <= 16384 &&
+           ggml_row_size(GGML_TYPE_Q8_0, src0->ne[0]) <= ggml_row_size(GGML_TYPE_Q8_K, src0->ne[0]);
+}
+
+static void ggml_compute_forward_mul_mat_id_card_round(
+        const struct ggml_compute_params * params,
+              struct ggml_tensor * dst) {
+    const struct ggml_tensor * src0 = dst->src[0];
+    const struct ggml_tensor * src1 = dst->src[1];
+    const struct ggml_tensor * ids  = dst->src[2];
+
+    GGML_TENSOR_BINARY_OP_LOCALS
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+    const int n_ids = ids->ne[0];
+    const int n_as  = ne02;
+
+    ggml_to_float_t const to_float = ggml_get_type_traits(src0->type)->to_float;
+    ggml_from_float_t const q8 = type_traits_cpu[GGML_TYPE_Q8_0].from_float;
+
+    // the same work buffer layout as the usual path, with q8_0 rows (never bigger than q8_K rows)
+    void * wdata_cur = params->wdata;
+    const size_t row_size = ggml_row_size(GGML_TYPE_Q8_0, ne10);
+    char * qdata = incr_ptr_aligned(&wdata_cur, row_size*ne11*ne12*ne13, sizeof(int64_t));
+    int64_t * matrix_row_counts = incr_ptr_aligned(&wdata_cur, n_as*sizeof(int64_t), sizeof(int64_t));
+    struct mmid_row_mapping * matrix_rows = incr_ptr_aligned(&wdata_cur, n_as*ids->ne[0]*ids->ne[1]*sizeof(struct mmid_row_mapping), sizeof(int64_t));
+    GGML_ASSERT(params->wsize >= (size_t)((char *) wdata_cur - (char *) params->wdata));
+
+    for (int64_t i13 = 0; i13 < ne13; ++i13) {
+        for (int64_t i12 = 0; i12 < ne12; ++i12) {
+            for (int64_t i11 = ith; i11 < ne11; i11 += nth) {
+                q8((const float *) ((const char *) src1->data + i13*nb13 + i12*nb12 + i11*nb11),
+                   qdata + ((i13*ne12 + i12)*ne11 + i11)*row_size, ne10);
+            }
+        }
+    }
+
+    if (ith == 0) {
+        memset(matrix_row_counts, 0, n_as*sizeof(int64_t));
+        for (int64_t iid1 = 0; iid1 < ids->ne[1]; ++iid1) {
+            for (int id = 0; id < n_ids; ++id) {
+                const int32_t i02 = *(const int32_t *) ((const char *) ids->data + iid1*ids->nb[1] + id*ids->nb[0]);
+                if (i02 == -1) {
+                    memset((char *) dst->data + id*nb1 + iid1*nb2, 0, ne0*sizeof(float));
+                    continue;
+                }
+                GGML_ASSERT(i02 >= 0 && i02 < n_as);
+                MMID_MATRIX_ROW(i02, matrix_row_counts[i02]) = (struct mmid_row_mapping) {id, iid1};
+                matrix_row_counts[i02] += 1;
+            }
+        }
+        ggml_cpu_expert_read_whole(src0, matrix_row_counts, n_as); // Brain Engine 0020, off unless asked
+    }
+
+    ggml_barrier(params->threadpool);
+
+    float w[16384];
+    const int64_t nb = ne00 / QK8_0;
+    for (int cur_a = 0; cur_a < n_as; ++cur_a) {
+        const int64_t cne1 = matrix_row_counts[cur_a];
+        if (cne1 == 0) {
+            continue;
+        }
+        const char * src0_cur = (const char *) src0->data + cur_a*nb02;
+        const int64_t ir0 = ne01*ith/nth, ir1 = ne01*(ith + 1)/nth;
+        for (int64_t ir = ir0; ir < ir1; ++ir) {
+            to_float(src0_cur + ir*nb01, w, ne00);
+            for (int64_t j = 0; j < cne1; ++j) {
+                const struct mmid_row_mapping rm = MMID_MATRIX_ROW(cur_a, j);
+                const int64_t i11 = rm.i1 % ne11, i12 = rm.i2;
+                const block_q8_0 * a = (const block_q8_0 *) (qdata + (i12*ne11 + i11)*row_size);
+                float sum = 0.0f;
+                for (int64_t b = 0; b < nb; ++b) {
+                    const float * wb = w + b*QK8_0;
+                    float acc[8] = { 0 }; // eight lanes, so the compiler can use vector registers
+                    for (int k = 0; k < QK8_0; k += 8) {
+                        for (int l = 0; l < 8; ++l) {
+                            acc[l] += wb[k + l] * (float) a[b].qs[k + l];
+                        }
+                    }
+                    const float sb = ((acc[0] + acc[1]) + (acc[2] + acc[3])) + ((acc[4] + acc[5]) + (acc[6] + acc[7]));
+                    sum += sb * GGML_CPU_FP16_TO_FP32(a[b].d);
+                }
+                *(float *) ((char *) dst->data + rm.i1*nb1 + rm.i2*nb2 + ir*nb0) = sum;
+            }
+        }
+    }
+}
+
 static void ggml_compute_forward_mul_mat_id(
         const struct ggml_compute_params * params,
               struct ggml_tensor * dst) {
+    if (ggml_mul_mat_id_card_round(dst)) {
+        ggml_compute_forward_mul_mat_id_card_round(params, dst);
+        return;
+    }
+
 
     const struct ggml_tensor * src0 = dst->src[0];
     const struct ggml_tensor * src1 = dst->src[1];
