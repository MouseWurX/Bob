+bool llama_model_base::create_trellis_bands(int64_t n_embd, int64_t n_vocab) {
+    return create_trellis_banded("trellis.lm_head_bands", LLM_TENSOR_OUTPUT, "lm_head", n_embd, n_vocab,
+            trellis.bands, trellis.vocab_gather);
+}
+
+bool llama_model_base::create_trellis_embed_bands(int64_t n_embd, int64_t n_vocab) {
+    if (!create_trellis_banded("trellis.embed_bands", LLM_TENSOR_TOKEN_EMBD, "embedding", n_embd, n_vocab,
+            trellis.embed_bands, trellis.embed_gather)) {
+        return false;
+    }
+    // build_inp_embd reads the bands only with the coded row lookup
+    for (const ggml_tensor * w : trellis.embed_bands) {
+        if (trellis_weight(w) == nullptr) {
+            throw std::runtime_error(format("trellis: embedding band %s is not coded", ggml_get_name(w)));
+        }
+    }
+    return true;
 }
 
