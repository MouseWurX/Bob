+    // Brain Engine 0042: the doorbell between a card and the processor, for the expert cache's misses.
+    // The card writes one layer's picks and expert input into host memory it can write while it runs (mapped pinned
+    // memory on CUDA, plain memory for the processor's own version of the op) and adds one to seq. A thread on the
+    // processor sees the new seq, computes the experts the card doesn't have into out and sets done to that seq.
+    // The card waits for done (at most timeout_ms, then it stops with a message) and adds out to its own part.
+    // Each counter sits on its own 64-byte line, so the card's and the processor's writes don't share one.
+    #define GGML_MOE_DOORBELL_MAX_TOKENS 8
+    #define GGML_MOE_DOORBELL_MAX_USED   64
+    #define GGML_MOE_DOORBELL_OFF_IDS    256
+    #define GGML_MOE_DOORBELL_OFF_CUR    (GGML_MOE_DOORBELL_OFF_IDS + 4*GGML_MOE_DOORBELL_MAX_USED*GGML_MOE_DOORBELL_MAX_TOKENS)
+
+    struct ggml_moe_doorbell {
+        uint32_t seq;  uint32_t pad0[15];                            // written by the card: one more per ring
+        uint32_t done; uint32_t pad1[15];                            // written by the processor: the seq it answered
+        uint32_t err;  int32_t err_layer; int32_t err_ms; uint32_t pad2[13]; // set by the card when it gave up waiting
+        int32_t  layer; int32_t n_tokens; int32_t n_used; int32_t n_embd; uint32_t pad3[12]; // of the last ring
+        // then: ids  i32 [n_used, n_tokens] at GGML_MOE_DOORBELL_OFF_IDS
+        //       cur  f32 [n_embd, n_tokens] at GGML_MOE_DOORBELL_OFF_CUR
+        //       out  f32 [n_embd, n_used, n_tokens] at ggml_moe_doorbell_off_out(n_embd), the processor's part
+    };
+
+    static inline size_t ggml_moe_doorbell_off_out(int64_t n_embd) {
+        return GGML_MOE_DOORBELL_OFF_CUR + (size_t) (4*n_embd*GGML_MOE_DOORBELL_MAX_TOKENS + 63)/64*64;
+    }
+    static inline size_t ggml_moe_doorbell_size(int64_t n_embd, int64_t n_used) {
+        return ggml_moe_doorbell_off_out(n_embd) + (size_t) 4*n_embd*n_used*GGML_MOE_DOORBELL_MAX_TOKENS;
+    }
+
+    // ring: slots[k, t] = slot_map[ids[k, t]] if below n_slots, else n_slots + k (a zero slot of the card's banks), and
+    // the picks and cur are published to the processor (ids: i32 [n_used, n_tokens], cur: f32 [n_embd, ..., n_tokens],
+    // both contiguous, slot_map: i32 [n_expert] or [1, n_expert]); res: i32 [n_used, n_tokens]
+    // bell is the host pointer, bell_dev the card's pointer to the same memory (NULL for the processor's version)
+    GGML_API struct ggml_tensor * ggml_moe_doorbell_ring(
