+            return false;
+        }
+    }
+    const ggml_type types[] = { GGML_TYPE_F16, GGML_TYPE_F32, GGML_TYPE_F32, GGML_TYPE_I32, GGML_TYPE_I32 };
+    const int64_t sizes[] = { w->ne[0] / 16, w->ne[0], w->ne[1], w->ne[0], w->ne[1] };
+    for (int i = 0; i < 5; ++i) {
+        const ggml_tensor * t = op->src[i + 2];
+        if (!t) {
+            if (i < 3) {
+                return false;
+            }
+            continue;
+        }
+        if (t->type != types[i] || !ggml_is_contiguous(t) || ggml_nelements(t) != sizes[i]) {
+            return false;
+        }
+    }
+    ggml_vk_trellis_side_shape rows, cols;
+    if (!ggml_vk_trellis_shape(w->ne[1], d[0], d[1], d[2], rows) || !ggml_vk_trellis_shape(w->ne[0], d[3], d[4], d[5], cols)) {
+        return false;
+    }
+    return ggml_vk_trellis_side_ok(device, rows) && ggml_vk_trellis_side_ok(device, cols) &&
+           (uint64_t) w->ne[1] / 16 <= device->properties.limits.maxComputeWorkGroupCount[0];
