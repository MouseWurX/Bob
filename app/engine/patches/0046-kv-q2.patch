+// Brain Engine 0046: as quantize_row_q2_kv_ref (the same scales tried, the least squared error kept, the first on a
+// tie), with every division, reciprocal, product and sum rounded on its own as on the processor (this file is built
+// with fast math and the compiler fuses multiply-adds), so the card and the processor pick the same d and codes
+static __device__ void quantize_f32_q2_kv_block(const float * __restrict__ x, block_q2_kv * __restrict__ y) {
+    const float ks[] = { GGML_Q2_KV_DIVISORS };
+    float amax = 0.0f;
+
+    for (int j = 0; j < QK2_KV; ++j) {
+        amax = fmaxf(amax, fabsf(x[j]));
+    }
+
+    float   best_err = 0.0f;
+    half    best_dh  = __float2half_rn(0.0f);
+    uint8_t best_qs[QK2_KV/4] = {0};
+
+#pragma unroll
+    for (int s = 0; s < int(sizeof(ks)/sizeof(ks[0])); ++s) {
+        const half  dh = __float2half_rn(__fdiv_rn(amax, ks[s]));
+        const float d  = __half2float(dh);
+        const float id = d ? __frcp_rn(d) : 0.0f;
+        const float hd = 0.5f*d;
+
+        uint8_t qs[QK2_KV/4] = {0};
+        float   err = 0.0f;
+        for (int j = 0; j < QK2_KV; ++j) {
+            const int c = max(0, min(3, (int) floorf(__fadd_rn(__fmul_rn(x[j], id), 2.0f))));
+            qs[j/4] |= (uint8_t) (c << (2*(j%4)));
+            const float e = __fsub_rn(x[j], (float) (2*c - 3)*hd); // the product is exact
+            err = __fadd_rn(err, __fmul_rn(e, e));
+        }
+        if (s == 0 || err < best_err) {
+            best_err = err;
+            best_dh  = dh;
+            for (int j = 0; j < QK2_KV/4; ++j) {
+                best_qs[j] = qs[j];
+            }
+        }
+    }
+
+    y->d = best_dh;
+    for (int j = 0; j < QK2_KV/4; ++j) {
+        y->qs[j] = best_qs[j];
+    }
+}
+
+static __device__ void cpy_blck_f32_q2_kv(const char * cxi, char * cdsti) {
+    quantize_f32_q2_kv_block((const float *)cxi, (block_q2_kv *)cdsti);
+}
