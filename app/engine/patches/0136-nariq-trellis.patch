+// trellis fork: ggml_trellis_mul_mat, ggml_trellis_get_rows, ggml_trellis_get_rows_band
+
+bool ggml_is_trellis_type(enum ggml_type type) {
+    return type >= GGML_TYPE_TRL1 && type <= GGML_TYPE_TRL6;
