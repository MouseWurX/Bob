+ggml_tensor * llama_kv_cache::cpy_k_hot(ggml_context * ctx, ggml_tensor * k_cur, ggml_tensor * idxs_hot, int32_t il) const {
+    ggml_tensor * k = layers[map_layer_ids.at(il)].k_hot;
+    GGML_ASSERT(ggml_row_size(k_cur->type, k_cur->ne[0]) == k_cur->nb[1]);
+    k_cur = ggml_view_2d(ctx, k_cur, k_cur->ne[0]*k_cur->ne[1], k_cur->ne[2], k_cur->nb[2], 0);
