new file mode 100644
index 0000000..1e3a8e7
--- /dev/null
+++ b/ggml/src/ggml-rpc/scut.h
@@ -0,0 +1,49 @@
+#pragma once
+// SCUT (Signals and Communications - Universal Transceiver): Bob's own transport for card sharing over home Wi-Fi (Brain Engine patch 0005).
+//
+// Opt-in (GGML_RPC_SCUT=1 on both machines), agreed in the HELLO handshake through conn_caps, and the original TCP
+// protocol is used whenever either side doesn't offer it or the UDP path doesn't answer. The RPC commands themselves
+// are unchanged: SCUT only replaces how the bytes travel.
+//   - one datagram train per message instead of one TCP send per field (a word's ~11 small commands go out as a few
+//     packets, not ~30), and nothing waits for an ack before sending;
+//   - a lost packet is resent after a few milliseconds (measured round trip), not after TCP's 200-300 ms timeout;
+//   - only what's missing is resent (selective acks);
+//   - it paces itself: a speed cap (GGML_RPC_SCUT_MBPS, default 300) and it slows down when packets are lost, so
+//     it never floods the home network;
+//   - while words are flowing it can send a tiny "stay awake" ping every 25 ms so a handheld's Wi-Fi doesn't doze
+//     between words (GGML_RPC_SCUT_AWAKE=0 turns that off).
+// The TCP connection stays open beside it, as the "are you still there" line.
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+
+#ifdef _WIN32
+#  ifndef NOMINMAX
+#    define NOMINMAX
+#  endif
+#  include <winsock2.h>
+typedef SOCKET scut_fd_t;
+#else
+typedef int scut_fd_t;
+#endif
+
+struct scut;
+
+struct scut_ptr_deleter { void operator()(scut * b) const; };
+typedef std::unique_ptr<scut, scut_ptr_deleter> scut_ptr;
+
+// Whether this machine offers SCUT (GGML_RPC_SCUT=1).
+bool scut_enabled();
+// Opens the UDP side next to an accepted (server) or connected (client) TCP socket and writes the offer into caps
+// (RPC_CONN_CAPS_SIZE bytes). Returns null (caps left as they were) when it can't.
+scut_ptr scut_prepare(scut_fd_t tcp_fd, bool server, uint8_t * caps, size_t caps_size);
+// Whether the peer's caps carry a SCUT offer.
+bool scut_offered(const uint8_t * caps, size_t caps_size);
+// Both sides call this after the HELLO answer is on the wire. The client probes the UDP path and tells the server
+// over TCP whether to switch; both return the same answer. false = stay on TCP.
+bool scut_activate(scut * b, const uint8_t * remote_caps, size_t caps_size);
+
+bool scut_send(scut * b, const void * data, size_t size);
+bool scut_flush(scut * b);
+bool scut_recv(scut * b, void * data, size_t size);
