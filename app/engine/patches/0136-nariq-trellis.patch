+#version 450
+
+// Lamplight 0136: a NariQ trellis weight's rows [16 row0_tile, ...) in the rotated basis to f16 (rows x K), for the f16
+// matrix multiply of long batches. The values are integers in [-126, 126], exact in f16; the per-16-input scale goes onto
+// the input (trellis_scale.comp). Eight tiles (16 rows x 128 inputs) per workgroup of 256: each 32-lane group decodes a
+// tile into shared memory, then each row's 128 values are written as one run (written straight from the decode they
+// scatter over 16 rows).
+
+#extension GL_EXT_control_flow_attributes : require
+#extension GL_EXT_shader_16bit_storage : require
+
+layout(constant_id = 0) const uint BITS = 3;
+
+layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+
+layout(push_constant) uniform parameter {
+    uint K;
+    uint row0_tile;  // first tile row
+    uint q_offset;
+} p;
+
+layout(binding = 0, std430) readonly buffer Q { uint data_q[]; };
+layout(binding = 1, std430) writeonly buffer W { float16_t data_w[]; };
+
+shared float tile_v[16][128];
+
+#include "trellis_decode.glsl"
+
+void main() {
+    const uint kt = p.K / 16u;
+    const uint lane = gl_LocalInvocationID.x & 31u;
+    const uint g = gl_LocalInvocationID.x >> 5;
+    const uint i0 = gl_WorkGroupID.x * 8u;
+    const uint J = gl_WorkGroupID.y;  // within the chunk
+    const uint nt = min(8u, kt - i0);
+    if (g < nt) {
+        float v[8];
+        trellis_decode8(p.q_offset + ((p.row0_tile + J) * kt + i0 + g) * (8u * BITS), lane, v);
+        [[unroll]] for (uint j = 0; j < 8u; ++j) {
+            const uint r = lane / 4u + 8u * (j / 4u);
+            const uint c = 16u * g + 2u * (lane % 4u) + j % 2u + 8u * (j / 2u % 2u);
+            tile_v[r][c] = v[j];
+        }
+    }
+    barrier();
+    const uint ncols = 16u * nt;
+    for (uint e = gl_LocalInvocationID.x; e < 16u * ncols; e += 256u) {
+        const uint r = e / ncols, c = e % ncols;
+        data_w[(16u * J + r) * p.K + 16u * i0 + c] = float16_t(tile_v[r][c]);
+    }
+}
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/trellis_io.comp b/ggml/src/ggml-vulkan/vulkan-shaders/trellis_io.comp
new file mode 100644
index 0000000..230bfa8
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/trellis_io.comp
@@ -0,0 +1,31 @@
+#version 450
+
+// Lamplight 0136: the elementwise ends of a NariQ linear whose side has no rotation, or whose output has a gather.
+// mode 0 (input):  scratch[t][i] = x[first + t][pin ? pin[i] : i] * pre[i]
+// mode 1 (output): dst[first + t][i] = scratch[t][j] * post[j], j = pout ? pout[i] : i
+// mode bit 3: coded experts: pre / post of the row's expert, G the ids (trellis_side.glsl)
+// One invocation per (entry, token).
+
+layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+
+#include "trellis_side.glsl"
+
+layout(binding = 0, std430) readonly buffer X { float data_x[]; };
+layout(binding = 1, std430) readonly buffer V { float data_v[]; };
+layout(binding = 2, std430) readonly buffer G { int data_g[]; };
+layout(binding = 3, std430) writeonly buffer DST { float data_dst[]; };
+
+void main() {
+    const uint i = gl_GlobalInvocationID.x;
+    const uint t = gl_GlobalInvocationID.y;
+    if (i >= p.n) {
+        return;
+    }
+    const uint g0 = TRELLIS_G(p.first + t), v0 = TRELLIS_V(p.first + t);
+    const uint j = g0 != 0xFFFFFFFFu ? uint(data_g[g0 + i]) : i;
+    if ((p.mode & 1u) == 0u) {
+        data_dst[t * p.n + i] = data_x[trellis_x_row(p.first + t) + j] * data_v[v0 + i];
+    } else {
+        data_dst[p.d_offset + (p.first + t) * p.n + i] = data_x[t * p.n + j] * data_v[v0 + j];
+    }
+}
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/trellis_mv.comp b/ggml/src/ggml-vulkan/vulkan-shaders/trellis_mv.comp
new file mode 100644
index 0000000..7bc6f8a
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/trellis_mv.comp
@@ -0,0 +1,77 @@
+#version 450
+
+// Lamplight 0136: y = W^ x for a NariQ trellis weight in its rotated basis, NT columns per workgroup.
+// One workgroup per 16-row tile row: four 32-lane groups split K, each lane decodes 8 weights per tile.
+
+#extension GL_EXT_control_flow_attributes : require
+#extension GL_EXT_shader_16bit_storage : require
+
+layout(constant_id = 0) const uint BITS = 3;
+layout(constant_id = 1) const uint NT = 1;
+
+layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
+
+layout(push_constant) uniform parameter {
+    uint K;
+    uint N;
+    uint T;
+    uint q_offset;  // words
+    uint s_offset;  // halves
+    uint a_offset;  // floats
+    uint b_offset;  // floats
+} p;
+
+layout(binding = 0, std430) readonly buffer Q { uint data_q[]; };
+layout(binding = 1, std430) readonly buffer S { float16_t data_s[]; };
+layout(binding = 2, std430) readonly buffer A { float data_a[]; };
+layout(binding = 3, std430) writeonly buffer B { float data_b[]; };
+
+#include "trellis_decode.glsl"
+
+shared float red[NT * 256];
+
+void main() {
+    const uint J = gl_WorkGroupID.x;
+    const uint t0 = gl_WorkGroupID.y * NT;
+    const uint tid = gl_LocalInvocationID.x;
+    const uint lane = tid & 31u, g = tid >> 5;
+    const uint c = 2u * (lane & 3u);
+    const uint kt = p.K / 16u;
+    const uint nw = 8u * BITS;
+
+    float acc0[NT], acc1[NT];
+    [[unroll]] for (uint t = 0; t < NT; ++t) {
+        acc0[t] = 0.0;
+        acc1[t] = 0.0;
+    }
+    for (uint i = g; i < kt; i += 4u) {
+        float v[8];
+        trellis_decode8(p.q_offset + (J * kt + i) * nw, lane, v);
+        const float s = float(data_s[p.s_offset + i]);
+        [[unroll]] for (uint t = 0; t < NT; ++t) {
+            if (t0 + t < p.T) {
+                const uint xb = p.a_offset + (t0 + t) * p.K + 16u * i + c;
+                const float x0 = data_a[xb], x1 = data_a[xb + 1u], x8 = data_a[xb + 8u], x9 = data_a[xb + 9u];
+                acc0[t] += s * (v[0] * x0 + v[1] * x1 + v[2] * x8 + v[3] * x9);
+                acc1[t] += s * (v[4] * x0 + v[5] * x1 + v[6] * x8 + v[7] * x9);
+            }
+        }
+    }
+    // red[t][row][partial]: 16 partials per row (4 lanes x 4 groups)
+    const uint r0 = lane >> 2, part = g * 4u + (lane & 3u);
+    [[unroll]] for (uint t = 0; t < NT; ++t) {
+        red[t * 256u + r0 * 16u + part] = acc0[t];
+        red[t * 256u + (r0 + 8u) * 16u + part] = acc1[t];
+    }
+    barrier();
+    for (uint e = tid; e < NT * 16u; e += 128u) {
+        const uint t = e / 16u, row = e % 16u;
+        float sum = 0.0;
+        [[unroll]] for (uint k = 0; k < 16u; ++k) {
+            sum += red[t * 256u + row * 16u + k];
+        }
+        if (t0 + t < p.T) {
+            data_b[p.b_offset + (t0 + t) * p.N + 16u * J + row] = sum;
+        }
+    }
+}
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/trellis_mv2.comp b/ggml/src/ggml-vulkan/vulkan-shaders/trellis_mv2.comp
new file mode 100644
index 0000000..9f45edc
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/trellis_mv2.comp
@@ -0,0 +1,127 @@
+#version 450
+
+// Lamplight 0136: y = W^ x for short batches, the second form: as trellis_mv.comp (one workgroup per 16-row tile row,
+// NT columns, four 32-lane groups, each lane decoding 8 weights per tile), but the workgroup stages each chunk of
+// 8 tiles' code words, their s16 and the chunk's 128 inputs of every column in shared memory with coalesced loads
+// (double-buffered, one barrier a chunk), instead of every lane loading its 4 words and 4 inputs a tile from memory.
+
+#extension GL_EXT_control_flow_attributes : require
+#extension GL_EXT_shader_16bit_storage : require
+
+layout(constant_id = 0) const uint BITS = 3;
+layout(constant_id = 1) const uint NT = 1;
+
+layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
+
+layout(push_constant) uniform parameter {
+    uint K;
+    uint N;
+    uint T;
+    uint q_offset;  // words
+    uint s_offset;  // halves
+    uint a_offset;  // floats
+    uint b_offset;  // floats
+} p;
+
+layout(binding = 0, std430) readonly buffer Q { uint data_q[]; };
+layout(binding = 1, std430) readonly buffer S { float16_t data_s[]; };
+layout(binding = 2, std430) readonly buffer A { float data_a[]; };
+layout(binding = 3, std430) writeonly buffer B { float data_b[]; };
+
+shared uint sq[2][8 * 8 * 6];
+shared float sx[2][NT * 128];
+shared float ss[2][8];
+shared float red[NT * 256];
+
+float trellis_value(uint state) {
+    const uint h = state * 0x83DCD12Du;
+    return float(int((((h >> 2) & 0x3f3f3f3fu) * 0x01010101u) >> 24) - 126);
+}
+
+uint trellis_state(uint hi, uint lo, uint o) {
+    return ((hi << o) | ((lo >> 1u) >> (31u - o))) >> 16u;
+}
+
+void main() {
+    const uint J = gl_WorkGroupID.x;
+    const uint t0 = gl_WorkGroupID.y * NT;
+    const uint tid = gl_LocalInvocationID.x;
+    const uint lane = tid & 31u, g = tid >> 5;
+    const uint c2 = 2u * (lane & 3u);
+    const uint kt = p.K / 16u;
+    const uint NW = 8u * BITS, TOTAL = 256u * BITS;
+    const uint nch = (kt + 7u) / 8u;
+    const uint start = ((8u * lane + 1u) * BITS + TOTAL - 16u) % TOTAL;
+    const uint w0 = start >> 5, o = start & 31u;
+
+    float acc0[NT], acc1[NT];
+    [[unroll]] for (uint t = 0; t < NT; ++t) {
+        acc0[t] = 0.0;
+        acc1[t] = 0.0;
+    }
+
+    // stage chunk c (tiles 8 c .. 8 c + 7 of this tile row) into buffer b
+    #define STAGE(c, b) {                                                                                          \
+        const uint tiles = min(8u, kt - 8u * (c));                                                                 \
+        const uint qbase = p.q_offset + (J * kt + 8u * (c)) * NW;                                                  \
+        for (uint i = tid; i < tiles * NW; i += 128u) {                                                            \
+            sq[b][i] = data_q[qbase + i];                                                                          \
+        }                                                                                                          \
+        for (uint i = tid; i < NT * 128u; i += 128u) {                                                             \
+            const uint t = i / 128u, k = 128u * (c) + i % 128u;                                                    \
+            sx[b][i] = (t0 + t < p.T && k < p.K) ? data_a[p.a_offset + (t0 + t) * p.K + k] : 0.0;                  \
+        }                                                                                                          \
+        if (tid < tiles) {                                                                                         \
+            ss[b][tid] = float(data_s[p.s_offset + 8u * (c) + tid]);                                               \
+        }                                                                                                          \
+    }
+
+    STAGE(0u, 0u)
+    barrier();
+    for (uint c = 0; c < nch; ++c) {
+        const uint b = c & 1u;
+        if (c + 1u < nch) {
+            STAGE(c + 1u, b ^ 1u)
+        }
+        [[unroll]] for (uint h = 0; h < 2u; ++h) {
+            const uint tt = 2u * g + h;
+            if (8u * c + tt < kt) {
+                const uint tw = tt * NW;
+                uint q[4];
+                [[unroll]] for (uint i = 0; i < 4u; ++i) {
+                    q[i] = sq[b][tw + (w0 + i) % NW];
+                }
+                float v[8];
+                [[unroll]] for (uint j = 0; j < 8u; ++j) {
+                    const uint oj = o + j * BITS;
+                    const uint wi = oj >> 5;
+                    v[j] = trellis_value(trellis_state(q[wi], q[wi + 1u], oj & 31u));
+                }
+                const float s = ss[b][tt];
+                [[unroll]] for (uint t = 0; t < NT; ++t) {
+                    const uint xb = t * 128u + tt * 16u + c2;
+                    const float x0 = sx[b][xb], x1 = sx[b][xb + 1u], x8 = sx[b][xb + 8u], x9 = sx[b][xb + 9u];
+                    acc0[t] += s * (v[0] * x0 + v[1] * x1 + v[2] * x8 + v[3] * x9);
+                    acc1[t] += s * (v[4] * x0 + v[5] * x1 + v[6] * x8 + v[7] * x9);
+                }
+            }
+        }
+        barrier();
+    }
+    const uint r0 = lane >> 2, part = g * 4u + (lane & 3u);
+    [[unroll]] for (uint t = 0; t < NT; ++t) {
+        red[t * 256u + r0 * 16u + part] = acc0[t];
+        red[t * 256u + (r0 + 8u) * 16u + part] = acc1[t];
+    }
+    barrier();
+    for (uint e = tid; e < NT * 16u; e += 128u) {
+        const uint t = e / 16u, row = e % 16u;
+        float sum = 0.0;
+        [[unroll]] for (uint k = 0; k < 16u; ++k) {
+            sum += red[t * 256u + row * 16u + k];
+        }
+        if (t0 + t < p.T) {
+            data_b[p.b_offset + (t0 + t) * p.N + 16u * J + row] = sum;
+        }
+    }
+}
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/trellis_mv_id.comp b/ggml/src/ggml-vulkan/vulkan-shaders/trellis_mv_id.comp
new file mode 100644
index 0000000..3220c35
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/trellis_mv_id.comp
@@ -0,0 +1,70 @@
+#version 450
+
+// Lamplight 0136: coded experts (ggml_trellis_mul_mat_id): y = W_e^ x for one row per workgroup, W_e the slice of the
+// expert that row picked (ids). As trellis_mv.comp with one column: one workgroup per (16-row tile row, row), four
+// 32-lane groups split K, each lane decodes 8 weights per tile.
+
+#extension GL_EXT_control_flow_attributes : require
+#extension GL_EXT_shader_16bit_storage : require
+
+layout(constant_id = 0) const uint BITS = 3;
+
+layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
+
+layout(push_constant) uniform parameter {
+    uint K;
+    uint N;
+    uint T;         // rows in this chunk
+    uint q_offset;  // words
+    uint s_offset;  // halves
+    uint first;     // the chunk's first row (r = token n_used + slot)
+    uint e_used;    // slots per token
+    uint e_nb1;     // ids: ints per token
+    uint i_offset;  // ids: ints
+} p;
+
+layout(binding = 0, std430) readonly buffer Q { uint data_q[]; };
+layout(binding = 1, std430) readonly buffer S { float16_t data_s[]; };
+layout(binding = 2, std430) readonly buffer A { float data_a[]; };
+layout(binding = 3, std430) writeonly buffer B { float data_b[]; };
+layout(binding = 4, std430) readonly buffer I { int data_i[]; };
+
+#include "trellis_decode.glsl"
+
+shared float red[256];
+
+void main() {
+    const uint J = gl_WorkGroupID.x;
+    const uint t = gl_WorkGroupID.y;
+    const uint tid = gl_LocalInvocationID.x;
+    const uint lane = tid & 31u, g = tid >> 5;
+    const uint c = 2u * (lane & 3u);
+    const uint kt = p.K / 16u;
+    const uint nw = 8u * BITS;
+    const uint r = p.first + t;
+    const uint e = uint(data_i[p.i_offset + (r / p.e_used) * p.e_nb1 + r % p.e_used]);
+    const uint q0 = p.q_offset + e * (p.N / 16u) * kt * nw;
+    const uint s0 = p.s_offset + e * kt;
+
+    float acc0 = 0.0, acc1 = 0.0;
+    for (uint i = g; i < kt; i += 4u) {
+        float v[8];
+        trellis_decode8(q0 + (J * kt + i) * nw, lane, v);
+        const float s = float(data_s[s0 + i]);
+        const uint xb = t * p.K + 16u * i + c;
+        const float x0 = data_a[xb], x1 = data_a[xb + 1u], x8 = data_a[xb + 8u], x9 = data_a[xb + 9u];
+        acc0 += s * (v[0] * x0 + v[1] * x1 + v[2] * x8 + v[3] * x9);
+        acc1 += s * (v[4] * x0 + v[5] * x1 + v[6] * x8 + v[7] * x9);
+    }
+    const uint r0 = lane >> 2, part = g * 4u + (lane & 3u);
+    red[r0 * 16u + part] = acc0;
+    red[(r0 + 8u) * 16u + part] = acc1;
+    barrier();
+    if (tid < 16u) {
+        float sum = 0.0;
+        [[unroll]] for (uint k = 0; k < 16u; ++k) {
+            sum += red[tid * 16u + k];
+        }
+        data_b[t * p.N + 16u * J + tid] = sum;
+    }
+}
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/trellis_mvq.comp b/ggml/src/ggml-vulkan/vulkan-shaders/trellis_mvq.comp
new file mode 100644
index 0000000..e49b9ac
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/trellis_mvq.comp
@@ -0,0 +1,132 @@
+#version 450
+
+// Lamplight 0136: y = W^ x for short batches on integer dot products: the decoded values v (-126..126) as packed
+// int8, the input as int8 with one scale per 16-input tile (trellis_q8.comp, s16 folded in), so each lane's four
+// products of a row are one dotPacked4x8EXT. One workgroup per (16-row tile row, run of up to NT rows); four 32-lane
+// groups split K; each lane decodes 8 weights per tile once for all the run's rows.
+// EXPERTS: rows are picks sorted by expert (trellis_sort.comp); a run's rows share an expert, whose slice is decoded.
+
+#extension GL_EXT_control_flow_attributes : require
+#ifdef TRELLIS_IDOT
+#extension GL_EXT_integer_dot_product : require
+#define dot4(a, b) dotPacked4x8EXT(a, b)
+#else
+// devices without integer dot products: the same sum, byte by byte
+int dot4(int a, int b) {
+    int s = 0;
+    [[unroll]] for (int i = 0; i < 32; i += 8) {
+        s += bitfieldExtract(a, i, 8) * bitfieldExtract(b, i, 8);
+    }
+    return s;
+}
+#endif
+
+layout(constant_id = 0) const uint BITS = 3;
+layout(constant_id = 1) const uint NT = 1;
+layout(constant_id = 2) const uint EXPERTS = 0;
+
+layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
+
+layout(push_constant) uniform parameter {
+    uint K;
+    uint N;
+    uint T;         // rows
+    uint q_offset;  // words
+} p;
+
+layout(binding = 0, std430) readonly buffer Q { uint data_q[]; };
+layout(binding = 1, std430) readonly buffer XQ { int data_xq[]; };
+layout(binding = 2, std430) readonly buffer XS { float data_xs[]; };
+layout(binding = 3, std430) writeonly buffer B { float data_b[]; };
+layout(binding = 4, std430) readonly buffer P { uint data_p[]; };
+
+// the INT8 grid as an integer
+int trellis_int(uint state) {
+    const uint h = state * 0x83DCD12Du;
+    return int((((h >> 2) & 0x3f3f3f3fu) * 0x01010101u) >> 24) - 126;
+}
+
+uint trellis_state(uint hi, uint lo, uint o) {
+    return ((hi << o) | ((lo >> 1u) >> (31u - o))) >> 16u;
+}
+
+// a lane's 8 values of the tile at word `tile`, packed: lo = output a / 4, inputs 2 (a % 4) + {0, 1, 8, 9}; hi = output + 8
+void trellis_decode_packed(uint tile, uint lane, out int lo, out int hi) {
+    const uint NW = 8u * BITS, TOTAL = 256u * BITS;
+    const uint start = ((8u * lane + 1u) * BITS + TOTAL - 16u) % TOTAL;
+    const uint w = start >> 5, o = start & 31u;
+    uint q[4];
+    [[unroll]] for (uint i = 0; i < 4u; ++i) {
+        q[i] = data_q[tile + (w + i) % NW];
+    }
+    uint pk[2] = { 0u, 0u };
+    [[unroll]] for (uint j = 0; j < 8u; ++j) {
+        const uint oj = o + j * BITS;
+        const uint wi = oj >> 5;
+        const int v = trellis_int(trellis_state(q[wi], q[wi + 1u], oj & 31u));
+        pk[j / 4u] |= (uint(v) & 255u) << (8u * (j % 4u));
+    }
+    lo = int(pk[0]);
+    hi = int(pk[1]);
+}
+
+shared float red[NT * 256];
+
+void main() {
+    const uint J = gl_WorkGroupID.x;
+    const uint tid = gl_LocalInvocationID.x;
+    const uint lane = tid & 31u, g = tid >> 5;
+    const uint kt = p.K / 16u;
+    const uint nw = 8u * BITS;
+
+    uint e = 0u, start = gl_WorkGroupID.y * NT, n = min(NT, p.T - min(p.T, start));
+    if (EXPERTS != 0u) {
+        const uint run = gl_WorkGroupID.y;
+        e = data_p[p.T + 3u * run];
+        if (e == 0xFFFFFFFFu) {
+            return;
+        }
+        start = data_p[p.T + 3u * run + 1u];
+        n = data_p[p.T + 3u * run + 2u];
+    }
+    uint rows[NT];
+    [[unroll]] for (uint t = 0; t < NT; ++t) {
+        rows[t] = EXPERTS != 0u ? data_p[start + min(t, n - 1u)] : start + min(t, n - 1u);
+    }
+    const uint q0 = p.q_offset + e * (p.N / 16u) * kt * nw;
+
+    float acc0[NT], acc1[NT];
+    [[unroll]] for (uint t = 0; t < NT; ++t) {
+        acc0[t] = 0.0;
+        acc1[t] = 0.0;
+    }
+    for (uint i = g; i < kt; i += 4u) {
+        int lo, hi;
+        trellis_decode_packed(q0 + (J * kt + i) * nw, lane, lo, hi);
+        [[unroll]] for (uint t = 0; t < NT; ++t) {
+            if (t < n) {
+                const uint xi = rows[t] * kt + i;
+                const int xw = data_xq[xi * 4u + (lane & 3u)];
+                const float s = data_xs[xi];
+                acc0[t] += float(dot4(lo, xw)) * s;
+                acc1[t] += float(dot4(hi, xw)) * s;
+            }
+        }
+    }
+    const uint r0 = lane >> 2, part = g * 4u + (lane & 3u);
+    [[unroll]] for (uint t = 0; t < NT; ++t) {
+        red[t * 256u + r0 * 16u + part] = acc0[t];
+        red[t * 256u + (r0 + 8u) * 16u + part] = acc1[t];
+    }
+    barrier();
+    for (uint c = tid; c < NT * 16u; c += 128u) {
+        const uint t = c / 16u, row = c % 16u;
+        float sum = 0.0;
+        [[unroll]] for (uint k = 0; k < 16u; ++k) {
+            sum += red[t * 256u + row * 16u + k];
+        }
+        if (t < n) {
+            data_b[rows[t] * p.N + 16u * J + row] = sum;
+        }
+    }
+}
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/trellis_q8.comp b/ggml/src/ggml-vulkan/vulkan-shaders/trellis_q8.comp
new file mode 100644
index 0000000..f5d3b65
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/trellis_q8.comp
@@ -0,0 +1,58 @@
+#version 450
+
+// Lamplight 0136: the int8 input of trellis_mvq: per row t and 16-input tile i, u = v[t][16 i + c] * s16[i] (the row's
+// expert's s16 for coded experts), one scale per tile xs = max |u| / 127 and q = round(u / xs) in -127..127, stored
+// as four words in the decode lanes' order: word c4 (lane % 4) holds inputs 2 c4, 2 c4 + 1, 2 c4 + 8, 2 c4 + 9.
+
+#extension GL_EXT_control_flow_attributes : require
+#extension GL_EXT_shader_16bit_storage : require
+
+layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
+
+layout(push_constant) uniform parameter {
+    uint K;
+    uint s_offset;  // halves
+    uint experts;   // 1: rows are picks r = first + t, s16 per expert (kt halves apart)
+    uint first;
+    uint e_used;
+    uint e_nb1;
+    uint i_offset;  // ids: ints
+} p;
+
+layout(binding = 0, std430) readonly buffer S { float16_t data_s[]; };
+layout(binding = 1, std430) readonly buffer V { float data_v[]; };
+layout(binding = 2, std430) writeonly buffer XQ { uint data_xq[]; };
+layout(binding = 3, std430) writeonly buffer XS { float data_xs[]; };
+layout(binding = 4, std430) readonly buffer I { int data_i[]; };
+
+void main() {
+    const uint kt = p.K / 16u;
+    const uint i = gl_GlobalInvocationID.x;
+    const uint t = gl_GlobalInvocationID.y;
+    if (i >= kt) {
+        return;
+    }
+    uint s0 = p.s_offset;
+    if (p.experts != 0u) {
+        const uint r = p.first + t;
+        s0 += uint(data_i[p.i_offset + (r / p.e_used) * p.e_nb1 + r % p.e_used]) * kt;
+    }
+    const float s = float(data_s[s0 + i]);
+    float u[16];
+    float mx = 0.0;
+    [[unroll]] for (uint k = 0; k < 16u; ++k) {
+        u[k] = data_v[t * p.K + 16u * i + k] * s;
+        mx = max(mx, abs(u[k]));
+    }
+    const float inv = mx > 0.0 ? 127.0 / mx : 0.0;
+    [[unroll]] for (uint c4 = 0; c4 < 4u; ++c4) {
+        const uint c = 2u * c4;
+        const int b0 = clamp(int(round(u[c] * inv)), -127, 127);
+        const int b1 = clamp(int(round(u[c + 1u] * inv)), -127, 127);
+        const int b2 = clamp(int(round(u[c + 8u] * inv)), -127, 127);
+        const int b3 = clamp(int(round(u[c + 9u] * inv)), -127, 127);
+        data_xq[(t * kt + i) * 4u + c4] = (uint(b0) & 255u) | ((uint(b1) & 255u) << 8) | ((uint(b2) & 255u) << 16) |
+                                          ((uint(b3) & 255u) << 24);
+    }
+    data_xs[t * kt + i] = mx / 127.0;
+}
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/trellis_runs.comp b/ggml/src/ggml-vulkan/vulkan-shaders/trellis_runs.comp
new file mode 100644
index 0000000..9f1b385
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/trellis_runs.comp
@@ -0,0 +1,67 @@
+#version 450
+
+// Lamplight 0136: the normalised Sylvester butterflies of one run (L entries, a power of two) of a NariQ side in shared
+// memory, one workgroup per (run, token). It also does what sits next to it:
+//   mode bit 0: read x (gather pin, times pre) instead of the scratch row
+//   mode bit 1: times post after the butterflies
+//   mode bit 2: write the op's dst row (first + token) instead of the scratch row
+//   mode bit 3: coded experts: pre / post of the row's expert, G the ids (trellis_side.glsl)
+
+#extension GL_EXT_control_flow_attributes : require
+
+layout(constant_id = 0) const uint L = 128;
+layout(constant_id = 1) const uint WG = 64;
+
+layout(local_size_x_id = 1, local_size_y = 1, local_size_z = 1) in;
+
+#include "trellis_side.glsl"
+
+layout(binding = 0, std430) readonly buffer X { float data_x[]; };
+layout(binding = 1, std430) readonly buffer V { float data_v[]; };
+layout(binding = 2, std430) readonly buffer G { int data_g[]; };
+layout(binding = 3, std430) readonly buffer SRC { float data_src[]; };
+layout(binding = 4, std430) writeonly buffer DST { float data_dst[]; };
+
+shared float sh[L];
+
+void main() {
+    const uint tid = gl_LocalInvocationID.x;
+    const uint slice = gl_WorkGroupID.x / p.m;
+    const uint base = (gl_WorkGroupID.x % p.m) * L;
+    const uint t = gl_WorkGroupID.y;
+    const bool from_x = (p.mode & 1u) != 0u;
+    const uint xrow = from_x ? trellis_x_row(p.first + t) : 0u;
+    const uint v0 = TRELLIS_V(p.first + t), g0 = TRELLIS_G(p.first + t);
+
+    for (uint e = tid; e < L; e += WG) {
+        const uint idx = trellis_stored(base + e, slice);
+        if (from_x) {
+            const uint j = g0 != 0xFFFFFFFFu ? uint(data_g[g0 + idx]) : idx;
+            sh[e] = data_x[xrow + j] * data_v[v0 + idx];
+        } else {
+            sh[e] = data_src[t * p.n + idx];
+        }
+    }
+    barrier();
+    [[unroll]] for (uint h = 1u; h < L; h *= 2u) {
+        for (uint j = tid; j < L / 2u; j += WG) {
+            const uint i = (j / h) * (2u * h) + j % h;
+            const float a = sh[i], b = sh[i + h];
+            sh[i] = a + b;
+            sh[i + h] = a - b;
+        }
+        barrier();
+    }
+    for (uint e = tid; e < L; e += WG) {
+        const uint idx = trellis_stored(base + e, slice);
+        float v = sh[e] * p.scale;
+        if ((p.mode & 2u) != 0u) {
+            v *= data_v[v0 + idx];
+        }
+        if ((p.mode & 4u) != 0u) {
+            data_dst[p.d_offset + (p.first + t) * p.n + idx] = v;
+        } else {
+            data_dst[t * p.n + idx] = v;
+        }
+    }
+}
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/trellis_scale.comp b/ggml/src/ggml-vulkan/vulkan-shaders/trellis_scale.comp
new file mode 100644
index 0000000..1a5312f
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/trellis_scale.comp
@@ -0,0 +1,25 @@
+#version 450
+
+// Lamplight 0136: v[t][k] *= s16[k / 16] in place, so the f16 weights of the long-batch product stay exact integers
+// (the per-16-input scale of a NariQ weight moves onto the input). One invocation per (entry, token).
+
+#extension GL_EXT_shader_16bit_storage : require
+
+layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+
+layout(push_constant) uniform parameter {
+    uint K;
+    uint s_offset;
+} p;
+
+layout(binding = 0, std430) readonly buffer S { float16_t data_s[]; };
+layout(binding = 1, std430) buffer V { float data_v[]; };
+
+void main() {
+    const uint k = gl_GlobalInvocationID.x;
+    const uint t = gl_GlobalInvocationID.y;
+    if (k >= p.K) {
+        return;
+    }
+    data_v[t * p.K + k] *= float(data_s[p.s_offset + k / 16u]);
+}
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/trellis_scale_f16.comp b/ggml/src/ggml-vulkan/vulkan-shaders/trellis_scale_f16.comp
new file mode 100644
index 0000000..7382737
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/trellis_scale_f16.comp
@@ -0,0 +1,26 @@
+#version 450
+
+// Lamplight 0136: h[t][k] = f16(v[t][k] * s16[k / 16]), the input of the long-batch product for devices whose matrix
+// multiply takes f16 x f16 only (coopmat devices: NVIDIA, newer AMD and Intel); the weights stay exact integers.
+
+#extension GL_EXT_shader_16bit_storage : require
+
+layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+
+layout(push_constant) uniform parameter {
+    uint K;
+    uint s_offset;
+} p;
+
+layout(binding = 0, std430) readonly buffer S { float16_t data_s[]; };
+layout(binding = 1, std430) readonly buffer V { float data_v[]; };
+layout(binding = 2, std430) writeonly buffer H { float16_t data_h[]; };
+
+void main() {
+    const uint k = gl_GlobalInvocationID.x;
+    const uint t = gl_GlobalInvocationID.y;
+    if (k >= p.K) {
+        return;
+    }
+    data_h[t * p.K + k] = float16_t(data_v[t * p.K + k] * float(data_s[p.s_offset + k / 16u]));
+}
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/trellis_side.glsl b/ggml/src/ggml-vulkan/vulkan-shaders/trellis_side.glsl
new file mode 100644
index 0000000..3855ee9
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/trellis_side.glsl
@@ -0,0 +1,56 @@
+// Lamplight 0136: shared push constants and index maps of the NariQ trellis side transforms (nariq/FORMAT.md).
+// A side of n entries is cut in `shards` slices of `len`; a slice is `m` runs of `run`. The output side's slices may
+// fuse up to 8 parts: slice r is shard r of every part, side by side (libtrellis's Parts).
+
+layout(push_constant) uniform parameter {
+    uint n;        // side length: the row stride of a token in the scratch
+    uint len;      // slice length
+    uint run;      // run length
+    uint m;        // runs per slice (1, 12, 20 or 68)
+    uint shards;
+    uint nparts;   // 0: one part
+    uint parts[8]; // part sizes
+    uint mode;     // see each shader
+    uint first;    // first token of this chunk (x and dst rows)
+    uint x_offset; // x: floats, strides in floats, ne1 / ne2 for the row of token c
+    uint x_nb1;
+    uint x_nb2;
+    uint x_nb3;
+    uint x_ne1;
+    uint x_ne2;
+    uint v_offset; // pre or post
+    uint g_offset; // pin or pout
+    uint d_offset; // the op's dst
+    float scale;
+    uint res0;     // quadratic residues mod m - 1, bits 0..95 (cross)
+    uint res1;
+    uint res2;
+    uint e_used;   // Lamplight 0136, coded experts (mode bit 3): slots per token; G holds the ids at g_offset,
+    uint e_nb1;    // e_nb1 ints per token, and row c's pre / post is expert ids[c]'s, n floats each (no gathers)
+} p;
+
+// the first index of row c's expert's pre / post in V (mode bit 3), else v_offset
+#define TRELLIS_V(c) (p.v_offset + ((p.mode & 8u) != 0u ? uint(data_g[p.g_offset + ((c) / p.e_used) * p.e_nb1 + (c) % p.e_used]) * p.n : 0u))
+#define TRELLIS_G(c) ((p.mode & 8u) != 0u ? 0xFFFFFFFFu : p.g_offset)
+
+// the stored index of slice r's local entry l
+uint trellis_stored(uint l, uint r) {
+    if (p.nparts == 0u) {
+        return r * p.len + l;
+    }
+    uint start = 0u;
+    for (uint i = 0u; i < p.nparts; ++i) {
+        const uint shard = p.parts[i] / p.shards;
+        if (l < shard || i + 1u == p.nparts) {
+            return start + r * shard + l;
+        }
+        l -= shard;
+        start += p.parts[i];
+    }
+    return start;
+}
+
+// the first index of token c's row of x
+uint trellis_x_row(uint c) {
+    return p.x_offset + (c % p.x_ne1) * p.x_nb1 + (c / p.x_ne1 % p.x_ne2) * p.x_nb2 + (c / (p.x_ne1 * p.x_ne2)) * p.x_nb3;
+}
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/trellis_sort.comp b/ggml/src/ggml-vulkan/vulkan-shaders/trellis_sort.comp
new file mode 100644
index 0000000..1255453
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/trellis_sort.comp
@@ -0,0 +1,71 @@
+#version 450
+
+// Lamplight 0136: coded experts for trellis_mvq: the chunk's picks r = first + t (t < T) sorted by expert on the card,
+// then cut in runs of at most NT picks of one expert. perm[j] = t in expert order; run c = (expert, start, count), or
+// expert -1 past the last run (those workgroups return).
+
+layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+
+layout(push_constant) uniform parameter {
+    uint T;
+    uint E;
+    uint first;
+    uint e_used;
+    uint e_nb1;
+    uint i_offset;
+    uint max_runs;
+    uint nt;  // picks per run at most
+} p;
+
+#define NT p.nt
+
+layout(binding = 0, std430) readonly buffer I { int data_i[]; };
+layout(binding = 1, std430) writeonly buffer P { uint data_p[]; };   // [T] perm, then [max_runs][3] runs
+
+#define MAX_E 2048
+shared uint cnt[MAX_E];
+shared uint fill[MAX_E];
+
+int pick(uint t) {
+    const uint r = p.first + t;
+    return data_i[p.i_offset + (r / p.e_used) * p.e_nb1 + r % p.e_used];
+}
+
+void main() {
+    const uint tid = gl_LocalInvocationID.x;
+    for (uint e = tid; e < p.E; e += 256u) {
+        cnt[e] = 0u;
+    }
+    barrier();
+    for (uint t = tid; t < p.T; t += 256u) {
+        const int e = pick(t);
+        if (e >= 0 && uint(e) < p.E) {
+            atomicAdd(cnt[uint(e)], 1u);
+        }
+    }
+    barrier();
+    if (tid == 0u) {
+        uint off = 0u, run = 0u;
+        for (uint e = 0u; e < p.E; ++e) {
+            const uint c = cnt[e];
+            fill[e] = off;
+            for (uint s = 0u; s < c; s += NT) {
+                data_p[p.T + 3u * run] = e;
+                data_p[p.T + 3u * run + 1u] = off + s;
+                data_p[p.T + 3u * run + 2u] = min(NT, c - s);
+                ++run;
+            }
+            off += c;
+        }
+        for (; run < p.max_runs; ++run) {
+            data_p[p.T + 3u * run] = 0xFFFFFFFFu;
+        }
+    }
+    barrier();
+    for (uint t = tid; t < p.T; t += 256u) {
+        const int e = pick(t);
+        if (e >= 0 && uint(e) < p.E) {
+            data_p[atomicAdd(fill[uint(e)], 1u)] = t;
+        }
+    }
+}
