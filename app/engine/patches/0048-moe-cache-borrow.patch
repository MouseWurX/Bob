+// Brain Engine 0048: how many bytes of buffer buffer_id the graph planned last uses (0 if none), from offset 0 up
+size_t ggml_gallocr_get_plan_size(ggml_gallocr_t galloc, int buffer_id) {
+    GGML_ASSERT(buffer_id >= 0 && buffer_id < galloc->n_buffers);
+    struct ggml_dyn_tallocr * talloc = galloc->buf_tallocs[buffer_id];
+    if (talloc == NULL || talloc->n_chunks == 0) {
+        return 0;
+    }
+    // a buffer of more than one chunk has no single range from offset 0, report all of it
+    size_t res = 0;
+    for (int c = 0; c < talloc->n_chunks; c++) {
+        res += ggml_dyn_tallocr_max_size(talloc, c);
+    }
+    return res;
+}
