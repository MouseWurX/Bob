+                                    __func__, a/1048576.0, b/1048576.0, u, need/1048576.0, best);
+                            needs.emplace_back(u, need);
+                            best = u;
+                            break;
+                        }
+                    }
+                }
+            }
             // the card's own scratch (outside the scheduler) grows with the step too: keep room free for it
             {
