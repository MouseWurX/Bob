+
+bool llama_context::ids_keep_ensure() {
+    const auto & hparams = model.hparams;
+    const uint32_t n_layer = hparams.n_layer();
+    auto & st = ids_keep;
+
+    // what each layer needs now: k picks (the live experts-per-word count, or the brain's own) for n_ubatch tokens
+    std::vector<int32_t> need(n_layer, 0);
+    bool remake = st.t.size() != n_layer || st.n_ubatch < cparams.n_ubatch || st.n_batch < cparams.n_batch;
+    for (uint32_t il = 0; il < n_layer; il++) {
+        if (model.layers[il].ffn_gate_inp == nullptr || hparams.n_expert_used(il) == 0) {
+            continue;
+        }
+        uint32_t k = hparams.n_expert_used(il);
+        if (cparams.expert_used && il < cparams.expert_used_n && cparams.expert_used[il] > 0) {
+            k = cparams.expert_used[il];
+        }
+        need[il] = (int32_t) k;
+        remake = remake || il >= st.k_alloc.size() || st.k_alloc[il] < (int32_t) k;
+    }
+    if (!remake) {
+        return true;
+    }
+
+    synchronize();
+    cparams.expert_ids_keep   = nullptr;
+    cparams.expert_ids_keep_n = 0;
+    cparams.expert_ids_keep_gen++;
+    sched_need_reserve = true;
+    st = {};
+    st.t.assign(n_layer, nullptr);
+    st.dev_of.assign(n_layer, -1);
+    st.slot.assign(n_layer, -1);
+    st.k_alloc.assign(n_layer, 0);
+    st.host.assign(n_layer, {});
+    st.k.assign(n_layer, 0);
+    st.bad.assign(n_layer, 0);
+    st.n_ubatch = cparams.n_ubatch;
+    st.n_batch  = cparams.n_batch;
+
+    // the layers of each device: the one that holds the layer's router, so the copy stays next to the picks
+    std::vector<ggml_backend_dev_t> dev_list;
+    for (uint32_t il = 0; il < n_layer; il++) {
+        if (need[il] == 0) {
+            continue;
+        }
+        const ggml_tensor * router = model.layers[il].ffn_gate_inp;
+        ggml_backend_dev_t dev = router->buffer ? ggml_backend_buft_get_device(ggml_backend_buffer_get_type(router->buffer)) : nullptr;
+        ggml_backend_t backend = nullptr;
+        for (auto & b : backends) {
+            if (dev && ggml_backend_get_device(b.get()) == dev) {
+                backend = b.get();
+                break;
+            }
+        }
+        if (!backend) {
+            backend = backend_cpu;
+            dev     = ggml_backend_get_device(backend_cpu);
+        }
+        int32_t d = -1;
+        for (size_t j = 0; j < dev_list.size(); j++) {
+            if (dev_list[j] == dev) {
+                d = (int32_t) j;
+            }
+        }
+        if (d < 0) {
+            d = (int32_t) dev_list.size();
+            dev_list.push_back(dev);
+            st.devs.emplace_back();
+            st.devs.back().backend = backend;
+        }
+        auto & D = st.devs[d];
+        st.dev_of[il] = d;
+        st.slot[il]   = D.n_slots++;
+        D.k_max       = std::max(D.k_max, need[il]);
+        st.k_alloc[il] = need[il];
+    }
+    for (size_t d = 0; d < st.devs.size(); d++) {
+        auto & D = st.devs[d];
+        ggml_init_params ip = { /*.mem_size =*/ ggml_tensor_overhead()*(n_layer + 1), /*.mem_buffer =*/ nullptr, /*.no_alloc =*/ true };
+        ggml_context * c = ggml_init(ip);
+        if (!c) {
+            LLAMA_LOG_ERROR("%s: could not make the kept expert picks\n", __func__);
+            st = {};
+            return false;
+        }
+        st.ctxs.emplace_back(c);
+        D.big = ggml_new_tensor_3d(c, GGML_TYPE_I32, D.k_max, D.n_slots, cparams.n_ubatch);
+        ggml_format_name(D.big, "expert_ids_kept_dev%zu", d);
+        for (uint32_t il = 0; il < n_layer; il++) {
+            if (st.dev_of[il] == (int32_t) d) {
+                st.t[il] = ggml_view_2d(c, D.big, need[il], cparams.n_ubatch, D.big->nb[2], st.slot[il]*D.big->nb[1]);
+                ggml_format_name(st.t[il], "expert_ids_kept-%u", il);
+            }
+        }
+        ggml_backend_buffer_type_t buft = ggml_backend_dev_buffer_type(dev_list[d]);
+        ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors_from_buft(c, buft);
+        if (!buf) {
+            LLAMA_LOG_ERROR("%s: no room for the kept expert picks on %s\n", __func__, ggml_backend_buft_name(buft));
+            st = {};
+            return false;
+        }
+        ggml_backend_buffer_clear(buf, 0);
+        st.bufs.emplace_back(buf);
+
+        // the stage holds every token of the biggest batch, pinned so the copy really is async
+        D.stage_n = (size_t) cparams.n_batch*D.k_max*D.n_slots;
+        ggml_backend_buffer_type_t host_buft = ggml_backend_dev_host_buffer_type(dev_list[d]);
+        if (host_buft) {
+            D.stage_buf.reset(ggml_backend_buft_alloc_buffer(host_buft, D.stage_n*sizeof(int32_t)));
+        }
+        if (D.stage_buf) {
+            D.stage = (int32_t *) ggml_backend_buffer_get_base(D.stage_buf.get());
+        } else {
+            D.stage_vec.resize(D.stage_n);
+            D.stage = D.stage_vec.data();
+        }
+    }
+    cparams.expert_ids_keep   = st.t.data();
+    cparams.expert_ids_keep_n = n_layer;
+    cparams.expert_ids_keep_gen++;
+    if (moe_cache) {
+        moe_cache->set_ids_sink(ids_keep_sink, this);
+    }
+    return true;
+}
+
+void llama_context::ids_keep_room(uint32_t n_tokens) {
+    auto & st = ids_keep;
+    for (const auto & D : st.devs) {
+        if (D.stage_at + (size_t) n_tokens*D.k_max*D.n_slots > D.stage_n) {
+            ids_keep_drain(); // nobody read the earlier batches yet: sort them out first (waits)
+            return;
+        }
+    }
+}
+
+void llama_context::ids_keep_sink(void * user_data, int32_t il, const int32_t * ids, size_t n, int32_t n_used) {
+    // called by the MoE cache while the graph computes, with the ids it has just read (and waited for) on the host
+    auto * lctx = (llama_context *) user_data;
+    auto & st = lctx->ids_keep;
+    if (!lctx->cparams.keep_expert_ids || il < 0 || (size_t) il >= st.t.size() || !st.t[il] || n_used <= 0) {
+        return;
+    }
+    ids_keep_state::pending p;
+    p.at = st.side.size();
+    p.il = il;
+    p.k  = n_used;
+    p.n  = (int32_t) (n / n_used);
+    st.side.insert(st.side.end(), ids, ids + n);
+    st.queued.push_back(std::move(p));
+}
+
+void llama_context::ids_keep_read(const llm_graph_result * res) {
+    auto & st = ids_keep;
+    // one block per device: the first n tokens of all its layers, n the most any of its layers computed
+    for (size_t d = 0; d < st.devs.size(); d++) {
+        auto & D = st.devs[d];
+        ids_keep_state::pending p;
+        p.dev = (int32_t) d;
+        int32_t n = 0;
+        for (const auto & e : res->ids_kept) {
+            const int32_t il = e[0];
+            if (il >= 0 && (size_t) il < st.t.size() && st.dev_of[il] == (int32_t) d) {
+                p.layers.push_back(e);
+                n = std::max(n, e[2]);
+            }
+        }
+        if (n == 0) {
+            continue;
+        }
+        const size_t ints = (size_t) n*D.k_max*D.n_slots;
+        if (D.stage_at + ints > D.stage_n) {
+            for (const auto & e : p.layers) {
+                st.bad[e[0]] = 1; // no room (ids_keep_room makes it before every decode, so this shouldn't happen)
+            }
+            continue;
+        }
+        p.at = D.stage_at;
+        D.stage_at += ints;
+        // queued on the stream that computed this micro-batch, so it lands before the next one writes the tensor again
+        ggml_backend_tensor_get_async(D.backend, D.big, D.stage + p.at, 0, ints*sizeof(int32_t));
+        st.queued.push_back(std::move(p));
+    }
+}
+
+void llama_context::ids_keep_drain() {
+    auto & st = ids_keep;
+    if (st.queued.empty()) {
+        return;
+    }
+    synchronize();
+    auto put = [&](int32_t il, int32_t k, const int32_t * src, int32_t n, size_t stride) {
+        if (st.bad[il]) {
+            return;
+        }
+        if (st.k[il] != 0 && st.k[il] != k) {
+            st.bad[il] = 1; // a changed count within one read
+            return;
+        }
+        st.k[il] = k;
+        auto & h = st.host[il];
+        for (int32_t i = 0; i < n; i++) {
+            h.insert(h.end(), src + i*stride, src + i*stride + k);
+        }
+    };
+    for (const auto & p : st.queued) {
+        if (p.dev < 0) {
+            put(p.il, p.k, st.side.data() + p.at, p.n, p.k);
+            continue;
+        }
+        const auto & D = st.devs[p.dev];
+        const size_t tok = (size_t) D.k_max*D.n_slots;
+        for (const auto & e : p.layers) {
+            put(e[0], e[1], D.stage + p.at + (size_t) st.slot[e[0]]*D.k_max, e[2], tok);
+        }
+    }
+    st.queued.clear();
+    st.side.clear();
+    for (auto & D : st.devs) {
+        D.stage_at = 0;
+    }
+}
+
+int32_t llama_context::get_kept_expert_ids(int32_t il, const int32_t ** ids, int32_t * k) {
+    auto & st = ids_keep;
+    ids_keep_drain();
+    if (ids) {
+        *ids = nullptr;
+    }
+    if (k) {
+        *k = 0;
+    }
+    if (il < 0 || (size_t) il >= st.t.size() || !st.t[il]) {
+        return 0;
+    }
+    if (st.bad[il]) {
+        return -1;
+    }
+    if (st.k[il] == 0) {
+        return 0;
+    }
+    if (ids) {
+        *ids = st.host[il].data();
+    }
+    if (k) {
+        *k = st.k[il];
+    }
+    return (int32_t) (st.host[il].size()/st.k[il]);
+}
+
+void llama_context::clear_kept_expert_ids() {
+    synchronize();
+    auto & st = ids_keep;
+    st.queued.clear();
+    st.side.clear();
+    for (auto & D : st.devs) {
+        D.stage_at = 0;
+    }
+    for (size_t il = 0; il < st.host.size(); il++) {
+        st.host[il].clear();
+        st.k[il]   = 0;
+        st.bad[il] = 0;
+    }
 }
 
