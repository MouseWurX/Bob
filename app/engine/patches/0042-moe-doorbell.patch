diff --git a/ggml/src/ggml-cuda/moe-doorbell.cu b/ggml/src/ggml-cuda/moe-doorbell.cu
new file mode 100644
index 0000000..61a547a
--- /dev/null
+++ b/ggml/src/ggml-cuda/moe-doorbell.cu
@@ -0,0 +1,193 @@
+#include "moe-doorbell.cuh"
+
+// Brain Engine 0042: the MoE doorbell on the card.
+// The ring and the wait are kernels, not events: a CUDA graph keeps kernels, and Strata found that an event recorded
+// while a graph is captured is dropped. The doorbell memory is mapped pinned host memory: the card writes and reads it
+// over the bus while its kernels run, and the processor's thread reads and writes it like any other memory.
+// Ordering: the writer stores its data, then a system-wide fence, then the counter; the reader waits for the counter,
+// then a fence, then reads the data. Reads of memory the processor wrote go around the card's caches (volatile / __ldcv).
+
+#if !defined(GGML_USE_HIP) && !defined(GGML_USE_MUSA)
+#define GGML_CUDA_MOE_DOORBELL 1
+#endif
+
+#ifdef GGML_CUDA_MOE_DOORBELL
+
+static __device__ __forceinline__ uint64_t moe_doorbell_now_ns() {
+    uint64_t t;
+    asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(t));
+    return t;
+}
+
+// one block: work out the slots, copy the picks and the expert input into the doorbell, then ring (seq + 1)
+static __global__ void moe_doorbell_ring_kernel(
+        const float * __restrict__ cur, const int32_t * __restrict__ ids, const int32_t * __restrict__ map,
+        int32_t * __restrict__ slots, uint8_t * bell,
+        const int n_embd, const int n_used, const int n_tok, const int n_slots, const int layer) {
+    volatile ggml_moe_doorbell * vb = (volatile ggml_moe_doorbell *) bell;
+    int32_t * b_ids = (int32_t *) (bell + GGML_MOE_DOORBELL_OFF_IDS);
+    float   * b_cur = (float   *) (bell + GGML_MOE_DOORBELL_OFF_CUR);
+
+    const int n_ids = n_used*n_tok;
+    for (int i = threadIdx.x; i < n_ids; i += blockDim.x) {
+        const int32_t e = ids[i];
+        const int32_t s = map[e];
+        // a miss reads zero slot k of the banks: distinct for the picks of one token, as the old path had them
+        slots[i] = s < n_slots ? s : n_slots + i % n_used;
+        b_ids[i] = e;
+    }
+    const int n_cur = n_embd*n_tok;
+    for (int i = threadIdx.x; i < n_cur; i += blockDim.x) {
+        b_cur[i] = cur[i];
+    }
+    __threadfence_system(); // this thread's writes reach the host before anything it writes later
+    __syncthreads();
+
+    if (threadIdx.x == 0) {
+        vb->layer    = layer;
+        vb->n_tokens = n_tok;
+        vb->n_used   = n_used;
+        vb->n_embd   = n_embd;
+        __threadfence_system();
+        vb->seq = vb->seq + 1; // the doorbell: the processor's thread is spinning on this
+        __threadfence_system();
+    }
+}
+
+// one thread: wait until the processor answered the last ring; on a timeout, flag it for the host's watchdog (which
+// stops the program with a clear message), give it a few seconds to do so, then stop the card
+static __global__ void moe_doorbell_wait_kernel(uint8_t * bell, const int layer, const int timeout_ms) {
+#if __CUDA_ARCH__ >= GGML_CUDA_CC_VOLTA
+    volatile ggml_moe_doorbell * vb = (volatile ggml_moe_doorbell *) bell;
+    const uint32_t seq = vb->seq;
+    const uint64_t t0  = moe_doorbell_now_ns();
+    const uint64_t max = (uint64_t) timeout_ms*1000000ull;
+    while (vb->done != seq) {
+        if (moe_doorbell_now_ns() - t0 > max) {
+            vb->err_layer = layer;
+            vb->err_ms    = timeout_ms;
+            __threadfence_system();
+            vb->err = 1;
+            __threadfence_system();
+            const uint64_t t1 = moe_doorbell_now_ns();
+            while (moe_doorbell_now_ns() - t1 < 5000000000ull) {
+                __nanosleep(1000000);
+            }
+            printf("MoE doorbell (LLAMA_MOE_DOORBELL): layer %d waited %d ms for the processor's part of its experts and gave up\n",
+                   layer, timeout_ms);
+            __trap();
+        }
+        __nanosleep(256);
+    }
+    __threadfence_system();
+#else
+    GGML_UNUSED(bell);
+    GGML_UNUSED(layer);
+    GGML_UNUSED(timeout_ms);
+    NO_DEVICE_CODE;
+#endif // __CUDA_ARCH__ >= GGML_CUDA_CC_VOLTA
+}
+
+// one block per pick: res = cached + the processor's part where the pick is a miss, cached + 0 elsewhere
+static __global__ void moe_doorbell_add_kernel(
+        const float * __restrict__ cached, const int32_t * __restrict__ slots, const uint8_t * bell, float * __restrict__ dst,
+        const int n_embd, const int n_used, const int n_slots, const int64_t off_out,
+        const int64_t c1, const int64_t c2, const int64_t d1, const int64_t d2) {
+    const int row = blockIdx.x; // t*n_used + k
+    const int k   = row % n_used;
+    const int t   = row / n_used;
+
+    const bool    miss = slots[row] >= n_slots;
+    const float * out  = (const float *) (bell + off_out) + (int64_t) row*n_embd;
+    const float * c    = cached + k*c1 + t*c2;
+    float       * d    = dst    + k*d1 + t*d2;
+    for (int i = threadIdx.x; i < n_embd; i += blockDim.x) {
+        d[i] = c[i] + (miss ? __ldcv(out + i) : 0.0f);
+    }
+}
+
+#endif // GGML_CUDA_MOE_DOORBELL
+
+bool ggml_cuda_moe_doorbell_supported(int device, const ggml_tensor * op) {
+#ifdef GGML_CUDA_MOE_DOORBELL
+    int64_t dev_ptr = 0;
+    memcpy(&dev_ptr, op->op_params + 6, sizeof(dev_ptr));
+    return dev_ptr != 0 && ggml_cuda_info().devices[device].cc >= GGML_CUDA_CC_VOLTA;
+#else
+    GGML_UNUSED(device);
+    GGML_UNUSED(op);
+    return false;
+#endif // GGML_CUDA_MOE_DOORBELL
+}
+
+void ggml_cuda_op_moe_doorbell(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+#ifdef GGML_CUDA_MOE_DOORBELL
+    const int32_t mode       = ggml_get_op_params_i32(dst, 0);
+    const int32_t n_slots    = ggml_get_op_params_i32(dst, 1);
+    const int32_t layer      = ggml_get_op_params_i32(dst, 2);
+    const int32_t timeout_ms = ggml_get_op_params_i32(dst, 3);
+    int64_t dev_ptr = 0;
+    memcpy(&dev_ptr, dst->op_params + 6, sizeof(dev_ptr));
+    uint8_t * bell = (uint8_t *) (intptr_t) dev_ptr;
+    GGML_ASSERT(bell != nullptr);
