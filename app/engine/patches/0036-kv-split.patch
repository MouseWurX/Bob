+    ggml_tensor * k = l.k_hot;
+    GGML_ASSERT(k != nullptr && n_kv <= split_hot);
+    return ggml_view_4d(ctx, k, hparams.n_embd_head_k(il), hparams.n_head_kv(il), n_kv, 1,
+            ggml_row_size(k->type, hparams.n_embd_head_k(il)), k->nb[1], k->nb[1]*k->ne[1], 0);
+}
