+// Brain Engine 0036: how attention reads a split KV cache for this batch
+static int kv_split_mode(const llama_kv_cache_context * mctx, uint32_t n_tokens, bool training) {
+    const uint32_t r = mctx->get_split_hot();
+    if (r == 0 || training) {
+        return 0;
+    }
+    if (mctx->get_n_kv() <= r) {
+        return 1;
+    }
+    return n_tokens == 1 && mctx->split_hot_used() ? 2 : 3;
+}
+
+// says once per cache, when a batch first runs a way of reading the split
+static void kv_split_tell(const llama_kv_cache_context * mctx, int used) {
+    if (used >= 2 && mctx->split_first(used)) {
+        if (used == 2) {
+            LLAMA_LOG_INFO("%s: KV split: writing past cell %u: the card attends to its copy and the processor to the rest, merged\n", __func__, mctx->get_split_hot());
+        } else {
+            LLAMA_LOG_INFO("%s: KV split: a batch past cell %u reads the RAM copy on the card\n", __func__, mctx->get_split_hot());
+        }
+    }
+}
