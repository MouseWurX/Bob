 }
 
+// ---- Brain Engine 0020: expert tiers, the cold tier (see ggml-cpu-impl.h) ----
+// When a brain is bigger than the RAM, the operating system keeps only part of the mapped brain file in memory and drops
+// what hasn't been used lately. A dropped expert is then read back a few pages at a time as the product touches it, and
+// a disk is slow at many small scattered reads. Asking for the whole expert at once (PrefetchVirtualMemory on Windows,
+// madvise(MADV_WILLNEED) elsewhere) lets the disk read it in large requests instead. An expert used in the last
+// `window` products of the same tensor is very likely still in memory, so it is skipped: asking costs a system call.
+#if !defined(_WIN32)
+#include <sys/mman.h>
+#include <unistd.h>
+#endif
+
+#define GGML_EXPERT_TIERS_MAX_TENSORS 4096
+
+struct ggml_expert_read_entry {
+    const void * key;    // the tensor's data
+    int          n_as;   // its experts
+    uint64_t     calls;  // products seen
+    uint64_t   * last;   // [n_as] product number of the last use + 1 (0 = never)
+};
+
+static struct ggml_expert_read_entry ggml_expert_read_table[GGML_EXPERT_TIERS_MAX_TENSORS];
+static int      ggml_expert_read_state  = -1; // -1 not read yet, 0 off, 1 on
+static uint64_t ggml_expert_read_window = 64;
+static uint64_t ggml_expert_read_every  = 0;  // LLAMA_EXPERT_READ_LOG_EVERY
+static uint64_t ggml_expert_read_n_calls = 0, ggml_expert_read_n_asked = 0, ggml_expert_read_n_skipped = 0, ggml_expert_read_bytes = 0;
+static size_t   ggml_expert_read_page = 0;
+
+#if defined(_WIN32)
+typedef BOOL (WINAPI * ggml_prefetch_vm_t)(HANDLE, ULONG_PTR, PVOID, ULONG);
+typedef struct { PVOID VirtualAddress; SIZE_T NumberOfBytes; } ggml_vm_range_t; // WIN32_MEMORY_RANGE_ENTRY
+static ggml_prefetch_vm_t ggml_prefetch_vm = NULL;
+#endif
+
+static void ggml_expert_read_init(void) {
+    const char * on = getenv("LLAMA_EXPERT_READ_WHOLE");
+    ggml_expert_read_state = (on != NULL && strcmp(on, "1") == 0) ? 1 : 0;
+    const char * w = getenv("LLAMA_EXPERT_READ_WINDOW");
+    if (w != NULL && strtoull(w, NULL, 10) > 0) {
+        ggml_expert_read_window = strtoull(w, NULL, 10);
+    }
+    const char * every = getenv("LLAMA_EXPERT_READ_LOG_EVERY");
+    if (every != NULL) {
+        ggml_expert_read_every = strtoull(every, NULL, 10);
+    }
+#if defined(_WIN32)
+    SYSTEM_INFO si;
+    GetSystemInfo(&si);
+    ggml_expert_read_page = (size_t) si.dwPageSize;
+    ggml_prefetch_vm = (ggml_prefetch_vm_t) (void *) GetProcAddress(GetModuleHandleW(L"kernel32.dll"), "PrefetchVirtualMemory");
+    if (ggml_expert_read_state == 1 && ggml_prefetch_vm == NULL) {
+        GGML_LOG_WARN("%s: !!! expert read-whole NOT USED: this Windows has no PrefetchVirtualMemory (Windows 8 or newer needed)\n", __func__);
+        ggml_expert_read_state = 0;
+    }
+#else
+    ggml_expert_read_page = (size_t) sysconf(_SC_PAGESIZE);
+#endif
+    if (ggml_expert_read_state == 1) {
+        GGML_LOG_INFO("%s: expert read-whole on: a picked expert unused for %llu products is asked for in one go\n", __func__,
+            (unsigned long long) ggml_expert_read_window);
+    }
+}
+
+static void ggml_expert_read_range(const char * p, size_t n) {
+    const uintptr_t a = (uintptr_t) p & ~(uintptr_t) (ggml_expert_read_page - 1);
+    const size_t    len = (size_t) ((uintptr_t) p + n - a);
+#if defined(_WIN32)
+    ggml_vm_range_t r = { (PVOID) a, (SIZE_T) len };
+    ggml_prefetch_vm(GetCurrentProcess(), 1, &r, 0);
+#else
+    madvise((void *) a, len, MADV_WILLNEED);
+#endif
+}
+
+void ggml_cpu_expert_read_whole(const struct ggml_tensor * src0, const int64_t * counts, int n_as) {
+    if (ggml_expert_read_state == 0) {
+        return;
+    }
+    ggml_critical_section_start();
+    if (ggml_expert_read_state < 0) {
+        ggml_expert_read_init();
+    }
+    if (ggml_expert_read_state == 0 || src0->data == NULL || n_as <= 0) {
+        ggml_critical_section_end();
+        return;
+    }
+    // find or claim this tensor's entry (open addressing on the data pointer; entries are never freed)
+    const uintptr_t key = (uintptr_t) src0->data;
+    struct ggml_expert_read_entry * en = NULL;
+    for (size_t k = 0, i = (size_t) ((key >> 6) * 0x9E3779B97F4A7C15ULL >> 52) % GGML_EXPERT_TIERS_MAX_TENSORS; k < GGML_EXPERT_TIERS_MAX_TENSORS; ++k, i = (i + 1) % GGML_EXPERT_TIERS_MAX_TENSORS) {
+        struct ggml_expert_read_entry * c = &ggml_expert_read_table[i];
+        if (c->key == src0->data && c->n_as == n_as) {
+            en = c;
+            break;
+        }
+        if (c->key == NULL) {
+            c->last = (uint64_t *) calloc((size_t) n_as, sizeof(uint64_t));
+            if (c->last == NULL) {
+                break;
+            }
+            c->key  = src0->data;
+            c->n_as = n_as;
+            en = c;
+            break;
+        }
+    }
+    if (en == NULL) {
+        ggml_critical_section_end();
+        return; // table full: products still run, just without asking ahead
+    }
+    en->calls++;
+    ggml_expert_read_n_calls++;
+    const size_t nb02 = src0->nb[2];
+    for (int e = 0; e < n_as; ++e) {
+        if (counts[e] <= 0) {
+            continue;
+        }
+        if (en->last[e] != 0 && en->calls - en->last[e] < ggml_expert_read_window) {
+            ggml_expert_read_n_skipped++;
+        } else {
+            ggml_expert_read_range((const char *) src0->data + (size_t) e*nb02, nb02);
+            ggml_expert_read_n_asked++;
+            ggml_expert_read_bytes += nb02;
+        }
+        en->last[e] = en->calls;
+    }
+    if (ggml_expert_read_every > 0 && ggml_expert_read_n_calls % ggml_expert_read_every == 0) {
+        GGML_LOG_INFO("%s: expert read-whole: %llu products, %llu experts asked for whole (%.1f MiB), %llu skipped as recently used\n", __func__,
+            (unsigned long long) ggml_expert_read_n_calls, (unsigned long long) ggml_expert_read_n_asked,
+            ggml_expert_read_bytes/1024.0/1024.0, (unsigned long long) ggml_expert_read_n_skipped);
+    }
+    ggml_critical_section_end();
+}
