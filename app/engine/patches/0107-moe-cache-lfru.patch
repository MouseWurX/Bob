+        lf_seg.assign(n_slots, 0);
+        lf_head[0] = lf_tail[0] = lf_head[1] = lf_tail[1] = -1;
+        lf_n[0] = lf_n[1] = 0;
+        for (int32_t s = 0; s < n_slots; ++s) {
+            lf_push(s, 0, true);
+        }
+    }
+    void lf_unlink(int32_t s) {
+        const int g = lf_seg[s];
+        if (lf_prev[s] >= 0) { lf_next[lf_prev[s]] = lf_next[s]; } else { lf_head[g] = lf_next[s]; }
+        if (lf_next[s] >= 0) { lf_prev[lf_next[s]] = lf_prev[s]; } else { lf_tail[g] = lf_prev[s]; }
+        lf_prev[s] = lf_next[s] = -1;
+        lf_n[g]--;
+    }
+    // to the most recent end of segment g (at_tail), or its least recent end
