+// quadratic residues mod q as bits
+static void ggml_vk_trellis_residues(uint32_t q, uint32_t res[3]) {
+    res[0] = res[1] = res[2] = 0;
+    for (uint32_t i = 1; i < q; ++i) {
+        const uint32_t r = (i * i) % q;
+        res[r >> 5] |= 1u << (r & 31);
+    }
