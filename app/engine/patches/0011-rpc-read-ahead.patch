+// Brain Engine 0011: read ahead. A lent card that holds some of a brain's layers is asked for its results after every
+// word: one GRAPH_RECOMPUTE, then one GET_TENSOR for each tensor the next card needs. Each GET_TENSOR waited for its own
+// answer, so a word cost that many round trips (three, in the PC and handheld test). The reads after a graph are the
+// same every word, so once the same list has been seen twice in a row for a graph, the dispatcher sends those reads
+// right behind the next GRAPH_RECOMPUTE of that graph, all of them before waiting for any answer, and hands each answer
+// to the GET_TENSOR that asks for it. One round trip a word instead of several. Nothing changes on the wire: the lent
+// card sees the same commands in the same order, so it works with any card server. A read that wasn't foreseen is
+// sent the old way; answers that turn out not to be wanted are dropped. GGML_RPC_AHEAD=0 turns it off.
+static const size_t RPC_AHEAD_MAX      = 8;           // reads foreseen after one graph
+static const size_t RPC_AHEAD_MAX_SIZE = 1024 * 1024; // each at most this big: results between cards, not whole caches
+
+static bool rpc_ahead_on() {
+    static const bool on = [] {
+        const char * env = std::getenv("GGML_RPC_AHEAD");
+        return !(env != nullptr && env[0] == '0');
+    }();
+    return on;
+}
+
+struct rpc_ahead_item {
+    rpc_msg_get_tensor_req   req;
+    std::vector<uint8_t>     buf;
+    std::shared_future<void> done;
+    bool                     used = false;
+};
+
+static bool rpc_ahead_same(const rpc_msg_get_tensor_req & a, const rpc_msg_get_tensor_req & b) {
+    return a.tensor.data == b.tensor.data && a.tensor.buffer == b.tensor.buffer && a.tensor.type == b.tensor.type &&
+           a.offset == b.offset && a.size == b.size;
+}
