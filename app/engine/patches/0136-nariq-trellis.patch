+                add(base + ".trellis_pre", GGML_TYPE_F32, {n_embd, n_expert});
+                add(base + ".trellis_post", GGML_TYPE_F32, {n_embd, n_expert});
+                const int32_t desc[] = {1, 128, 1, 1, 128, 1, 1, (int32_t) n_embd};  // rht128 on both sides, as Flash-Next
+                gguf_set_arr_data(meta, ("trellis.desc." + base).c_str(), GGUF_TYPE_INT32, desc, 8);
+            }
+        } else {
+            for (const char * name : {"ffn_gate", "ffn_down", "ffn_up"}) {
+                add(std::string("blk.0.") + name + ".weight", GGML_TYPE_F32, {n_embd, n_embd});
+            }
+        }
+    }
+
+    // Lamplight 0136: every tensor filled from its name (norms near 1, coded codes random, scales small), so two
+    // fixtures share all but their experts
+    void randomize() {
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != nullptr; t = ggml_get_next_tensor(ctx, t)) {
+            const std::string name = ggml_get_name(t);
+            std::mt19937 rng((uint32_t) std::hash<std::string>{}(name));
+            std::uniform_real_distribution<float> u(-1.0f, 1.0f);
+            if (ggml_is_trellis_type(t->type)) {
+                for (size_t i = 0; i < ggml_nbytes(t); ++i) { ((uint8_t *) t->data)[i] = (uint8_t) (rng() & 255); }
+            } else if (t->type == GGML_TYPE_F16) {
+                for (int64_t i = 0; i < ggml_nelements(t); ++i) { ((ggml_fp16_t *) t->data)[i] = ggml_fp32_to_fp16(0.0005f * (1 + (rng() % 4))); }
+            } else if (t->type == GGML_TYPE_F32 && name.find("_norm") != std::string::npos) {
+                for (int64_t i = 0; i < ggml_nelements(t); ++i) { ((float *) t->data)[i] = 1.0f + 0.1f * u(rng); }
+            } else if (t->type == GGML_TYPE_F32 && name.find(".trellis_") != std::string::npos) {
+                for (int64_t i = 0; i < ggml_nelements(t); ++i) { ((float *) t->data)[i] = (rng() % 2 ? -1.0f : 1.0f) * (0.8f + 0.2f * u(rng)); }
+            } else if (t->type == GGML_TYPE_F32) {
+                for (int64_t i = 0; i < ggml_nelements(t); ++i) { ((float *) t->data)[i] = 0.06f * u(rng); }
+            }
+        }
+    }
+
+    int32_t * pin() {
+        return (int32_t *) ggml_get_tensor(ctx, "output.trellis_pin")->data;
+    }
+};
