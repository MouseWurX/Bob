+static int trellis_vk_profile() {
+    static const int v = [] {
+        const char * e = getenv("LAMPLIGHT_TRELLIS_VK_PROFILE");
+        if (!e) {
+            return 0;
+        }
+        const std::string s(e);
+        return s == "nodecode" ? 1 : s == "nomul" ? 2 : 0;
+    }();
+    return v;
+}
