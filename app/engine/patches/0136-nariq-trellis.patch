+int ggml_cuda_trellis_group_size(const ggml_cgraph * cgraph, int i) {
+    GGML_UNUSED(cgraph);
+    GGML_UNUSED(i);
+    return 1;
+}
+
+void ggml_cuda_op_trellis_group(ggml_backend_cuda_context & ctx, ggml_tensor * const * nodes, int n) {
+    GGML_UNUSED(ctx);
+    GGML_UNUSED(nodes);
+    GGML_UNUSED(n);
+    GGML_ABORT("trellis: this build has no libtrellis");
+}
+
+int ggml_cuda_trellis_mlp_chain(const ggml_cgraph * cgraph, int i) {
+    GGML_UNUSED(cgraph);
+    GGML_UNUSED(i);
+    return 0;
+}
+
+void ggml_cuda_op_trellis_mlp_chain(ggml_backend_cuda_context & ctx, ggml_tensor * const * nodes) {
+    GGML_UNUSED(ctx);
+    GGML_UNUSED(nodes);
+    GGML_ABORT("trellis: this build has no libtrellis");
+}
+
+bool ggml_cuda_trellis_id_card(int cc, const ggml_tensor * op) {
+    GGML_UNUSED(cc);
+    GGML_UNUSED(op);
+    return false;
+}
+
+void ggml_cuda_op_trellis_id_card(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    GGML_UNUSED(ctx);
+    GGML_UNUSED(dst);
+    GGML_ABORT("trellis: this build has no libtrellis");
+}
