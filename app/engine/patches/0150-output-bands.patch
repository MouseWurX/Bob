+ggml_tensor * llm_graph_context::build_output_bands(
+          ggml_tensor * w,
+          ggml_tensor * cur) const {
+    if (model.output_bands.empty() || w != model.output_bands[0]) {
+        return nullptr;
+    }
+    GGML_ASSERT(cur->ne[2] == 1 && cur->ne[3] == 1 && "banded output head: cur must be 2D");
+    // each band times cur, the bands laid end to end (a balanced tree of concats: fewer copies than one by one)
+    std::vector<ggml_tensor *> parts;
+    for (ggml_tensor * band : model.output_bands) {
+        ggml_tensor * r = ggml_mul_mat(ctx0, band, cur);
+        if (prec_policy) {
+            prec_policy->apply(r);
+        }
+        parts.push_back(r);
+    }
+    while (parts.size() > 1) {
+        std::vector<ggml_tensor *> next;
+        for (size_t i = 0; i + 1 < parts.size(); i += 2) {
+            next.push_back(ggml_concat(ctx0, parts[i], parts[i + 1], 0));
+        }
+        if (parts.size() % 2 == 1) {
+            next.push_back(parts.back());
+        }
+        parts.swap(next);
+    }
+    ggml_tensor * sorted = parts[0];                                  // [n_vocab, n_tokens], band order
+    ggml_tensor * pos = ggml_cast(ctx0, model.output_band_pos, GGML_TYPE_I32);
+    const int64_t n_vocab_head = sorted->ne[0];
+    const int64_t n_tok        = sorted->ne[1];
+    if (n_tok == 1) {
+        ggml_tensor * col = ggml_reshape_2d(ctx0, sorted, 1, n_vocab_head);
+        return ggml_reshape_2d(ctx0, ggml_get_rows(ctx0, col, pos), n_vocab_head, 1);
+    }
+    ggml_tensor * by_row = ggml_cont(ctx0, ggml_transpose(ctx0, sorted));  // [n_tokens, n_vocab]
+    return ggml_cont(ctx0, ggml_transpose(ctx0, ggml_get_rows(ctx0, by_row, pos)));
+}
+
+ggml_tensor * llm_graph_context::build_output_mm(
+          ggml_tensor * w,
+          ggml_tensor * cur) const {
+    if (ggml_tensor * res = build_output_bands(w, cur)) {
+        return res;
+    }
+    return ggml_mul_mat(ctx0, w, cur);
+}
+
 ggml_tensor * llm_graph_context::build_lora_mm(
           ggml_tensor * w,
           ggml_tensor * cur,
           ggml_tensor * w_s) const {
+    if (ggml_tensor * res = build_output_bands(w, cur)) {
+        return w_s ? ggml_mul(ctx0, res, w_s) : res;
+    }
     // a Hadamard-folded weight reads the transformed input; a LoRA delta lives in the primal basis and reads `cur`
     ggml_tensor * cur_mm = build_hadamard_input(w, cur);
     ggml_tensor * res = ggml_mul_mat(ctx0, w, cur_mm);
