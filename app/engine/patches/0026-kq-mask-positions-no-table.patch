+// Brain Engine 0026: a position mask (ggml_flash_attn_ext_pos_mask_init) instead of the F16 table. The kernels get
+// nb31 < 0 for it: n_swa = -nb31 - 1; per stream (nb33 apart) the query rows' positions come first, then the K/V
+// columns' positions, so a kernel finds the columns at its query base + ne01.z (the number of query rows).
+static __device__ __forceinline__ float fattn_pos_mask(const int p0, const int p1, const int n_swa) {
+    return (p0 <= p1 && (n_swa == 0 || p1 - p0 < n_swa)) ? 0.0f : -INFINITY;
+}
+
+// The F16 table a position mask stands for, so every choice made from the mask's shape (kernel, tile skip, strides,
+// alignment) is the same as with the table; data still points at the positions.
+static inline const ggml_tensor * ggml_cuda_fattn_mask(const ggml_tensor * dst, ggml_tensor & virt) {
+    const ggml_tensor * mask = dst->src[3];
+    if (mask == nullptr || mask->type != GGML_TYPE_I32) {
+        return mask;
+    }
+    virt = *mask;
+    virt.type  = GGML_TYPE_F16;
+    virt.ne[0] = ggml_get_op_params_i32(mask, 0);
+    virt.ne[1] = ggml_get_op_params_i32(mask, 1);
+    virt.ne[2] = 1;
+    virt.ne[3] = mask->ne[3];
+    virt.nb[0] = sizeof(half);
+    virt.nb[1] = virt.nb[0]*virt.ne[0];
+    virt.nb[2] = virt.nb[1]*virt.ne[1];
+    virt.nb[3] = virt.nb[2];
+    return &virt;
+}
