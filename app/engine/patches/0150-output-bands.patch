 ggml_tensor * llama_model_base::create_tensor(llama_model_loader & ml, const LLM_TN_IMPL & tn, const std::initializer_list<int64_t> & ne, int flags) {
+    // BE 0150: a file whose output head is in bands (output.band0.weight, output.band1.weight, ... and
+    // output.band_pos) has no output.weight. The arch asks for the head here; it gets band 0, and every band
+    // and the positions are created with it. The graph sees model.output == band 0 and multiplies by every band.
+    if (tn.tensor == LLM_TENSOR_OUTPUT && tn.bid == -1 && tn.suffix != nullptr && strcmp(tn.suffix, "weight") == 0 &&
+            ne.size() == 2 && !(flags & TENSOR_SKIP) && ml.get_tensor_meta("output.band0.weight") != nullptr) {
+        if (!model->output_bands.empty()) {
+            return model->output_bands[0];
+        }
+        static const char * band_suffix[] = {
+            "band0.weight",  "band1.weight",  "band2.weight",  "band3.weight",  "band4.weight",  "band5.weight",
+            "band6.weight",  "band7.weight",  "band8.weight",  "band9.weight",  "band10.weight", "band11.weight",
+            "band12.weight", "band13.weight", "band14.weight", "band15.weight", "band16.weight", "band17.weight",
+            "band18.weight", "band19.weight", "band20.weight", "band21.weight", "band22.weight", "band23.weight",
+            "band24.weight", "band25.weight", "band26.weight", "band27.weight", "band28.weight", "band29.weight",
+            "band30.weight", "band31.weight",
+        };
+        const int64_t n_embd_head = ne.begin()[0];
+        const int64_t n_vocab_head = ne.begin()[1];
+        int64_t rows = 0;
+        for (const char * suf : band_suffix) {
+            const std::string name = std::string("output.") + suf;
+            const ggml_tensor * meta = ml.get_tensor_meta(name.c_str());
+            if (meta == nullptr) {
+                break;
+            }
+            if (meta->ne[0] != n_embd_head || meta->ne[2] != 1 || meta->ne[3] != 1) {
+                throw std::runtime_error(format("%s: wrong shape for a band of the output head", name.c_str()));
+            }
+            model->output_bands.push_back(create_tensor(ml, this->tn(LLM_TENSOR_OUTPUT, suf), {n_embd_head, meta->ne[1]}, 0));
+            rows += meta->ne[1];
+        }
+        if (ml.get_tensor_meta("output.band32.weight") != nullptr) {
+            throw std::runtime_error("the output head has more than 32 bands");
+        }
+        if (rows != n_vocab_head) {
+            throw std::runtime_error(format("the output head's bands hold %lld rows, the vocabulary has %lld",
+                    (long long) rows, (long long) n_vocab_head));
+        }
+        model->output_band_pos = create_tensor(ml, this->tn(LLM_TENSOR_OUTPUT, "band_pos"), {n_vocab_head}, 0);
+        LLAMA_LOG_INFO("%s: output head in %zu bands (bits by word)\n", __func__, model->output_bands.size());
+        return model->output_bands[0];
+    }
