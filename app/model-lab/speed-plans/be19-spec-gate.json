{
 "name": "Brain Engine 19: n-gram drafts only when they pay (0034), code edit vs plain chat, 3 rounds",
 "method": "app/docs/test-results/2026-11-16-speed-test-method.md (addendum 54 (D))",
 "brain": "${BRAIN}",
 "engines": {
  "be19": {
   "exe": "${BE19_SERVER}"
  }
 },
