+    // Brain Engine 0069 (on unless LLAMA_MOE_CACHE_READ_IN_PLACE=0): long reads use the cached experts where they sit.
+    // A batch of more than max_batch tokens used to bypass the cache: the scheduler copied every used expert of a layer
+    // into a working copy of the whole layer (from the cache card to card, the rest from RAM) before each step. Now such a
+    // batch reads through the slot map like writing does. The hits are read in their slots; the misses go up into a
+    // zone of the group's coldest slots, taken out of the cache for the read (their experts are put back, hottest first,
+    // before the first written word). The zone is as big as the most misses any layer of the group can have, so every
+    // layer always fits and the step's working memory no longer holds a copy of a layer's experts. The LRU is not
+    // touched by a read, so the experts used in writing stay. Off next to borrowed reading (0048), lending (0022), the
+    // read layout (0024) and stream ahead (0059/0067), which all work on the layer copies; layers whose group has fewer
+    // slots than a layer has experts read the stock way.
+    bool ip_on = false;
+    bool ip_active = false;
+    std::vector<std::vector<int32_t>> ip_zone;    // per group: the zone's slots, ascending
+    std::vector<std::vector<int32_t>> ip_dropped; // per group: keys the zone took out of the cache
+    std::vector<int32_t> ip_map;                  // the slot map sent for a layer
+    std::vector<uint8_t> ip_seen;
+    std::vector<moe_cache_lru::fill> ip_fills;
+    size_t ip_hits = 0, ip_misses = 0, ip_bytes = 0, ip_reads = 0, ip_zone_slots = 0, ip_back = 0;
+    int64_t ip_back_us = 0;
+
+    void ip_init() {
+        const char * v = getenv("LLAMA_MOE_CACHE_READ_IN_PLACE");
+        if (v != nullptr && *v != '\0' && atoi(v) == 0) {
+            LLAMA_LOG_INFO("llama_moe_cache: long reads copy each layer's experts as before (LLAMA_MOE_CACHE_READ_IN_PLACE=0)\n");
+            return;
+        }
+        auto set = [](const char * k) { const char * e = getenv(k); return e != nullptr && *e != '\0' && atoi(e) != 0; };
+        const char * next_to = set("LLAMA_MOE_CACHE_LEND") ? "LLAMA_MOE_CACHE_LEND" :
+                               set("LLAMA_MOE_CACHE_READ_LAYERS") ? "LLAMA_MOE_CACHE_READ_LAYERS" :
+                               set("LLAMA_MOE_STREAM_AHEAD") ? "LLAMA_MOE_STREAM_AHEAD" :
+                               set("LLAMA_MOE_STREAM_NEXT") ? "LLAMA_MOE_STREAM_NEXT" : nullptr;
+        if (next_to != nullptr) {
+            LLAMA_LOG_WARN("llama_moe_cache: !!! in-place long reads NOT USED next to %s (it works on the layer copies)\n", next_to);
+            return;
+        }
+        ip_on = true;
+        ip_zone.assign(groups.size(), {});
+        ip_dropped.assign(groups.size(), {});
+        LLAMA_LOG_INFO("llama_moe_cache: long reads use the cached experts in place, only the misses go up (LLAMA_MOE_CACHE_READ_IN_PLACE=0 turns it off)\n");
+    }
+
+    bool ip_group_ok(const group & g) const {
+        return g.n_slots >= (int32_t) g.ref[0]->ne[2];
+    }
+
+    // the zones, taken from the coldest slots of each group, before the first layer of a long read
+    void ip_begin() {
+        la_drain();
+        db_lost();
+        const int64_t t0 = ggml_time_us();
+        size_t total = 0, dropped = 0;
+        for (size_t ig = 0; ig < groups.size(); ++ig) {
+            group & g = groups[ig];
+            ip_zone[ig].clear();
+            ip_dropped[ig].clear();
+            if (!ip_group_ok(g)) {
+                continue;
+            }
+            moe_cache_lru & lru = g.lru;
+            const int32_t n_exp = (int32_t) g.ref[0]->ne[2];
+            // misses per layer of the group: the experts it has no slot for
+            std::vector<int32_t> miss(layers.size(), 0);
+            int32_t z = 0;
+            for (int32_t il : g.layers) {
+                const int32_t * map = lru.slot_map[il];
+                if (map == nullptr) {
+                    continue;
+                }
+                for (int32_t e = 0; e < n_exp; ++e) {
+                    miss[il] += map[e] >= g.n_slots;
+                }
+                z = std::max(z, miss[il]);
+            }
+            // coldest first, as victim() scores them: empty slots, then age/2^class, highest first
+            std::vector<std::pair<double, int32_t>> order;
+            order.reserve(g.n_slots);
+            for (int32_t s = 0; s < g.n_slots; ++s) {
+                const int32_t key = lru.key_of[s];
+                const double score = key < 0 ? HUGE_VAL : std::ldexp((double) (lru.clock[lru.key_layer(key)] - lru.last_use[key]), -(int) lru.list_of[s]);
+                order.push_back({ score, s });
+            }
+            std::stable_sort(order.begin(), order.end(), [](const auto & a, const auto & b) { return a.first > b.first; });
+            std::vector<int32_t> & zone = ip_zone[ig];
+            for (size_t k = 0; (int32_t) zone.size() < z && k < order.size(); ++k) {
+                const int32_t s   = order[k].second;
+                const int32_t key = lru.key_of[s];
+                if (key >= 0) {
+                    const int32_t kl = lru.key_layer(key);
+                    lru.slot_map[kl][lru.key_expert(key)] = lru.empty;
+                    lru.n_filled--;
+                    lru.key_of[s] = -1;
+                    lru.move_head(s, 0);
+                    ip_dropped[ig].push_back(key);
+                    dropped++;
+                    z = std::max(z, ++miss[kl]); // that layer now misses this expert too
+                }
+                zone.push_back(s);
+            }
+            GGML_ASSERT((int32_t) zone.size() >= z && "the in-place zone is smaller than a layer's misses");
+            std::sort(zone.begin(), zone.end());
+            total += zone.size();
+        }
+        db_dirty = true; // 0042: the doorbell's mirrors follow the slot maps
+        ip_active = true;
+        ip_reads++;
+        ip_zone_slots = std::max(ip_zone_slots, total);
+        LLAMA_LOG_DEBUG("llama_moe_cache: in-place long read: zone of %zu slots (%zu experts taken out of the cache) in %.1f ms\n",
+            total, dropped, (ggml_time_us() - t0)/1000.0);
+    }
+
+    // after a long read: the experts the zones took out go back, hottest first, before the first written word
+    void ip_end() {
+        if (!ip_active) {
+            return;
+        }
+        ip_active = false;
+        const int64_t t0 = ggml_time_us();
+        for (size_t ig = 0; ig < groups.size(); ++ig) {
+            group & g = groups[ig];
+            moe_cache_lru & lru = g.lru;
+            std::vector<int32_t> keys;
+            keys.swap(ip_dropped[ig]);
+            std::vector<int32_t> zone;
+            zone.swap(ip_zone[ig]);
+            if (keys.empty()) {
+                continue;
+            }
+            auto heat = [&](int32_t key) { return lru.decayed_crf(lru.key_layer(key), key); };
+            std::stable_sort(keys.begin(), keys.end(), [&](int32_t a, int32_t b) { return heat(a) > heat(b); });
+            ggml_backend_t backend = devices[g.id].backend;
+            // per layer, so upload_fills can take runs and the RAM cache
+            std::vector<std::vector<moe_cache_lru::fill>> per(layers.size());
+            size_t zi = 0;
+            for (int32_t key : keys) {
+                if (zi >= zone.size()) {
+                    break;
+                }
+                const int32_t kl = lru.key_layer(key);
+                const int32_t ke = lru.key_expert(key);
+                if (lru.slot_map[kl] == nullptr || lru.slot_map[kl][ke] < g.n_slots) {
+                    continue;
+                }
+                const int32_t s = zone[zi++];
+                GGML_ASSERT(lru.key_of[s] < 0);
+                per[kl].push_back({ ke, s });
+                lru.slot_map[kl][ke] = s;
+                lru.key_of[s] = key;
+                lru.move(s, lru.class_of(key));
+                lru.n_filled++;
+                ip_back++;
+            }
+            for (size_t il = 0; il < per.size(); ++il) {
+                if (!per[il].empty()) {
+                    std::sort(per[il].begin(), per[il].end(), [](const auto & a, const auto & b) { return a.expert < b.expert; });
+                    upload_fills(backend, layers[il], g, per[il]);
+                }
+            }
+        }
+        db_dirty = true;
+        ip_back_us += ggml_time_us() - t0;
+    }
