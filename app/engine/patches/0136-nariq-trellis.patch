+        ggml_set_name(w, "w");
+        ggml_set_name(x, "x");
+        if (x_pad > 0) {
+            x = ggml_view_2d(ctx, x, k, t, x->nb[1], 0);
+            ggml_set_name(x, "x_view");
+        }
+
+        std::vector<int32_t> p = { (int32_t) n };
+        if (parts[0] > 0) {
