+        if (tied) {
+            coded("token_embd", n_embd, vocab, GGML_TYPE_COUNT);
+        } else {
+            add("token_embd.weight", GGML_TYPE_F32, {n_embd, vocab});
+            coded("output", n_embd, vocab, pin_type);
