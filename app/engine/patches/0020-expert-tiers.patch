diff --git a/src/llama-expert-tiers.cpp b/src/llama-expert-tiers.cpp
new file mode 100644
index 0000000..ec67895
--- /dev/null
+++ b/src/llama-expert-tiers.cpp
@@ -0,0 +1,223 @@
+#include "llama-expert-tiers.h"
+
+#include "llama-impl.h"
+#include "llama-mmap.h"
+#include "llama-model.h"
+
+#include "ggml-backend.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+#include <mutex>
+#include <set>
+#include <string>
+#include <tuple>
+#include <vector>
+
+#if defined(_WIN32)
+#define WIN32_LEAN_AND_MEAN
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#else
+#include <unistd.h>
+#endif
+
+// The three tiers:
+//   hot  = the busiest experts copied to the card (llama.cpp's --moe-cache-mib, filled from a ranking by 0016)
+//   warm = the next busiest experts pinned in RAM (this file): never dropped back to the disk
+//   cold = the rest: left to the operating system; with LLAMA_EXPERT_READ_WHOLE=1 a cold expert that is picked is read
+//          from the disk in one go instead of a few pages at a time (ggml-cpu, ggml_cpu_expert_read_whole)
+//
+// LLAMA_EXPERT_WARM_MIB=N       how much RAM the warm tier may pin, in MiB (off unless set and > 0)
+// LLAMA_EXPERT_WARM_RANKING=P   the ranking file (the same "bob-moe-ranking 2" file as 0016); if unset,
+//                               LLAMA_MOE_CACHE_RANKING is used
+// The experts are pinned busiest first (ties by layer, then expert, so one file always pins the same set). Only experts
+// whose bytes sit in host memory are pinned; layers on the card are skipped. A ranking made on another brain, or one
+// that doesn't fit this brain, is refused out loud and nothing is pinned.
+
+// gate, up, down or gate_up, down: the same tensors, in the same order, as 0016's fingerprint
+static std::vector<ggml_tensor *> tiers_layer_experts(const llama_layer & layer) {
+    std::vector<ggml_tensor *> res;
+    for (ggml_tensor * t : { layer.ffn_gate_up_exps, layer.ffn_gate_exps, layer.ffn_up_exps, layer.ffn_down_exps }) {
+        if (t != nullptr) {
+            res.push_back(t);
+        }
+    }
+    return res;
+}
+
+// Must stay the same as 0016's model_fingerprint() in llama-moe-cache.cpp, so one ranking file serves both tiers.
+static uint64_t tiers_fingerprint(const llama_model & model) {
+    uint64_t h = 1469598103934665603ULL;
+    auto mix = [&](const void * p, size_t n) { const uint8_t * b = (const uint8_t *) p; for (size_t i = 0; i < n; ++i) { h ^= b[i]; h *= 1099511628211ULL; } };
+    for (size_t il = 0; il < model.layers.size(); ++il) {
+        for (const ggml_tensor * t : tiers_layer_experts(model.layers[il])) {
+            const int32_t type = (int32_t) t->type;
+            mix(&il, sizeof(il));
+            mix(&type, sizeof(type));
+            mix(t->ne, sizeof(t->ne));
+            const size_t n = std::min<size_t>(64, t->nb[2]);
+            for (const size_t off : { (size_t) 0, (size_t) (t->ne[2] - 1)*t->nb[2] + t->nb[2] - n }) {
+                uint8_t buf[64];
+                ggml_backend_tensor_get(t, buf, off, n);
+                mix(buf, n);
+            }
+        }
+    }
+    return h;
+}
+
+static size_t tiers_page_size() {
+#if defined(_WIN32)
+    SYSTEM_INFO si;
+    GetSystemInfo(&si);
+    return (size_t) si.dwPageSize;
+#else
+    return (size_t) sysconf(_SC_PAGESIZE);
+#endif
+}
+
+void llama_expert_tiers_pin_warm(const llama_model & model) {
+    const char * mib_s = getenv("LLAMA_EXPERT_WARM_MIB");
+    if (mib_s == nullptr || *mib_s == '\0') {
+        return;
+    }
+    const unsigned long long mib = strtoull(mib_s, nullptr, 10);
+    if (mib == 0) {
+        return;
+    }
+
+    static std::mutex                                 mtx;
+    static std::set<const llama_model *>              done;
+    static std::vector<std::unique_ptr<llama_mlock>>  locks; // kept until the engine stops
+    std::lock_guard<std::mutex> lock(mtx);
+    if (!done.insert(&model).second) {
+        return;
+    }
+
+    const char * path = getenv("LLAMA_EXPERT_WARM_RANKING");
+    if (path == nullptr || *path == '\0') {
+        path = getenv("LLAMA_MOE_CACHE_RANKING");
+    }
+    auto refuse = [&](const std::string & why) {
+        LLAMA_LOG_WARN("%s: !!! warm experts NOT PINNED: %s (%s). Nothing is pinned; the operating system manages the RAM as usual.\n",
+            __func__, why.c_str(), path ? path : "no ranking file");
+    };
+    if (path == nullptr || *path == '\0') {
+        refuse("LLAMA_EXPERT_WARM_MIB is set but no ranking file is (LLAMA_EXPERT_WARM_RANKING or LLAMA_MOE_CACHE_RANKING)");
+        return;
+    }
+    if (!llama_mlock::SUPPORTED) {
+        refuse("this system can't pin memory");
+        return;
+    }
+    const uint32_t n_expert = model.hparams.n_expert;
+    if (n_expert == 0) {
+        refuse("this brain has no experts");
+        return;
+    }
+
+    FILE * f = fopen(path, "r");
+    if (f == nullptr) {
+        refuse("the file can't be opened");
+        return;
+    }
+    char magic[32] = {0};
+    int version = 0;
+    unsigned long long fp = 0;
+    char stamp[256] = {0};
+    if (fscanf(f, "%31s %d %llx %255s", magic, &version, &fp, stamp) != 4 || strcmp(magic, "bob-moe-ranking") != 0 || version != 2) {
+        fclose(f);
+        refuse("not a bob-moe-ranking 2 file");
+        return;
+    }
+    const uint64_t fingerprint = tiers_fingerprint(model);
+    if ((uint64_t) fp != fingerprint) {
+        fclose(f);
+        char why[128];
+        snprintf(why, sizeof(why), "made on another brain (fingerprint %016llx, this brain %016llx)", fp, (unsigned long long) fingerprint);
+        refuse(why);
+        return;
+    }
+    std::vector<std::tuple<double, int, int>> cand; // (count, layer, expert)
+    int il = 0, e = 0;
+    double count = 0.0;
+    size_t n_bad = 0;
+    int got = 0;
+    while ((got = fscanf(f, "%d %d %lf", &il, &e, &count)) == 3) {
+        if (il < 0 || (size_t) il >= model.layers.size() || e < 0 || (uint32_t) e >= n_expert || !(count > 0.0)) {
+            n_bad++;
+            continue;
+        }
+        cand.emplace_back(count, il, e);
+    }
+    const bool tail_ok = got == EOF;
+    fclose(f);
+    if (!tail_ok || n_bad > 0 || cand.empty()) {
+        char why[160];
+        snprintf(why, sizeof(why), "%s (%zu lines read, %zu naming a layer or expert this brain doesn't have)",
+            !tail_ok ? "a line that can't be read" : cand.empty() ? "no experts in it" : "it doesn't fit this brain", cand.size() + n_bad, n_bad);
+        refuse(why);
+        return;
+    }
+    // the busiest first; ties by layer, then expert
+    std::sort(cand.begin(), cand.end(), [](const auto & a, const auto & b) {
+        if (std::get<0>(a) != std::get<0>(b)) { return std::get<0>(a) > std::get<0>(b); }
+        if (std::get<1>(a) != std::get<1>(b)) { return std::get<1>(a) < std::get<1>(b); }
+        return std::get<2>(a) < std::get<2>(b);
+    });
+    cand.erase(std::unique(cand.begin(), cand.end(), [](const auto & a, const auto & b) {
+        return std::get<1>(a) == std::get<1>(b) && std::get<2>(a) == std::get<2>(b); }), cand.end());
+
+    const size_t page   = tiers_page_size();
+    const size_t budget = (size_t) mib * 1024 * 1024;
+    size_t pinned = 0, n_experts = 0, n_on_card = 0;
+    bool   failed = false;
+    for (const auto & c : cand) {
+        const llama_layer & layer = model.layers[std::get<1>(c)];
+        const int ex = std::get<2>(c);
+        std::vector<std::pair<uintptr_t, size_t>> ranges;
+        size_t need = 0;
+        for (const ggml_tensor * t : tiers_layer_experts(layer)) {
+            if (t->buffer == nullptr || !ggml_backend_buffer_is_host(t->buffer) || t->data == nullptr) {
+                continue;
+            }
+            const uintptr_t p = (uintptr_t) t->data + (size_t) ex*t->nb[2];
+            const uintptr_t a = p & ~(uintptr_t) (page - 1);
+            ranges.emplace_back(a, (size_t) (p + t->nb[2] - a));
+            need += t->nb[2];
+        }
+        if (ranges.empty()) {
+            n_on_card++;
+            continue; // this layer's experts sit on the card
+        }
+        if (pinned + need > budget) {
+            break;
+        }
+        for (const auto & r : ranges) {
+            auto ml = std::make_unique<llama_mlock>();
+            ml->init((void *) r.first);
+            ml->grow_to(r.second);
+            const bool ok = !ml->failed();
+            locks.push_back(std::move(ml));
+            if (!ok) {
+                failed = true; // llama_mlock has logged why; the system's limit is reached, so stop here
+                break;
+            }
+        }
+        if (failed) {
+            break;
+        }
+        pinned += need;
+        n_experts++;
+    }
+    LLAMA_LOG_INFO("%s: warm experts: %zu experts pinned in RAM, %.1f MiB of the %llu MiB allowed (%zu ranked experts sit on the card, %zu ranked in all)%s\n",
+        __func__, n_experts, pinned/1024.0/1024.0, mib, n_on_card, cand.size(),
+        failed ? "; stopped early: the system refused to pin more (on Linux raise 'ulimit -l', on Windows the working set limit)" : "");
+}
