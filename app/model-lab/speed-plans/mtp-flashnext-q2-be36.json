{
 "name": "MTP drafting on Flash-Next (UD-Q2_K_XL) with Brain Engine 36, only once the owner lifts the Flash-Next stop on the test PC: first check Bob's log or the file header for nextn_predict_layers and nextn.eh_proj (inside the file) or an mtp-*.gguf beside it; then the 32K conductor-e2e job, plain vs MTP (in the file, or the file beside it). Words and speed. RAM floor on (LLAMA_MOE_DRIVE=1). 1 round. Stop on a lockup sign (free RAM under 256 MiB for 30 s).",
 "method": "app/docs/test-results/2026-11-16-speed-test-method.md (addendum 99)",
 "brain": "${FLASHNEXT_Q2}",
 "engines": {
  "be36": {
   "exe": "${BE36_SERVER}",
   "env": {
    "GGML_CUDA_NO_PINNED": "1",
    "LLAMA_MOE_CACHE_LOG_EVERY": "2000",
    "LLAMA_MOE_DRIVE": "1"
   }
  }
 },
 "text": "long-text.md",
 "system": "You are a helpful assistant. Answer plainly.",
 "followUps": 5,
 "followTokens": 200,
 "replyTokens": 300,
 "retryOnce": true,
 "saveText": true,
 "spillCheck": true,
 "lock": "${LOCK}",
 "stopFile": "${STOP_FILE}",
 "textRepeat": 1,
 "bigRead": 12288,
 "rounds": 1,
 "alternate": true,
 "loadTimeoutMs": 2700000,
 "wordsRef": "plain",
 "baseArgs": [
  "--jinja",
  "-np",
  "1",
  "--no-webui",
  "-fa",
  "on",
  "-c",
  "32768",
  "-ctk",
  "q4_0",
  "-ctv",
  "q4_0",
  "-ngl",
  "99",
  "--n-cpu-moe",
  "999",
  "-ub",
  "4096",
  "--moe-cache-mib",
  "4096",
  "-lv",
  "4"
 ],
 "ways": [
  {
   "id": "plain",
   "engine": "be36",
   "args": [
    "--moe-cache-cpu-share",
    "0"
   ]
  },
  {
   "id": "mtp-3",
   "engine": "be36",
   "args": [
    "--moe-cache-cpu-share",
    "0",
    "--spec-type",
    "draft-mtp",
    "--spec-draft-n-max",
    "3"
   ]
  },
  {
   "id": "mtp-3-sidecar",
   "engine": "be36",
   "args": [
    "--moe-cache-cpu-share",
    "0",
    "--spec-type",
    "draft-mtp",
    "--spec-draft-n-max",
    "3",
    "-md",
    "${FLASHNEXT_MTP_SIDECAR}"
   ],
   "skipIfMissing": "${FLASHNEXT_MTP_SIDECAR}"
  }
 ]
}