+            vk_pipeline & p = device->pipeline_trellis_mvq[bits][c][ids ? 1 : 0];
+            const vk_op_trellis_mvq_push_constants pc = { K, N, tc, q_off };
+            ggml_pipeline_request_descriptor_sets(ctx, p, 1);
+            ggml_vk_dispatch_pipeline(ctx, subctx, p, { qb, XQ, XS, B, ids ? PB : XS }, pc, { N / 16, groups, 1 });
+            ggml_vk_sync_buffers(ctx, subctx);
+        } else if (ids) {
+            vk_pipeline & p = device->pipeline_trellis_mv_id[bits];
+            const vk_op_trellis_mv_id_push_constants pc = { K, N, tc, q_off, s_off, first, base.e_used, base.e_nb1, ids_off };
