+// the tier that holds position p for a word at position p_cur, or -1 when only the main cache has it
+static int tier_of(const std::vector<llama_kv_cache_tier_view> & tv, llama_pos p, llama_pos p_cur) {
+    for (size_t t = 0; t < tv.size(); ++t) {
