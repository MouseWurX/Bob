+// Brain Engine 0039: how attention reads Progressive Memory for this batch
+static int kv_tiers_mode(const llama_kv_cache_context * mctx, uint32_t n_tokens, bool training) {
+    const auto * kv = mctx->get_kv();
+    if (kv == nullptr || kv->n_tiers() == 0 || training) {
+        return 0;
+    }
+    return n_tokens == 1 ? 1 : kv->tiers_fit(n_tokens) ? 2 : 3;
+}
+
+static void kv_tiers_tell(const llama_kv_cache_context * mctx, int used) {
+    const auto * kv = mctx->get_kv();
+    if (used > 0 && kv->tiers_first(used)) {
+        if (used == 1) {
+            LLAMA_LOG_INFO("%s: Progressive Memory: writing: each word attends to the sharpest copy of every word, merged\n", __func__);
+        } else if (used == 2) {
+            LLAMA_LOG_INFO("%s: Progressive Memory: reading: the newest words' sharp copies laid over the cache\n", __func__);
+        } else if (used == 3) {
+            LLAMA_LOG_INFO("%s: Progressive Memory: a batch bigger than LLAMA_KV_TIERS_SLACK reads the main cache only (its words are still kept sharp)\n", __func__);
+        } else {
+            LLAMA_LOG_WARN("%s: !!! Progressive Memory NOT USED for some layers: this attention can't merge (sinks, soft-capping, ALiBi or no flash attention); they read the main cache\n", __func__);
+        }
+    }
+}
+
+static void kv_tiers_set_input(llm_graph_input_attn_kv * inp, const llama_kv_cache_context * mctx, const llama_ubatch * ubatch) {
+    if (inp->tiers_mode == 0) {
+        return;
+    }
+    const auto * kv = mctx->get_kv();
+    for (uint32_t t = 0; t < inp->tier_idxs.size(); ++t) {
