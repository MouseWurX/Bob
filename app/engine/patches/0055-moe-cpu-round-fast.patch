+        case GGML_TYPE_IQ2_XXS: return be_iq2_xxs((const block_iq2_xxs *) row, a, da, nbk);
+        case GGML_TYPE_IQ2_XS:  return be_iq2_xs ((const block_iq2_xs  *) row, a, da, nbk);
+        case GGML_TYPE_IQ2_S:   return be_iq2_s  ((const block_iq2_s   *) row, a, da, nbk);
+        case GGML_TYPE_IQ3_XXS: return be_iq3_xxs((const block_iq3_xxs *) row, a, da, nbk);
