diff --git a/src/llama-table-window.cpp b/src/llama-table-window.cpp
new file mode 100644
index 0000000..ee6878f
--- /dev/null
+++ b/src/llama-table-window.cpp
@@ -0,0 +1,227 @@
+// Brain Engine 0030: see llama-table-window.h
+#include "llama-table-window.h"
+#include "llama-impl.h"
+#include "llama-mmap.h"
+#include "ggml-backend.h"
+
+#include <algorithm>
+#include <cstring>
+#include <memory>
+#include <mutex>
+#include <unordered_map>
+#include <vector>
+
+#ifdef _WIN32
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#else
+#include <sys/mman.h>
+#include <unistd.h>
+#endif
+
+static constexpr size_t PAGE = 4096;
+
+struct llama_table_window {
+    ggml_tensor * tensor = nullptr;
+    void        * old_data = nullptr;
+    ggml_backend_buffer_t old_buffer = nullptr;
+    ggml_backend_buffer_t buffer = nullptr; // over the window, so the gather sees an ordinary host tensor
+    std::unique_ptr<llama_file> file;
+    size_t  file_offset = 0;
+    size_t  n_bytes = 0, n_pages = 0;
+    char  * base = nullptr;
+    size_t  budget_pages = 0, n_resident = 0;
+    uint64_t stamp = 0;
+    std::vector<uint64_t> last_use; // 0 = not resident
+    uint64_t n_reads = 0, n_read_pages = 0, n_evicted = 0, n_calls = 0;
+    std::mutex mtx;
+};
+
+static std::mutex g_mtx;
+static std::unordered_map<const ggml_tensor *, llama_table_window *> g_windows;
+
+static char * reserve(size_t n) {
+#ifdef _WIN32
+    return (char *) VirtualAlloc(nullptr, n, MEM_RESERVE, PAGE_NOACCESS);
+#else
+    void * p = mmap(nullptr, n, PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0);
+    return p == MAP_FAILED ? nullptr : (char *) p;
+#endif
+}
+static void release(char * p, size_t n) {
+#ifdef _WIN32
+    (void) n; VirtualFree(p, 0, MEM_RELEASE);
+#else
+    munmap(p, n);
+#endif
+}
+static bool commit(char * p, size_t n) {
+#ifdef _WIN32
+    return VirtualAlloc(p, n, MEM_COMMIT, PAGE_READWRITE) != nullptr;
+#else
+    return mprotect(p, n, PROT_READ | PROT_WRITE) == 0;
+#endif
+}
+// gives the memory back and makes the page fault if it is read again before it is read in (never silently zero)
+static void decommit(char * p, size_t n) {
+#ifdef _WIN32
+    VirtualFree(p, n, MEM_DECOMMIT);
+#else
+    madvise(p, n, MADV_DONTNEED);
+    mprotect(p, n, PROT_NONE);
+#endif
+}
+
+llama_table_window * llama_table_window_open(ggml_tensor * t, const std::string & path, size_t file_offset, size_t budget) {
+    if (t == nullptr || path.empty() || !t->buffer || !ggml_backend_buffer_is_host(t->buffer)) {
+        LLAMA_LOG_WARN("%s: !!! table window NOT USED for %s: not a host tensor with a known file\n", __func__, t ? t->name : "?");
+        return nullptr;
+    }
+    auto w = std::make_unique<llama_table_window>();
+    w->tensor = t;
+    w->n_bytes = ggml_nbytes(t);
+    w->n_pages = (w->n_bytes + PAGE - 1) / PAGE;
+    w->file_offset = file_offset;
+    w->budget_pages = std::max<size_t>(8, budget / PAGE);
+    try {
+        w->file = std::make_unique<llama_file>(path.c_str(), "rb", /*use_direct_io =*/ true);
+    } catch (const std::exception & e) {
+        LLAMA_LOG_WARN("%s: !!! table window NOT USED for %s: %s\n", __func__, t->name, e.what());
+        return nullptr;
+    }
+    if (file_offset + w->n_bytes > w->file->size()) {
+        LLAMA_LOG_WARN("%s: !!! table window NOT USED for %s: the table is past the end of its file\n", __func__, t->name);
+        return nullptr;
+    }
+    w->base = reserve(w->n_pages*PAGE);
+    if (w->base == nullptr) {
+        LLAMA_LOG_WARN("%s: !!! table window NOT USED for %s: could not reserve %.1f GiB of address space\n", __func__, t->name,
+                w->n_pages*PAGE/1073741824.0);
+        return nullptr;
+    }
+    ggml_backend_dev_t cpu = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU);
+    w->buffer = cpu ? ggml_backend_dev_buffer_from_host_ptr(cpu, w->base, w->n_pages*PAGE, w->n_pages*PAGE) : nullptr;
+    if (w->buffer == nullptr) {
+        release(w->base, w->n_pages*PAGE);
+        LLAMA_LOG_WARN("%s: !!! table window NOT USED for %s: no processor buffer over the window\n", __func__, t->name);
+        return nullptr;
+    }
+    ggml_backend_buffer_set_usage(w->buffer, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+    w->last_use.assign(w->n_pages, 0);
+    w->old_data   = t->data;
+    w->old_buffer = t->buffer;
+    t->data   = w->base;
+    t->buffer = w->buffer;
+    LLAMA_LOG_INFO("%s: table %s (%.2f GiB) read on demand %s into a window of at most %.2f MiB\n", __func__, t->name,
+            w->n_bytes/1073741824.0, w->file->has_direct_io() ? "with unbuffered I/O" : "(buffered: this system has no unbuffered I/O)",
+            w->budget_pages*PAGE/1048576.0);
+    std::lock_guard<std::mutex> lock(g_mtx);
+    g_windows[t] = w.get();
+    return w.release();
+}
+
+void llama_table_window_close(llama_table_window * w) {
+    if (!w) {
+        return;
+    }
+    {
+        std::lock_guard<std::mutex> lock(g_mtx);
+        g_windows.erase(w->tensor);
+    }
+    LLAMA_LOG_INFO("%s: table %s: %llu gathers, %llu reads (%.1f MiB), %llu pages given back\n", __func__, w->tensor->name,
+            (unsigned long long) w->n_calls, (unsigned long long) w->n_reads, w->n_read_pages*PAGE/1048576.0,
+            (unsigned long long) w->n_evicted);
+    w->tensor->data   = w->old_data;
+    w->tensor->buffer = w->old_buffer;
+    ggml_backend_buffer_free(w->buffer);
+    release(w->base, w->n_pages*PAGE);
+    delete w;
+}
+
+llama_table_window * llama_table_window_of(const ggml_tensor * t) {
+    std::lock_guard<std::mutex> lock(g_mtx);
+    auto it = g_windows.find(t);
+    return it == g_windows.end() ? nullptr : it->second;
+}
+
+bool llama_table_window_ensure(llama_table_window * w, const int32_t * rows, size_t n_rows) {
+    std::lock_guard<std::mutex> lock(w->mtx);
+    const size_t row_bytes = ggml_row_size(w->tensor->type, w->tensor->ne[0]);
+    const size_t nb1 = w->tensor->nb[1];
+    const uint64_t now = ++w->stamp;
+    w->n_calls++;
+
+    // the pages of every row, sorted, so neighbouring pages are read together
+    std::vector<size_t> pages;
+    pages.reserve(n_rows*2);
+    for (size_t i = 0; i < n_rows; ++i) {
+        GGML_ASSERT(rows[i] >= 0 && rows[i] < w->tensor->ne[1]);
+        const size_t b = (size_t) rows[i]*nb1, e = b + row_bytes;
+        for (size_t p = b/PAGE; p <= (e - 1)/PAGE; ++p) {
+            pages.push_back(p);
+        }
+    }
+    std::sort(pages.begin(), pages.end());
+    pages.erase(std::unique(pages.begin(), pages.end()), pages.end());
+
+    size_t n_new = 0;
+    for (size_t p : pages) {
+        n_new += w->last_use[p] == 0;
+    }
+    // make room first: the pages used least recently, never one this gather needs
+    if (w->n_resident + n_new > w->budget_pages) {
+        std::vector<std::pair<uint64_t, size_t>> old;
+        old.reserve(w->n_resident);
+        for (size_t p = 0; p < w->n_pages; ++p) {
+            if (w->last_use[p] != 0 && w->last_use[p] != now) {
+                old.emplace_back(w->last_use[p], p);
+            }
+        }
+        // a quarter of the window at a time, so the scan isn't done every word
+        const size_t want = std::min(old.size(), std::max(w->n_resident + n_new - w->budget_pages, w->budget_pages/4));
+        std::partial_sort(old.begin(), old.begin() + want, old.end());
+        for (size_t k = 0; k < want; ++k) {
+            const size_t p = old[k].second;
+            decommit(w->base + p*PAGE, PAGE);
+            w->last_use[p] = 0;
+            w->n_resident--;
+            w->n_evicted++;
+        }
+    }
+    // read the missing pages, a run of neighbours in one read
+    for (size_t k = 0; k < pages.size(); ) {
+        if (w->last_use[pages[k]] != 0) {
+            w->last_use[pages[k]] = now;
+            k++;
+            continue;
+        }
+        size_t k1 = k + 1;
+        while (k1 < pages.size() && pages[k1] == pages[k1 - 1] + 1 && w->last_use[pages[k1]] == 0) {
+            k1++;
+        }
+        const size_t p0 = pages[k], np = k1 - k;
+        const size_t off = p0*PAGE, len = std::min(np*PAGE, w->n_bytes - off);
+        if (!commit(w->base + off, np*PAGE)) {
+            LLAMA_LOG_ERROR("%s: table %s: could not take %zu KiB of memory for the window\n", __func__, w->tensor->name, np*PAGE/1024);
+            return false;
+        }
+        try {
+            w->file->seek(w->file_offset + off, SEEK_SET);
+            w->file->read_raw(w->base + off, len);
+        } catch (const std::exception & e) {
+            decommit(w->base + off, np*PAGE);
+            LLAMA_LOG_ERROR("%s: table %s: read failed: %s\n", __func__, w->tensor->name, e.what());
+            return false;
+        }
+        for (size_t j = k; j < k1; ++j) {
+            w->last_use[pages[j]] = now;
+        }
+        w->n_resident += np;
+        w->n_reads++;
+        w->n_read_pages += np;
+        k = k1;
+    }
+    return true;
+}
diff --git a/src/llama-table-window.h b/src/llama-table-window.h
new file mode 100644
index 0000000..ee300ec
--- /dev/null
+++ b/src/llama-table-window.h
@@ -0,0 +1,20 @@
+#pragma once
+// Brain Engine 0030 (LLAMA_TABLE_DIRECT=1): a big lookup table read on demand (Qwen3.8-Flash-Next's n-gram table,
+// DeepSeek V4.1's Engram, Gemma 4's per-layer embeddings - the tensors upstream reads lazily) is read with unbuffered
+// I/O into a window of our own instead of through the memory map, so its rows never fill the system's file cache and
+// push the brain's experts out of RAM. The window holds at most LLAMA_TABLE_DIRECT_MIB of the table (default 512),
+// the pages used least recently go first. Idea from Strata (github Jackwwg83/Strata-DS, MIT): "--ple-io direct".
+#include "ggml.h"
+#include <cstddef>
+#include <cstdint>
+#include <string>
+
+struct llama_table_window;
+
+// make a window for a lazy table; returns nullptr (and says why) when it can't, then the memory map is used as before
+llama_table_window * llama_table_window_open(ggml_tensor * t, const std::string & path, size_t file_offset, size_t budget);
+void                 llama_table_window_close(llama_table_window * w);
+// the window of a tensor, or nullptr
+llama_table_window * llama_table_window_of(const ggml_tensor * t);
+// read the rows the next gather needs; false if a read failed (logged)
+bool                 llama_table_window_ensure(llama_table_window * w, const int32_t * rows, size_t n_rows);
