+        }
+    }
+    // one word: the main cache's mask without the cells a tier holds (a copy of the plain mask's row)
+    // (filled the plain way first: the plain mask itself may be left unallocated when no layer reads it)
+    if (inp->tier_main_mask && inp->tier_main_mask->buffer) {
