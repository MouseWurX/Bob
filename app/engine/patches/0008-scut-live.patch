+// Brain Engine 0008: the link log. Every GGML_RPC_STATS seconds (default 10, 0 = off) in which the link carried
+// anything, both ends write what it carried and where the time went: "[link] ..." lines, and SCUT's own counters as
+// "[scut] ...". Nothing is added to the protocol except one tiny GET_ALIGNMENT round trip per report, to time the link.
+static int rpc_stats_secs() {
+    static const int secs = [] {
+        const char * env = std::getenv("GGML_RPC_STATS");
+        if (env == nullptr || env[0] == '\0') {
+            return 10;
+        }
+        const int v = atoi(env);
+        return v < 0 ? 0 : v;
+    }();
+    return secs;
