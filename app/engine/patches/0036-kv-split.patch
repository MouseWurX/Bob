+// the card's copy is only kept right by the split-aware attention; a layer stored some other way reads RAM from then on
+static void split_mark_write(const bool split_writing, const llama_kv_cache * kv, bool & stale, bool has_hot, int32_t il) {
+    if (has_hot && !split_writing && !stale) {
+        stale = true;
+        LLAMA_LOG_WARN("%s: layer %d is stored outside the split-aware attention; it reads its whole K and V from RAM now\n", __func__, il);
+    }
