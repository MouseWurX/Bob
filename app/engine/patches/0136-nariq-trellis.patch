+        add("output_norm.weight", GGML_TYPE_F32, {n_embd});
+        add("blk.0.attn_norm.weight", GGML_TYPE_F32, {n_embd});
+        for (const char * name : {"attn_q", "attn_k", "attn_v", "attn_output"}) {
