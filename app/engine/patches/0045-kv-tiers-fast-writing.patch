 }
 
+// Brain Engine 0045: each row's log-sum-exp from the blocks' [max, sum] pairs, for ggml_flash_attn_ext_with_lse
+static __global__ void flash_attn_write_lse(
+        const float2 * meta_ptr,
+        float * lse_ptr,
+        const int nrows,
+        const int parallel_blocks) {
+    ggml_cuda_pdl_lc();
+    const int j = blockIdx.x*blockDim.x + threadIdx.x;
+    ggml_cuda_pdl_sync();
+    if (j >= nrows) {
+        return;
+    }
+    const float2 * meta = meta_ptr + int64_t(j)*parallel_blocks;
+    float kqmax = meta[0].x;
+    for (int l = 1; l < parallel_blocks; ++l) {
+        kqmax = fmaxf(kqmax, meta[l].x);
+    }
+    float kqsum = 0.0f;
+    for (int l = 0; l < parallel_blocks; ++l) {
+        kqsum += meta[l].y*expf(meta[l].x - kqmax);
+    }
+    lse_ptr[j] = kqsum > 0.0f ? kqmax + logf(kqsum) : -INFINITY;
+}
