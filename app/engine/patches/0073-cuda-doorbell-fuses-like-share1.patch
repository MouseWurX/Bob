+// Brain Engine 0073: GGML_CUDA_FUSION_OFF=<list> turns single fusion families off (comma list: shared, glu, topk,
+// reduce), to find which one changes words; GGML_CUDA_DISABLE_FUSION=1 still turns them all off
+static bool ggml_cuda_fusion_off(const char * name) {
+    static const std::string list = [] {
+        const char * e = getenv("GGML_CUDA_FUSION_OFF");
+        return std::string(",") + (e ? e : "") + ",";
+    }();
+    return list.find(std::string(",") + name + ",") != std::string::npos;
+}
+
+// Brain Engine 0073: the doorbell's (0042) expert products read their slots from the ring op, maybe through a view
+static bool ggml_cuda_ids_from_doorbell(const ggml_tensor * ids) {
+    for (int i = 0; ids != nullptr && i < 4; ++i) {
+        if (ids->op == GGML_OP_MOE_DOORBELL) {
+            return true;
+        }
+        if (ids->op != GGML_OP_VIEW && ids->op != GGML_OP_RESHAPE && ids->op != GGML_OP_CONT) {
+            return false;
+        }
+        ids = ids->src[0];
+    }
+    return false;
+}
