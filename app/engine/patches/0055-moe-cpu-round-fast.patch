index 5498459..7fbf81e 100644
--- a/ggml/src/ggml-cpu/ggml-cpu.c
+++ b/ggml/src/ggml-cpu/ggml-cpu.c
@@ -1721,6 +1721,252 @@ static bool ggml_mul_mat_id_card_round(const struct ggml_tensor * dst) {
            ggml_row_size(GGML_TYPE_Q8_0, src0->ne[0]) <= ggml_row_size(GGML_TYPE_Q8_K, src0->ne[0]);
