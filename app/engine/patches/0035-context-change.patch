+    // Brain Engine 0035: POST /context {"n_ctx": N, "moe_cache_mib": M} makes the context again with the new size once no
+    // slot is busy; the brain stays loaded when its placement doesn't change. The chats' caches are emptied (save and
+    // restore slots around it to keep them).
+    this->post_context = [this](const server_http_req & req) {
+        auto res = create_response();
+        json body = json::parse(req.body.empty() ? "{}" : req.body);
+        if (!body.is_object() || (!body.contains("n_ctx") && !body.contains("moe_cache_mib"))) {
+            res->error(format_error_response("give n_ctx and/or moe_cache_mib", ERROR_TYPE_INVALID_REQUEST));
+            return res;
+        }
+        auto & rd = res->rd;
+        {
+            server_task task(SERVER_TASK_TYPE_CONTEXT);
+            task.id = rd.get_new_id();
+            task.context_change = std::move(body);
+            rd.post_task(std::move(task));
+        }
+        auto result = rd.next(req.should_stop);
+        if (!result) {
+            GGML_ASSERT(req.should_stop());
+            return res;
+        }
+        if (result->is_error()) {
+            res->error(result->to_json());
+            return res;
+        }
+        res->ok(result->to_json());
+        return res;
+    };
