+// Brain Engine 0019: weight prefetch while reading a prompt. Off unless LLAMA_PREFETCH_EXPERTS=1.
+//
+// When part of a mixture-of-experts brain stays in RAM and a big batch (prompt reading) runs its layers on the card,
+// the scheduler copies each layer's experts to the card right before that layer, on the card's own stream, so the card
+// waits for every copy. Here, once a layer's tensor has been sent with most of its experts in use, the same tensor of
+// the next layer in RAM is copied whole into a staging buffer on the card, on a second stream of the same card, while
+// this layer computes. When the scheduler asks for that tensor, the card waits for the copy (on the card, not the
+// processor) and moves it from the staging buffer to its place, a copy inside the card's memory.
+//
+// One staging buffer per kind of expert tensor (gate, up, down, gate_up), each the size of the biggest one in RAM, so
+// about one layer of experts more on the card; it is allocated at first use and, if the card has no room, the
+// prefetch turns itself off with a warning. A staging buffer is only written again after the card has moved its last
+// contents (an event recorded after that move). No math code and no scheduler code change: this sits in the copy
+// callback llama already gives the scheduler. Only for batches that use at least half the experts (prompt reading);
+// one-word writing is untouched.
+struct llama_expert_prefetch {
+    struct slot {
+        ggml_backend_buffer_t buf      = nullptr;
+        ggml_context        * ctx      = nullptr;
+        ggml_tensor         * staged   = nullptr; // the copy in the staging buffer
+        const ggml_tensor   * of       = nullptr; // the RAM tensor it holds
+        ggml_backend_event_t  ready    = nullptr; // the copy into the staging buffer finished
+        ggml_backend_event_t  consumed = nullptr; // the move out of it finished
+        bool                  pending  = false;   // consumed was recorded and not waited for yet
+    };
+
+    ggml_backend_t copier = nullptr;
+    std::map<const ggml_tensor *, const ggml_tensor *> next_of;  // a RAM expert tensor -> the same kind in the next layer in RAM
+    std::map<const ggml_tensor *, int>                 role_of;
+    slot slots[4];
+    uint64_t n_prefetched = 0, n_served = 0, bytes = 0;
+    bool off = false;
+
+    ~llama_expert_prefetch() {
+        if (copier) {
+            ggml_backend_synchronize(copier);
+        }
+        for (auto & s : slots) {
+            if (s.ctx)      { ggml_free(s.ctx); }
+            if (s.buf)      { ggml_backend_buffer_free(s.buf); }
+            if (s.ready)    { ggml_backend_event_free(s.ready); }
+            if (s.consumed) { ggml_backend_event_free(s.consumed); }
+        }
+        if (copier) {
+            ggml_backend_free(copier);
+        }
+        if (n_prefetched > 0) {
+            LLAMA_LOG_INFO("llama_expert_prefetch: %llu tensors copied ahead (%.2f MiB), %llu used\n", (unsigned long long) n_prefetched, bytes/1024.0/1024.0, (unsigned long long) n_served);
+        }
+    }
+
+    static bool in_ram(const ggml_tensor * t) {
+        return t && t->buffer && ggml_backend_buffer_is_host(t->buffer) && ggml_backend_buffer_get_usage(t->buffer) == GGML_BACKEND_BUFFER_USAGE_WEIGHTS;
+    }
+
+    bool init(const llama_model & model, ggml_backend_t backend) {
+        const ggml_tensor * last[4] = { nullptr, nullptr, nullptr, nullptr };
+        size_t biggest[4] = { 0, 0, 0, 0 };
+        for (size_t il = 0; il < model.layers.size(); ++il) {
+            const auto & l = model.layers[il];
+            const ggml_tensor * ts[4] = { l.ffn_gate_exps, l.ffn_up_exps, l.ffn_down_exps, l.ffn_gate_up_exps };
+            for (int r = 0; r < 4; ++r) {
+                if (!in_ram(ts[r])) {
+                    continue;
+                }
+                role_of[ts[r]] = r;
+                if (last[r]) {
+                    next_of[last[r]] = ts[r];
+                }
+                last[r]    = ts[r];
+                biggest[r] = std::max(biggest[r], ggml_nbytes(ts[r]));
+            }
+        }
+        if (next_of.empty()) {
+            return false;
+        }
+        ggml_backend_dev_t dev = ggml_backend_get_device(backend);
+        copier = ggml_backend_dev_init(dev, nullptr);
+        if (!copier) {
+            LLAMA_LOG_WARN("%s: !!! expert prefetch NOT USED: no second stream on %s\n", __func__, ggml_backend_dev_name(dev));
+            return false;
+        }
+        size_t total = 0;
+        for (int r = 0; r < 4; ++r) {
+            if (biggest[r] == 0) {
+                continue;
+            }
+            slot & s = slots[r];
+            s.buf      = ggml_backend_buft_alloc_buffer(ggml_backend_get_default_buffer_type(copier), biggest[r]);
+            s.ready    = ggml_backend_event_new(dev);
+            s.consumed = ggml_backend_event_new(dev);
+            if (!s.buf || !s.ready || !s.consumed) {
+                LLAMA_LOG_WARN("%s: !!! expert prefetch NOT USED: no room on %s for a %.2f MiB staging buffer (or no events)\n", __func__, ggml_backend_dev_name(dev), biggest[r]/1024.0/1024.0);
+                return false;
+            }
+            total += biggest[r];
+        }
+        LLAMA_LOG_INFO("%s: expert prefetch on: %zu tensors in RAM, %.2f MiB of staging on %s\n", __func__, role_of.size(), total/1024.0/1024.0, ggml_backend_dev_name(dev));
+        return true;
+    }
+
+    // the scheduler wants `src` on the card in `dst`: if it was copied ahead, move it there (inside the card's memory)
+    bool serve(ggml_backend_t backend, const ggml_tensor * src, ggml_tensor * dst) {
+        auto it = role_of.find(src);
+        if (it == role_of.end()) {
+            return false;
+        }
+        slot & s = slots[it->second];
+        if (s.of != src || !s.staged) {
+            return false;
+        }
+        ggml_backend_event_wait(backend, s.ready);
+        ggml_backend_tensor_copy_async(backend, backend, s.staged, dst); // on the card's own stream, after its earlier work with dst
+        ggml_backend_event_record(s.consumed, backend);
+        s.pending = true;
+        n_served++;
+        return true;
+    }
+
+    // `src` was just sent with `used` of its experts: copy the next layer's tensor of the same kind ahead
+    void ahead(ggml_backend_t backend, const ggml_tensor * src, int64_t used) {
+        GGML_UNUSED(backend);
+        if (used * 2 < src->ne[2]) {
+            return; // writing, or a small batch: the next layer will want only a few experts
+        }
+        auto nx = next_of.find(src);
+        if (nx == next_of.end()) {
+            return;
+        }
+        const ggml_tensor * t = nx->second;
+        slot & s = slots[role_of[t]];
+        if (s.of == t) {
+            return; // already there
+        }
+        if (s.pending) {
+            ggml_backend_event_wait(copier, s.consumed); // not over a staging buffer the card hasn't moved out yet
+            s.pending = false;
+        }
+        if (s.ctx) {
+            ggml_free(s.ctx);
+        }
+        ggml_init_params ip = { ggml_tensor_overhead(), nullptr, true };
+        s.ctx    = ggml_init(ip);
+        s.staged = ggml_dup_tensor(s.ctx, t);
+        if (ggml_backend_tensor_alloc(s.buf, s.staged, ggml_backend_buffer_get_base(s.buf)) != GGML_STATUS_SUCCESS) {
+            s.staged = nullptr;
+            s.of     = nullptr;
+            return;
+        }
+        ggml_backend_tensor_set_async(copier, s.staged, t->data, 0, ggml_nbytes(t));
+        ggml_backend_event_record(s.ready, copier);
+        s.of = t;
+        n_prefetched++;
+        bytes += ggml_nbytes(t);
+    }
+};
+
 bool llama_context::sched_copy_experts(ggml_backend_t backend, const ggml_tensor * src, ggml_tensor * dst, ggml_cgraph * graph, void * user_data) {
     auto * lctx = static_cast<llama_context *>(user_data);
 
@@ -3338,6 +3497,21 @@ bool llama_context::sched_copy_experts(ggml_backend_t backend, const ggml_tensor
         return true;
     }
 
+    // Brain Engine 0019: copied ahead while the layer before computed
+    if (!lctx->expert_prefetch_tried) {
+        lctx->expert_prefetch_tried = true;
+        const char * on = getenv("LLAMA_PREFETCH_EXPERTS");
+        if (on && atoi(on) > 0) {
+            auto pf = std::make_unique<llama_expert_prefetch>();
+            if (pf->init(lctx->model, backend)) {
+                lctx->expert_prefetch = std::move(pf);
+            }
+        }
+    }
+    if (lctx->expert_prefetch && lctx->expert_prefetch->serve(backend, src, dst)) {
+        return true;
+    }
+
     auto & st = lctx->copy_experts;
 
     // the ids must be computed before the split starts, so only the first node of the split is considered
@@ -3411,6 +3585,10 @@ bool llama_context::sched_copy_experts(ggml_backend_t backend, const ggml_tensor
         first = last + 1;
     }
 
+    if (lctx->expert_prefetch) {
+        lctx->expert_prefetch->ahead(backend, src, std::count(st.used.begin(), st.used.end(), true));
+    }
+
     return true;
 }
 
