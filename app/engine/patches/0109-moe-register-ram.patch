+// Brain Engine 0109: register host memory the brain's map already holds (read-only, for every card), so uploads from it
+// are asynchronous at the link's speed. Not behind GGML_CUDA_REGISTER_HOST (that is upstream's own, unused, switch).
+// 0: registered, 1: the driver had it registered already, -1: refused (the error is cleared).
+static int ggml_backend_cuda_host_register(void * ptr, size_t size) {
+#if CUDART_VERSION >= 11010 || defined(GGML_USE_MUSA) || defined(GGML_USE_HIP)
+    cudaError_t err = cudaHostRegister(ptr, size, cudaHostRegisterPortable | cudaHostRegisterReadOnly);
+    if (err == cudaErrorHostMemoryAlreadyRegistered) {
+        (void) cudaGetLastError();
+        return 1;
+    }
+    if (err != cudaSuccess) {
+        (void) cudaGetLastError();
+        GGML_LOG_WARN("%s: the driver refused to register %.2f MiB: %s\n", __func__, size/1048576.0, cudaGetErrorString(err));
+        return -1;
+    }
+    return 0;
+#else
+    GGML_UNUSED(ptr);
+    GGML_UNUSED(size);
+    return -1;
+#endif
+}
+
+static void ggml_backend_cuda_host_unregister(void * ptr) {
+    if (cudaHostUnregister(ptr) != cudaSuccess) {
+        (void) cudaGetLastError();
+    }
+}
