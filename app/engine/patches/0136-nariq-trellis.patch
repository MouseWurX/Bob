+    string_to_spv("trellis_mvq", "trellis_mvq.comp", {});
+#if defined(GGML_VULKAN_INTEGER_DOT_GLSLC_SUPPORT)
+    string_to_spv("trellis_mvq_idot", "trellis_mvq.comp", {{"TRELLIS_IDOT", "1"}});
