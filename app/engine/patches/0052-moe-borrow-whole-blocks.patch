-                return;
-            }
-            slot += bank->nb[2];
+            GGML_ASSERT(slot % ggml_type_size(bank->type) == 0); // 0052: a whole number of blocks for every kernel
         }
         // the banks were placed one after another from banks[0]; slot by slot they fill the same bytes
         device & d = devices[bw_dev];
@@ -3226,7 +3250,9 @@ struct llama_moe_cache::impl {
                 bytes += GGML_PAD(ggml_backend_buft_get_alloc_size(d.buft, t), align);
             }
         }
-        ggml_backend_buffer_t buf = ggml_backend_buft_alloc_buffer(d.buft, own + bytes + align);
+        const ggml_tensor * last_bank = groups[bw_g].banks.back();
+        const size_t pad = GGML_PAD(bw_slot_bytes().second, align); // 0052: room for the padded slots after the last bank
+        ggml_backend_buffer_t buf = ggml_backend_buft_alloc_buffer(d.buft, own + bytes + pad + align);
