+    // rows = every token this slot read, in order: {"t": the token's text, "e": [[expert ids] per layer]}.
+    // The first n_prompt rows are the prompt; the rest are the answer's own tokens being read back. The experts
+    // lit while reading a token are the ones that wrote the next one; "last" is the final token written (never read).
+    json expert_trace_end(server_slot & slot) {
+        json out = nullptr;
+        if (!slot.task->params.expert_trace || !etrace.on) {
+            return out;
+        }
+        llama_synchronize(ctx_tgt);
+        {
+            std::lock_guard<std::mutex> lock(etrace.mutex);
+            bool ok = !etrace.bad && etrace.n_used > 0;
+
+            int32_t n_layer_seen = 0;
+            int32_t n_output = 0;
+            for (const auto & tag : etrace.tags) {
+                n_output += tag.output ? 1 : 0;
+            }
+            // a layer saw every token, or (the last layer, which is only computed where an output is wanted)
+            // only the tokens with an output
+            std::vector<uint8_t> outputs_only(etrace.cols.size(), 0);
+            for (size_t il = 0; il < etrace.cols.size(); il++) {
+                if (etrace.n_cols[il] == 0) {
+                    continue; // a layer without a router
+                }
+                n_layer_seen++;
+                if (etrace.n_cols[il] == (int32_t) etrace.tags.size()) {
+                    continue;
+                }
+                outputs_only[il] = 1;
+                ok = ok && etrace.n_cols[il] == n_output;
+            }
+            if (ok && n_layer_seen > 0) {
+                const int32_t k = etrace.n_used;
+                json rows = json::array();
+                int32_t n_prompt = 0;
+                size_t i_output = 0; // index among the tokens with an output
+                for (size_t i = 0; i < etrace.tags.size(); i++) {
+                    const size_t i_out = i_output;
+                    i_output += etrace.tags[i].output ? 1 : 0;
+                    if (etrace.tags[i].id_slot != slot.id) {
+                        continue;
+                    }
+                    n_prompt += etrace.tags[i].is_prompt ? 1 : 0;
+                    json e = json::array();
+                    for (size_t il = 0; il < etrace.cols.size(); il++) {
+                        if (etrace.n_cols[il] == 0 || (outputs_only[il] && !etrace.tags[i].output)) {
+                            e.push_back(json::array());
+                            continue;
+                        }
+                        const auto b = etrace.cols[il].begin() + (outputs_only[il] ? i_out : i)*k;
+                        e.push_back(std::vector<int32_t>(b, b + k));
+                    }
+                    const llama_token tok = etrace.tags[i].token;
+                    rows.push_back(json {
+                        {"t", tok == LLAMA_TOKEN_NULL ? std::string() : common_token_to_piece(ctx_tgt, tok, true)},
+                        {"e", std::move(e)},
+                    });
+                }
+                const int32_t n_gen = slot.stats.n_gen;
+                out = json {
+                    {"n_layer",       (int32_t) etrace.cols.size()},
+                    {"n_expert",      llama_model_n_expert(model_tgt)},
+                    {"n_expert_used", k},
+                    {"n_prompt",      n_prompt},
+                    {"rows",          std::move(rows)},
+                    {"last",          n_gen > 0 && slot.sampled != LLAMA_TOKEN_NULL ? common_token_to_piece(ctx_tgt, slot.sampled, true) : std::string()},
+                };
+            }
+        }
+        if (!expert_trace_wanted(&slot)) {
+            llama_set_eval_callback(ctx_tgt, nullptr, nullptr);
+            std::lock_guard<std::mutex> lock(etrace.mutex);
+            etrace.on = false;
+            etrace.clear(0);
+        }
+        return out;
+    }
