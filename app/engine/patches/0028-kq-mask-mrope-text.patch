index 35a3089..632935e 100644
--- a/src/llama-graph.cpp
+++ b/src/llama-graph.cpp
@@ -57,9 +57,25 @@ static bool kq_mask_can_build(
         const llama_cparams & cparams,
         int64_t n_tps,
         int64_t ns) {
-    if (!(cparams.kq_mask_build || (cparams.kq_mask_pos && cparams.flash_attn)) || !cparams.causal_attn || ubatch.is_pos_2d()) {
+    if (!(cparams.kq_mask_build || (cparams.kq_mask_pos && cparams.flash_attn)) || !cparams.causal_attn) {
         return false;
     }
+    // Brain Engine 0028: M-RoPE brains (Qwen 3.5 / 3.6) always have 2-D positions, even for plain text. The stock
+    // table has one extra rule for them: a cell at the SAME position as a word is hidden when its picture place
+    // (y, x) is further along than the word's. Plain text gets the place [p, p], so when every word of this batch
+    // and every cell in the cache is [p, p], the rule never hides anything and the mask from positions is exact.
+    // Otherwise (a picture in the cache or the batch) keep the table.
+    if (ubatch.is_pos_2d()) {
+        if (mctx->get_has_ext_2d()) {
+            return false;
+        }
+        const uint32_t n = ubatch.n_tokens;
+        for (uint32_t i = 0; i < n; ++i) {
+            if (ubatch.pos[i + n] != ubatch.pos[i] || ubatch.pos[i + 2*n] != ubatch.pos[i]) {
+                return false;
+            }
+        }
+    }
     const llama_swa_type st = mctx->get_swa_type();
     if (st != LLAMA_SWA_TYPE_NONE && st != LLAMA_SWA_TYPE_STANDARD) {
         return false;
