+    // Brain Engine, streamed trace: the rows this slot read since the last piece, in the same form as the final trace's
+    // rows, with where they start ("from", counted in this slot's rows) and how many of all the rows so far are the
+    // prompt. Null when not asked for, or when the trace went bad (two requests at once, a failed decode).
+    json expert_trace_part(server_slot & slot) {
+        json out = nullptr;
+        if (!slot.task->params.expert_trace || !slot.task->params.expert_trace_stream || !slot.task->params.stream || !etrace.on) {
+            return out;
+        }
+        llama_synchronize(ctx_tgt);
+        std::lock_guard<std::mutex> lock(etrace.mutex);
+        if (etrace.bad || etrace.n_used <= 0 || etrace.sent_tag >= etrace.tags.size()) {
+            return out;
+        }
+        for (; etrace.seen_tag < etrace.tags.size(); etrace.seen_tag++) {
+            const auto & tag = etrace.tags[etrace.seen_tag];
+            etrace.seen_out    += tag.output ? 1 : 0;
+            etrace.seen_prompt += tag.id_slot == slot.id && tag.is_prompt ? 1 : 0;
+        }
+        const size_t n_output = etrace.seen_out;
+        // as at the end: a layer has seen every token so far, or (the last layer) only the tokens with an output
+        std::vector<uint8_t> outputs_only(etrace.cols.size(), 0);
+        for (size_t il = 0; il < etrace.cols.size(); il++) {
+            if (etrace.n_cols[il] == 0 || etrace.n_cols[il] == (int32_t) etrace.tags.size()) {
+                continue;
+            }
+            if (etrace.n_cols[il] != (int32_t) n_output) {
+                return out; // a layer is behind (still computing, or a shape we don't follow): wait for the next piece
+            }
+            outputs_only[il] = 1;
+        }
+        const int32_t k = etrace.n_used;
+        const bool with_acts = etrace.neurons || etrace.heads;
+        json rows = json::array();
+        const int32_t n_prompt = etrace.seen_prompt;
+        // the slot's new rows; when there are more than part_max_rows, skip the early ones (still counted in "from")
+        size_t n_new = 0;
+        for (size_t i = etrace.sent_tag; i < etrace.tags.size(); i++) {
+            n_new += etrace.tags[i].id_slot == slot.id ? 1 : 0;
+        }
+        const size_t n_skip = n_new > etrace.part_max_rows ? n_new - etrace.part_max_rows : 0;
+        size_t skipped = 0;
+        size_t i_output = etrace.sent_out;
+        for (size_t i = etrace.sent_tag; i < etrace.tags.size(); i++) {
+            const size_t i_out = i_output;
+            i_output += etrace.tags[i].output ? 1 : 0;
+            if (etrace.tags[i].id_slot != slot.id) {
+                continue;
+            }
+            if (skipped < n_skip) {
+                skipped++;
+                continue;
+            }
+            json e = json::array();
+            json a = json::array();
+            for (size_t il = 0; il < etrace.cols.size(); il++) {
+                if (etrace.n_cols[il] == 0 || (outputs_only[il] && !etrace.tags[i].output)) {
+                    e.push_back(json::array());
+                    if (with_acts) {
+                        a.push_back(0.0f);
+                    }
+                    continue;
+                }
+                const size_t at = outputs_only[il] ? i_out : i;
+                if ((at + 1)*k > etrace.cols[il].size()) {
+                    return out; // not there yet
+                }
+                const auto b = etrace.cols[il].begin() + at*k;
+                e.push_back(std::vector<int32_t>(b, b + k));
+                if (with_acts) {
+                    a.push_back(at < etrace.acts[il].size() ? etrace.acts[il][at] : 0.0f);
+                }
+            }
+            const llama_token tok = etrace.tags[i].token;
+            rows.push_back(json {
+                {"t", tok == LLAMA_TOKEN_NULL ? std::string() : common_token_to_piece(ctx_tgt, tok, true)},
+                {"e", std::move(e)},
+            });
+            if (with_acts) {
+                rows.back()["a"] = std::move(a);
+            }
+        }
+        out = json {
+            {"n_layer",       (int32_t) etrace.cols.size()},
+            {"kind",          etrace.heads ? "heads" : etrace.neurons ? "neurons" : "experts"},
+            {"n_expert",      etrace.neurons || etrace.heads ? etrace.n_group : llama_model_n_expert(model_tgt)},
+            {"n_ff",          etrace.n_ff},
+            {"n_expert_used", k},
+            {"n_prompt",      n_prompt},
+            {"from",          etrace.sent_rows + (int32_t) n_skip},
+            {"rows",          rows},
+        };
+        etrace.sent_rows += (int32_t) (n_skip + rows.size());
+        etrace.sent_tag   = etrace.tags.size();
+        etrace.sent_out   = i_output;
+        return out;
+    }
+
