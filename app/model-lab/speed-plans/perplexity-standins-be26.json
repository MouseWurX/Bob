{
 "name": "Stand-ins (0043) drift on Brain Engine 26: perplexity/KLD at 16K x 2 against the same engine with stand-ins off (q4_0 memory), plus look-ahead 1 as a lossless check",
 "method": "app/docs/test-results/2026-11-16-speed-test-method.md (addendum 80)",
 "brain": "${BRAIN}",
 "engines": {
  "be26": {
   "exe": "${BE26_PERPLEXITY}"
  }
 },
 "text": "long-text.md",
 "baseArgs": [
  "-fa",
  "on",
  "--fit",
  "on"
 ],
 "lock": "${LOCK}",
 "stopFile": "${STOP_FILE}",
 "rowTimeoutMs": 2700000,
 "groups": [
  {
   "id": "strata-16K",
   "about": "f16 base vs q8_0, q4_0, q3_0 and Progressive A (3-step), C (2-step), D (8+3) with windows a quarter of the 32K design so they engage at 16K (Addendum 71, rerun note)",
   "ctx": 16384,
   "chunks": 2,
   "needDiskGB": 12,
   "base": {
    "id": "q4_0-off",
    "engine": "be26",
    "args": [
     "-b",
     "2048",
     "-ub",
     "2048",
     "--moe-cache-mib",
     "4096",
     "--moe-cache-cpu-share",
     "0",
     "-ctk",
     "q4_0",
     "-ctv",
     "q4_0"
    ]
   },
   "rows": [
    {
     "id": "standin-rank-max1",
     "engine": "be26",
     "args": [
      "-b",
      "2048",
      "-ub",
      "2048",
      "--moe-cache-mib",
      "4096",
      "--moe-cache-cpu-share",
      "0",
      "-ctk",
      "q4_0",
      "-ctv",
      "q4_0"
     ],
     "env": {
      "LLAMA_MOE_STANDIN": "rank",
      "LLAMA_MOE_STANDIN_MAX": "1"
     }
    },
    {
     "id": "standin-rank-max2",
     "engine": "be26",
     "args": [
      "-b",
      "2048",
      "-ub",
      "2048",
      "--moe-cache-mib",
      "4096",
      "--moe-cache-cpu-share",
      "0",
      "-ctk",
      "q4_0",
      "-ctv",
      "q4_0"
     ],
     "env": {
      "LLAMA_MOE_STANDIN": "rank",
      "LLAMA_MOE_STANDIN_MAX": "2"
     }
    },
    {
     "id": "lookahead1",
     "engine": "be26",
     "args": [
      "-b",
      "2048",
      "-ub",
      "2048",
      "--moe-cache-mib",
      "4096",
      "--moe-cache-cpu-share",
      "0",
      "-ctk",
      "q4_0",
      "-ctv",
      "q4_0"
     ],
     "env": {
      "LLAMA_MOE_LOOKAHEAD": "1"
     }
    }
   ]
  }
 ]
}