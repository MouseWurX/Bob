{
 "name": "Turbo (MTP): stock Qwen3.6 35B A3B, the copy that keeps its MTP layers (unsloth Qwen3.6-35B-A3B-MTP-GGUF, UD-Q4_K_XL), 16 GB card",
 "method": "app/docs/test-results/2026-11-16-speed-test-method.md (addenda 8, 10 and 11)",
 "brain": "${BRAIN_MTP}",
 "engines": {
  "be9": {
   "exe": "${BE9_SERVER}"
  }
 },
 "prompts": {
  "start": "start.json",
  "k16": "long-text.md",
  "k32": "long-text.md"
 },
 "promptTokens": {
  "k16": 16384,
  "k32": 32768
 },
 "question": {
  "k16": "\n\nIn two sentences, what is this text about?",
  "k32": "\n\nIn two sentences, what is this text about?"
 },
 "baseArgs": [
  "--jinja",
  "-fa",
  "on",
  "-ctk",
  "q8_0",
  "-ctv",
  "q8_0",
  "--fit",
  "on",
  "-np",
  "1",
  "--cache-reuse",
  "256",
  "-c",
  "49152",
  "--no-webui"
 ],
 "maxTokens": 300,
 "rounds": 5,
 "lock": "${LOCK}",
 "stopFile": "${STOP_FILE}",
 "loadTimeoutMs": 600000,
 "rows": [
  {
   "id": "T0",
   "engine": "be9",
   "prompts": [
    "start",
    "k16",
    "k32"
   ]
  },
  {
   "id": "T2",
   "engine": "be9",
   "prompts": [
    "start",
    "k16",
    "k32"
   ],
   "args": [
    "--spec-type",
    "draft-mtp",
    "--spec-draft-n-max",
    "2"
   ]
  },
  {
   "id": "T3",
   "engine": "be9",
   "prompts": [
    "start",
    "k16",
    "k32"
   ],
   "args": [
    "--spec-type",
    "draft-mtp",
    "--spec-draft-n-max",
    "3"
   ]
  },
  {
   "id": "T0S",
   "engine": "be9",
   "prompts": [
    "start",
    "k16",
    "k32"
   ],
   "body": {
    "temperature": 0.7,
    "top_p": 0.8,
    "top_k": 20,
    "min_p": 0,
    "presence_penalty": 1.5,
    "repeat_penalty": 1.0
   }
  },
  {
   "id": "T3S",
   "engine": "be9",
   "prompts": [
    "start",
    "k16",
    "k32"
   ],
   "args": [
    "--spec-type",
    "draft-mtp",
    "--spec-draft-n-max",
    "3"
   ],
   "body": {
    "temperature": 0.7,
    "top_p": 0.8,
    "top_k": 20,
    "min_p": 0,
    "presence_penalty": 1.5,
    "repeat_penalty": 1.0
   }
  }
 ]
}
