+//
+// llama_adapter_dials
+//
+
+// Brain Engine dials: per-layer multipliers for single experts, single attention heads, a layer's attention and a
+// layer's feed-forward block. A tensor is only handed to the graph for the layers and kinds that have a dial set.
+struct llama_adapter_dials {
+    ggml_tensor * expert_for(int il) const { return get(expert, on_expert, il); } // [1, n_expert, 1]
+    ggml_tensor * head_for  (int il) const { return get(head,   on_head,   il); } // [1, n_head, 1]
+    ggml_tensor * attn_for  (int il) const { return get(attn,   on_attn,   il); } // [1]
+    ggml_tensor * ffn_for   (int il) const { return get(ffn,    on_ffn,    il); } // [1]
+
+    bool apply(const llama_model & model, const struct llama_dial * dials, size_t n);
+
+private:
+    bool init(const llama_model & model);
+
+    static ggml_tensor * get(const std::vector<ggml_tensor *> & t, const std::vector<uint8_t> & on, int il) {
+        return il >= 0 && (size_t) il < t.size() && (size_t) il < on.size() && on[il] ? t[il] : nullptr;
+    }
+
+    std::vector<ggml_context_ptr> ctxs;
+    std::vector<ggml_backend_buffer_ptr> bufs;
+
+    std::vector<ggml_tensor *> expert, head, attn, ffn; // per layer
+    std::vector<uint8_t> on_expert, on_head, on_attn, on_ffn;
+};
+
+using llama_adapter_dials_ptr = std::shared_ptr<llama_adapter_dials>;
