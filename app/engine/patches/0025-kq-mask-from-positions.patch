+// cases: causal, no ALiBi (kq_mask_build is off for ALiBi brains), no 2-D (vision) positions, no or standard sliding
+// window, and one chat per stream with every word in one chat. Everything else keeps the processor-filled table.
+static bool kq_mask_can_build(
+        const llama_kv_cache_context * mctx,
+        const llama_ubatch & ubatch,
+        const llama_cparams & cparams,
+        int64_t n_tps,
