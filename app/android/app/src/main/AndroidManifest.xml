<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Talking to Bobs on your network (Tailscale) and downloading the phone brain. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Only asked for when you tap the microphone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Only asked for when Bob first wants to tell you something (a finished job, an OK card). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Only while "Lend my brain" is on: the notification that keeps the door open, and keeping the phone awake
         while it thinks one reply for another Bob. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".BobApp"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Bob">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Share to Bob (2026-11-11): Bob in other apps' Share menu. Off to start with (enabled="false"); Settings,
             "Take shares from other apps" switches this door on and off. Shared things land in the message box and
             wait for your Send. -->
        <activity-alias
            android:name=".ShareToBob"
            android:enabled="false"
            android:exported="true"
            android:label="@string/share_label"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/json" />
            </intent-filter>
        </activity-alias>
        <!-- The home-screen widget (AskWidget.kt): only there if you put it on your home screen. -->
        <receiver
            android:name=".AskWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_ask_info" />
        </receiver>
        <service
            android:name=".LendService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Answers chat requests from the owner's own Bob apps over their private Tailscale network, only while the owner has Lend my brain switched on." />
        </service>
    </application>
</manifest>
