+            lf_next[s] = -1;
+            if (lf_tail[g] >= 0) { lf_next[lf_tail[g]] = s; } else { lf_head[g] = s; }
+            lf_tail[g] = s;
+        } else {
+            lf_prev[s] = -1;
+            lf_next[s] = lf_head[g];
+            if (lf_head[g] >= 0) { lf_prev[lf_head[g]] = s; } else { lf_tail[g] = s; }
+            lf_head[g] = s;
+        }
+        lf_n[g]++;
+    }
+    // slot s was just used (move): a new expert comes in on probation, a second use moves it to the protected segment
+    void lf_touch(int32_t s) {
