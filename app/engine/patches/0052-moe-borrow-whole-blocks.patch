     bool bw_striped = false;
     std::vector<std::pair<ggml_tensor *, std::array<size_t, 2>>> bw_native; // banks and their views, nb[2] and nb[3]
 
+    // Brain Engine 0052: the bytes of one striped slot (0 = no striping), and the bytes the padding adds after the
+    // group's last bank. The CUDA matrix kernels take a bank's expert stride in blocks of its own type (nb[2]/type
+    // size), so the slot must be a whole number of blocks of every bank's type: a brain with Q4_K gates and Q6_K downs
+    // (144 and 210 byte blocks) otherwise reads every expert but the first from the wrong place. Padded up to the
+    // least common multiple; if that wastes more than an eighth, the first bank alone is lent (the 0048 layout).
+    std::pair<size_t, size_t> bw_slot_bytes() const {
+        if (bw_g < 0 || getenv("LLAMA_MOE_CACHE_BORROW_FIRST_BANK") != nullptr) {
+            return { 0, 0 };
+        }
+        const group & g = groups[bw_g];
+        size_t slot = 0, unit = 256;
+        for (const ggml_tensor * bank : g.banks) {
+            if (bank->nb[2] % 256 != 0) {
+                LLAMA_LOG_WARN("llama_moe_cache: borrowed reading lends the first bank only: a slot of %zu bytes is not a multiple of 256\n", (size_t) bank->nb[2]);
+                return { 0, 0 };
+            }
+            slot += bank->nb[2];
+            unit = std::lcm(unit, ggml_type_size(bank->type));
+        }
+        const size_t padded = (slot + unit - 1)/unit*unit; // unit is not a power of two (GGML_PAD needs one)
+        if ((padded - slot)*8 > slot) {
+            LLAMA_LOG_WARN("llama_moe_cache: borrowed reading lends the first bank only: a slot laid out slot by slot would need %zu bytes of padding on %zu\n", padded - slot, slot);
+            return { 0, 0 };
+        }
+        return { padded, (padded - slot)*(size_t) g.n_slots };
+    }
+
     void bw_unstripe() {
