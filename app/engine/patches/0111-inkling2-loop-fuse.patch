+                l.ctrl_forget[LOOP_CTRL_K], l.ctrl_gain[LOOP_CTRL_V], l.ctrl_forget[LOOP_CTRL_V] },
+                { rank, 2*n_embd, 3 }, pre + "loop_ctrl_gf_qkv");
+        if (!l.ctrl_down_qkv || !l.ctrl_gf_qkv || !(fuse_loop & 2)) {
