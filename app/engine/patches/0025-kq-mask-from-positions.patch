+    if (st != LLAMA_SWA_TYPE_NONE && st != LLAMA_SWA_TYPE_STANDARD) {
+        return false;
+    }
+    if (n_tps*ns != (int64_t) ubatch.n_tokens) {
+        return false;
+    }
+    for (int64_t s = 0; s < ns; ++s) {
+        const llama_seq_id seq_id = ubatch.seq_id[s*n_tps][0];
