{
 "brain": "${BRAIN}",
 "prompts": {
  "start": "start.json",
  "k60": "long-text.md"
 },
 "promptTokens": {
  "k60": 61440
 },
 "question": {
  "k60": "\n\nIn two sentences, what is this text about?"
 },
 "promptRepeat": {
  "k60": 2
 },
 "lock": "${LOCK}",
 "stopFile": "${STOP_FILE}",
 "loadTimeoutMs": 900000,
 "spillCheck": true,
 "spillMB": 512,
 "spillMinusStep": true,
 "name": "Where a long read's time goes on Brain Engine 32 (Addendum 95): a 60K read with patch 0029's split timing on (GGML_SCHED_TIMING=4), card compute against weights copied per reading step, at fixed -ub 4096 (4 GB cache), fixed -ub 8192 (2,296 MiB cache, the size that fit on BE29) and borrowing at -b 16384 -ub 4096 (4 GB cache), q4_0, share 0, 2 rounds, cool-down on",
 "method": "app/docs/test-results/2026-11-16-speed-test-method.md (addendum 95)",
 "engines": {
  "be32": {
   "exe": "${BE32_SERVER}"
  }
 },
 "baseArgs": [
  "--jinja",
  "-np",
  "1",
  "--no-webui",
  "-fa",
  "on",
  "--cache-reuse",
  "256"
 ],
 "maxTokens": 300,
 "rounds": 2,
 "saveText": true,
 "rows": [
  {
   "id": "fixed-ub4096",
   "engine": "be32",
   "prompts": [
    "start",
    "k60"
   ],
   "args": [
    "-c",
    "81920",
    "--moe-cache-cpu-share",
    "0",
    "-ctk",
    "q4_0",
    "-ctv",
    "q4_0",
    "--fit",
    "on",
    "--fit-target",
    "512",
    "--moe-cache-mib",
    "4096",
    "-b",
    "16384",
    "-ub",
    "4096"
   ],
   "env": {
    "GGML_CUDA_NO_PINNED": "1",
    "LLAMA_MOE_CACHE_LOG_EVERY": "4000",
    "GGML_SCHED_TIMING": "4"
   }
  },
  {
   "id": "fixed-ub8192",
   "engine": "be32",
   "prompts": [
    "start",
    "k60"
   ],
   "args": [
    "-c",
    "81920",
    "--moe-cache-cpu-share",
    "0",
    "-ctk",
    "q4_0",
    "-ctv",
    "q4_0",
    "--fit",
    "on",
    "--fit-target",
    "512",
    "--moe-cache-mib",
    "2296",
    "-b",
    "8192",
    "-ub",
    "8192"
   ],
   "env": {
    "GGML_CUDA_NO_PINNED": "1",
    "LLAMA_MOE_CACHE_LOG_EVERY": "4000",
    "GGML_SCHED_TIMING": "4"
   }
  },
  {
   "id": "borrow",
   "engine": "be32",
   "prompts": [
    "start",
    "k60"
   ],
   "args": [
    "-c",
    "81920",
    "--moe-cache-cpu-share",
    "0",
    "-ctk",
    "q4_0",
    "-ctv",
    "q4_0",
    "--fit",
    "on",
    "--fit-target",
    "512",
    "--moe-cache-mib",
    "4096",
    "-b",
    "16384",
    "-ub",
    "4096"
   ],
   "env": {
    "GGML_CUDA_NO_PINNED": "1",
    "LLAMA_MOE_CACHE_LOG_EVERY": "4000",
    "GGML_SCHED_TIMING": "4",
    "LLAMA_MOE_CACHE_BORROW": "1"
   }
  }
 ]
}
