+// Brain Engine 0025: replace attn_mask.raw by a table made in the graph. For a block of query rows at a time:
+//   d       = cell position - query position                       (repeat + sub)
+//   allowed = step(0.5 - d)              (cell not later: causal)  (scale_bias + step)
+//           * step(d + n_swa - 0.5)      (inside the window: SWA)  (scale_bias + step + mul, standard SWA only)
+//   row     = log(allowed)               = 0 or -inf, the values the processor writes
+// then written into the table with set_rows (which also turns f32 into the f16 flash attention reads). Positions are
+// whole numbers below 2^24, exact in f32; hidden cells get 1e9 so the causal test hides them. A block is at most
+// 64 MiB of f32 unless that needs more than 64 blocks.
+static void build_attn_inp_attn_mask_made(
+        ggml_context * ctx,
+        const llama_kv_cache_context * mctx,
+        llm_attn_mask & attn_mask) {
+    ggml_tensor * tmpl = attn_mask.raw;
+
+    const int64_t n_kv  = tmpl->ne[0];
+    const int64_t n_tps = tmpl->ne[1];
+    const int64_t ns    = tmpl->ne[3];
+    GGML_ASSERT(tmpl->ne[2] == 1);
+
+    attn_mask.kv_pos = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, n_kv, 1, 1, ns);
+    ggml_set_input(attn_mask.kv_pos);
+    ggml_set_name(attn_mask.kv_pos, "attn_inp_kq_mask_kv_pos");
+
+    attn_mask.q_pos = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, 1, n_tps, 1, ns);
+    ggml_set_input(attn_mask.q_pos);
+    ggml_set_name(attn_mask.q_pos, "attn_inp_kq_mask_q_pos");
+
+    attn_mask.q_rows = ggml_new_tensor_1d(ctx, GGML_TYPE_I64, n_tps);
+    ggml_set_input(attn_mask.q_rows);
+    ggml_set_name(attn_mask.q_rows, "attn_inp_kq_mask_rows");
+
+    // the table itself: not an input any more, every row is written below
+    tmpl->flags &= ~GGML_TENSOR_FLAG_INPUT;
+    ggml_set_name(tmpl, "attn_kq_mask_made");
+    attn_mask.made.push_back(tmpl);
+
+    const llama_swa_type st    = mctx->get_swa_type();
+    const float          n_swa = (float) mctx->get_n_swa();
+
+    const int64_t blk_mem = std::max<int64_t>(1, (int64_t) (64u*1024*1024) / (n_kv*ns*(int64_t) sizeof(float)));
+    const int64_t blk     = std::min<int64_t>(n_tps, std::max<int64_t>(blk_mem, (n_tps + 63)/64));
+
+    ggml_tensor * cur = tmpl;
+    for (int64_t r0 = 0; r0 < n_tps; r0 += blk) {
+        const int64_t nr = std::min<int64_t>(blk, n_tps - r0);
+
+        ggml_tensor * q = ggml_view_4d(ctx, attn_mask.q_pos, 1, nr, 1, ns,
+                attn_mask.q_pos->nb[1], attn_mask.q_pos->nb[2], attn_mask.q_pos->nb[3], r0*attn_mask.q_pos->nb[1]);
+        if (ns > 1) {
+            q = ggml_cont(ctx, q);
+            attn_mask.made.push_back(q);
+        }
+
+        ggml_tensor * d = ggml_repeat_4d(ctx, attn_mask.kv_pos, n_kv, nr, 1, ns);
+        attn_mask.made.push_back(d);
+        d = ggml_sub_inplace(ctx, d, q);
+        attn_mask.made.push_back(d);
+
+        ggml_tensor * a = ggml_scale_bias(ctx, d, -1.0f, 0.5f);
+        attn_mask.made.push_back(a);
+        a = ggml_step_inplace(ctx, a);
+        attn_mask.made.push_back(a);
+
+        if (st == LLAMA_SWA_TYPE_STANDARD) {
+            ggml_tensor * w = ggml_scale_bias(ctx, d, 1.0f, n_swa - 0.5f);
+            attn_mask.made.push_back(w);
+            w = ggml_step_inplace(ctx, w);
+            attn_mask.made.push_back(w);
+            a = ggml_mul_inplace(ctx, a, w);
+            attn_mask.made.push_back(a);
+        }
+
+        a = ggml_log_inplace(ctx, a);
+        attn_mask.made.push_back(a);
+
+        ggml_tensor * idx = ggml_view_1d(ctx, attn_mask.q_rows, nr, r0*ggml_element_size(attn_mask.q_rows));
+
+        cur = ggml_set_rows(ctx, cur, a, idx);
+        attn_mask.made.push_back(cur);
+    }
+
+    ggml_set_name(cur, "attn_kq_mask");
+    attn_mask.raw = cur;
+
+    LLAMA_LOG_DEBUG("%s: attention mask made in the graph: %lld cells x %lld words x %lld streams, %lld rows a block\n",
+            __func__, (long long) n_kv, (long long) n_tps, (long long) ns, (long long) blk);
+}
