{
 "name": "Conductor switch cost at 128K on Brain Engine 21: save the chat, live POST /context step change with the brain kept loaded (fixed placement), restore, against a fresh start, 3 repeats",
 "method": "app/docs/test-results/2026-11-16-speed-test-method.md (addendum 66)",
 "exe": "${BE21_SERVER}",
 "brain": "${BRAIN}",
 "baseArgs": [
  "--jinja",
  "-np",
  "1",
  "--no-webui",
  "-fa",
  "on",
  "-c",
  "139264",
  "-b",
  "5120",
  "-ub",
  "5120",
  "--fit",
  "off",
  "-ngl",
  "99",
  "--n-cpu-moe",
  "${NCMOE_128K}",
  "--moe-cache-mib",
  "4096",
  "--moe-cache-cpu-share",
  "0",
  "-ctk",
  "q4_0",
  "-ctv",
  "q4_0",
  "--slot-save-path",
  "${SLOT_DIR}",
  "-lv",
  "4"
 ],
 "env": {
  "GGML_CUDA_NO_PINNED": "1",
  "LLAMA_MOE_CACHE_LOG_EVERY": "4000"
 },
 "prompt": {
  "file": "long-text.md",
  "tokens": 122880,
  "repeat": 4
 },
 "followUp": "\n\nIn two sentences, what is this text about?",
 "maxTokens": 64,
 "repeats": 3,
 "lock": "${LOCK}",
 "stopFile": "${STOP_FILE}",
 "loadTimeoutMs": 1200000,
 "switches": [
  {
   "id": "step-5120-to-4096",
   "from": {
    "n_batch": 5120,
    "n_ubatch": 5120,
    "cache_type_k": "q4_0",
    "cache_type_v": "q4_0",
    "moe_cache_cpu_share": 0,
    "engine_keys": {
     "LLAMA_MOE_CACHE_LEARN": null,
     "LLAMA_MOE_CACHE_LEARN_MARGIN": null,
     "LLAMA_MOE_CACHE_LEND": null
    }
   },
   "to": {
    "n_batch": 4096,
    "n_ubatch": 4096
   }
  },
  {
   "id": "step-4096-to-5120",
   "from": {
    "n_batch": 4096,
    "n_ubatch": 4096,
    "cache_type_k": "q4_0",
    "cache_type_v": "q4_0",
    "moe_cache_cpu_share": 0,
    "engine_keys": {
     "LLAMA_MOE_CACHE_LEARN": null,
     "LLAMA_MOE_CACHE_LEARN_MARGIN": null,
     "LLAMA_MOE_CACHE_LEND": null
    }
   },
   "to": {
    "n_batch": 5120,
    "n_ubatch": 5120
   }
  }
 ]
}