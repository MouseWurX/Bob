+// Brain Engine 0046: values iqs and iqs + 1 of a q2_kv block, (2c - 3) times d/2 (as dequantize_row_q2_kv)
+static __device__ __forceinline__ void dequantize_q2_kv(const void * vx, const int64_t ib, const int iqs, float2 & v){
+    const block_q2_kv * x = (const block_q2_kv *) vx;
