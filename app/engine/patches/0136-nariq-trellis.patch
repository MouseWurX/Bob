+        }
+        const std::vector<int32_t> desc = trellis_desc(rows, cols, p);
+        ggml_tensor * out = ggml_trellis_mul_mat(ctx, w, x, s16, pre, post, pin, pout, desc.data(), (int) desc.size());
+        ggml_set_name(out, "out");
