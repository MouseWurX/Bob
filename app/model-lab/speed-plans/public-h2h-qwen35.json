{
 "name": "Public head to head, stock Qwen3.6 35B A3B on a 16 GB card: plain llama.cpp b12359 (its defaults, -b 2048 -ub 512, and steps 4096 and 6144) against Brain Engine 14 (no cache, chat pick, work pick, step 6144 + 3.5 GB), 5 rounds, Claude and Bob closed",
 "method": "app/docs/test-results/2026-11-16-speed-test-method.md (addendum 28)",
 "brain": "${BRAIN}",
 "engines": {
  "plain": {
   "exe": "${PLAIN_SERVER}"
  },
  "be14": {
   "exe": "${BE14_SERVER}"
  }
 },
 "prompts": {
  "start": "start.json",
  "k16": "long-text.md",
  "k32": "long-text.md"
 },
 "promptTokens": {
