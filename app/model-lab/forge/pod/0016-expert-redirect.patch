index 0000000..dee1e9c
--- /dev/null
+++ b/tools/expert-pair/expert-pair.cpp
@@ -0,0 +1,187 @@
+// Brain Engine lab tool (pod patch 0016): how alike the experts of each layer are, judged by what they put out on the same
+// words. Every expert of every layer is run on every token of the prompts (experts per word = all of them, the mask off),
+// and for each token the cosine between each pair of experts' outputs is added up. Written per layer as
+// <out>/sim-<il>.f32 (n_expert x n_expert, the mean cosine over the tokens) with <out>/info.json. expert-redirect.mjs turns it
+// into the pairs for the live redirect (each expert that is off goes to its most alike kept one). Read only.
+//   llama-expert-pair -m brain.gguf --pair-prompts prompts.txt --pair-out dir [--pair-max 256] [-ub 16] [llama args]
+#include "arg.h"
+#include "common.h"
+#include "llama.h"
+#include "ggml.h"
+#include "ggml-cpu.h"
+#include "ggml-backend.h"
+
+#include <cmath>
+#include <cstdio>
+#include <algorithm>
+#include <cstring>
+#include <fstream>
+#include <string>
+#include <thread>
+#include <vector>
+
+struct pair_cb {
+    int n_layer = 0, n_expert = 0, n_threads = 4;
+    std::vector<std::vector<int32_t>> ids;  // per layer: the last top-k picks [n_tok x n_used]
+    std::vector<int> ids_used;               // per layer: n_used of those picks
+    std::vector<std::vector<double>> sum;   // per layer: n_expert x n_expert
+    std::vector<long> count;                // per layer: tokens added
+    std::vector<float> buf;
+    long skipped = 0;
+};
+
+static int layer_of(const char * name, const char * prefix) {
+    const size_t n = strlen(prefix);
+    if (strncmp(name, prefix, n) != 0 || name[n] != '-') return -1;
+    return atoi(name + n + 1);
+}
+
+static bool cb_eval(struct ggml_tensor * t, bool ask, void * user_data) {
+    auto * cb = (pair_cb *) user_data;
+    const int il_k = layer_of(t->name, "ffn_moe_topk");
+    const int il_d = layer_of(t->name, "ffn_moe_down");
+    if (ask) return il_k >= 0 || il_d >= 0;
+    if (il_k >= 0 && il_k < cb->n_layer && t->type == GGML_TYPE_I32) {
+        const size_t n = ggml_nelements(t);
+        cb->ids[il_k].resize(n);
+        if (ggml_is_contiguous(t)) {
+            ggml_backend_tensor_get(t, cb->ids[il_k].data(), 0, n * sizeof(int32_t));
+        } else {
+            for (int64_t r = 0; r < t->ne[1]; r++) ggml_backend_tensor_get(t, cb->ids[il_k].data() + r * t->ne[0], r * t->nb[1], t->ne[0] * sizeof(int32_t));
+        }
+        cb->ids_used[il_k] = (int) t->ne[0];
+        return true;
+    }
+    if (il_d < 0 || il_d >= cb->n_layer || t->type != GGML_TYPE_F32 || !ggml_is_contiguous(t)) return true;
+    const int64_t n_embd = t->ne[0], n_used = t->ne[1], n_tok = t->ne[2];
+    if (n_tok < 1) return true; // the last layer runs only the words that give an output: a part of a prompt before its end has none there
+    if (n_used != cb->n_expert || cb->ids_used[il_d] != n_used || (int64_t) cb->ids[il_d].size() != n_used * n_tok) { cb->skipped++; return true; }
+    cb->buf.resize(ggml_nelements(t));
+    ggml_backend_tensor_get(t, cb->buf.data(), 0, cb->buf.size() * sizeof(float));
+    // unit length, so the dot product is the cosine (an expert that puts out nothing stays 0)
+    for (int64_t r = 0; r < n_used * n_tok; r++) {
+        float * v = cb->buf.data() + r * n_embd; double s = 0;
+        for (int64_t i = 0; i < n_embd; i++) s += (double) v[i] * v[i];
+        const float k = s > 0 ? (float) (1.0 / std::sqrt(s)) : 0.0f;
+        for (int64_t i = 0; i < n_embd; i++) v[i] *= k;
+    }
+    // G = U^T U for each token on the CPU (ggml's own threaded matmul)
+    const size_t mem = (size_t) (n_used * n_used * n_tok + n_embd * n_used * n_tok) * sizeof(float) + 16 * ggml_tensor_overhead() + ggml_graph_overhead() + (1 << 20);
+    ggml_init_params ip = { mem, nullptr, false };
+    ggml_context * gc = ggml_init(ip);
+    ggml_tensor * u = ggml_new_tensor_3d(gc, GGML_TYPE_F32, n_embd, n_used, n_tok);
+    memcpy(u->data, cb->buf.data(), cb->buf.size() * sizeof(float));
+    ggml_tensor * g = ggml_mul_mat(gc, u, u); // [n_used, n_used, n_tok]
+    ggml_cgraph * gf = ggml_new_graph(gc);
+    ggml_build_forward_expand(gf, g);
+    ggml_graph_compute_with_ctx(gc, gf, cb->n_threads);
+    const float * G = (const float *) g->data;
+    auto & S = cb->sum[il_d];
+    const int32_t * id = cb->ids[il_d].data();
+    const int E = cb->n_expert;
+    for (int64_t tk = 0; tk < n_tok; tk++) {
+        const int32_t * row = id + tk * n_used;
+        const float * Gt = G + tk * n_used * n_used;
+        for (int64_t a = 0; a < n_used; a++) for (int64_t b = 0; b < n_used; b++) S[(size_t) row[a] * E + row[b]] += Gt[a + b * n_used];
+    }
+    cb->count[il_d] += n_tok;
+    ggml_free(gc);
+    return true;
+}
+
+int main(int argc, char ** argv) {
+    std::string prompts_file, out_dir;
+    int max_tokens = 256;
+    std::vector<char *> rest = { argv[0] };
+    for (int i = 1; i < argc; i++) {
+        std::string a = argv[i];
+        if (a == "--pair-prompts" && i + 1 < argc) prompts_file = argv[++i];
+        else if (a == "--pair-out" && i + 1 < argc) out_dir = argv[++i];
+        else if (a == "--pair-max" && i + 1 < argc) max_tokens = atoi(argv[++i]);
+        else rest.push_back(argv[i]);
+    }
+    if (prompts_file.empty() || out_dir.empty()) {
+        fprintf(stderr, "usage: %s -m brain.gguf --pair-prompts file --pair-out dir [--pair-max 256] [-ub 16]\n", argv[0]);
+        return 1;
+    }
+    common_params params;
+    common_init();
+    if (!common_params_parse((int) rest.size(), rest.data(), params, LLAMA_EXAMPLE_COMMON)) return 1;
+    pair_cb cb;
+    params.cb_eval = cb_eval;
+    params.cb_eval_user_data = &cb;
+    params.warmup = false;
+    if (params.n_batch < max_tokens) params.n_batch = max_tokens;
+    if (params.n_ctx < max_tokens) params.n_ctx = max_tokens;
+    cb.n_threads = std::max(1, (int) std::thread::hardware_concurrency());
+
+    llama_backend_init();
+    auto init = common_init_from_params(params);
+    auto * model = init->model();
+    auto * ctx   = init->context();
+    if (!model || !ctx) { fprintf(stderr, "could not load the brain\n"); return 1; }
+    cb.n_layer = llama_model_n_layer(model);
+    cb.n_expert = llama_model_n_expert(model);
+    if (cb.n_expert <= 0) { fprintf(stderr, "the brain has no experts\n"); return 1; }
+    cb.ids.resize(cb.n_layer); cb.ids_used.assign(cb.n_layer, 0); cb.count.assign(cb.n_layer, 0);
+    cb.sum.assign(cb.n_layer, std::vector<double>((size_t) cb.n_expert * cb.n_expert, 0.0));
+    // every expert on every word
+    std::vector<int32_t> all(cb.n_layer, cb.n_expert);
+    const int32_t r = llama_set_expert_used(ctx, all.data(), all.size());
+    if (r != 0) { fprintf(stderr, "could not run all %d experts per word (code %d); try a smaller -ub\n", cb.n_expert, r); return 1; }
+
+    // 23 Nov 2026: every prompt gets an even share of --pair-max (the first run spent it all on the first 50 of 129 asks),
+    // and every word asks for an output, so the last layer (which runs only the words that give one) is measured on all of them
+    std::ifstream in(prompts_file);
+    std::vector<std::string> texts; std::string line;
+    while (std::getline(in, line)) {
+        if (!line.empty() && line.back() == '\r') line.pop_back();
+        if (line.empty()) continue;
+        std::string text; for (size_t i = 0; i < line.size(); i++) { if (line[i] == '\\' && i + 1 < line.size() && line[i + 1] == 'n') { text += '\n'; i++; } else text += line[i]; }
+        texts.push_back(text);
+    }
+    if (texts.empty()) { fprintf(stderr, "no prompts in %s\n", prompts_file.c_str()); return 1; }
+    // what was measured so far goes to disk now and then (and info.json says "done": false), so a run cut off by the
+    // time limit still leaves pairs to use
+    auto save = [&](int p, size_t total, bool done) -> int {
+        int ok = 0;
+        for (int il = 0; il < cb.n_layer; il++) {
+            if (!cb.count[il]) continue;
+            std::vector<float> m((size_t) cb.n_expert * cb.n_expert);
+            for (size_t i = 0; i < m.size(); i++) m[i] = (float) (cb.sum[il][i] / cb.count[il]);
+            FILE * f = fopen((out_dir + "/sim-" + std::to_string(il) + ".f32").c_str(), "wb");
+            if (!f) { fprintf(stderr, "could not write to %s\n", out_dir.c_str()); return -1; }
+            fwrite(m.data(), sizeof(float), m.size(), f); fclose(f); ok++;
+        }
+        const std::string tmp = out_dir + "/info.json.part";
+        FILE * info = fopen(tmp.c_str(), "wb");
+        if (!info) { fprintf(stderr, "could not write to %s\n", out_dir.c_str()); return -1; }
+        fprintf(info, "{\"n_layer\":%d,\"n_expert\":%d,\"layers\":[", cb.n_layer, cb.n_expert);
+        for (int il = 0, k = 0; il < cb.n_layer; il++) if (cb.count[il]) fprintf(info, "%s%d", k++ ? "," : "", il);
+        fprintf(info, "],\"prompts\":%d,\"prompts_in_file\":%zu,\"tokens\":%zu,\"skipped\":%ld,\"done\":%s,\"measure\":\"mean cosine of the two experts' outputs on the same token\"}\n", p, texts.size(), total, cb.skipped, done ? "true" : "false");
+        fclose(info);
+        std::rename(tmp.c_str(), (out_dir + "/info.json").c_str());
+        return ok;
+    };
+    const int per = std::max(8, max_tokens / (int) texts.size());
+    int p = 0; size_t total = 0;
+    for (const auto & text : texts) {
+        if ((int) total >= max_tokens) break;
+        std::vector<llama_token> toks = common_tokenize(ctx, text, true, true);
+        const int n = std::min({ (int) toks.size(), per, max_tokens - (int) total });
+        if (n <= 0) continue;
+        llama_memory_clear(llama_get_memory(ctx), true);
+        llama_batch batch = llama_batch_init(n, 0, 1);
+        for (int i = 0; i < n; i++) { batch.token[i] = toks[i]; batch.pos[i] = i; batch.n_seq_id[i] = 1; batch.seq_id[i][0] = 0; batch.logits[i] = 1; }
+        batch.n_tokens = n;
+        const int rc = llama_decode(ctx, batch);
+        llama_batch_free(batch);
+        if (rc) { fprintf(stderr, "prompt %d failed to run (code %d)\n", p, rc); return 1; }
+        total += n; p++;
+        if (p % 16 == 0) { fprintf(stderr, "expert-pair: %d of %zu prompts, %zu tokens\n", p, texts.size(), total); if (save(p, total, false) < 0) return 1; }
+    }
+    const int ok_layers = save(p, total, true);
+    if (ok_layers < 0) return 1;
+    printf("expert-pair: %d prompts, %zu tokens, %d MoE layers measured (%ld tensors skipped) -> %s\n", p, total, ok_layers, cb.skipped, out_dir.c_str());
+    return ok_layers > 0 ? 0 : 1;
+}
