+// Brain Engine 0011: read ahead (see rpc_ahead_on)
+void rpc_dispatcher::ahead_forget() {
+    std::lock_guard<std::mutex> lock(ahead_mutex);
+    ahead_stash.clear(); // answers still on their way are kept alive by their message, and dropped when they arrive
+}
+
+// A graph is about to be sent: what was read since the last one is what follows that graph.
+void rpc_dispatcher::ahead_learn() {
+    std::lock_guard<std::mutex> lock(ahead_mutex);
+    if (ahead_graph != 0) {
+        bool fits = !ahead_seen.empty() && ahead_seen.size() <= RPC_AHEAD_MAX;
+        for (const auto & r : ahead_seen) {
+            fits = fits && r.size > 0 && r.size <= RPC_AHEAD_MAX_SIZE;
+        }
+        if (!fits) {
+            ahead_learned.erase(ahead_graph);
+        } else {
+            ahead_list & l = ahead_learned[ahead_graph];
+            bool same = l.reqs.size() == ahead_seen.size();
+            for (size_t i = 0; same && i < l.reqs.size(); i++) {
+                same = rpc_ahead_same(l.reqs[i], ahead_seen[i]);
+            }
+            l.twice = same;
+            if (!same) {
+                l.reqs = ahead_seen;
+            }
+        }
+        if (ahead_learned.size() > 256) {
+            ahead_learned.clear();
+        }
+    }
+    ahead_seen.clear();
+    ahead_stash.clear();
+    ahead_graph = 0;
+}
+
+// The graph has been sent: ask now for what is read after it every time, all in one message.
+void rpc_dispatcher::ahead_ask(uint64_t key) {
+    std::lock_guard<std::mutex> lock(ahead_mutex);
+    ahead_graph = key;
+    if (key == 0 || !rpc_ahead_on()) {
+        return;
+    }
+    auto it = ahead_learned.find(key);
+    if (it == ahead_learned.end() || !it->second.twice) {
+        return;
+    }
+    auto msg = std::make_shared<rpc_msg>();
+    msg->cmd = RPC_CMD_GET_TENSOR;
+    msg->input_size = 0;
+    msg->output = nullptr;
+    msg->output_size = 0;
+    auto done = msg->completion.get_future().share();
+    for (const auto & r : it->second.reqs) {
+        auto item = std::make_shared<rpc_ahead_item>();
+        item->req = r;
+        item->buf.resize(r.size);
+        item->done = done;
+        msg->ahead.push_back(item);
+    }
+    ahead_stash = msg->ahead;
+    ahead_n_asked += msg->ahead.size();
+    GGML_ASSERT(queue.push(msg));
+}
+
+void rpc_dispatcher::get_tensor(std::shared_ptr<rpc_msg_get_tensor_req> request, void * data, size_t size, bool wait) {
+    std::shared_ptr<rpc_ahead_item> hit;
+    {
+        std::lock_guard<std::mutex> lock(ahead_mutex);
+        for (auto & item : ahead_stash) {
+            if (!item->used && item->buf.size() == size && rpc_ahead_same(item->req, *request)) {
+                item->used = true;
+                hit = item;
+                break;
+            }
+        }
+        if (ahead_graph != 0 && ahead_seen.size() <= RPC_AHEAD_MAX) {
+            ahead_seen.push_back(*request);
+        }
+    }
+    if (hit) {
+        hit->done.wait();
+        memcpy(data, hit->buf.data(), size);
+        ahead_n_used++;
+        return;
+    }
+    if (wait) {
+        send(RPC_CMD_GET_TENSOR, request, sizeof(*request), nullptr, 0, data, size);
+    } else {
+        send_async(RPC_CMD_GET_TENSOR, request, sizeof(*request), data, size);
+    }
+}
