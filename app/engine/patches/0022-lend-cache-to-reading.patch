+    bool lend() {
+        if (lent) {
+            return false;
+        }
+        size_t bytes = 0;
+        for (device & d : devices) {
+            if (d.buf) {
+                ggml_backend_synchronize(d.backend);
+                bytes += d.buf_size;
+                d.buf.reset();
+            }
+        }
+        lent = true;
+        LLAMA_LOG_INFO("llama_moe_cache: lent %.2f MiB of the cache to prompt reading\n", bytes/1024.0/1024.0);
+        return true;
+    }
+
+    void restore() {
+        if (!lent) {
+            return;
+        }
+        const int64_t t0 = ggml_time_us();
+        for (device & d : devices) {
+            if (!d.ctx) {
+                continue;
+            }
+            for (ggml_tensor * t = ggml_get_first_tensor(d.ctx.get()); t != nullptr; t = ggml_get_next_tensor(d.ctx.get(), t)) {
+                t->data   = nullptr;
+                t->buffer = nullptr;
+            }
+            d.buf = llama_memory_bufs::alloc_buf(d.ctx.get(), d.buft, false, "MoE cache");
+            ggml_backend_buffer_clear(d.buf.get(), 0); // the zero slots and the padding
+            ggml_backend_buffer_set_usage(d.buf.get(), GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+            d.buf_size = ggml_backend_buffer_get_size(d.buf.get());
+        }
+        lent = false;
+        // the same experts go back in the same slots, so the cache is as it was before the read
+        size_t bytes = 0;
+        size_t n = 0;
+        for (group & g : groups) {
+            ggml_backend_t backend = devices[g.id].backend;
+            for (int32_t s = 0; s < g.n_slots;) {
+                const int32_t key = g.lru.key_of[s];
+                if (key < 0) {
+                    s++;
+                    continue;
+                }
+                const int32_t kl = g.lru.key_layer(key);
+                const int32_t ke = g.lru.key_expert(key);
+                // consecutive experts of a layer in consecutive slots go up together
+                int32_t c = 1;
+                while (s + c < g.n_slots && g.lru.key_of[s + c] == key + c && g.lru.key_layer(key + c) == kl) {
+                    c++;
+                }
+                for (size_t ip = 0; ip < layers[kl].experts.size(); ++ip) {
+                    const ggml_tensor * w = layers[kl].experts[ip];
+                    const size_t expert_size = w->nb[2];
+                    ggml_backend_tensor_set_async(backend, g.banks[ip], (const uint8_t *) w->data + (size_t) ke*expert_size, (size_t) s*expert_size, (size_t) c*expert_size);
+                    bytes += (size_t) c*expert_size;
+                }
+                n += c;
+                s += c;
+            }
+        }
+        for (device & d : devices) {
+            if (d.buf) {
+                ggml_backend_synchronize(d.backend);
+            }
+        }
+        LLAMA_LOG_INFO("llama_moe_cache: cache back from prompt reading: %zu experts (%.2f MiB) uploaded again in %.1f ms\n",
+            n, bytes/1024.0/1024.0, (ggml_time_us() - t0)/1000.0);
+    }
