+
+    void bw_stripe(ggml_backend_buffer_t buf) {
+        if (getenv("LLAMA_MOE_CACHE_BORROW_FIRST_BANK") != nullptr) {
+            return; // the 0048 layout (tests)
+        }
+        group & g = groups[bw_g];
+        size_t slot = 0;
+        for (const ggml_tensor * bank : g.banks) {
+            if (bank->nb[2] % 256 != 0) {
+                LLAMA_LOG_WARN("llama_moe_cache: borrowed reading lends the first bank only: a slot of %zu bytes is not a multiple of 256\n", (size_t) bank->nb[2]);
+                return;
+            }
+            slot += bank->nb[2];
+        }
+        // the banks were placed one after another from banks[0]; slot by slot they fill the same bytes
+        device & d = devices[bw_dev];
+        const size_t align = ggml_backend_buft_get_alignment(d.buft);
+        for (size_t ip = 0; ip + 1 < g.banks.size(); ++ip) {
+            if ((char *) g.banks[ip + 1]->data != (char *) g.banks[ip]->data + GGML_PAD(ggml_nbytes(g.banks[ip]), align)) {
+                LLAMA_LOG_WARN("llama_moe_cache: borrowed reading lends the first bank only: the banks are not side by side\n");
+                return;
+            }
+        }
+        char * base = (char *) g.banks[0]->data;
+        size_t at = 0;
+        for (ggml_tensor * bank : g.banks) {
+            const size_t nb2 = bank->nb[2];
+            bw_native.push_back({ bank, { (size_t) bank->nb[2], (size_t) bank->nb[3] } });
+            GGML_ASSERT((char *) bank->data >= base);
+            bank->data  = base + at;
+            bank->nb[2] = slot;
+            bank->nb[3] = slot*bank->ne[2];
+            at += nb2;
+        }
+        GGML_ASSERT((size_t) (g.banks.back()->ne[2] - 1)*slot + at <= ggml_backend_buffer_get_size(buf) - (size_t) (base - (char *) ggml_backend_buffer_get_base(buf)));
+        // the views of the banks (the experts the graphs read) follow their bank's stride
+        for (ggml_tensor * t = ggml_get_first_tensor(d.ctx.get()); t != nullptr; t = ggml_get_next_tensor(d.ctx.get(), t)) {
+            for (ggml_tensor * bank : g.banks) {
+                if (t->view_src == bank) {
+                    bw_native.push_back({ t, { (size_t) t->nb[2], (size_t) t->nb[3] } });
+                    t->nb[2] = slot;
+                    t->nb[3] = slot*t->ne[2];
+                }
+            }
+        }
+        bw_striped = true;
+    }
