 }
 
+// Brain Engine 0068: GGML_CUDA_WDDM_BUDGET=1 (Windows; off unless set) caps the free figure at what WDDM's budget for
+// this program still allows, so a fit never plans memory that Windows would quietly move to shared system memory
+static void ggml_cuda_apply_wddm_budget(int device, size_t * free) {
+#if defined(_WIN32) && !defined(GGML_USE_HIP) && !defined(GGML_USE_MUSA)
+    static const bool on = [] {
+        const char * v = getenv("GGML_CUDA_WDDM_BUDGET");
+        return v != nullptr && atoi(v) != 0;
+    }();
+    if (!on) {
+        return;
+    }
+    static std::mutex mutex;
+    static char luids[GGML_CUDA_MAX_DEVICES][8];
+    static int  state[GGML_CUDA_MAX_DEVICES] = {}; // 0 not read yet, 1 has a LUID, -1 none (TCC or unknown)
+    static bool logged[GGML_CUDA_MAX_DEVICES] = {};
+    const int phys = ggml_cuda_get_physical_device(device);
+    if (phys < 0 || phys >= GGML_CUDA_MAX_DEVICES) {
+        return;
+    }
+    std::lock_guard<std::mutex> lock(mutex);
+    if (state[phys] == 0) {
+        cudaDeviceProp prop;
+        state[phys] = -1;
+        if (cudaGetDeviceProperties(&prop, phys) == cudaSuccess && prop.luidDeviceNodeMask != 0) {
+            memcpy(luids[phys], prop.luid, 8);
+            state[phys] = 1;
+        } else {
+            (void) cudaGetLastError();
+            GGML_LOG_WARN("%s: !!! GGML_CUDA_WDDM_BUDGET NOT USED on CUDA%d: the card has no WDDM LUID (TCC mode?)\n", __func__, device);
+        }
+    }
+    size_t budget = 0;
+    size_t used   = 0;
+    if (state[phys] != 1 || !ggml_cuda_wddm_budget(luids[phys], &budget, &used)) {
+        if (state[phys] == 1 && !logged[phys]) {
+            logged[phys] = true;
+            GGML_LOG_WARN("%s: !!! GGML_CUDA_WDDM_BUDGET NOT USED on CUDA%d: DXGI gave no budget for the card\n", __func__, device);
+        }
+        return;
+    }
+    const size_t room = budget > used ? budget - used : 0;
+    if (!logged[phys]) {
+        logged[phys] = true;
+        GGML_LOG_INFO("%s: CUDA%d WDDM budget %.0f MiB, this program uses %.0f MiB, so %.0f MiB more fits (CUDA says %.0f MiB free)\n",
+            __func__, device, budget/1048576.0, used/1048576.0, room/1048576.0, *free/1048576.0);
+    }
+    if (room < *free) {
+        *free = room;
+    }
+#else
+    GGML_UNUSED(device);
+    GGML_UNUSED(free);
+#endif
+}
