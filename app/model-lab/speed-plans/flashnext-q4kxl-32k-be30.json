{
 "name": "Flash-Next (UD-Q4_K_XL, mmap on) on npc with Brain Engine 30: the 32K conductor-e2e job, plain, the drive tier (0050), the drive tier saving the hot set, then the drive tier reading that saved ranking; 1 round in this order, cool-down on",
 "method": "app/docs/test-results/2026-11-16-speed-test-method.md (addendum 92)",
 "brain": "${FLASHNEXT}",
 "engines": {
  "be30": {
   "exe": "${BE30_SERVER}",
   "env": {
    "GGML_CUDA_NO_PINNED": "1",
    "LLAMA_MOE_CACHE_LOG_EVERY": "2000",
    "LLAMA_MOE_CACHE_BORROW": "1"
   }
  }
 },
 "text": "long-text.md",
 "textRepeat": 1,
 "system": "You are a helpful assistant. Answer plainly.",
 "bigRead": 12288,
 "followUps": 5,
 "followTokens": 200,
 "replyTokens": 300,
 "rounds": 1,
 "alternate": false,
 "retryOnce": true,
 "saveText": true,
 "spillCheck": true,
 "lock": "${LOCK}",
 "stopFile": "${STOP_FILE}",
 "loadTimeoutMs": 2700000,
 "wordsRef": "plain",
 "baseArgs": [
  "--jinja",
  "-np",
  "1",
  "--no-webui",
  "-fa",
  "on",
  "-c",
  "32768",
  "-ctk",
  "q4_0",
  "-ctv",
  "q4_0",
  "-ngl",
  "99",
  "--n-cpu-moe",
  "999",
  "-ub",
  "4096",
  "-b",
  "16384",
  "--moe-cache-mib",
  "4096",
  "--moe-cache-cpu-share",
  "0",
  "-lv",
  "4"
 ],
 "ways": [
  {
   "id": "plain",
   "engine": "be30"
  },
  {
   "id": "drive",
   "engine": "be30",
   "env": {
    "LLAMA_MOE_DRIVE": "1"
   }
  },
  {
   "id": "drive-save",
   "engine": "be30",
   "env": {
    "LLAMA_MOE_DRIVE": "1",
    "LLAMA_MOE_CACHE_SAVE": "${HOT_FILE}"
   }
  },
  {
   "id": "drive-ranked",
   "engine": "be30",
   "env": {
    "LLAMA_MOE_DRIVE": "1",
    "LLAMA_MOE_CACHE_SAVE": "${HOT_FILE}",
    "LLAMA_MOE_CACHE_RANKING": "${HOT_FILE}"
   }
  }
 ]
}
