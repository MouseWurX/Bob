+static bool ggml_vk_trellis_supported(const vk_device & device, const ggml_tensor * op) {
+    const ggml_tensor * w = op->src[0];
+    const ggml_tensor * x = op->src[1];
+    const int32_t * d = (const int32_t *) op->op_params;
+    if (op->src[7] != nullptr) {
+        // Lamplight 0136: coded experts: no gathers, sides of kind 0 or 1 (one run per slice), [., E] sides
+        const ggml_tensor * ids = op->src[7];
+        if (!w || !x || !ggml_is_trellis_type(w->type) || w->ne[3] != 1 || !ggml_is_contiguous(w) || op->src[5] || op->src[6] ||
+            ids->type != GGML_TYPE_I32 || ids->nb[0] != sizeof(int32_t) || ids->nb[1] % sizeof(int32_t) ||
+            x->type != GGML_TYPE_F32 || x->nb[0] != sizeof(float) || x->nb[1] % sizeof(float) || x->nb[2] % sizeof(float) ||
+            op->type != GGML_TYPE_F32 || !ggml_is_contiguous(op) || d[0] == 2 || d[3] == 2 ||
+            ggml_nbytes(w) > device->properties.limits.maxStorageBufferRange ||
+            w->ne[0] > (1 << 24) || w->ne[1] > (1 << 24) || ggml_nelements(ids) > (1 << 24) ||
+            !ggml_trellis_desc_supported(w->ne[0], w->ne[1], d, 7 + d[6]) || device->pipeline_trellis_mv_id[0] == nullptr) {
+            return false;
+        }
+        ggml_vk_trellis_side_shape rows, cols;
+        if (!ggml_vk_trellis_shape(w->ne[1], d[0], d[1], d[2], rows) || !ggml_vk_trellis_shape(w->ne[0], d[3], d[4], d[5], cols) ||
+            rows.m > 1 || cols.m > 1) {
+            return false;
+        }
+        return ggml_vk_trellis_side_ok(device, rows) && ggml_vk_trellis_side_ok(device, cols) &&
+               (uint64_t) w->ne[1] / 16 <= device->properties.limits.maxComputeWorkGroupCount[0];
+    }
+    if (!w || !x || !ggml_is_trellis_type(w->type) || !ggml_is_matrix(w) || !ggml_is_contiguous(w) ||
+        x->type != GGML_TYPE_F32 || x->nb[0] != sizeof(float) || x->ne[0] != w->ne[0] ||
+        op->type != GGML_TYPE_F32 || !ggml_is_contiguous(op) ||
+        w->ne[0] > (1 << 24) || w->ne[1] > (1 << 24) || ggml_nrows(x) > (1 << 24) ||
+        d[6] < 0 || d[6] > GGML_TRELLIS_MAX_PARTS || !ggml_trellis_desc_supported(w->ne[0], w->ne[1], d, 7 + d[6])) {
