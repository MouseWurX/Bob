+        auto * tr = (server_expert_trace *) user_data;
+        if (tr->neurons || tr->heads) {
+            static const char kqv[] = "kqv_out-";
+            const int il = tr->heads ? (strncmp(t->name, kqv, sizeof(kqv) - 1) == 0 && t->name[sizeof(kqv) - 1] >= '0' && t->name[sizeof(kqv) - 1] <= '9' ? atoi(t->name + sizeof(kqv) - 1) : -1)
