+// Brain Engine: --seed. A client sends a hash before any weight above the threshold (ggml-rpc.cpp
+// rpc_hash_threshold) and skips sending it when the cache holds a file of that name. The weights in a gguf file are
+// the exact bytes the client hashes, so the cache can be filled from a copy of the brain on this machine instead of
+// over the network. Same hash (64-bit FNV-1a), same threshold (GGML_RPC_HASH_MIN), same names (16 hex digits).
+// Files are written as NAME.part and renamed when whole, so a stopped seed never leaves a short file behind.
+// Prints "seed: <done>/<total> <path>" lines; exit code 0 when every file was seeded.
+static size_t seed_threshold() {
+    const char * env = std::getenv("GGML_RPC_HASH_MIN");
+    if (env && *env) {
+        char * end = nullptr;
+        const unsigned long long v = std::strtoull(env, &end, 10);
+        if (end && *end == '\0') {
+            return (size_t) v;
+        }
+    }
+    return (size_t) 1024 * 1024;
+}
+
+static uint64_t seed_fnv(const uint8_t * data, size_t len, uint64_t hash = 0xcbf29ce484222325ULL) {
+    const uint64_t prime = 0x100000001b3ULL;
+    for (size_t i = 0; i < len; ++i) {
+        hash ^= data[i];
+        hash *= prime;
+    }
+    return hash;
+}
+
+static bool seed_one(const std::string & fname, const std::filesystem::path & dir) {
+    struct gguf_init_params gp = { /*.no_alloc =*/ true, /*.ctx =*/ nullptr };
+    struct gguf_context * g = gguf_init_from_file(fname.c_str(), gp);
+    if (!g) {
+        fprintf(stderr, "seed: can't read %s\n", fname.c_str());
+        return false;
+    }
+    FILE * f = ggml_fopen(fname.c_str(), "rb"); // the same way gguf_init_from_file opens it
+    if (!f) {
+        gguf_free(g);
+        fprintf(stderr, "seed: can't open %s\n", fname.c_str());
+        return false;
+    }
+    const size_t  min   = seed_threshold();
+    const size_t  base  = gguf_get_data_offset(g);
+    const int64_t n     = gguf_get_n_tensors(g);
+    int64_t total = 0, done = 0, wrote = 0;
+    for (int64_t i = 0; i < n; ++i) {
+        total += gguf_get_tensor_size(g, i) > min ? 1 : 0;
+    }
+    std::vector<uint8_t> buf;
+    bool ok = true;
+    for (int64_t i = 0; i < n && ok; ++i) {
+        const size_t size = gguf_get_tensor_size(g, i);
+        if (size <= min) {
+            continue;
+        }
+        const uint64_t at = base + gguf_get_tensor_offset(g, i);
+        buf.resize(size);
+#ifdef _WIN32
+        ok = _fseeki64(f, (long long) at, SEEK_SET) == 0;
+#else
+        ok = fseeko(f, (off_t) at, SEEK_SET) == 0;
+#endif
+        ok = ok && fread(buf.data(), 1, size, f) == size;
+        if (!ok) {
+            fprintf(stderr, "seed: %s is shorter than it says (%s)\n", fname.c_str(), gguf_get_tensor_name(g, i));
+            break;
+        }
+        char name[17];
+        snprintf(name, sizeof(name), "%016llx", (unsigned long long) seed_fnv(buf.data(), size));
+        const std::filesystem::path file = dir / name;
+        std::error_code ec;
+        if (!std::filesystem::exists(file, ec)) {
+            const std::filesystem::path part = dir / (std::string(name) + ".part");
+#ifdef _WIN32
+            FILE * o = _wfopen(part.wstring().c_str(), L"wb");
+#else
+            FILE * o = fopen(part.string().c_str(), "wb");
+#endif
+            ok = o && fwrite(buf.data(), 1, size, o) == size;
+            if (o) {
+                ok = fclose(o) == 0 && ok;
+            }
+            if (ok) {
+                std::filesystem::rename(part, file, ec);
+                ok = !ec;
+            }
+            if (!ok) {
+                std::filesystem::remove(part, ec);
+                fprintf(stderr, "seed: couldn't write %s (is the disk full?)\n", file.string().c_str());
+                break;
+            }
+            wrote++;
+        }
+        done++;
+        fprintf(stdout, "seed: %lld/%lld %s\n", (long long) done, (long long) total, fname.c_str());
+        fflush(stdout);
+    }
+    fclose(f);
+    gguf_free(g);
+    fprintf(stdout, "seed: %s %s (%lld new of %lld)\n", ok ? "done" : "stopped", fname.c_str(), (long long) wrote, (long long) total);
+    fflush(stdout);
+    return ok;
+}
+
