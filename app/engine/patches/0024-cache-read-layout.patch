+    // Brain Engine 0024: switch the banks to whole layers for a long read; returns the number of resident layers
+    int32_t begin_read_layout() {
+        if (reading || lent || filling) {
+            return 0;
+        }
+        const int64_t t0 = ggml_time_us();
+        for (device & d : devices) {
+            if (d.buf) {
+                ggml_backend_synchronize(d.backend);
+            }
+        }
+        saved_key_of.assign(groups.size(), {});
+        saved_slot_map.assign(layers.size(), {});
+        resident.assign(layers.size(), false);
+        int32_t n_res = 0;
+        size_t bytes = 0;
+        for (size_t ig = 0; ig < groups.size(); ++ig) {
+            group & g = groups[ig];
+            saved_key_of[ig] = g.lru.key_of;
+            const int32_t n_exp = (int32_t) g.ref[0]->ne[2];
+            int32_t base = 0;
+            for (int32_t il : g.layers) {
+                layer & l = layers[il];
+                if (l.slot_map == nullptr) {
+                    continue;
+                }
+                int32_t * map = (int32_t *) l.slot_map->data;
+                saved_slot_map[il].assign(map, map + l.slot_map->ne[1]);
+                if (base + n_exp > g.n_slots) {
+                    continue; // no room: this layer reads the stock way (host experts uploaded per batch)
+                }
+                for (int32_t e = 0; e < n_exp; ++e) {
+                    map[e] = base + e;
+                }
+                for (size_t ip = 0; ip < l.experts.size(); ++ip) {
+                    const ggml_tensor * w = l.experts[ip];
+                    ggml_backend_tensor_set_async(devices[g.id].backend, g.banks[ip], w->data, (size_t) base*w->nb[2], (size_t) n_exp*w->nb[2]);
+                    bytes += (size_t) n_exp*w->nb[2];
+                }
+                resident[il] = true;
+                base += n_exp;
+                n_res++;
+            }
+        }
+        for (device & d : devices) {
+            if (d.buf) {
+                ggml_backend_synchronize(d.backend);
+            }
+        }
+        reading = true;
+        LLAMA_LOG_INFO("llama_moe_cache: read layout: %d whole layers on the card (%.2f MiB) in %.1f ms\n",
+            n_res, bytes/1024.0/1024.0, (ggml_time_us() - t0)/1000.0);
+        return n_res;
+    }
+
+    // back to the hot experts: the saved placement, uploaded again
+    void end_read_layout() {
+        if (!reading) {
+            return;
+        }
+        const int64_t t0 = ggml_time_us();
+        for (device & d : devices) {
+            if (d.buf) {
+                ggml_backend_synchronize(d.backend);
+            }
+        }
+        for (size_t ig = 0; ig < groups.size(); ++ig) {
+            groups[ig].lru.key_of = saved_key_of[ig];
+        }
+        for (size_t il = 0; il < layers.size(); ++il) {
+            if (!saved_slot_map[il].empty()) {
+                std::copy(saved_slot_map[il].begin(), saved_slot_map[il].end(), (int32_t *) layers[il].slot_map->data);
+            }
+        }
+        reading = false;
+        const auto [bytes, n] = upload_slots([&](int32_t id) { return devices[id].backend; });
+        LLAMA_LOG_INFO("llama_moe_cache: hot experts back after the read layout: %zu experts (%.2f MiB) in %.1f ms\n",
+            n, bytes/1024.0/1024.0, (ggml_time_us() - t0)/1000.0);
+    }
