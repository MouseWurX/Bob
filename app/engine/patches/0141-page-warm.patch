diff --git a/src/llama-page-warm.cpp b/src/llama-page-warm.cpp
new file mode 100644
index 0000000..1abe8a8
--- /dev/null
+++ b/src/llama-page-warm.cpp
@@ -0,0 +1,126 @@
+// Brain Engine 0141: page warm-up. With the brain file mapped (mmap), the parts that stay in RAM come into the
+// engine's page table only when a word first needs them, one page fault at a time: the first answers after a load
+// are slower than the later ones (on Windows the whole file can still be on the drive). A helper thread now reads
+// one byte of each such page right after load, while nobody is waiting on it, so the first answer finds them mapped.
+// Nothing is changed or copied: same words. Off unless LLAMA_PAGE_WARM=1, until a test shows it pays. Skipped when the drive tier
+// (LLAMA_MOE_DRIVE) keeps the experts on the drive, or when the pages to read don't fit in free RAM above the floor
+// (LLAMA_MOE_RAM_FLOOR_MIB, 512 unless set), so it never pushes the computer into swapping. Idea from PolyStrata (MIT).
+
+#include "llama-page-warm.h"
+#include "llama-impl.h"
+
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <thread>
+
+#ifdef _WIN32
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#elif defined(__APPLE__)
+#include <mach/mach.h>
+#endif
+
+struct llama_page_warm {
+    std::vector<std::pair<const uint8_t *, size_t>> ranges;
+    std::atomic<bool> stop{false};
+    std::thread th;
+};
+
+static void page_warm_run(llama_page_warm * w) {
+    const auto t0 = std::chrono::steady_clock::now();
+    const size_t page = 4096;
+    volatile uint8_t sink = 0;
+    size_t done = 0;
+    for (const auto & r : w->ranges) {
+        const uintptr_t a = (uintptr_t) r.first;
+        uintptr_t p = (a + page - 1) & ~(uintptr_t) (page - 1);
+        if (r.second > 0) {
+            sink ^= r.first[0]; // the first page, even when the range starts inside it
+        }
+        for (; p < a + r.second; p += page) {
+            sink ^= *(const volatile uint8_t *) p;
+            done += page;
+            if ((done & ((64u << 20) - 1)) == 0 && w->stop.load(std::memory_order_relaxed)) {
+                LLAMA_LOG_INFO("page warm-up (0141): stopped after %.0f MiB\n", done/1048576.0);
+                return;
+            }
+        }
+    }
+    (void) sink;
+    const double s = std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
+    LLAMA_LOG_INFO("page warm-up (0141): %.0f MiB of the brain file mapped in %.2f s\n", done/1048576.0, s);
+}
+
+const char * llama_page_warm_refuse(double need_mib, double avail_mib, double floor_mib) {
+    if (need_mib <= 0) {
+        return "nothing of the file stays in RAM";
+    }
+    if (avail_mib < 0) {
+        return "free RAM is not known";
+    }
+    if (need_mib > avail_mib - floor_mib) {
+        return "the pages don't fit in free RAM above the floor";
+    }
+    return nullptr;
+}
+
+llama_page_warm * llama_page_warm_start(std::vector<std::pair<const uint8_t *, size_t>> ranges) {
+    if (ranges.empty()) {
+        return nullptr;
+    }
+    auto * w = new llama_page_warm();
+    w->ranges = std::move(ranges);
+    w->th = std::thread(page_warm_run, w);
+    return w;
+}
+
+void llama_page_warm_stop(llama_page_warm * w) {
+    if (w == nullptr) {
+        return;
+    }
+    w->stop.store(true);
+    if (w->th.joinable()) {
+        w->th.join();
+    }
+    delete w;
+}
+
+double llama_page_warm_avail_mib() {
+    if (const char * t = getenv("LLAMA_PAGE_WARM_TEST_AVAIL_MIB")) { // tests only: pretend free RAM is this much
+        return atof(t);
+    }
+#ifdef _WIN32
+    MEMORYSTATUSEX ms = {};
+    ms.dwLength = sizeof(ms);
+    return GlobalMemoryStatusEx(&ms) ? ms.ullAvailPhys/1048576.0 : -1.0;
+#elif defined(__linux__)
+    FILE * f = fopen("/proc/meminfo", "r");
+    if (f == nullptr) {
+        return -1.0;
+    }
+    char line[256];
+    double kb = -1.0;
+    while (fgets(line, sizeof(line), f)) {
+        if (strncmp(line, "MemAvailable:", 13) == 0) {
+            kb = atof(line + 13);
+            break;
+        }
+    }
+    fclose(f);
+    return kb >= 0 ? kb/1024.0 : -1.0;
+#elif defined(__APPLE__)
+    vm_statistics64_data_t vs;
+    mach_msg_type_number_t cnt = HOST_VM_INFO64_COUNT;
+    if (host_statistics64(mach_host_self(), HOST_VM_INFO64, (host_info64_t) &vs, &cnt) != KERN_SUCCESS) {
+        return -1.0;
+    }
+    return ((double) vs.free_count + vs.inactive_count + vs.purgeable_count)*(double) vm_page_size/1048576.0;
+#else
+    return -1.0;
+#endif
+}
diff --git a/src/llama-page-warm.h b/src/llama-page-warm.h
new file mode 100644
index 0000000..eca3915
--- /dev/null
+++ b/src/llama-page-warm.h
@@ -0,0 +1,18 @@
+#pragma once
+// Brain Engine 0141: the brain file's pages read once after load (see llama-page-warm.cpp)
+
+#include <cstddef>
+#include <cstdint>
+#include <utility>
+#include <vector>
+
+struct llama_page_warm;
+
+// starts a helper thread that reads one byte of every page in ranges; nullptr when there is nothing to do
+llama_page_warm * llama_page_warm_start(std::vector<std::pair<const uint8_t *, size_t>> ranges);
+// stops the helper (if it is still reading) and waits for it; call before the ranges are unmapped
+void llama_page_warm_stop(llama_page_warm * w);
+// Brain Engine 0141: the decision, kept apart so it can be told plainly: 0 = warm, else the reason it is skipped
+const char * llama_page_warm_refuse(double need_mib, double avail_mib, double floor_mib);
+// free RAM in MiB (-1 when not known)
+double llama_page_warm_avail_mib();
