+int64_t llama_model::layer_place(int il, ggml_backend_dev_t dev, std::string & err) {
+    if (il < 0 || il >= (int) pimpl->dev_layer.size()) {
+        err = "layer " + std::to_string(il) + " is not in this brain";
+        return -1;
+    }
+    if (dev == nullptr) {
+        // home: every moved weight points at the bytes it was loaded into again, and the card copy is freed
+        const auto it = pimpl->live_moved.find(il);
+        if (it == pimpl->live_moved.end()) {
+            return 0;
+        }
+        int64_t n = 0;
+        for (const auto & h : it->second) {
+            h.t->buffer = h.buf;
+            h.t->data   = h.data;
+            h.t->extra  = h.extra;
+            n += (int64_t) ggml_nbytes(h.t);
+        }
+        pimpl->live_moved.erase(it);
+        pimpl->live_bufs.erase(il);
+        pimpl->dev_layer[il] = pimpl->live_dev_home.at(il);
+        pimpl->live_dev_home.erase(il);
+        return n;
+    }
+    if (pimpl->live_moved.count(il)) {
+        if (pimpl->dev_layer[il].dev == dev) {
+            return 0;
+        }
+        err = "layer " + std::to_string(il) + " is on another card already: send it home first";
+        return -1;
+    }
+    const auto it_list = pimpl->gpu_buft_list.find(dev);
+    if (it_list == pimpl->gpu_buft_list.end()) {
+        err = std::string("this brain does not use ") + ggml_backend_dev_name(dev);
+        return -1;
+    }
+    ggml_backend_buffer_type_t buft = ggml_backend_dev_buffer_type(dev);
+    // only weights in plain host memory move: repacked processor weights (is_host false) have their own layout
+    std::vector<ggml_tensor *> todo;
+    for (ggml_tensor * t : llama_model_layer_tensors(*this, il)) {
+        if (t->buffer == nullptr || t->data == nullptr || t->view_src != nullptr) {
+            continue;
+        }
+        if (ggml_backend_buffer_is_host(t->buffer)) {
+            todo.push_back(t);
+        } else if (ggml_backend_buft_get_device(ggml_backend_buffer_get_type(t->buffer)) == nullptr ||
+                   ggml_backend_dev_type(ggml_backend_buft_get_device(ggml_backend_buffer_get_type(t->buffer))) == GGML_BACKEND_DEVICE_TYPE_CPU) {
+            err = "layer " + std::to_string(il) + " has repacked processor weights (" + ggml_backend_buffer_name(t->buffer) +
+                  "), which can't be moved: start the brain with --no-repack";
+            return -1;
+        }
+    }
+    if (todo.empty()) {
+        return 0;
+    }
+    const size_t align = ggml_backend_buft_get_alignment(buft);
+    size_t size = 0;
+    for (ggml_tensor * t : todo) {
+        size += GGML_PAD(ggml_backend_buft_get_alloc_size(buft, t), align);
+    }
+    ggml_backend_buffer_t buf = ggml_backend_buft_alloc_buffer(buft, size);
+    if (buf == nullptr) {
+        err = "not enough room on " + std::string(ggml_backend_dev_name(dev)) + " for layer " + std::to_string(il) +
+              format(" (%.0f MiB)", size / 1048576.0);
+        return -1;
+    }
+    ggml_backend_buffer_set_usage(buf, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+    std::vector<impl::live_home> homes;
+    char * base = (char *) ggml_backend_buffer_get_base(buf);
+    size_t offs = 0;
+    for (ggml_tensor * t : todo) {
+        homes.push_back({ t, t->buffer, t->data, t->extra });
+        void * src = t->data;
+        t->buffer = nullptr;
+        t->data   = nullptr;
+        t->extra  = nullptr;
+        if (ggml_backend_tensor_alloc(buf, t, base + offs) != GGML_STATUS_SUCCESS) {
+            for (const auto & h : homes) { // put back what was done so far
+                h.t->buffer = h.buf;
+                h.t->data   = h.data;
+                h.t->extra  = h.extra;
+            }
+            ggml_backend_buffer_free(buf);
+            err = "could not lay out layer " + std::to_string(il) + " on " + ggml_backend_dev_name(dev);
+            return -1;
+        }
+        ggml_backend_tensor_set(t, src, 0, ggml_nbytes(t));
+        offs += GGML_PAD(ggml_backend_buft_get_alloc_size(buft, t), align);
+    }
+    pimpl->live_moved[il]    = std::move(homes);
+    pimpl->live_bufs[il]     = ggml_backend_buffer_ptr(buf);
+    pimpl->live_dev_home[il] = pimpl->dev_layer[il];
+    pimpl->dev_layer[il]     = { dev, &it_list->second }; // the layer's KV and small steps follow it in the next context
+    return (int64_t) size;
+}
