 bool llama_context::set_expert_mask(const uint8_t * keep, size_t len) {
+    const auto & hparams = model.hparams;
+    const size_t n_expert = hparams.n_expert;
+    const size_t n_layer  = hparams.n_layer();
+
+    // a layer must keep at least as many experts as it uses for each word, the live count included
+    std::vector<uint32_t> n_keep;
+    if (keep != nullptr && n_expert > 0 && len == n_layer*n_expert) {
+        n_keep.assign(n_layer, 0);
+        for (size_t il = 0; il < n_layer; il++) {
+            for (size_t e = 0; e < n_expert; e++) {
+                n_keep[il] += keep[il*n_expert + e] != 0;
+            }
+            if (il < expert_used_live.size() && expert_used_live[il] > n_keep[il]) {
+                LLAMA_LOG_ERROR("%s: layer %zu keeps %u experts, it uses %u for each word\n", __func__, il, n_keep[il], expert_used_live[il]);
+                return false;
+            }
+        }
+    }
+
     bool res = emask->apply(model, keep, len);
+    if (res) {
+        emask_n_keep = std::move(n_keep);
+    }
 
     sched_need_reserve = true;
 
     return res;
 }
 
+int32_t llama_context::set_expert_used(const int32_t * used, size_t n) {
+    const auto & hparams = model.hparams;
+    const uint32_t n_layer  = hparams.n_layer();
+    const uint32_t n_expert = hparams.n_expert;
+
+    if (n_expert == 0 || hparams.router_layer >= 0) {
+        LLAMA_LOG_ERROR("%s: the model has no experts, or its layers share one router\n", __func__);
+        return -4;
+    }
+
+    std::vector<uint32_t> next;
+    if (used != nullptr && n > 0) {
+        if (n != n_layer) {
+            LLAMA_LOG_ERROR("%s: %zu counts, the model has %u layers\n", __func__, n, n_layer);
+            return -1;
+        }
+        next.assign(n_layer, 0);
+        bool any = false;
+        for (uint32_t il = 0; il < n_layer; il++) {
+            if (used[il] < 0 || (uint32_t) used[il] > n_expert || used[il] > LLAMA_MAX_EXPERTS) {
+                LLAMA_LOG_ERROR("%s: layer %u: %d experts per word, it must be from 1 to %u (0 = the model's own)\n", __func__, il, used[il], n_expert);
+                return -1;
+            }
+            // the model's own count is the same as none set
+            next[il] = (uint32_t) used[il] == hparams.n_expert_used(il) ? 0 : (uint32_t) used[il];
+            any = any || next[il] > 0;
+            if (il < emask_n_keep.size() && next[il] > emask_n_keep[il]) {
+                LLAMA_LOG_ERROR("%s: layer %u: the expert mask keeps %u experts, fewer than %u\n", __func__, il, emask_n_keep[il], next[il]);
+                return -2;
+            }
+            // the MoE cache sized its slots and its zero slots for the model's own count
+            if (moe_cache && next[il] > hparams.n_expert_used_max()) {
+                LLAMA_LOG_ERROR("%s: layer %u: more than %u experts per word while the MoE cache is on\n", __func__, il, hparams.n_expert_used_max());
+                return -5;
+            }
+        }
+        if (!any) {
+            next.clear();
+        }
+    }
+
+    if (next == expert_used_live) {
+        return 0;
+    }
+
+    synchronize();
+
+    std::vector<uint32_t> prev = std::move(expert_used_live);
+
+    auto point = [this]() {
+        cparams.expert_used     = expert_used_live.empty() ? nullptr : expert_used_live.data();
+        cparams.expert_used_n   = (uint32_t) expert_used_live.size();
+        cparams.expert_used_gen++;
+    };
+
+    expert_used_live = std::move(next);
+    point();
+
+    // lay the working memory out again now, so a count that doesn't fit is refused here and not in the next decode
+    sched_need_reserve = true;
+    try {
+        sched_reserve();
+    } catch (const std::exception & err) {
+        LLAMA_LOG_ERROR("%s: %s, keeping the counts as they were\n", __func__, err.what());
+        expert_used_live = std::move(prev);
+        point();
+        sched_need_reserve = true;
+        sched_reserve();
+        return -3;
+    }
+
+    LLAMA_LOG_INFO("%s: %s\n", __func__, expert_used_live.empty() ? "back to the model's own experts per word" : "experts per word set");
+
+    return 0;
+}
+
+int32_t llama_context::get_expert_used(int32_t il) const {
+    const auto & hparams = model.hparams;
+    if (il < 0 || (uint32_t) il >= hparams.n_layer_all) {
+        return -1;
+    }
+    if ((size_t) il < expert_used_live.size() && expert_used_live[il] > 0) {
+        return (int32_t) expert_used_live[il];
+    }
+    return (int32_t) hparams.n_expert_used(il);
+}
