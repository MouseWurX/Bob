+// Lamplight 0152: the weights of layer il (names "blk.<il>.")
+static std::vector<ggml_tensor *> llama_model_layer_tensors(const llama_model & model, int il) {
+    const std::string pre = "blk." + std::to_string(il) + ".";
+    std::vector<ggml_tensor *> out;
+    for (const auto & [name, t] : model.tensors_by_name) {
+        if (name.compare(0, pre.size(), pre) == 0) {
+            out.push_back(t);
+        }
+    }
+    return out;
+}
+
+size_t llama_model::layer_host_bytes(int il) const {
+    size_t n = 0;
+    for (ggml_tensor * t : llama_model_layer_tensors(*this, il)) {
+        if (t->buffer != nullptr && ggml_backend_buffer_is_host(t->buffer)) {
+            n += ggml_nbytes(t);
+        }
+    }
+    return n;
+}
+
+ggml_backend_dev_t llama_model::layer_moved_to(int il) const {
+    const auto it = pimpl->live_dev_home.find(il);
+    return it == pimpl->live_dev_home.end() ? nullptr : pimpl->dev_layer.at(il).dev;
+}
