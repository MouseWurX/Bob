diff --git a/ggml/src/ggml-cpu/trellis.cpp b/ggml/src/ggml-cpu/trellis.cpp
new file mode 100644
index 0000000..2fe7292
--- /dev/null
+++ b/ggml/src/ggml-cpu/trellis.cpp
@@ -0,0 +1,1290 @@
+#include "trellis.h"
+#include "ops.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdlib>
+#include <cstring>
+
+// trellis fork: rows of a coded embedding (ggml_trellis_get_rows); each value has its own 16-bit window, so a row decodes without its 16-row group
+static inline int ggml_trellis_value(const uint32_t * tile, int k, int p) {
+    const int total = 256 * k;
+    const int start = ((p + 1) * k - 16 + total) % total;
+    const int w = start >> 5, o = start & 31;
+    const uint64_t pair = ((uint64_t) tile[w] << 32) | tile[(w + 1) % (8 * k)];
+    const uint32_t state = (uint32_t) (pair >> (48 - o)) & 0xFFFFu;
+    const uint32_t x = state * 0x83DCD12Du;
+    return (int) (((x >> 2) & 63) + ((x >> 10) & 63) + ((x >> 18) & 63) + ((x >> 26) & 63)) - 126;
+}
+
+// per thread: the 2 L floats of an inverse whole-slice Hadamard
+static int64_t ggml_trellis_get_rows_scratch(const int32_t * desc, int64_t K) {
+    return (2 * K / desc[5] + 15) / 16 * 16 + (int64_t) CACHE_LINE_SIZE_F32;
+}
+
+size_t ggml_compute_forward_trellis_get_rows_work_size(const ggml_tensor * dst, int n_tasks) {
+    const int32_t * desc = (const int32_t *) dst->op_params;
+    if (desc[3] != 2 || desc[5] < 1) {
+        return 0;
+    }
+    return (size_t) n_tasks * ggml_trellis_get_rows_scratch(desc, dst->src[0]->ne[0]) * sizeof(float);
+}
+
+void ggml_compute_forward_trellis_get_rows(const ggml_compute_params * params, ggml_tensor * dst) {
+    const ggml_tensor * w    = dst->src[0];
+    const ggml_tensor * ids  = dst->src[1];
+    const ggml_tensor * s16  = dst->src[2];
+    const ggml_tensor * pre  = dst->src[3];
+    const ggml_tensor * post = dst->src[4];
+    const ggml_tensor * gather = dst->src[5];  // a band of a banded embedding (ggml_trellis_get_rows_band)
+    const int32_t * desc = (const int32_t *) dst->op_params;
+    const int32_t row0 = gather ? desc[GGML_TRELLIS_BAND_ROW0] : 0;
+    GGML_ASSERT(desc[0] == 0 && "trellis_get_rows: the embedding's rows must be unrotated");
+
+    const int k = w->type - GGML_TYPE_TRL1 + 1;
+    const int K = (int) w->ne[0], N = (int) w->ne[1], kt = K / 16, nw = 8 * k;
+    GGML_ASSERT(ggml_trellis_desc_supported(K, N, desc, 7 + desc[6]));
+    const uint32_t * codes = (const uint32_t *) w->data;
+    const ggml_fp16_t * sc = (const ggml_fp16_t *) s16->data;
+    const float * a = (const float *) pre->data;
+    const float * b = (const float *) post->data;
+    const int n = (int) ids->ne[0];
+    GGML_ASSERT(params->wsize >= ggml_compute_forward_trellis_get_rows_work_size(dst, params->nth));
+    float * tmp = desc[3] == 2 ? (float *) params->wdata + params->ith * ggml_trellis_get_rows_scratch(desc, K) : nullptr;
+
+    for (int r0 = params->ith; r0 < n; r0 += params->nth) {
+        int t = ((const int32_t *) ids->data)[r0];
+        if (gather) {  // the band's own row, or a row of another band (left as it is)
+            GGML_ASSERT(t >= 0 && t < gather->ne[0]);
+            t = ((const int32_t *) gather->data)[t] - row0;
+            if (t < 0 || t >= N) {
+                continue;
+            }
+        }
+        GGML_ASSERT(t >= 0 && t < N);
+        float * out = (float *) ((char *) dst->data + (size_t) r0 * dst->nb[1]);
+        const int J = t / 16, r = t % 16;
+        for (int i = 0; i < kt; ++i) {
+            const uint32_t * tile = codes + ((size_t) J * kt + i) * nw;
+            const float s = GGML_CPU_FP16_TO_FP32(sc[i]);
+            for (int c = 0; c < 16; ++c) {
+                const int p = 8 * (4 * (r % 8) + (c % 8) / 2) + 4 * (r / 8) + 2 * (c / 8) + c % 2;
+                out[16 * i + c] = (float) ggml_trellis_value(tile, k, p) * s;
+            }
+        }
+        if (desc[3] == 1) {
+            ggml_trellis_rht(out, K, desc[4]);
+        } else if (desc[3] == 2) {  // T_cols^T: the inverse of the input side's whole-slice Hadamard
+            for (int sl = 0; sl < desc[5]; ++sl) {
+                const bool ok = ggml_trellis_hadfull_slice(out, K, nullptr, 0, desc[5], sl, true, nullptr, nullptr, tmp);
+                GGML_ASSERT(ok);
+            }
+        }
+        for (int j = 0; j < K; ++j) {
+            out[j] *= a[j] * b[t];
+        }
+    }
+}
+
+// trellis fork: the coded linear (ggml_trellis_mul_mat) in fp32, in four phases with a barrier after each.
+// The phases: rotate the inputs (s16 folded in), multiply each decoded tile row of V with all columns, apply the output side and post, gather the outputs.
+
+#if !defined(__AVX2__)
+// the window of value q = 16 c + r of a tile (input c, output row r): the first word of its 16-bit window, and the shift of that word pair
+struct ggml_trellis_windows {
+    uint8_t word[6][256];
+    uint8_t shift[6][256];
+};
+
+static const ggml_trellis_windows & ggml_trellis_window_table() {
+    static const ggml_trellis_windows tab = [] {
+        ggml_trellis_windows t{};
+        for (int k = 1; k <= 6; ++k) {
+            const int total = 256 * k;
+            for (int c = 0; c < 16; ++c) {
+                for (int r = 0; r < 16; ++r) {
+                    const int p = 8 * (4 * (r % 8) + (c % 8) / 2) + 4 * (r / 8) + 2 * (c / 8) + c % 2;
+                    const int start = ((p + 1) * k - 16 + total) % total;
+                    t.word[k - 1][16 * c + r] = (uint8_t) (start >> 5);
+                    t.shift[k - 1][16 * c + r] = (uint8_t) (48 - (start & 31));
+                }
+            }
+        }
+        return t;
+    }();
+    return tab;
+}
+#endif
+
+#if defined(__AVX2__)
+// SIMD decode: the 8 windows of a group (input c, outputs 8 h .. 8 h + 7) start k words apart at the same bit offset.
+// With the tile's words as 8 x k columns in registers, a group is two permutes and one funnel shift: state = ((H << (32 - c)) | (L >> c)) & 0xFFFF.
+struct ggml_trellis_groups {
+    uint8_t hc[6][32], hr[6][32], lc[6][32], lr[6][32]; // per group: H's and L's column and rotation
+    int64_t cr[6][32], cl[6][32];                       // per group: c and 32 - c
+#if defined(__AVX512F__) && defined(__AVX512BW__)
+    // per input c, both of its groups in one 16-lane register: lanes 8 h + r' of group 2 c + h
+    int32_t hidx[6][16][16], lidx[6][16][16], rcnt[6][16][16], lcnt[6][16][16];
+#endif
+};
+
+static const ggml_trellis_groups & ggml_trellis_group_table() {
+    static const ggml_trellis_groups tab = [] {
+        ggml_trellis_groups t{};
+        for (int k = 1; k <= 6; ++k) {
+            const int total = 256 * k, q = k - 1;
+            for (int g = 0; g < 32; ++g) {
+                const int c = g / 2, h = g % 2;
+                const int p0 = 8 * ((c % 8) / 2) + 4 * h + 2 * (c / 8) + c % 2;
+                const int start = ((p0 + 1) * k - 16 + total) % total;
+                const int w0 = start >> 5, s = 48 - (start & 31);
+                const int a0 = w0 / k, b0 = w0 % k;
+                t.hc[q][g] = (uint8_t) b0;
+                t.hr[q][g] = (uint8_t) a0;
+                if (s < 32) {
+                    t.lc[q][g] = (uint8_t) (b0 + 1 < k ? b0 + 1 : 0);
+                    t.lr[q][g] = (uint8_t) (b0 + 1 < k ? a0 : (a0 + 1) % 8);
+                    t.cr[q][g] = s;
+                } else {
+                    t.lc[q][g] = (uint8_t) b0;
+                    t.lr[q][g] = (uint8_t) a0;
+                    t.cr[q][g] = s - 32;
+                }
+                t.cl[q][g] = 32 - t.cr[q][g];  // 32 (c = 0) clears the lanes
+            }
+#if defined(__AVX512F__) && defined(__AVX512BW__)
+            for (int c = 0; c < 16; ++c) {
+                for (int l = 0; l < 16; ++l) {
+                    const int h = l / 8, r = l % 8, g = 2 * c + h;
+                    t.hidx[q][c][l] = 16 * h + (t.hr[q][g] + r) % 8;  // h = 1: from the second source
+                    t.lidx[q][c][l] = 16 * h + (t.lr[q][g] + r) % 8;
+                    t.rcnt[q][c][l] = (int32_t) t.cr[q][g];
+                    t.lcnt[q][c][l] = (int32_t) t.cl[q][g];
+                }
+            }
+#endif
+        }
+        return t;
+    }();
+    return tab;
+}
+#endif
+
+// V of one tile row (kt tiles of 8 k words) into wt: wt[16 j + r] = V[16 J + r][j], j = 16 i + c
+static void ggml_trellis_decode_tile_row(const uint32_t * words, int k, int64_t kt, float * wt) {
+#if defined(__AVX2__)
+    const ggml_trellis_groups & gt = ggml_trellis_group_table();
+    const int q = k - 1, nw = 8 * k;
+    const __m256i stride = _mm256_setr_epi32(0, k, 2 * k, 3 * k, 4 * k, 5 * k, 6 * k, 7 * k);
+#if defined(__AVX512F__) && defined(__AVX512BW__)
+    const __m512i mult = _mm512_set1_epi32((int) 0x83DCD12Du), m16 = _mm512_set1_epi32(0xFFFF);
+    const __m512i m3f = _mm512_set1_epi32(0x3F3F3F3F), ones8 = _mm512_set1_epi8(1), ones16 = _mm512_set1_epi16(1);
+    const __m512i off = _mm512_set1_epi32(126);
+    for (int64_t i = 0; i < kt; ++i) {
+        const int * tile = (const int *) (words + i * nw);
+        __m512i col[6];
+        for (int b = 0; b < k; ++b) {  // words b, k + b, .., 7 k + b (the upper lanes are never selected)
+            col[b] = _mm512_castsi256_si512(_mm256_i32gather_epi32(tile + b, stride, 4));
+        }
+        float * out = wt + i * 256;
+        for (int c = 0; c < 16; ++c) {
+            const int g0 = 2 * c, g1 = 2 * c + 1;
+            const __m512i H = _mm512_permutex2var_epi32(col[gt.hc[q][g0]], _mm512_loadu_si512(gt.hidx[q][c]),
+                                                        col[gt.hc[q][g1]]);
+            const __m512i L = _mm512_permutex2var_epi32(col[gt.lc[q][g0]], _mm512_loadu_si512(gt.lidx[q][c]),
+                                                        col[gt.lc[q][g1]]);
+            const __m512i st = _mm512_and_si512(_mm512_or_si512(_mm512_sllv_epi32(H, _mm512_loadu_si512(gt.lcnt[q][c])),
+                                                                _mm512_srlv_epi32(L, _mm512_loadu_si512(gt.rcnt[q][c]))),
+                                                m16);
+            const __m512i d = _mm512_and_si512(_mm512_srli_epi32(_mm512_mullo_epi32(st, mult), 2), m3f);
+            const __m512i v = _mm512_sub_epi32(_mm512_madd_epi16(_mm512_maddubs_epi16(d, ones8), ones16), off);
+            _mm512_storeu_ps(out + 16 * c, _mm512_cvtepi32_ps(v));
+        }
+    }
+#else
+    __m256i rot[8];
+    for (int a = 0; a < 8; ++a) {
+        rot[a] = _mm256_setr_epi32(a % 8, (a + 1) % 8, (a + 2) % 8, (a + 3) % 8, (a + 4) % 8, (a + 5) % 8, (a + 6) % 8,
+                                   (a + 7) % 8);
+    }
+    const __m256i mult = _mm256_set1_epi32((int) 0x83DCD12Du), m16 = _mm256_set1_epi32(0xFFFF);
+    const __m256i m3f = _mm256_set1_epi32(0x3F3F3F3F), ones8 = _mm256_set1_epi8(1), ones16 = _mm256_set1_epi16(1);
+    const __m256i off = _mm256_set1_epi32(126);
+    const uint8_t * hc = gt.hc[q], * hr = gt.hr[q], * lc = gt.lc[q], * lr = gt.lr[q];
+    const int64_t * cr = gt.cr[q], * cl = gt.cl[q];
+    for (int64_t i = 0; i < kt; ++i) {
+        const int * tile = (const int *) (words + i * nw);
+        __m256i col[6];
+        for (int b = 0; b < k; ++b) {
+            col[b] = _mm256_i32gather_epi32(tile + b, stride, 4);  // words b, k + b, .., 7 k + b
+        }
+        float * out = wt + i * 256;
+        for (int g = 0; g < 32; ++g) {
+            const __m256i H = _mm256_permutevar8x32_epi32(col[hc[g]], rot[hr[g]]);
+            const __m256i L = _mm256_permutevar8x32_epi32(col[lc[g]], rot[lr[g]]);
+            const __m256i st = _mm256_and_si256(_mm256_or_si256(_mm256_sll_epi32(H, _mm_set_epi64x(0, cl[g])),
+                                                                _mm256_srl_epi32(L, _mm_set_epi64x(0, cr[g]))),
+                                                m16);
+            const __m256i d = _mm256_and_si256(_mm256_srli_epi32(_mm256_mullo_epi32(st, mult), 2), m3f);
+            const __m256i v = _mm256_sub_epi32(_mm256_madd_epi16(_mm256_maddubs_epi16(d, ones8), ones16), off);
+            _mm256_storeu_ps(out + 8 * g, _mm256_cvtepi32_ps(v));
+        }
+    }
+#endif
+#else
+    const ggml_trellis_windows & tab = ggml_trellis_window_table();
+    const uint8_t * tw = tab.word[k - 1];
+    const uint8_t * ts = tab.shift[k - 1];
+    const int nw = 8 * k;
+    uint32_t buf[8 * 6 + 1];  // the tile's words and the first again: the stream is circular
+    for (int64_t i = 0; i < kt; ++i) {
+        memcpy(buf, words + i * nw, nw * sizeof(uint32_t));
+        buf[nw] = buf[0];
+        float * out = wt + i * 256;
+        for (int q = 0; q < 256; ++q) {
+            const uint64_t pair = ((uint64_t) buf[tw[q]] << 32) | buf[tw[q] + 1];
+            const uint32_t x = ((uint32_t) (pair >> ts[q]) & 0xFFFFu) * 0x83DCD12Du;  // the INT8 grid
+            out[q] = (float) ((int) (((x >> 2) & 63) + ((x >> 10) & 63) + ((x >> 18) & 63) + ((x >> 26) & 63)) - 126);
+        }
+    }
+#endif
+}
+
+#if defined(GGML_SIMD) && !defined(__ARM_FEATURE_SVE) && !defined(__riscv_v) && defined(GGML_F32_EPR) && \
+    (GGML_F32_EPR == 4 || GGML_F32_EPR == 8 || GGML_F32_EPR == 16)
+#define GGML_TRELLIS_SIMD
+#define GGML_TRELLIS_NV (16 / GGML_F32_EPR)          // registers per 16 output rows
+#define GGML_TRELLIS_CT (GGML_F32_EPR == 16 ? 8 : 4) // columns per pass
+#else
+#define GGML_TRELLIS_CT 4
+#endif
+
+// ys[c][0 .. 15] = the tile row's 16 outputs for column xs[c], c < CT (wt as ggml_trellis_decode_tile_row)
+template <int CT>
+static void ggml_trellis_tile_mm(const float * wt, int64_t K, const float * const * xs, float * const * ys) {
+#ifdef GGML_TRELLIS_SIMD
+    GGML_F32_VEC acc[CT][GGML_TRELLIS_NV];
+    for (int c = 0; c < CT; ++c) {
+        for (int v = 0; v < GGML_TRELLIS_NV; ++v) {
+            acc[c][v] = GGML_F32_VEC_ZERO;
+        }
+    }
+    for (int64_t j = 0; j < K; ++j) {
+        GGML_F32_VEC wv[GGML_TRELLIS_NV];
+        for (int v = 0; v < GGML_TRELLIS_NV; ++v) {
+            wv[v] = GGML_F32_VEC_LOAD(wt + 16 * j + v * GGML_F32_EPR);
+        }
+        for (int c = 0; c < CT; ++c) {
+            const GGML_F32_VEC xv = GGML_F32_VEC_SET1(xs[c][j]);
+            for (int v = 0; v < GGML_TRELLIS_NV; ++v) {
+                acc[c][v] = GGML_F32_VEC_FMA(acc[c][v], wv[v], xv);
+            }
+        }
+    }
+    for (int c = 0; c < CT; ++c) {
+        for (int v = 0; v < GGML_TRELLIS_NV; ++v) {
+            GGML_F32_VEC_STORE(ys[c] + v * GGML_F32_EPR, acc[c][v]);
+        }
+    }
+#else
+    float acc[CT][16] = {};
+    for (int64_t j = 0; j < K; ++j) {
+        const float * wj = wt + 16 * j;
+        for (int c = 0; c < CT; ++c) {
+            const float xv = xs[c][j];
+            for (int r = 0; r < 16; ++r) {
+                acc[c][r] += wj[r] * xv;
+            }
+        }
+    }
+    for (int c = 0; c < CT; ++c) {
+        for (int r = 0; r < 16; ++r) {
+            ys[c][r] = acc[c][r];
+        }
+    }
+#endif
+}
+
+
+// Lamplight 0136: the fast CPU product. Nari's loop above decodes a tile row to fp32 in memory and reads it back for
+// the products; this one decodes each value in registers (the tile's words loaded once, each lane's 16-bit window
+// picked by index) and uses it at once for every token of the pass, so the weights are never written. The value is
+// exact (an integer from its four 6-bit digits) and the products are fp32 as in Nari's loop.
+#if defined(__AVX512F__) && defined(__AVX512BW__)
+#define GGML_TRELLIS_FAST 1
+#elif defined(__AVX2__)
+#define GGML_TRELLIS_FAST 2
+#elif defined(__ARM_NEON) && defined(__aarch64__)
+#define GGML_TRELLIS_FAST 3
+#endif
+
+#ifdef GGML_TRELLIS_FAST
+#define GGML_TRELLIS_FAST_NT 4 // tokens per pass over a tile row's codes
+
+// per width, input c of a tile and output row r: the stream word holding the window's high bits, the next word, and
+// the right shift of that pair; state = low 16 bits of ((H << 32 | L) >> cnt)
+struct ggml_trellis_lanes {
+    int32_t hw[6][16][16], lw[6][16][16], cnt[6][16][16];
+};
+
+static const ggml_trellis_lanes & ggml_trellis_lane_table() {
+    static const ggml_trellis_lanes tab = [] {
+        ggml_trellis_lanes t{};
+        for (int k = 1; k <= 6; ++k) {
+            const int total = 256 * k, nw = 8 * k;
+            for (int c = 0; c < 16; ++c) {
+                for (int r = 0; r < 16; ++r) {
+                    const int p = 8 * (4 * (r % 8) + (c % 8) / 2) + 4 * (r / 8) + 2 * (c / 8) + c % 2;
+                    const int start = ((p + 1) * k - 16 + total) % total;
+                    const int w = start >> 5, sh = 48 - (start & 31);
+                    t.hw[k - 1][c][r] = w;
+                    t.lw[k - 1][c][r] = sh < 32 ? (w + 1) % nw : w;
+                    t.cnt[k - 1][c][r] = sh < 32 ? sh : sh - 32;
+                }
+            }
+        }
+        return t;
+    }();
+    return tab;
+}
+
+#if GGML_TRELLIS_FAST == 1 && defined(__AVX512VBMI__) && defined(__AVX512VBMI2__) && defined(__AVX512VNNI__)
+// Widths 1-4 with AVX-512 VBMI, VBMI2 and VNNI (Ice Lake and newer, Zen 4 and newer): 32 values a register as 16-bit
+// lanes, lane 2 r + e = output row r, input 2 m + e of the tile. The stream is read in 16-bit units (unit u = stream
+// bits 16 u .. 16 u + 15, at 16-bit index u ^ 1 in memory); a window is a funnel shift of two units, both picked with
+// one byte permute from the tile's at most 128 bytes. The multiply by 0x83DCD12D is done in 16-bit halves, the four
+// digits summed to v + 126, and an int16 multiply-add takes inputs 2 m and 2 m + 1 at once. The inputs are int16 with
+// one scale per 16 (s16 folded in), which rounds them far less than CUDA's fp16 activations do.
+#define GGML_TRELLIS_W16 1
+struct ggml_trellis_lanes16 {
+    uint8_t ia[4][8][64], ib[4][8][64]; // per width 1-4 and input pair m: the bytes of each lane's two units
+    uint16_t cnt[4][8][32];             // and its left shift
+};
+
+static const ggml_trellis_lanes16 & ggml_trellis_lane16_table() {
+    static const ggml_trellis_lanes16 tab = [] {
+        ggml_trellis_lanes16 t{};
+        for (int k = 1; k <= 4; ++k) {
+            const int total = 256 * k, units = 16 * k;
+            for (int m = 0; m < 8; ++m) {
+                for (int l = 0; l < 32; ++l) {
+                    const int r = l / 2, c = 2 * m + (l & 1);
+                    const int p = 8 * (4 * (r % 8) + (c % 8) / 2) + 4 * (r / 8) + 2 * (c / 8) + c % 2;
+                    const int start = ((p + 1) * k - 16 + total) % total;
+                    const int ua = (start >> 4) ^ 1, ub = (((start >> 4) + 1) % units) ^ 1;
+                    t.ia[k - 1][m][2 * l] = (uint8_t) (2 * ua);
+                    t.ia[k - 1][m][2 * l + 1] = (uint8_t) (2 * ua + 1);
+                    t.ib[k - 1][m][2 * l] = (uint8_t) (2 * ub);
+                    t.ib[k - 1][m][2 * l + 1] = (uint8_t) (2 * ub + 1);
+                    t.cnt[k - 1][m][l] = (uint16_t) (start & 15);
+                }
+            }
+        }
+        return t;
+    }();
+    return tab;
+}
+
+template <int nt>
+static void ggml_trellis_fast_row16(const uint32_t * words, int k, int64_t kt, const int16_t * const * x16,
+                                    const float * const * dx, const int32_t * const * corr, float * const * ys) {
+    const ggml_trellis_lanes16 & lt = ggml_trellis_lane16_table();
+    const int q = k - 1, nb = 32 * k;  // the tile's bytes
+    const __m512i mlo = _mm512_set1_epi16((short) 0xD12D), mhi = _mm512_set1_epi16((short) 0x83DC);
+    const __m512i m3f = _mm512_set1_epi16(0x3F3F), ones8 = _mm512_set1_epi8(1);
+    const __mmask64 b0 = nb >= 64 ? ~(__mmask64) 0 : (((__mmask64) 1 << nb) - 1);
+    const __mmask64 b1 = nb >= 128 ? ~(__mmask64) 0 : nb > 64 ? (((__mmask64) 1 << (nb - 64)) - 1) : 0;
+    __m512 yacc[nt];
+    for (int t = 0; t < nt; ++t) {
+        yacc[t] = _mm512_setzero_ps();
+    }
+    for (int64_t i = 0; i < kt; ++i) {
+        const uint8_t * tb = (const uint8_t *) (words + i * 8 * k);
+        const __m512i z0 = _mm512_maskz_loadu_epi8(b0, tb);
+        const __m512i z1 = _mm512_maskz_loadu_epi8(b1, tb + 64);
+        __m512i acc[nt];
+        for (int t = 0; t < nt; ++t) {
+            acc[t] = _mm512_setzero_si512();
+        }
+        for (int m = 0; m < 8; ++m) {
+            const __m512i wa = _mm512_permutex2var_epi8(z0, _mm512_loadu_si512(lt.ia[q][m]), z1);
+            const __m512i wb = _mm512_permutex2var_epi8(z0, _mm512_loadu_si512(lt.ib[q][m]), z1);
+            const __m512i st = _mm512_shldv_epi16(wa, wb, _mm512_loadu_si512(lt.cnt[q][m]));
+            const __m512i lo = _mm512_mullo_epi16(st, mlo);
+            const __m512i hi = _mm512_add_epi16(_mm512_mulhi_epu16(st, mlo), _mm512_mullo_epi16(st, mhi));
+            const __m512i dg = _mm512_add_epi16(_mm512_and_si512(_mm512_srli_epi16(lo, 2), m3f),
+                                                _mm512_and_si512(_mm512_srli_epi16(hi, 2), m3f));
+            const __m512i v = _mm512_maddubs_epi16(dg, ones8);  // v + 126
+            for (int t = 0; t < nt; ++t) {
+                int32_t xp;
+                memcpy(&xp, x16[t] + 16 * i + 2 * m, sizeof(xp));
+                acc[t] = _mm512_dpwssd_epi32(acc[t], v, _mm512_set1_epi32(xp));
+            }
+        }
+        for (int t = 0; t < nt; ++t) {
+            const __m512i a = _mm512_sub_epi32(acc[t], _mm512_set1_epi32(corr[t][i]));
+            yacc[t] = _mm512_fmadd_ps(_mm512_cvtepi32_ps(a), _mm512_set1_ps(dx[t][i]), yacc[t]);
+        }
+    }
+    for (int t = 0; t < nt; ++t) {
+        _mm512_storeu_ps(ys[t], yacc[t]);
+    }
+}
+
+// Many tokens (prompt reading): the tile row's values decoded once into buf (v + 126 as int16, 512 bytes a tile, in
+// the register order above: 32 KB per 1024 inputs), then every token's products from there, four tokens a pass
+static void ggml_trellis_fast_decode16(const uint32_t * words, int k, int64_t kt, __m512i * buf) {
+    const ggml_trellis_lanes16 & lt = ggml_trellis_lane16_table();
+    const int q = k - 1, nb = 32 * k;
+    const __m512i mlo = _mm512_set1_epi16((short) 0xD12D), mhi = _mm512_set1_epi16((short) 0x83DC);
+    const __m512i m3f = _mm512_set1_epi16(0x3F3F), ones8 = _mm512_set1_epi8(1);
+    const __mmask64 b0 = nb >= 64 ? ~(__mmask64) 0 : (((__mmask64) 1 << nb) - 1);
+    const __mmask64 b1 = nb >= 128 ? ~(__mmask64) 0 : nb > 64 ? (((__mmask64) 1 << (nb - 64)) - 1) : 0;
+    for (int64_t i = 0; i < kt; ++i) {
+        const uint8_t * tb = (const uint8_t *) (words + i * 8 * k);
+        const __m512i z0 = _mm512_maskz_loadu_epi8(b0, tb);
+        const __m512i z1 = _mm512_maskz_loadu_epi8(b1, tb + 64);
+        for (int m = 0; m < 8; ++m) {
+            const __m512i wa = _mm512_permutex2var_epi8(z0, _mm512_loadu_si512(lt.ia[q][m]), z1);
+            const __m512i wb = _mm512_permutex2var_epi8(z0, _mm512_loadu_si512(lt.ib[q][m]), z1);
+            const __m512i st = _mm512_shldv_epi16(wa, wb, _mm512_loadu_si512(lt.cnt[q][m]));
+            const __m512i lo = _mm512_mullo_epi16(st, mlo);
+            const __m512i hi = _mm512_add_epi16(_mm512_mulhi_epu16(st, mlo), _mm512_mullo_epi16(st, mhi));
+            const __m512i dg = _mm512_add_epi16(_mm512_and_si512(_mm512_srli_epi16(lo, 2), m3f),
+                                                _mm512_and_si512(_mm512_srli_epi16(hi, 2), m3f));
+            _mm512_store_si512(buf + 8 * i + m, _mm512_maddubs_epi16(dg, ones8));
+        }
+    }
+}
+
+template <int nt>
+static void ggml_trellis_fast_gemm16(const __m512i * buf, int64_t kt, const int16_t * const * x16,
+                                     const float * const * dx, const int32_t * const * corr, float * const * ys) {
+    __m512 yacc[nt];
+    for (int t = 0; t < nt; ++t) {
+        yacc[t] = _mm512_setzero_ps();
+    }
+    for (int64_t i = 0; i < kt; ++i) {
+        __m512i acc[nt];
+        for (int t = 0; t < nt; ++t) {
+            acc[t] = _mm512_setzero_si512();
+        }
+        for (int m = 0; m < 8; ++m) {
+            const __m512i v = _mm512_load_si512(buf + 8 * i + m);
+            for (int t = 0; t < nt; ++t) {
+                int32_t xp;
+                memcpy(&xp, x16[t] + 16 * i + 2 * m, sizeof(xp));
+                acc[t] = _mm512_dpwssd_epi32(acc[t], v, _mm512_set1_epi32(xp));
+            }
+        }
+        for (int t = 0; t < nt; ++t) {
+            const __m512i a = _mm512_sub_epi32(acc[t], _mm512_set1_epi32(corr[t][i]));
+            yacc[t] = _mm512_fmadd_ps(_mm512_cvtepi32_ps(a), _mm512_set1_ps(dx[t][i]), yacc[t]);
+        }
+    }
+    for (int t = 0; t < nt; ++t) {
+        _mm512_storeu_ps(ys[t], yacc[t]);
+    }
+}
+
+// the int16 inputs: x16 [K], one scale dx and one 126 sum(x16) corr per 16 inputs
+static void ggml_trellis_fast_quantize(const float * x, int64_t K, int16_t * x16, float * dx, int32_t * corr) {
+    for (int64_t b = 0; b < K / 16; ++b) {
+        const float * v = x + 16 * b;
+        float amax = 0.0f;
+        for (int j = 0; j < 16; ++j) {
+            amax = std::max(amax, std::fabs(v[j]));
+        }
+        const float id = amax > 0.0f ? 32767.0f / amax : 0.0f;
+        int32_t sum = 0;
+        for (int j = 0; j < 16; ++j) {
+            const int32_t qv = (int32_t) lrintf(v[j] * id);
+            x16[16 * b + j] = (int16_t) qv;
+            sum += qv;
+        }
+        dx[b] = amax / 32767.0f;
+        corr[b] = 126 * sum;
+    }
+}
+#endif
+
+#if defined(__AVX2__)
+// Lamplight 0136: every width with AVX2 (and on AVX-512 chips, for widths 5-6 and chips without VBMI): 16 values a
+// register as 16-bit lanes, read from the stream through byte windows. The tile's words are byte-swapped into a linear
+// copy (stream bit q = bit 7 - q % 8 of byte q / 8, with 16 bytes repeated past the end for the wrap), so 8 consecutive
+// ring positions sit inside one 16-byte load. A byte shuffle puts each lane's two 16-bit units in place, multiplies by
+// powers of two do the per-lane shifts, then the same 16-bit hash as above. A register holds positions 8 a .. 8 a + 7
+// in its low half and 8 (a + 4) .. in its high half: rows a / 4 and a / 4 + 1 (+ 8), inputs 2 (a % 4) + {0, 1, 8, 9},
+// so an int16 multiply-add with inputs [x_c x_c+1 x_c+8 x_c+9] gives row sums in pairs.
+#define GGML_TRELLIS_B16 1
+#ifndef GGML_TRELLIS_B16_NT
+#define GGML_TRELLIS_B16_NT 3 // tokens per pass over a decoded tile row
+#endif
+struct ggml_trellis_lanesb {
+    uint8_t off[6][16][2];        // per width and register (pair index 4 (a / 8) + a % 4): the two groups' byte offsets
+    uint8_t i0[6][16][32], i1[6][16][32]; // byte shuffles: unit 0 (bytes B, B + 1), unit 1 (bytes B + 1, B + 2)
+    uint16_t p0[6][16][16], p1[6][16][16]; // 2^r and 2^(8 + r), r the lane's bit offset in byte B
+};
+
+static const ggml_trellis_lanesb & ggml_trellis_laneb_table() {
+    static const ggml_trellis_lanesb tab = [] {
+        ggml_trellis_lanesb t{};
+        for (int k = 1; k <= 6; ++k) {
+            const int total = 256 * k;
+            for (int g = 0; g < 16; ++g) {
+                const int a0 = 8 * (g / 4) + g % 4;
+                for (int h = 0; h < 2; ++h) {
+                    const int a = a0 + 4 * h;
+                    const int s = ((8 * a + 1) * k - 16 + total) % total;
+                    t.off[k - 1][g][h] = (uint8_t) (s >> 3);
+                    for (int j = 0; j < 8; ++j) {
+                        const int b = (s & 7) + j * k, B = b >> 3, r = b & 7;
+                        const int l = 8 * h + j;  // 16-bit lane; byte 2 l is its low byte (within its 128-bit half: 2 j)
+                        t.i0[k - 1][g][16 * h + 2 * j] = (uint8_t) (B + 1);
+                        t.i0[k - 1][g][16 * h + 2 * j + 1] = (uint8_t) B;
+                        t.i1[k - 1][g][16 * h + 2 * j] = (uint8_t) (B + 2);
+                        t.i1[k - 1][g][16 * h + 2 * j + 1] = (uint8_t) (B + 1);
+                        t.p0[k - 1][g][l] = (uint16_t) (1u << r);
+                        t.p1[k - 1][g][l] = (uint16_t) (1u << (8 + r));
+                    }
+                }
+            }
+        }
+        return t;
+    }();
+    return tab;
+}
+
+// the tile's stream as bytes in order, 16 bytes of wrap past the end
+static inline void ggml_trellis_stream_bytes(const uint32_t * tw, int nw, uint8_t * out) {
+    const __m256i sw = _mm256_setr_epi8(3, 2, 1, 0, 7, 6, 5, 4, 11, 10, 9, 8, 15, 14, 13, 12,
+                                        3, 2, 1, 0, 7, 6, 5, 4, 11, 10, 9, 8, 15, 14, 13, 12);
+    for (int w = 0; w < nw; w += 8) {  // nw = 8 k: whole registers
+        _mm256_storeu_si256((__m256i *) (out + 4 * w),
+                            _mm256_shuffle_epi8(_mm256_loadu_si256((const __m256i *) (tw + w)), sw));
+    }
+    memcpy(out + 4 * nw, out, 16);
+}
+
+// register g of a tile: v + 126 as int16 for its 16 positions
+static inline __m256i ggml_trellis_decode_b16(const uint8_t * bytes, const ggml_trellis_lanesb & lt, int q, int g) {
+    const __m256i mlo = _mm256_set1_epi16((short) 0xD12D), mhi = _mm256_set1_epi16((short) 0x83DC);
+    const __m256i m3f = _mm256_set1_epi16(0x3F3F), ones8 = _mm256_set1_epi8(1);
+    const __m256i d = _mm256_inserti128_si256(
+        _mm256_castsi128_si256(_mm_loadu_si128((const __m128i *) (bytes + lt.off[q][g][0]))),
+        _mm_loadu_si128((const __m128i *) (bytes + lt.off[q][g][1])), 1);
+    const __m256i u0 = _mm256_shuffle_epi8(d, _mm256_loadu_si256((const __m256i *) lt.i0[q][g]));
+    const __m256i u1 = _mm256_shuffle_epi8(d, _mm256_loadu_si256((const __m256i *) lt.i1[q][g]));
+    const __m256i st = _mm256_or_si256(_mm256_mullo_epi16(u0, _mm256_loadu_si256((const __m256i *) lt.p0[q][g])),
+                                       _mm256_mulhi_epu16(u1, _mm256_loadu_si256((const __m256i *) lt.p1[q][g])));
+    const __m256i lo = _mm256_mullo_epi16(st, mlo);
+    const __m256i hi = _mm256_add_epi16(_mm256_mulhi_epu16(st, mlo), _mm256_mullo_epi16(st, mhi));
+    const __m256i dg = _mm256_add_epi16(_mm256_and_si256(_mm256_srli_epi16(lo, 2), m3f),
+                                        _mm256_and_si256(_mm256_srli_epi16(hi, 2), m3f));
+    return _mm256_maddubs_epi16(dg, ones8);
+}
+
+// the input pattern of column group j (a % 4) of tile i: int32 lanes [x(2j, 2j+1), x(2j+8, 2j+9)] repeated
+static inline __m256i ggml_trellis_xpat_b16(const int16_t * x, int j) {
+    int32_t p, q;
+    memcpy(&p, x + 2 * j, 4);
+    memcpy(&q, x + 2 * j + 8, 4);
+    return _mm256_unpacklo_epi32(_mm256_set1_epi32(p), _mm256_set1_epi32(q));
+}
+
+// the 16 row sums of a tile from the 4 register-pair accumulators (rows 2 rp, 2 rp + 1 and + 8 in each), minus corr, times dx
+static inline void ggml_trellis_flush_b16(const __m256i * acc, int32_t corr, float dx, __m256 & y0, __m256 & y1) {
+    // hadd(acc0, acc1): rows 0 8 2 10 | 1 9 3 11; hadd(acc2, acc3): rows 4 12 6 14 | 5 13 7 15
+    const __m256i c = _mm256_set1_epi32(corr);
+    const __m256 s = _mm256_set1_ps(dx);
+    y0 = _mm256_fmadd_ps(_mm256_cvtepi32_ps(_mm256_sub_epi32(_mm256_hadd_epi32(acc[0], acc[1]), c)), s, y0);
+    y1 = _mm256_fmadd_ps(_mm256_cvtepi32_ps(_mm256_sub_epi32(_mm256_hadd_epi32(acc[2], acc[3]), c)), s, y1);
+}
+
+static inline void ggml_trellis_store_b16(__m256 y0, __m256 y1, float * ys) {
+    static const int rows0[8] = { 0, 8, 2, 10, 1, 9, 3, 11 }, rows1[8] = { 4, 12, 6, 14, 5, 13, 7, 15 };
+    float t0[8], t1[8];
+    _mm256_storeu_ps(t0, y0);
+    _mm256_storeu_ps(t1, y1);
+    for (int l = 0; l < 8; ++l) {
+        ys[rows0[l]] = t0[l];
+        ys[rows1[l]] = t1[l];
+    }
+}
+
+// a tile row, decoded in registers, for nt (1-2) tokens
+template <int nt>
+static void ggml_trellis_fast_row_b16(const uint32_t * words, int k, int64_t kt, const int16_t * const * x16,
+                                      const float * const * dx, const int32_t * const * corr, float * const * ys) {
+    const ggml_trellis_lanesb & lt = ggml_trellis_laneb_table();
+    const int q = k - 1, nw = 8 * k;
+    alignas(32) uint8_t bytes[6 * 32 + 16];
+    __m256 y0[nt], y1[nt];
+    for (int t = 0; t < nt; ++t) {
+        y0[t] = y1[t] = _mm256_setzero_ps();
+    }
+    for (int64_t i = 0; i < kt; ++i) {
+        ggml_trellis_stream_bytes(words + i * nw, nw, bytes);
+        __m256i acc[nt][4];
+        for (int t = 0; t < nt; ++t) {
+            acc[t][0] = acc[t][1] = acc[t][2] = acc[t][3] = _mm256_setzero_si256();
+        }
+        for (int j = 0; j < 4; ++j) {
+            __m256i xp[nt];
+            for (int t = 0; t < nt; ++t) {
+                xp[t] = ggml_trellis_xpat_b16(x16[t] + 16 * i, j);
+            }
+            for (int rp = 0; rp < 4; ++rp) {
+                const __m256i v = ggml_trellis_decode_b16(bytes, lt, q, 4 * rp + j);
+                for (int t = 0; t < nt; ++t) {
+                    acc[t][rp] = _mm256_add_epi32(acc[t][rp], _mm256_madd_epi16(v, xp[t]));
+                }
+            }
+        }
+        for (int t = 0; t < nt; ++t) {
+            ggml_trellis_flush_b16(acc[t], corr[t][i], dx[t][i], y0[t], y1[t]);
+        }
+    }
+    for (int t = 0; t < nt; ++t) {
+        ggml_trellis_store_b16(y0[t], y1[t], ys[t]);
+    }
+}
+
+// many tokens: the tile row decoded once into buf (16 registers, 512 bytes a tile), then the products from there
+static void ggml_trellis_fast_decode_b16(const uint32_t * words, int k, int64_t kt, __m256i * buf) {
+    const ggml_trellis_lanesb & lt = ggml_trellis_laneb_table();
+    const int q = k - 1, nw = 8 * k;
+    alignas(32) uint8_t bytes[6 * 32 + 16];
+    for (int64_t i = 0; i < kt; ++i) {
+        ggml_trellis_stream_bytes(words + i * nw, nw, bytes);
+        for (int g = 0; g < 16; ++g) {
+            _mm256_store_si256(buf + 16 * i + g, ggml_trellis_decode_b16(bytes, lt, q, g));
+        }
+    }
+}
+
+template <int nt>
+static void ggml_trellis_fast_gemm_b16(const __m256i * buf, int64_t kt, const int16_t * const * x16,
+                                       const float * const * dx, const int32_t * const * corr, float * const * ys) {
+    __m256 y0[nt], y1[nt];
+    for (int t = 0; t < nt; ++t) {
+        y0[t] = y1[t] = _mm256_setzero_ps();
+    }
+    for (int64_t i = 0; i < kt; ++i) {
+        __m256i acc[nt][4];
+        for (int t = 0; t < nt; ++t) {
+            acc[t][0] = acc[t][1] = acc[t][2] = acc[t][3] = _mm256_setzero_si256();
+        }
+        for (int j = 0; j < 4; ++j) {
+            __m256i xp[nt];
+            for (int t = 0; t < nt; ++t) {
+                xp[t] = ggml_trellis_xpat_b16(x16[t] + 16 * i, j);
+            }
+            for (int rp = 0; rp < 4; ++rp) {
+                const __m256i v = _mm256_load_si256(buf + 16 * i + 4 * rp + j);
+                for (int t = 0; t < nt; ++t) {
+                    acc[t][rp] = _mm256_add_epi32(acc[t][rp], _mm256_madd_epi16(v, xp[t]));
+                }
+            }
+        }
+        for (int t = 0; t < nt; ++t) {
+            ggml_trellis_flush_b16(acc[t], corr[t][i], dx[t][i], y0[t], y1[t]);
+        }
+    }
+    for (int t = 0; t < nt; ++t) {
+        ggml_trellis_store_b16(y0[t], y1[t], ys[t]);
+    }
+}
+#endif
+
+#if defined(GGML_TRELLIS_B16) && !defined(GGML_TRELLIS_W16)
+// the int16 inputs: x16 [K], one scale dx and one 126 sum(x16) corr per 16 inputs
+static void ggml_trellis_fast_quantize(const float * x, int64_t K, int16_t * x16, float * dx, int32_t * corr) {
+    for (int64_t b = 0; b < K / 16; ++b) {
+        const float * v = x + 16 * b;
+        float amax = 0.0f;
+        for (int j = 0; j < 16; ++j) {
+            amax = std::max(amax, std::fabs(v[j]));
+        }
+        const float id = amax > 0.0f ? 32767.0f / amax : 0.0f;
+        int32_t sum = 0;
+        for (int j = 0; j < 16; ++j) {
+            const int32_t qv = (int32_t) lrintf(v[j] * id);
+            x16[16 * b + j] = (int16_t) qv;
+            sum += qv;
+        }
+        dx[b] = amax / 32767.0f;
+        corr[b] = 126 * sum;
+    }
+}
+#endif
+
+// ys[t][0 .. 15] = the tile row's 16 outputs for the rotated inputs xs[t], t < nt
+static void ggml_trellis_fast_row(const uint32_t * words, int k, int64_t kt, int nt, const float * const * xs,
+                                  float * const * ys) {
+    const ggml_trellis_lanes & lt = ggml_trellis_lane_table();
+    const int q = k - 1, nw = 8 * k;
+#if GGML_TRELLIS_FAST == 1
+    const __m512i mult = _mm512_set1_epi32((int) 0x83DCD12Du), m16 = _mm512_set1_epi32(0xFFFF);
+    const __m512i m3f = _mm512_set1_epi32(0x3F3F3F3F), ones8 = _mm512_set1_epi8(1), ones16 = _mm512_set1_epi16(1);
+    const __m512i off = _mm512_set1_epi32(126), c32 = _mm512_set1_epi32(32);
+    __m512 yacc[GGML_TRELLIS_FAST_NT];
+    for (int t = 0; t < nt; ++t) {
+        yacc[t] = _mm512_setzero_ps();
+    }
+    const __mmask16 m0 = (__mmask16) (nw >= 16 ? 0xFFFF : (1u << nw) - 1);
+    const __mmask16 m1 = (__mmask16) (nw >= 32 ? 0xFFFF : nw > 16 ? (1u << (nw - 16)) - 1 : 0);
+    const __mmask16 m2 = (__mmask16) (nw > 32 ? (1u << (nw - 32)) - 1 : 0);
+    for (int64_t i = 0; i < kt; ++i) {
+        const uint32_t * tw = words + i * nw;
+        const __m512i z0 = _mm512_maskz_loadu_epi32(m0, tw);
+        const __m512i z1 = _mm512_maskz_loadu_epi32(m1, tw + 16);
+        const __m512i z2 = _mm512_maskz_loadu_epi32(m2, tw + 32);
+        for (int c = 0; c < 16; ++c) {
+            const __m512i ih = _mm512_loadu_si512(lt.hw[q][c]);
+            const __m512i il = _mm512_loadu_si512(lt.lw[q][c]);
+            __m512i H = _mm512_permutex2var_epi32(z0, ih, z1);
+            __m512i L = _mm512_permutex2var_epi32(z0, il, z1);
+            if (k > 4) {  // words 32 .. 8 k - 1 from the third register
+                H = _mm512_mask_permutexvar_epi32(H, _mm512_cmpge_epi32_mask(ih, c32), ih, z2);
+                L = _mm512_mask_permutexvar_epi32(L, _mm512_cmpge_epi32_mask(il, c32), il, z2);
+            }
+            const __m512i cnt = _mm512_loadu_si512(lt.cnt[q][c]);
+#if defined(__AVX512VBMI2__)
+            const __m512i st = _mm512_and_si512(_mm512_shrdv_epi32(L, H, cnt), m16);
+#else
+            const __m512i st = _mm512_and_si512(
+                _mm512_or_si512(_mm512_sllv_epi32(H, _mm512_sub_epi32(c32, cnt)), _mm512_srlv_epi32(L, cnt)), m16);
+#endif
+            const __m512i d = _mm512_and_si512(_mm512_srli_epi32(_mm512_mullo_epi32(st, mult), 2), m3f);
+            const __m512 v = _mm512_cvtepi32_ps(
+                _mm512_sub_epi32(_mm512_madd_epi16(_mm512_maddubs_epi16(d, ones8), ones16), off));
+            for (int t = 0; t < nt; ++t) {
+                yacc[t] = _mm512_fmadd_ps(v, _mm512_set1_ps(xs[t][16 * i + c]), yacc[t]);
+            }
+        }
+    }
+    for (int t = 0; t < nt; ++t) {
+        _mm512_storeu_ps(ys[t], yacc[t]);
+    }
+#elif GGML_TRELLIS_FAST == 2
+    // 8 lanes: rows 0-7 and 8-15 as two halves, a lane's words gathered from the tile (in L1)
+    const __m256i mult = _mm256_set1_epi32((int) 0x83DCD12Du), m16 = _mm256_set1_epi32(0xFFFF);
+    const __m256i m3f = _mm256_set1_epi32(0x3F3F3F3F), ones8 = _mm256_set1_epi8(1), ones16 = _mm256_set1_epi16(1);
+    const __m256i off = _mm256_set1_epi32(126), c32 = _mm256_set1_epi32(32);
+    __m256 yacc[GGML_TRELLIS_FAST_NT][2];
+    for (int t = 0; t < nt; ++t) {
+        yacc[t][0] = yacc[t][1] = _mm256_setzero_ps();
+    }
+    for (int64_t i = 0; i < kt; ++i) {
+        const int * tw = (const int *) (words + i * nw);
+        for (int c = 0; c < 16; ++c) {
+            for (int h = 0; h < 2; ++h) {
+                const __m256i ih = _mm256_loadu_si256((const __m256i *) (lt.hw[q][c] + 8 * h));
+                const __m256i il = _mm256_loadu_si256((const __m256i *) (lt.lw[q][c] + 8 * h));
+                const __m256i cnt = _mm256_loadu_si256((const __m256i *) (lt.cnt[q][c] + 8 * h));
+                const __m256i H = _mm256_i32gather_epi32(tw, ih, 4);
+                const __m256i L = _mm256_i32gather_epi32(tw, il, 4);
+                const __m256i st = _mm256_and_si256(
+                    _mm256_or_si256(_mm256_sllv_epi32(H, _mm256_sub_epi32(c32, cnt)), _mm256_srlv_epi32(L, cnt)), m16);
+                const __m256i d = _mm256_and_si256(_mm256_srli_epi32(_mm256_mullo_epi32(st, mult), 2), m3f);
+                const __m256 v = _mm256_cvtepi32_ps(
+                    _mm256_sub_epi32(_mm256_madd_epi16(_mm256_maddubs_epi16(d, ones8), ones16), off));
+                for (int t = 0; t < nt; ++t) {
+                    yacc[t][h] = _mm256_fmadd_ps(v, _mm256_set1_ps(xs[t][16 * i + c]), yacc[t][h]);
+                }
+            }
+        }
+    }
+    for (int t = 0; t < nt; ++t) {
+        _mm256_storeu_ps(ys[t], yacc[t][0]);
+        _mm256_storeu_ps(ys[t] + 8, yacc[t][1]);
+    }
+#elif GGML_TRELLIS_FAST == 3
+    // 4 lanes: rows in four quarters, a lane's words read from the tile by index
+    const uint32x4_t mult = vdupq_n_u32(0x83DCD12Du), m16 = vdupq_n_u32(0xFFFF), m3f = vdupq_n_u32(0x3F3F3F3F);
+    const int32x4_t c32 = vdupq_n_s32(32);
+    float32x4_t yacc[GGML_TRELLIS_FAST_NT][4];
+    for (int t = 0; t < nt; ++t) {
+        for (int g = 0; g < 4; ++g) {
+            yacc[t][g] = vdupq_n_f32(0.0f);
+        }
+    }
+    for (int64_t i = 0; i < kt; ++i) {
+        const uint32_t * tw = words + i * nw;
+        for (int c = 0; c < 16; ++c) {
+            for (int g = 0; g < 4; ++g) {
+                const int32_t * ih = lt.hw[q][c] + 4 * g, * il = lt.lw[q][c] + 4 * g;
+                const uint32_t hv[4] = { tw[ih[0]], tw[ih[1]], tw[ih[2]], tw[ih[3]] };
+                const uint32_t lv[4] = { tw[il[0]], tw[il[1]], tw[il[2]], tw[il[3]] };
+                const int32x4_t cnt = vld1q_s32(lt.cnt[q][c] + 4 * g);
+                // (H << (32 - cnt)) | (L >> cnt): NEON shifts left by a signed count, right when it is negative
+                const uint32x4_t st = vandq_u32(vorrq_u32(vshlq_u32(vld1q_u32(hv), vsubq_s32(c32, cnt)),
+                                                          vshlq_u32(vld1q_u32(lv), vnegq_s32(cnt))), m16);
+                const uint8x16_t d = vreinterpretq_u8_u32(vandq_u32(vshrq_n_u32(vmulq_u32(st, mult), 2), m3f));
+                // the four digit bytes of each lane summed: pairwise to 16 bits, then to 32
+                const int32x4_t sum = vreinterpretq_s32_u32(vpaddlq_u16(vpaddlq_u8(d)));
+                const float32x4_t v = vcvtq_f32_s32(vsubq_s32(sum, vdupq_n_s32(126)));
+                for (int t = 0; t < nt; ++t) {
+                    yacc[t][g] = vfmaq_n_f32(yacc[t][g], v, xs[t][16 * i + c]);
+                }
+            }
+        }
+    }
+    for (int t = 0; t < nt; ++t) {
+        for (int g = 0; g < 4; ++g) {
+            vst1q_f32(ys[t] + 4 * g, yacc[t][g]);
+        }
+    }
+#endif
+}
+#endif // GGML_TRELLIS_FAST
+
+static int64_t ggml_trellis_pad(int64_t n) {  // floats, to 64 bytes
+    return (n + 15) / 16 * 16;
+}
+
+// per thread: the decoded tile row, or the whole-slice transforms' 2 L floats
+#define GGML_TRELLIS_JB 4 // Lamplight 0136: tile rows decoded per block when many tokens share them (8 K floats each)
+
+static int64_t ggml_trellis_scratch(const int32_t * d, int64_t K, int64_t N) {
+    int64_t s = std::max<int64_t>(16 * K, GGML_TRELLIS_JB * 8 * K);
+    if (d[3] == 2) {
+        s = std::max<int64_t>(s, 2 * K / d[5]);
+    }
+    if (d[0] == 2) {
+        s = std::max<int64_t>(s, 2 * N / d[2]);
+    }
+    return ggml_trellis_pad(s) + (int64_t) CACHE_LINE_SIZE_F32;
+}
+
+// the int16 inputs of the 16-bit product (x16: K T, dx and corr: K T / 16 each), in floats
+static int64_t ggml_trellis_w16_floats(int64_t K, int64_t T) {
+#if defined(GGML_TRELLIS_W16) || defined(GGML_TRELLIS_B16)
+    return ggml_trellis_pad((K * T + 1) / 2) + 2 * ggml_trellis_pad(K * T / 16);
+#else
+    GGML_UNUSED(K);
+    GGML_UNUSED(T);
+    return 0;
+#endif
+}
+
+static int64_t ggml_trellis_work_floats(const ggml_tensor * dst, int n_tasks) {
+    const int64_t K = dst->src[0]->ne[0], N = dst->src[0]->ne[1], T = ggml_nrows(dst->src[1]);
+    return ggml_trellis_pad(K * T) + (dst->src[6] != nullptr ? ggml_trellis_pad(N * T) : 0) +
+           ggml_trellis_w16_floats(K, T) +
+           (int64_t) n_tasks * ggml_trellis_scratch((const int32_t *) dst->op_params, K, N);
+}
+
+// Lamplight 0136: the experts' op (src[7] = ids): the routing lists (E counts, E offsets, n_used T entries), the
+// gathered inputs (K x n_used T), the outputs (N x n_used T), then the 2D op's work for n_used T tokens
+static int64_t ggml_trellis_id_work_floats(const ggml_tensor * dst, int n_tasks) {
+    const ggml_tensor * w = dst->src[0], * ids = dst->src[7];
+    const int64_t K = w->ne[0], N = w->ne[1], E = w->ne[2], R = ids->ne[0] * ids->ne[1];
+    ggml_tensor xf = *dst->src[1];
+    xf.ne[1] = R;
+    xf.ne[2] = xf.ne[3] = 1;
+    ggml_tensor df = *dst;
+    df.src[1] = &xf;
+    df.src[6] = nullptr;
+    df.src[7] = nullptr;
+    return ggml_trellis_pad(2 * E + R) + ggml_trellis_pad(K * R) + ggml_trellis_pad(N * R) +
+           ggml_trellis_work_floats(&df, n_tasks);
+}
+
+size_t ggml_compute_forward_trellis_work_size(const ggml_tensor * dst, int n_tasks) {
+    if (dst->src[7] != nullptr) {
+        return (size_t) ggml_trellis_id_work_floats(dst, n_tasks) * sizeof(float);
+    }
+    return (size_t) ggml_trellis_work_floats(dst, n_tasks) * sizeof(float);
+}
+
+static void ggml_compute_forward_trellis_2d(const ggml_compute_params * params, ggml_tensor * dst);
+
+// Lamplight 0136: coded experts, as mul_mat_id: each used expert's tokens gathered, the 2D op on its slice, scattered
+static void ggml_compute_forward_trellis_id(const ggml_compute_params * params, ggml_tensor * dst) {
+    const ggml_tensor * w    = dst->src[0];
+    const ggml_tensor * x    = dst->src[1];
+    const ggml_tensor * s16  = dst->src[2];
+    const ggml_tensor * pre  = dst->src[3];
+    const ggml_tensor * post = dst->src[4];
+    const ggml_tensor * ids  = dst->src[7];
+    GGML_ASSERT(x->type == GGML_TYPE_F32 && x->nb[0] == sizeof(float));
+    GGML_ASSERT(dst->type == GGML_TYPE_F32 && ggml_is_contiguous(dst));
+    GGML_ASSERT(dst->src[5] == nullptr && dst->src[6] == nullptr);
+
+    const int ith = params->ith, nth = params->nth;
+    const int64_t K = w->ne[0], N = w->ne[1], E = w->ne[2];
+    const int64_t n_used = ids->ne[0], T = ids->ne[1], R = n_used * T, n_x = x->ne[1];
+    GGML_ASSERT(params->wsize >= (size_t) ggml_trellis_id_work_floats(dst, nth) * sizeof(float));
+
+    int32_t * cnt = (int32_t *) params->wdata;  // E counts, E offsets, then the entries (slot + n_used token)
+    int32_t * off = cnt + E;
+    int32_t * ent = off + E;
+    float * xg = (float *) params->wdata + ggml_trellis_pad(2 * E + R);
+    float * yg = xg + ggml_trellis_pad(K * R);
+    float * rest = yg + ggml_trellis_pad(N * R);
+    const size_t rest_size = params->wsize - (size_t) (rest - (float *) params->wdata) * sizeof(float);
+
+    if (ith == 0) {
+        std::fill(cnt, cnt + E, 0);
+        for (int64_t t = 0; t < T; ++t) {
+            const int32_t * row = (const int32_t *) ((const char *) ids->data + t * ids->nb[1]);
+            for (int64_t i1 = 0; i1 < n_used; ++i1) {
+                GGML_ASSERT(row[i1] >= 0 && row[i1] < E);
+                cnt[row[i1]]++;
+            }
+        }
+        int32_t o = 0;
+        for (int64_t e = 0; e < E; ++e) {
+            off[e] = o;
+            o += cnt[e];
+            cnt[e] = 0;
+        }
+        for (int64_t t = 0; t < T; ++t) {
+            const int32_t * row = (const int32_t *) ((const char *) ids->data + t * ids->nb[1]);
+            for (int64_t i1 = 0; i1 < n_used; ++i1) {
+                ent[off[row[i1]] + cnt[row[i1]]++] = (int32_t) (t * n_used + i1);
+            }
+        }
+    }
+    ggml_barrier(params->threadpool);
+
+    const size_t wbytes = ggml_row_size(w->type, K) * (size_t) N;
+    for (int64_t e = 0; e < E; ++e) {
+        const int64_t c = cnt[e];
+        if (c == 0) {
+            continue;
+        }
+        const int32_t * le = ent + off[e];
+        for (int64_t r = ith; r < c; r += nth) {  // the gather
+            const int64_t t = le[r] / n_used, i1 = le[r] % n_used;
+            const float * xc = (const float *) ((const char *) x->data + (i1 % n_x) * x->nb[1] + t * x->nb[2]);
+            memcpy(xg + r * K, xc, K * sizeof(float));
+        }
+        ggml_barrier(params->threadpool);
+
+        // expert e as an ordinary 2D op: views of its slice and sides
+        ggml_tensor we = *w, se = *s16, pe = *pre, qe = *post, xe = *x, de = *dst;
+        we.data = (char *) w->data + e * wbytes;
+        we.ne[2] = 1;
+        we.nb[3] = we.nb[2] = wbytes;
+        se.data = (char *) s16->data + e * s16->nb[1];
+        pe.data = (char *) pre->data + e * pre->nb[1];
+        qe.data = (char *) post->data + e * post->nb[1];
+        se.ne[1] = pe.ne[1] = qe.ne[1] = 1;
+        xe.data = xg;
+        xe.ne[1] = c;
+        xe.ne[2] = xe.ne[3] = 1;
+        xe.nb[1] = K * sizeof(float);
+        xe.nb[2] = xe.nb[3] = c * xe.nb[1];
+        de.data = yg;
+        de.ne[0] = N;
+        de.ne[1] = c;
+        de.ne[2] = de.ne[3] = 1;
+        de.nb[1] = N * sizeof(float);
+        de.nb[2] = de.nb[3] = c * de.nb[1];
+        de.src[0] = &we;
+        de.src[1] = &xe;
+        de.src[2] = &se;
+        de.src[3] = &pe;
+        de.src[4] = &qe;
+        de.src[7] = nullptr;
+        ggml_compute_params pp = *params;
+        pp.wdata = rest;
+        pp.wsize = rest_size;
+        ggml_compute_forward_trellis_2d(&pp, &de);
+        ggml_barrier(params->threadpool);
+
+        for (int64_t r = ith; r < c; r += nth) {  // the scatter
+            const int64_t t = le[r] / n_used, i1 = le[r] % n_used;
+            memcpy((char *) dst->data + i1 * dst->nb[1] + t * dst->nb[2], yg + r * N, N * sizeof(float));
+        }
+        // the next expert's gather writes xg, which this expert's op has finished with; yg is read here only
+        ggml_barrier(params->threadpool);
+    }
+}
+
+void ggml_compute_forward_trellis(const ggml_compute_params * params, ggml_tensor * dst) {
+    if (dst->src[7] != nullptr) {
+        ggml_compute_forward_trellis_id(params, dst);
+        return;
+    }
+    ggml_compute_forward_trellis_2d(params, dst);
+}
+
+static void ggml_compute_forward_trellis_2d(const ggml_compute_params * params, ggml_tensor * dst) {
+    const ggml_tensor * w    = dst->src[0];
+    const ggml_tensor * x    = dst->src[1];
+    const ggml_tensor * s16  = dst->src[2];
+    const ggml_tensor * pre  = dst->src[3];
+    const ggml_tensor * post = dst->src[4];
+    const ggml_tensor * pin  = dst->src[5];
+    const ggml_tensor * pout = dst->src[6];
+    const int32_t * d = (const int32_t *) dst->op_params;
+    const int rows_kind = d[0], rows_block = d[1], rows_shards = d[2];
+    const int cols_kind = d[3], cols_block = d[4], cols_shards = d[5], nparts = d[6];
+    const int32_t * parts = nparts > 0 ? d + 7 : nullptr;
+
+    GGML_ASSERT(x->type == GGML_TYPE_F32 && x->nb[0] == sizeof(float));
+    GGML_ASSERT(dst->type == GGML_TYPE_F32 && ggml_is_contiguous(dst));
+
+    const int ith = params->ith, nth = params->nth;
+    const int k = (int) w->type - (int) GGML_TYPE_TRL1 + 1;
+    const int64_t K = w->ne[0], N = w->ne[1], kt = K / 16, NJ = N / 16;
+    const int64_t T = ggml_nrows(x);
+    const int64_t ne11 = x->ne[1], ne12 = x->ne[2];
+    GGML_ASSERT(ggml_trellis_desc_supported(K, N, d, 7 + nparts));
+
+    GGML_ASSERT(params->wsize >= (size_t) ggml_trellis_work_floats(dst, nth) * sizeof(float));
+    const int64_t scratch = ggml_trellis_scratch(d, K, N);
+    float * xr = (float *) params->wdata;                                   // x_rot, K x T
+    float * yb = pout ? xr + ggml_trellis_pad(K * T) : (float *) dst->data; // the product, N x T
+    float * w16 = xr + ggml_trellis_pad(K * T) + (pout ? ggml_trellis_pad(N * T) : 0);
+    float * sc = w16 + ggml_trellis_w16_floats(K, T) + ith * scratch;
+    GGML_UNUSED(w16);
+
+    const uint32_t * codes = (const uint32_t *) w->data;
+    const ggml_fp16_t * s = (const ggml_fp16_t *) s16->data;
+    const float * a = (const float *) pre->data;
+    const float * b = (const float *) post->data;
+    const int32_t * gin = pin ? (const int32_t *) pin->data : nullptr;
+    const int32_t * gout = pout ? (const int32_t *) pout->data : nullptr;
+
+    // 1. the inputs
+    {
+        const int64_t seg = cols_kind == 2 ? K / cols_shards : cols_kind == 1 ? cols_block : K;
+        const int64_t nseg = K / seg;
+        for (int64_t it = ith; it < T * nseg; it += nth) {
+            const int64_t t = it / nseg, j0 = (it % nseg) * seg;
+            const int64_t i3 = t / (ne11 * ne12), i2 = (t / ne11) % ne12, i1 = t % ne11;
+            const float * xc = (const float *) ((const char *) x->data + i1 * x->nb[1] + i2 * x->nb[2] + i3 * x->nb[3]);
+            float * v = xr + t * K;
+            for (int64_t j = j0; j < j0 + seg; ++j) {
+                v[j] = (gin ? xc[gin[j]] : xc[j]) * a[j];
+            }
+            if (cols_kind == 1) {
+                ggml_trellis_rht(v + j0, seg, cols_block);
+            } else if (cols_kind == 2) {
+                const bool ok = ggml_trellis_hadfull_slice(v, K, nullptr, 0, cols_shards, (int) (j0 / seg), false,
+                                                           nullptr, nullptr, sc);
+                GGML_ASSERT(ok);
+            }
+            for (int64_t j = j0; j < j0 + seg; ++j) {
+                v[j] *= GGML_CPU_FP16_TO_FP32(s[j / 16]);
+            }
+        }
+    }
+    ggml_barrier(params->threadpool);
+
+#ifdef GGML_TRELLIS_FAST
+    // LAMPLIGHT_TRELLIS_CPU=nari: Nari's loop; =exact: fp32 inputs (no int16 rounding), to compare and to test
+    const char * cpu_mode = getenv("LAMPLIGHT_TRELLIS_CPU");
+    const bool use_fast = cpu_mode == nullptr || strcmp(cpu_mode, "nari") != 0;
+    const bool use_w16 = use_fast && (cpu_mode == nullptr || strcmp(cpu_mode, "exact") != 0);
+    GGML_UNUSED(use_w16);
+    const bool force_b16 = cpu_mode != nullptr && strcmp(cpu_mode, "b16") == 0;  // the AVX2 decoder on AVX-512 chips too
+    GGML_UNUSED(force_b16);
+#ifdef GGML_TRELLIS_W16
+    if (use_w16 && k <= 4 && !force_b16) {
+        int16_t * x16 = (int16_t *) w16;
+        float * dxs = w16 + ggml_trellis_pad((K * T + 1) / 2);
+        int32_t * crs = (int32_t *) (dxs + ggml_trellis_pad(K * T / 16));
+        // 1b. the int16 inputs
+        for (int64_t t = ith; t < T; t += nth) {
+            ggml_trellis_fast_quantize(xr + t * K, K, x16 + t * K, dxs + t * kt, crs + t * kt);
+        }
+        ggml_barrier(params->threadpool);
+        // 2. the product, tile row by tile row, a few tokens per pass over the codes
+        const int64_t J0 = NJ * ith / nth, J1 = NJ * (ith + 1) / nth;
+        // from 8 tokens on, decode each tile row once (into this thread's scratch, 64-byte aligned) and reuse it
+        __m512i * buf = (__m512i *) (((uintptr_t) sc + 63) & ~(uintptr_t) 63);
+        const bool once = T >= 8;
+        // a block of tile rows decoded at a time, so each token's inputs are read once a block (they stay in cache)
+        const int64_t jb_max = once ? GGML_TRELLIS_JB : 1;
+        for (int64_t Jb = J0; Jb < J1; Jb += jb_max) {
+            const int64_t jn = std::min<int64_t>(jb_max, J1 - Jb);
+            if (once) {
+                for (int64_t jb = 0; jb < jn; ++jb) {
+                    ggml_trellis_fast_decode16(codes + (Jb + jb) * kt * 8 * k, k, kt, buf + jb * kt * 8);
+                }
+            }
+            const int64_t per = once ? 8 : GGML_TRELLIS_FAST_NT;
+            for (int64_t t0 = 0; t0 < T; t0 += per)
+            for (int64_t jb = 0; jb < jn; ++jb) {
+                const int64_t J = Jb + jb;
+                const __m512i * bj = buf + jb * kt * 8;
+                const int nc = (int) std::min<int64_t>(per, T - t0);
+                const int16_t * xs[8];
+                const float * ds[8];
+                const int32_t * cs[8];
+                float * ys[8];
+                for (int c = 0; c < nc; ++c) {
+                    xs[c] = x16 + (t0 + c) * K;
+                    ds[c] = dxs + (t0 + c) * kt;
+                    cs[c] = crs + (t0 + c) * kt;
+                    ys[c] = yb + (t0 + c) * N + 16 * J;
+                }
+                const uint32_t * wj = codes + J * kt * 8 * k;
+                switch (once ? nc + 8 : nc) {
+                    case 1: ggml_trellis_fast_row16<1>(wj, k, kt, xs, ds, cs, ys); break;
+                    case 2: ggml_trellis_fast_row16<2>(wj, k, kt, xs, ds, cs, ys); break;
+                    case 3: ggml_trellis_fast_row16<3>(wj, k, kt, xs, ds, cs, ys); break;
+                    case 4: ggml_trellis_fast_row16<4>(wj, k, kt, xs, ds, cs, ys); break;
+                    case 9: ggml_trellis_fast_gemm16<1>(bj, kt, xs, ds, cs, ys); break;
+                    case 10: ggml_trellis_fast_gemm16<2>(bj, kt, xs, ds, cs, ys); break;
+                    case 11: ggml_trellis_fast_gemm16<3>(bj, kt, xs, ds, cs, ys); break;
+                    case 12: ggml_trellis_fast_gemm16<4>(bj, kt, xs, ds, cs, ys); break;
+                    case 13: ggml_trellis_fast_gemm16<5>(bj, kt, xs, ds, cs, ys); break;
+                    case 14: ggml_trellis_fast_gemm16<6>(bj, kt, xs, ds, cs, ys); break;
+                    case 15: ggml_trellis_fast_gemm16<7>(bj, kt, xs, ds, cs, ys); break;
+                    default: ggml_trellis_fast_gemm16<8>(bj, kt, xs, ds, cs, ys); break;
+                }
+            }
+        }
+    } else
+#endif
+#ifdef GGML_TRELLIS_B16
+    if (use_w16) {
+        int16_t * x16 = (int16_t *) w16;
+        float * dxs = w16 + ggml_trellis_pad((K * T + 1) / 2);
+        int32_t * crs = (int32_t *) (dxs + ggml_trellis_pad(K * T / 16));
+        // 1b. the int16 inputs
+        for (int64_t t = ith; t < T; t += nth) {
+            ggml_trellis_fast_quantize(xr + t * K, K, x16 + t * K, dxs + t * kt, crs + t * kt);
+        }
+        ggml_barrier(params->threadpool);
+        // 2. the product, tile row by tile row; from 2 tokens on, each tile row decoded once into this thread's scratch
+        const int64_t J0 = NJ * ith / nth, J1 = NJ * (ith + 1) / nth;
+        __m256i * buf = (__m256i *) (((uintptr_t) sc + 63) & ~(uintptr_t) 63);
+        const bool once = T >= 2;
+        const int64_t jb_max = once ? GGML_TRELLIS_JB : 1;
+        for (int64_t Jb = J0; Jb < J1; Jb += jb_max) {
+            const int64_t jn = std::min<int64_t>(jb_max, J1 - Jb);
+            if (once) {
+                for (int64_t jb = 0; jb < jn; ++jb) {
+                    ggml_trellis_fast_decode_b16(codes + (Jb + jb) * kt * 8 * k, k, kt, buf + jb * kt * 16);
+                }
+            }
+            for (int64_t t0 = 0; t0 < T; t0 += GGML_TRELLIS_B16_NT)
+            for (int64_t jb = 0; jb < jn; ++jb) {
+                const int64_t J = Jb + jb;
+                const uint32_t * wj = codes + J * kt * 8 * k;
+                const __m256i * bj = buf + jb * kt * 16;
+                const int nc = (int) std::min<int64_t>(GGML_TRELLIS_B16_NT, T - t0);
+                const int16_t * xs[GGML_TRELLIS_B16_NT];
+                const float * ds[GGML_TRELLIS_B16_NT];
+                const int32_t * cs[GGML_TRELLIS_B16_NT];
+                float * ys[GGML_TRELLIS_B16_NT];
+                for (int c = 0; c < nc; ++c) {
+                    xs[c] = x16 + (t0 + c) * K;
+                    ds[c] = dxs + (t0 + c) * kt;
+                    cs[c] = crs + (t0 + c) * kt;
+                    ys[c] = yb + (t0 + c) * N + 16 * J;
+                }
+                if (once) {
+                    switch (nc) {
+                        case 1: ggml_trellis_fast_gemm_b16<1>(bj, kt, xs, ds, cs, ys); break;
+                        case 2: ggml_trellis_fast_gemm_b16<2>(bj, kt, xs, ds, cs, ys); break;
+#if GGML_TRELLIS_B16_NT > 2
+                        case 3: ggml_trellis_fast_gemm_b16<3>(bj, kt, xs, ds, cs, ys); break;
+#endif
+#if GGML_TRELLIS_B16_NT > 3
+                        default: ggml_trellis_fast_gemm_b16<4>(bj, kt, xs, ds, cs, ys); break;
+#endif
+                    }
+                } else {
+                    ggml_trellis_fast_row_b16<1>(wj, k, kt, xs, ds, cs, ys);
+                }
+            }
+        }
+    } else
+#endif
+    if (use_fast) {
+        // 2. the product, tile row by tile row, a few tokens per pass over the codes
+        const int64_t J0 = NJ * ith / nth, J1 = NJ * (ith + 1) / nth;
+        for (int64_t J = J0; J < J1; ++J) {
+            for (int64_t t0 = 0; t0 < T; t0 += GGML_TRELLIS_FAST_NT) {
+                const int nc = (int) std::min<int64_t>(GGML_TRELLIS_FAST_NT, T - t0);
+                const float * xs[GGML_TRELLIS_FAST_NT];
+                float * ys[GGML_TRELLIS_FAST_NT];
+                for (int c = 0; c < nc; ++c) {
+                    xs[c] = xr + (t0 + c) * K;
+                    ys[c] = yb + (t0 + c) * N + 16 * J;
+                }
+                ggml_trellis_fast_row(codes + J * kt * 8 * k, k, kt, nc, xs, ys);
+            }
+        }
+    } else
+#endif
+    // 2. the product, tile row by tile row
+    {
+        const int64_t J0 = NJ * ith / nth, J1 = NJ * (ith + 1) / nth;
+        for (int64_t J = J0; J < J1; ++J) {
+            ggml_trellis_decode_tile_row(codes + J * kt * 8 * k, k, kt, sc);
+            for (int64_t t0 = 0; t0 < T; t0 += GGML_TRELLIS_CT) {
+                const int nc = (int) std::min<int64_t>(GGML_TRELLIS_CT, T - t0);
+                const float * xs[GGML_TRELLIS_CT];
+                float * ys[GGML_TRELLIS_CT];
+                for (int c = 0; c < nc; ++c) {
+                    xs[c] = xr + (t0 + c) * K;
+                    ys[c] = yb + (t0 + c) * N + 16 * J;
+                }
+                switch (nc) {
+                    case 1: ggml_trellis_tile_mm<1>(sc, K, xs, ys); break;
+                    case 2: ggml_trellis_tile_mm<2>(sc, K, xs, ys); break;
+                    case 3: ggml_trellis_tile_mm<3>(sc, K, xs, ys); break;
+#if GGML_TRELLIS_CT > 4
+                    case 4: ggml_trellis_tile_mm<4>(sc, K, xs, ys); break;
+                    case 5: ggml_trellis_tile_mm<5>(sc, K, xs, ys); break;
+                    case 6: ggml_trellis_tile_mm<6>(sc, K, xs, ys); break;
+                    case 7: ggml_trellis_tile_mm<7>(sc, K, xs, ys); break;
+#endif
+                    default: ggml_trellis_tile_mm<GGML_TRELLIS_CT>(sc, K, xs, ys); break;
+                }
+            }
+        }
+    }
+    ggml_barrier(params->threadpool);
+
+    // 3. the output side and post
+    {
+        const int64_t seg = rows_kind == 2 ? N / rows_shards : rows_kind == 1 ? rows_block : N;
+        const int64_t nseg = N / seg;
+        for (int64_t it = ith; it < T * nseg; it += nth) {
+            const int64_t t = it / nseg, i0 = (it % nseg) * seg;
+            float * v = yb + t * N;
+            if (rows_kind == 2) {  // a slice gathers its entries from the fused parts: post on its own entries
+                const bool ok = ggml_trellis_hadfull_slice(v, N, parts, nparts, rows_shards, (int) (i0 / seg), true,
+                                                           nullptr, b, sc);
+                GGML_ASSERT(ok);
+                continue;
+            }
+            if (rows_kind == 1) {
+                ggml_trellis_rht(v + i0, seg, rows_block);
+            }
+            for (int64_t i = i0; i < i0 + seg; ++i) {
+                v[i] *= b[i];
+            }
+        }
+    }
+
+    // 4. the output gather
+    if (gout) {
+        ggml_barrier(params->threadpool);
+        float * y = (float *) dst->data;
+        for (int64_t t = ith; t < T; t += nth) {
+            const float * v = yb + t * N;
+            float * o = y + t * N;
+            for (int64_t i = 0; i < N; ++i) {
+                o[i] = v[gout[i]];
+            }
+        }
+    }
+}
+
+#undef GGML_TRELLIS_CT
+#ifdef GGML_TRELLIS_SIMD
+#undef GGML_TRELLIS_NV
+#undef GGML_TRELLIS_SIMD
+#endif
