+// Brain Engine 0111: fused loop controllers. Where weights of one kind lie side by side in one buffer (same type, the
+// next one starting where the last one ends), one tensor reads them all: no copy, no extra memory, the same numbers.
+// Anything else (another device, a file order that differs under mmap, an adapter) keeps the separate weights.
+static bool loop_side_by_side(const std::vector<ggml_tensor *> & ts) {
+    for (size_t i = 0; i < ts.size(); ++i) {
+        const ggml_tensor * t = ts[i];
+        // (a tensor with extra data, a split over several cards or a repacked one, is left alone)
+        if (!t || !t->buffer || !t->data || t->view_src || t->extra || !ggml_is_contiguous(t) || t->type != ts[0]->type ||
+            t->buffer != ts[0]->buffer || !ggml_are_same_shape(t, ts[0])) {
+            return false;
+        }
+        if (i > 0 && (const char *) t->data != (const char *) ts[i - 1]->data + ggml_nbytes(ts[i - 1])) {
+            return false;
+        }
+    }
+    return !ts.empty();
+}
