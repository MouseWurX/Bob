+            kv->set_input_tier_idxs(inp->tier_idxs[t], ubatch, t);
+        }
+        if (t < inp->tier_mask.size() && inp->tier_mask[t] && inp->tier_mask[t]->buffer) {
+            kv->set_input_tier_mask(inp->tier_mask[t], ubatch, t);
