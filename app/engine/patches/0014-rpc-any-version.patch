+static constexpr uint32_t BOB_WIRE_OP_COUNT = sizeof(bob_wire_ops) / sizeof(bob_wire_ops[0]);
+static constexpr bool bob_wire_covers_every_op() {
+    for (int op = 0; op < GGML_OP_COUNT; op++) {
+        bool found = false;
+        for (uint32_t w = 0; w < BOB_WIRE_OP_COUNT; w++) {
+            found = found || bob_wire_ops[w] == op;
+        }
+        if (!found) {
+            return false;
+        }
+    }
+    return true;
+}
+static_assert(bob_wire_covers_every_op(), "llama.cpp added a step: add it at the end of bob_wire_ops (Brain Engine 0014)");
+static const std::vector<uint32_t> & bob_local_to_wire() {
+    static const std::vector<uint32_t> map = [] {
+        std::vector<uint32_t> m(GGML_OP_COUNT, UINT32_MAX);
+        for (uint32_t w = 0; w < BOB_WIRE_OP_COUNT; w++) {
+            if (bob_wire_ops[w] >= 0 && bob_wire_ops[w] < GGML_OP_COUNT) {
+                m[bob_wire_ops[w]] = w;
+            }
+        }
+        return m;
+    }();
+    return map;
+}
+// local op -> wire number, UINT32_MAX when this step has no wire number yet
+static uint32_t bob_op_to_wire(int op) {
+    return (op >= 0 && op < GGML_OP_COUNT) ? bob_local_to_wire()[op] : UINT32_MAX;
+}
+// wire number -> local op, -1 when this build has no such step
+static int bob_op_from_wire(uint32_t w) {
+    return w < BOB_WIRE_OP_COUNT ? bob_wire_ops[w] : -1;
+}
