+            // Brain Engine 0064 (LLAMA_MOE_STEP_FIT=1, off unless set): the working memory grows about in a line with the
+            // step (need = a + b x tokens), so a line fitted to the steps measured above gives the biggest step on a
+            // 256-token grid that fits what the cache lends, not just a power of two.
+            // The step it picks is measured again before it's used. From Avalon's ubatch_fit (freriadoc/Avalon, MIT).
+            const bool step_fit = [] { const char * v = getenv("LLAMA_MOE_STEP_FIT"); return v && atoi(v) > 0; }();
+            if (step_fit) {
+                std::vector<std::pair<double, double>> pts = { { (double) own_ub, (double) own } };
+                for (const auto & [u, need] : needs) {
+                    pts.emplace_back((double) u, (double) need);
+                }
+                if (pts.size() >= 2) {
+                    double mx = 0, my = 0;
+                    for (const auto & [x, y] : pts) { mx += x; my += y; }
+                    mx /= pts.size(); my /= pts.size();
+                    double sxx = 0, sxy = 0;
+                    for (const auto & [x, y] : pts) { sxx += (x - mx)*(x - mx); sxy += (x - mx)*(y - my); }
