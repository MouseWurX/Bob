+    // upload the missing experts, consecutive experts going to consecutive slots are uploaded together
+    // Brain Engine 0050: runs that are not in RAM are read from the drive first (dr_upload), all of a layer's at once
+    // Brain Engine 0069: a member, so the in-place reads upload their misses the same way
+    size_t upload_fills(ggml_backend_t backend, const layer & l, group & g, const std::vector<moe_cache_lru::fill> & up) {
+        size_t bytes = 0;
+        if (dr_on) {
+            dr_jobs.clear();
+        }
+        for (size_t ip = 0; ip < l.experts.size(); ++ip) {
+            const ggml_tensor * w    = l.experts[ip];
+            ggml_tensor       * bank = g.banks[ip];
+            const size_t expert_size = w->nb[2];
+            for (size_t i = 0; i < up.size();) {
+                // Brain Engine 0060: through the RAM cache, one expert at a time
+                if (rc_on && rc_take(backend, w, bank, up[i].expert, (size_t) up[i].slot*bank->nb[2])) {
+                    bytes += expert_size;
+                    i += 1;
+                    continue;
+                }
+                size_t n = 1;
+                while (!striped(bank, w) && !rc_on && i + n < up.size() && up[i + n].expert == up[i].expert + (int32_t) n && up[i + n].slot == up[i].slot + (int32_t) n) {
+                    n++;
+                }
+                const uint8_t * src = (const uint8_t *) w->data + up[i].expert*expert_size;
+                const size_t    dst = (size_t) up[i].slot*bank->nb[2];
+                if (!dr_on || !dr_want(w, src, n*expert_size)) {
+                    ggml_backend_tensor_set_async(backend, bank, src, dst, n*expert_size);
+                    if (rf_on) {
+                        rf_note(w, src, n*expert_size);
+                    }
+                } else {
+                    dr_jobs.push_back({ w, bank, (size_t) up[i].expert*expert_size, dst, n*expert_size, nullptr });
+                }
+                bytes += n*expert_size;
+                i += n;
+            }
+        }
+        if (dr_on && !dr_jobs.empty()) {
+            dr_upload(backend);
+        }
+        return bytes;
+    }
