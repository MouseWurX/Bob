+    base.x_nb2 = (uint32_t) (x->nb[2] / sizeof(float));
+    base.x_nb3 = (uint32_t) (x->nb[3] / sizeof(float));
+    base.x_ne1 = (uint32_t) x->ne[1];
+    base.x_ne2 = (uint32_t) x->ne[2];
+    base.d_offset = d_off;
+    if (ids) {  // row r reads x[:, slot % n_x, token]; with one shared input the slot stride is 0
