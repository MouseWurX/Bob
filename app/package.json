  "bob": {
    "release": "1.5",
    "patch": 229,
    "branch": "",
    "build": 281,
    "bundledLlamaTag": "b12282",
    "brainEngineVersion": 7,
    "brainEngine": {
      "tag": "brain-engine-7b12282",
      "win-x64": "sha256:c8070764a86696efb338d04a59c7ceb837d897e53cb08201342bdc1f4a5f696e",
      "linux-x64": "sha256:ec5dbb112ebe965ecdf6c2f70bf60b093d27a3693570624b5567a1e4874e89b7"
    },
    "electronSha256": "88e08039d0ef359bab9f674e8051fa103bd8628ea7c5a5e1daaa610a8a0c6931",
    "layout": "From 0.9.32 Bob app\\Bob.exe is Electron's official electron.exe (devDependencies.electron), only renamed, and Bob's files sit in Bob app\\resources\\app. Updates never build an exe. electronSha256 (optional) pins the official zip's checksum; otherwise it is checked against Electron's SHASUMS256.txt. electron-builder (dist scripts) is only for making a portable exe by hand.",
    "note": "Version = <release>.<patch> from 1.0.0 (formatVersion in src/config.js): 1.0.1 for fixes, 1.1.0 (release 1.1, patch 0) for new features, a letter for unmerged branch work (1.0.1a). Before 1.0 it was 0.9.<build>. build goes up by one with every drop and never resets; the update check compares it. Git tags are v<version>."
  },
  "main": "electron/main.cjs",
  "desktopName": "bob.desktop",
  "author": "MouseWurX",
  "homepage": "https://github.com/MouseWurX/Bob",
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "ca.mousewurx.bob",
    "productName": "Bob",
    "copyright": "MouseWurX",
    "asar": true,
    "publish": null,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "src/**",
      "public/**",
      "audio/**",
      "model3d/**",
      "installer/**",
      "catalog.json",
      "config.example.json",
      "package.json",
      {
        "from": "..",
        "to": ".",
        "filter": [
          "LICENSE",
          "README.md"
        ]
      },
      {
        "from": "docs/legal",
        "to": "legal"
      },
      "engines/**"
    ],
    "win": {
      "icon": "public/icons/bob.ico",
      "target": [
        "portable",
        "nsis"
      ],
      "artifactName": "Bob-${version}-${arch}.${ext}"
    },
    "linux": {
      "syncDesktopName": true,
      "icon": "public/icons/bob-512.png",
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "synopsis": "A local AI who lives on your PC",
      "executableName": "bob",
      "artifactName": "Bob-${version}-linux-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "Bob",
          "StartupWMClass": "Bob"
        }
      }
    },
    "deb": {
      "packageName": "bob",
      "maintainer": "MouseWurX <https://github.com/MouseWurX/Bob>",
      "vendor": "MouseWurX",
      "recommends": [
        "libappindicator3-1",
        "pkexec | policykit-1"
      ]
    },
    "flatpak": {
      "runtime": "org.freedesktop.Platform",
      "runtimeVersion": "25.08",
      "sdk": "org.freedesktop.Sdk",
      "base": "org.electronjs.Electron2.BaseApp",
      "baseVersion": "25.08",
      "branch": "stable",
      "finishArgs": [
        "--socket=wayland",
        "--socket=x11",
        "--share=ipc",
        "--device=all",
        "--socket=pulseaudio",
        "--filesystem=home",
        "--filesystem=xdg-config/autostart:create",
        "--share=network",
        "--talk-name=org.freedesktop.Notifications",
        "--talk-name=org.kde.StatusNotifierWatcher",
        "--talk-name=org.freedesktop.Flatpak"
      ]
    },
    "portable": {
      "artifactName": "Bob-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Bob-Setup-${version}.exe"
    },
    "asarUnpack": [
      "audio/**",
      "model3d/**",
      "engines/**"
    ]
  }
}
