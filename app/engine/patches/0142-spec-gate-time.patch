     float  spec_gate_rate   = 0.0f;
     size_t spec_gate_pauses = 0;
+    bool   spec_gate_time   = false; // Brain Engine 0142: LLAMA_SPEC_GATE_TIME=1
+    size_t spec_time_pauses = 0;
 
     mtmd_context * mctx = nullptr;
     mtmd_helper_cap mtmd_cap = {};
@@ -1671,6 +1725,11 @@ private:
     // this may also be called to resume from sleeping state
     bool load_model(common_params & params) {
         spec_gate_rate = 0.0f; // Brain Engine 0017: a context change may have turned the key off
+        spec_gate_time = false;
+        if (const char * gt = getenv("LLAMA_SPEC_GATE_TIME"); gt != nullptr && strcmp(gt, "1") == 0) {
+            spec_gate_time = true; // Brain Engine 0142
+            SRV_INF("%s", "drafts go on only while they write faster (LLAMA_SPEC_GATE_TIME=1)\n");
+        }
         if (const char * g = getenv("LLAMA_SPEC_GATE"); g != nullptr && *g != '\0') {
             const float v = (float) atof(g);
             if (v > 0.0f && v < 1.0f) {
@@ -4786,7 +4845,21 @@ private:
                 const bool use_ckpt_tgt = ctx_tgt_seq_rm_type == COMMON_CONTEXT_SEQ_RM_TYPE_FULL;
                 const bool use_ckpt_dft = ctx_dft_seq_rm_type == COMMON_CONTEXT_SEQ_RM_TYPE_FULL;
 
+                // Brain Engine 0142: the last round's time, and a pause while drafting writes slower
+                if (spec_gate_time && !slot.spec_is_replay && slot.spec_draft.empty() && slot.spec_time_step()) {
+                    spec_time_pauses++;
+                    SLT_INF(slot, "drafts paused for %d words: %.3f words/ms with drafts, %.3f without (time pause %zu)\n",
+                            slot.spec_gate_skip, slot.spt_rate[1], slot.spt_rate[0], spec_time_pauses);
+                }
                 const int n_draft_max = slot.get_n_draft_max();
+                if (spec_gate_time && !slot.spec_is_replay && slot.spec_draft.empty()) {
+                    slot.spt_last_drafted = n_draft_max > 0;
+                    // tests only: a drafter that costs this many ms a round, so the gate's choice can be checked
+                    static const int test_ms = getenv("LLAMA_SPEC_GATE_TIME_TEST_DRAFT_MS") ? atoi(getenv("LLAMA_SPEC_GATE_TIME_TEST_DRAFT_MS")) : 0;
+                    if (test_ms > 0 && n_draft_max > 0) {
+                        std::this_thread::sleep_for(std::chrono::milliseconds(test_ms));
+                    }
+                }
                 if (slot.spec_gate_skip > 0) {
                     slot.spec_gate_skip--; // Brain Engine 0034: one word written without a draft
                 }
