+// ggml_moe_doorbell (Brain Engine 0042)
+
+static void ggml_moe_doorbell_params(struct ggml_tensor * t, int32_t mode, int32_t n_slots, int32_t layer, int32_t timeout_ms,
+        struct ggml_moe_doorbell * bell, void * bell_dev) {
+    int32_t params[8] = { mode, n_slots, layer, timeout_ms, 0, 0, 0, 0 };
+    const int64_t host = (int64_t) (intptr_t) bell;
+    const int64_t dev  = (int64_t) (intptr_t) bell_dev;
+    memcpy(params + 4, &host, sizeof(host));
+    memcpy(params + 6, &dev,  sizeof(dev));
+    ggml_set_op_params(t, params, sizeof(params));
+}
+
+struct ggml_tensor * ggml_moe_doorbell_ring(
+        struct ggml_context      * ctx,
+        struct ggml_tensor       * cur,
+        struct ggml_tensor       * ids,
+        struct ggml_tensor       * slot_map,
+        int32_t                    n_slots,
+        int32_t                    layer,
+        struct ggml_moe_doorbell * bell,
+        void                     * bell_dev) {
+    GGML_ASSERT(cur->type == GGML_TYPE_F32 && ggml_is_contiguous(cur));
+    GGML_ASSERT(ids->type == GGML_TYPE_I32 && ggml_is_contiguous(ids) && ids->ne[2] == 1 && ids->ne[3] == 1);
+    GGML_ASSERT(slot_map->type == GGML_TYPE_I32 && ggml_is_contiguous(slot_map));
+    GGML_ASSERT(ggml_nelements(cur) == cur->ne[0]*ids->ne[1]);
+    GGML_ASSERT(ids->ne[0] <= GGML_MOE_DOORBELL_MAX_USED && ids->ne[1] <= GGML_MOE_DOORBELL_MAX_TOKENS);
+    GGML_ASSERT(bell != NULL);
+
+    struct ggml_tensor * result = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, ids->ne[0], ids->ne[1]);
+    ggml_moe_doorbell_params(result, 0, n_slots, layer, 0, bell, bell_dev);
+
+    result->op     = GGML_OP_MOE_DOORBELL;
+    result->src[0] = cur;
+    result->src[1] = ids;
+    result->src[2] = slot_map;
+
+    return result;
+}
+
+struct ggml_tensor * ggml_moe_doorbell_join(
+        struct ggml_context      * ctx,
+        struct ggml_tensor       * cached,
+        struct ggml_tensor       * slots,
+        int32_t                    n_slots,
+        int32_t                    layer,
+        int32_t                    timeout_ms,
+        struct ggml_moe_doorbell * bell,
+        void                     * bell_dev) {
+    GGML_ASSERT(cached->type == GGML_TYPE_F32 && cached->nb[0] == sizeof(float));
+    GGML_ASSERT(slots->type == GGML_TYPE_I32 && ggml_is_contiguous(slots));
+    GGML_ASSERT(cached->ne[1] == slots->ne[0] && cached->ne[2] == slots->ne[1] && cached->ne[3] == 1);
+    GGML_ASSERT(bell != NULL);
+
+    struct ggml_tensor * result = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, cached->ne[0], cached->ne[1], cached->ne[2]);
+    ggml_moe_doorbell_params(result, 1, n_slots, layer, timeout_ms, bell, bell_dev);
+
+    result->op     = GGML_OP_MOE_DOORBELL;
+    result->src[0] = cached;
+    result->src[1] = slots;
+
+    return result;
+}
