 };
 
+// Brain Engine 0035: a brain kept between two contexts, and what its placement depended on
+static llama_model * g_kept_model = nullptr;
+static std::string   g_kept_placement;
+
+static std::string common_model_placement(const common_params & params, const llama_model_params & mp) {
+    if (!params.lora_adapters.empty() || mp.vocab_only || mp.no_alloc || mp.kv_overrides != nullptr) {
+        return "";
+    }
+    std::string s;
+    for (const auto & path : params.model.get_paths()) {
+        s += path + "\n";
+    }
+    s += string_format("ngl %d split %d load %d lazy %d main %d check %d extra %d nohost %d mtp %d\n", mp.n_gpu_layers, (int) mp.split_mode,
+        (int) mp.load_mode, (int) mp.lazy_mode, mp.main_gpu, mp.check_tensors, mp.use_extra_bufts, mp.no_host, mp.load_mtp);
+    if (mp.tensor_split != nullptr) {
+        for (size_t i = 0; i < llama_max_devices(); ++i) {
+            s += string_format("%g ", mp.tensor_split[i]);
+        }
+        s += "\n";
+    }
+    for (const ggml_backend_dev_t * d = mp.devices; d != nullptr && *d != nullptr; ++d) {
+        s += string_format("dev %s\n", ggml_backend_dev_name(*d));
+    }
+    for (const llama_model_tensor_buft_override * o = mp.tensor_buft_overrides; o != nullptr && o->pattern != nullptr; ++o) {
+        s += string_format("ovr %s %s\n", o->pattern, o->buft ? ggml_backend_buft_name(o->buft) : "-");
+    }
+    return s;
+}
+
+bool common_init_result::keep_model_for_next() {
+    if (!pimpl->model || pimpl->placement.empty()) {
+        return false;
+    }
+    if (g_kept_model != nullptr && g_kept_model != pimpl->model.get()) {
+        llama_model_free(g_kept_model);
+    }
+    // the context goes now; the rest is freed with this object, the brain stays
+    pimpl->context.reset();
+    g_kept_model     = pimpl->model.release();
+    g_kept_placement = pimpl->placement;
+    return true;
+}
+
 static const std::map<common_decision_type, std::string> COMMON_DECISION_TYPE_NAMES = {
     { COMMON_DECISION_TYPE_OPENJEV,        "openjev"       },
     { COMMON_DECISION_TYPE_LEV,            "lev"           },
@@ -1280,7 +1325,23 @@ common_init_result::common_init_result(common_params & params, bool model_only)
 
     common_fit_apply(params, mparams, cparams);
 
-    llama_model * model = common_model_load(params.model.get_paths(), mparams);
+    // Brain Engine 0035: a brain kept from the last context with the same placement is used again, no load
+    pimpl->placement = common_model_placement(params, mparams);
+    llama_model * model = nullptr;
+    if (g_kept_model != nullptr) {
+        if (!pimpl->placement.empty() && pimpl->placement == g_kept_placement) {
+            model = g_kept_model;
+            COM_INF("%s", "brain kept loaded: only the context is made again\n");
+        } else {
+            COM_INF("%s", "brain loaded again: its placement changed (layers, devices or overrides)\n");
+            llama_model_free(g_kept_model);
+        }
+        g_kept_model = nullptr;
+        g_kept_placement.clear();
+    }
+    if (model == nullptr) {
+        model = common_model_load(params.model.get_paths(), mparams);
+    }
     if (model == NULL) {
         return;
     }
