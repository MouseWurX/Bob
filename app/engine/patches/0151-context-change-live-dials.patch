+    // moves layers between the card and home on the kept brain (no context alive). A move that fails is undone,
+    // with every other move of this request, and the reason is given back; the rest of the switch goes on.
+    static json card_layers_apply(llama_model * model, ggml_backend_dev_t dev, const std::vector<int> & want) {
+        json out = json::object();
+        if (model == nullptr) {
+            out["error"] = "the brain could not stay loaded, so no layers moved";
+            return out;
+        }
+        const int64_t t0 = ggml_time_us();
+        const int n_layer = llama_model_n_layer(model);
+        std::vector<std::pair<int, ggml_backend_dev_t>> undo; // what to put back if a move fails
+        int64_t up = 0, home = 0;
+        std::string err;
+        for (int il = 0; il < n_layer && err.empty(); il++) { // homes first: they free room
+            ggml_backend_dev_t now = llama_model_layer_moved_to(model, il);
+            const bool wanted = std::find(want.begin(), want.end(), il) != want.end();
+            if (now != nullptr && (!wanted || now != dev)) {
+                char e[256] = "";
+                const int64_t n = llama_model_layer_place(model, il, nullptr, e, sizeof(e));
+                if (n < 0) {
+                    err = e;
+                } else {
+                    home += n;
+                    undo.emplace_back(il, now);
+                }
+            }
+        }
+        for (int il : want) {
+            if (!err.empty()) {
+                break;
+            }
+            if (il >= n_layer) {
+                err = "layer " + std::to_string(il) + " is not in this brain (it has " + std::to_string(n_layer) + ")";
+                break;
+            }
+            if (llama_model_layer_moved_to(model, il) == dev) {
+                continue;
+            }
+            char e[256] = "";
+            const int64_t n = llama_model_layer_place(model, il, dev, e, sizeof(e));
+            if (n < 0) {
+                err = e;
+            } else if (n > 0) {
+                up += n;
+                undo.emplace_back(il, nullptr);
+            }
+        }
+        if (!err.empty()) {
+            for (auto it = undo.rbegin(); it != undo.rend(); ++it) {
+                char e[256] = "";
+                if (llama_model_layer_place(model, it->first, nullptr, e, sizeof(e)) >= 0 && it->second != nullptr) {
+                    llama_model_layer_place(model, it->first, it->second, e, sizeof(e));
