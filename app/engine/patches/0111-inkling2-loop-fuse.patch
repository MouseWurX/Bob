+    // one tensor of shape ne over the memory of ts (side by side, checked first)
+    auto over = [&](const std::vector<ggml_tensor *> & ts, std::initializer_list<int64_t> ne, const std::string & name) -> ggml_tensor * {
+        if (!loop_side_by_side(ts)) {
+            return nullptr;
+        }
+        const int64_t * d = ne.begin();
