+// emask
+
+ggml_tensor * llama_adapter_emask::tensor_for(int il) const {
+    if (!active || il < 0 || (size_t) il >= tensors.size()) {
+        return nullptr;
+    }
+
+    return tensors[il];
+}
+
+bool llama_adapter_emask::init(const llama_model & model) {
+    const auto & hparams = model.hparams;
+
+    GGML_ASSERT(tensors.empty());
+
+    std::map<ggml_backend_buffer_type_t, ggml_context *> ctx_map;
+    auto ctx_for_buft = [&](ggml_backend_buffer_type_t buft) -> ggml_context * {
+        auto it = ctx_map.find(buft);
+        if (it != ctx_map.end()) {
+            return it->second;
+        }
+
+        ggml_init_params params = {
+            /*.mem_size   =*/ hparams.n_layer()*ggml_tensor_overhead(),
+            /*.mem_buffer =*/ NULL,
+            /*.no_alloc   =*/ true,
+        };
+
+        ggml_context * ctx = ggml_init(params);
+        if (ctx) {
+            ctx_map[buft] = ctx;
+            ctxs.emplace_back(ctx);
+        }
+
+        return ctx;
+    };
+
+    tensors.reserve(hparams.n_layer());
+    for (size_t il = 0; il < hparams.n_layer(); il++) {
+        ggml_context * ctx = ctx_for_buft(model.select_buft(il));
+        if (!ctx) {
+            LLAMA_LOG_ERROR("%s: failed to allocate context for expert mask\n", __func__);
+            return false;
+        }
+        tensors.push_back(ggml_new_tensor_1d(ctx, GGML_TYPE_F32, hparams.n_expert));
+    }
+
+    for (auto it : ctx_map) {
+        ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors_from_buft(it.second, it.first);
+        if (!buf) {
+            LLAMA_LOG_ERROR("%s: failed to allocate buffer for expert mask\n", __func__);
+            return false;
+        }
+        ggml_backend_buffer_clear(buf, 0);
+        bufs.emplace_back(buf);
+    }
+
+    return true;
+}
+
+bool llama_adapter_emask::apply(const llama_model & model, const uint8_t * keep, size_t len) {
+    const auto & hparams = model.hparams;
+
+    if (keep == nullptr) {
+        active = false;
+        return true;
+    }
+
+    const size_t n_expert = hparams.n_expert;
+    const size_t n_layer  = hparams.n_layer();
+
+    if (n_expert == 0) {
+        LLAMA_LOG_ERROR("%s: the model has no experts\n", __func__);
+        return false;
+    }
+
+    if (len != n_layer*n_expert) {
+        LLAMA_LOG_ERROR("%s: expert mask has %zu values, expected %zu (n_layer x n_expert)\n", __func__, len, n_layer*n_expert);
+        return false;
+    }
+
+    for (size_t il = 0; il < n_layer; il++) {
+        size_t n_keep = 0;
+        for (size_t e = 0; e < n_expert; e++) {
+            n_keep += keep[il*n_expert + e] != 0;
+        }
+        if (n_keep < hparams.n_expert_used(il)) {
+            LLAMA_LOG_ERROR("%s: layer %zu keeps %zu experts, it needs at least %u\n", __func__, il, n_keep, hparams.n_expert_used(il));
+            return false;
+        }
+    }
+
+    if (tensors.empty() && !init(model)) {
+        return false;
+    }
+
+    std::vector<float> row(n_expert);
+    for (size_t il = 0; il < n_layer; il++) {
+        for (size_t e = 0; e < n_expert; e++) {
+            row[e] = keep[il*n_expert + e] ? 0.0f : -INFINITY;
+        }
+        ggml_backend_tensor_set(tensors[il], row.data(), 0, n_expert*sizeof(float));
+    }
+
+    active = true;
+
+    return true;
+}
