index a76af84..b7535b6 100644
--- a/ggml/src/ggml-cpu/ggml-cpu.c
+++ b/ggml/src/ggml-cpu/ggml-cpu.c
@@ -1563,6 +1563,139 @@ static void * incr_ptr_aligned(void ** p, size_t size, size_t align) {
