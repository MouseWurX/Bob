+// Brain Engine 0122: LLAMA_ATTN_ROT_K_NROT / LLAMA_ATTN_ROT_V_NROT pick the rotation's block size for the drift runs
+// (a power of 2 from 64 that divides the head; 0 = the whole head's largest). Unset keeps upstream's choice.
+static uint32_t rot_size_env(const char * key, uint32_t dflt, int64_t head) {
+    const char * e = getenv(key);
+    if (e == nullptr || *e == '\0' || head <= 0) {
+        return dflt;
+    }
+    long long want = atoll(e);
+    if (want == 0) {
+        want = 64;
+        while (head % (2*want) == 0) {
+            want *= 2;
+        }
+    }
+    if (want < 64 || (want & (want - 1)) != 0 || head % want != 0) {
+        LLAMA_LOG_WARN("%s: !!! %s=%s NOT USED: a power of 2 from 64 that divides the head (%lld), or 0; keeping %u\n", __func__, key, e, (long long) head, dflt);
+        return dflt;
+    }
+    if ((uint32_t) want != dflt) {
+        LLAMA_LOG_INFO("%s: %s=%lld: rotation in blocks of %lld (upstream picks %u)\n", __func__, key, want, want, dflt);
+    }
+    return (uint32_t) want;
+}
