+
+// Brain Engine 0055: q2_K to q6_K rows (q4_K and q6_K only without AVX2) against q8_0 input with whole-number sums per block of 32, the way the card's
+// q4_K x q8_1 and q6_K x q8_1 dots work, instead of turning every weight into a float first (6-35x slower than the stock
+// kernel in a cloud test). With AVX2 the dot works straight from the packed weights; without it, a plain whole-number loop.
+static inline void be_scale_min_k4(int j, const uint8_t * q, uint8_t * d, uint8_t * m) {
+    if (j < 4) { *d = q[j] & 63; *m = q[j + 4] & 63; }
+    else { *d = (q[j+4] & 0xF) | ((q[j-4] >> 6) << 4); *m = (q[j+4] >> 4) | ((q[j-0] >> 6) << 4); }
+}
+
+// one weight row as small whole numbers: q[] (k values), and per block of 32: scale fs[] and offset fm[] (q4_K) or
+// two scales per block of 16 in fs[] (q6_K)
+static void be_unpack_row(enum ggml_type t, const void * row, int64_t k, int8_t * q, float * fs, float * fm) {
+    const int64_t nbk = k / QK_K;
+    if (t == GGML_TYPE_Q4_K) {
+        const block_q4_K * x = (const block_q4_K *) row;
+        for (int64_t i = 0; i < nbk; ++i) {
+            const float d = GGML_CPU_FP16_TO_FP32(x[i].d), dmin = GGML_CPU_FP16_TO_FP32(x[i].dmin);
+            const uint8_t * qs = x[i].qs;
+            for (int j = 0; j < 4; ++j) {
+                uint8_t sc, m;
+                be_scale_min_k4(2*j, x[i].scales, &sc, &m);     fs[i*8 + 2*j]     = d*sc; fm[i*8 + 2*j]     = dmin*m;
+                be_scale_min_k4(2*j + 1, x[i].scales, &sc, &m); fs[i*8 + 2*j + 1] = d*sc; fm[i*8 + 2*j + 1] = dmin*m;
+                int8_t * o = q + i*QK_K + 64*j;
+                for (int l = 0; l < 32; ++l) { o[l] = qs[l] & 0xF; o[l + 32] = qs[l] >> 4; }
+                qs += 32;
+            }
+        }
+    } else { // GGML_TYPE_Q6_K
+        const block_q6_K * x = (const block_q6_K *) row;
+        for (int64_t i = 0; i < nbk; ++i) {
+            const float d = GGML_CPU_FP16_TO_FP32(x[i].d);
+            const uint8_t * ql = x[i].ql; const uint8_t * qh = x[i].qh;
+            int8_t * o = q + i*QK_K;
+            for (int n = 0; n < QK_K; n += 128) {
+                for (int l = 0; l < 32; ++l) {
+                    o[l]      = (int8_t)((ql[l]      & 0xF) | (((qh[l] >> 0) & 3) << 4));
+                    o[l + 32] = (int8_t)((ql[l + 32] & 0xF) | (((qh[l] >> 2) & 3) << 4));
+                    o[l + 64] = (int8_t)((ql[l]      >>  4) | (((qh[l] >> 4) & 3) << 4));
+                    o[l + 96] = (int8_t)((ql[l + 32] >>  4) | (((qh[l] >> 6) & 3) << 4));
+                }
+                o += 128; ql += 64; qh += 32;
+            }
+            for (int s = 0; s < 16; ++s) fs[i*16 + s] = d * x[i].scales[s];
+        }
+    }
+}
+
+static inline int32_t be_idot16(const int8_t * a, const int8_t * b) {
+    int32_t s = 0;
+    for (int l = 0; l < 16; ++l) s += (int32_t) (uint8_t) a[l] * (int32_t) b[l];
+    return s;
+}
+
+
+#if defined(__AVX2__)
+static inline __m256i be_dot32(__m256i q, __m256i a) {
+    return _mm256_madd_epi16(_mm256_maddubs_epi16(q, a), _mm256_set1_epi16(1));
+}
+static inline __m256i be_sum32(__m256i a) {
+    return _mm256_madd_epi16(_mm256_maddubs_epi16(_mm256_set1_epi8(1), a), _mm256_set1_epi16(1));
+}
+static inline float be_hsum(__m256 acc) {
+    __m128 h = _mm_add_ps(_mm256_castps256_ps128(acc), _mm256_extractf128_ps(acc, 1));
+    h = _mm_add_ps(h, _mm_movehl_ps(h, h));
+    h = _mm_add_ss(h, _mm_movehdup_ps(h));
+    return _mm_cvtss_f32(h);
+}
+// eight vectors in, one out: lane j holds the sum of all lanes of v[j]
+static inline __m256i be_hsum8(const __m256i * v) {
+    const __m256i t0 = _mm256_hadd_epi32(v[0], v[1]), t1 = _mm256_hadd_epi32(v[2], v[3]);
+    const __m256i t2 = _mm256_hadd_epi32(v[4], v[5]), t3 = _mm256_hadd_epi32(v[6], v[7]);
+    const __m256i u0 = _mm256_hadd_epi32(t0, t1), u1 = _mm256_hadd_epi32(t2, t3);
+    return _mm256_add_epi32(_mm256_permute2x128_si256(u0, u1, 0x20), _mm256_permute2x128_si256(u0, u1, 0x31));
+}
+static inline __m256i be_dotu8(__m256i q, __m256i a) {
+#if defined(__AVXVNNI__) || (defined(__AVX512VNNI__) && defined(__AVX512VL__))
+    return _mm256_dpbusd_epi32(_mm256_setzero_si256(), q, a);
+#else
+    return _mm256_madd_epi16(_mm256_maddubs_epi16(q, a), _mm256_set1_epi16(1));
+#endif
+}
+// per-16 types (q2_K, q3_K, q6_K): v[k] holds block k's whole-number sums, lanes 0-3 its first 16 values, 4-7 its
+// second 16. Two levels of hadd give the 16 half-block sums, which get their own scale (sc, 16 signed bytes) and
+// the block's input scale, all in one float step per 8 halves.
+static inline __m256 be_acc16(__m256 acc, const __m256i * v, const int8_t * sc, float d, const float * da) {
+    const __m256i t0 = _mm256_hadd_epi32(v[0], v[1]), t1 = _mm256_hadd_epi32(v[2], v[3]);
+    const __m256i t2 = _mm256_hadd_epi32(v[4], v[5]), t3 = _mm256_hadd_epi32(v[6], v[7]);
+    const __m256i u0 = _mm256_hadd_epi32(t0, t1), u1 = _mm256_hadd_epi32(t2, t3); // [b0..b3 first | b0..b3 second]
+    const __m128i sb = _mm_shuffle_epi8(_mm_loadu_si128((const __m128i *) sc), _mm_setr_epi8(0, 2, 4, 6, 1, 3, 5, 7, 8, 10, 12, 14, 9, 11, 13, 15));
+    const __m256 s0 = _mm256_cvtepi32_ps(_mm256_cvtepi8_epi32(sb)), s1 = _mm256_cvtepi32_ps(_mm256_cvtepi8_epi32(_mm_srli_si128(sb, 8)));
+    const __m256 dv = _mm256_set1_ps(d);
+    acc = _mm256_fmadd_ps(_mm256_cvtepi32_ps(u0), _mm256_mul_ps(_mm256_mul_ps(dv, s0), _mm256_broadcast_ps((const __m128 *) da)), acc);
+    acc = _mm256_fmadd_ps(_mm256_cvtepi32_ps(u1), _mm256_mul_ps(_mm256_mul_ps(dv, s1), _mm256_broadcast_ps((const __m128 *) (da + 4))), acc);
+    return acc;
+}
+// one q4_K row against q8_0 input, straight from the packed weights. da_: the input's block scales, ms: da*sum per block.
+// Whole-number sum per block of 32, then times (weight scale x input scale), like the card's q4_K x q8_1.
+static float be_dot_q4_K_q8_0(const block_q4_K * x, const block_q8_0 * a, const float * da_, const float * ms, int64_t nbk) {
+    const __m256i m4 = _mm256_set1_epi8(0xF);
+    __m256 acc = _mm256_setzero_ps(), off = _mm256_setzero_ps();
+    for (int64_t i = 0; i < nbk; ++i) {
+        uint32_t u[4];
+        memcpy(u, x[i].scales, 12);
+        u[3] = ((u[2] >> 4) & 0x0f0f0f0f) | (((u[1] >> 6) & 0x03030303) << 4);
+        const uint32_t ua = u[1] & 0x3f3f3f3f;
+        u[1] = (u[2] & 0x0f0f0f0f) | (((u[0] >> 6) & 0x03030303) << 4);
+        u[2] = ua;
+        u[0] &= 0x3f3f3f3f;
+        const __m256 sc = _mm256_cvtepi32_ps(_mm256_cvtepu8_epi32(_mm_loadl_epi64((const __m128i *) &u[0])));
+        const __m256 mn = _mm256_cvtepi32_ps(_mm256_cvtepu8_epi32(_mm_loadl_epi64((const __m128i *) &u[2])));
+        const block_q8_0 * ab = a + i*8;
+        __m256i v[8];
+        for (int j = 0; j < 4; ++j) {
+            const __m256i raw = _mm256_loadu_si256((const __m256i *) (x[i].qs + 32*j));
+            v[2*j]     = be_dotu8(_mm256_and_si256(raw, m4), _mm256_loadu_si256((const __m256i *) ab[2*j].qs));
+            v[2*j + 1] = be_dotu8(_mm256_and_si256(_mm256_srli_epi16(raw, 4), m4), _mm256_loadu_si256((const __m256i *) ab[2*j + 1].qs));
+        }
+        const __m256 dav = _mm256_loadu_ps(da_ + i*8);
+        const __m256 d = _mm256_set1_ps(GGML_CPU_FP16_TO_FP32(x[i].d)), dmin = _mm256_set1_ps(GGML_CPU_FP16_TO_FP32(x[i].dmin));
+        acc = _mm256_fmadd_ps(_mm256_cvtepi32_ps(be_hsum8(v)), _mm256_mul_ps(_mm256_mul_ps(d, sc), dav), acc);
+        off = _mm256_fmadd_ps(_mm256_mul_ps(dmin, mn), _mm256_loadu_ps(ms + i*8), off);
+    }
+    return be_hsum(_mm256_sub_ps(acc, off));
+}
+// one q6_K row against q8_0 input; values kept 0..63, the 32 taken off through the input's sums per 16 (ms16 = da*sum)
+static float be_dot_q6_K_q8_0(const block_q6_K * x, const block_q8_0 * a, const float * da_, const float * ms16, int64_t nbk) {
+    const __m256i m4 = _mm256_set1_epi8(0xF), m3 = _mm256_set1_epi8(3);
+    __m256 acc = _mm256_setzero_ps(), off = _mm256_setzero_ps();
+    for (int64_t i = 0; i < nbk; ++i) {
+        const int8_t * sc = x[i].scales;
+        __m256i v[8];
+        for (int n = 0; n < 2; ++n) {
+            const uint8_t * ql = x[i].ql + 64*n; const uint8_t * qh = x[i].qh + 32*n;
+            const __m256i l0 = _mm256_loadu_si256((const __m256i *) ql), l1 = _mm256_loadu_si256((const __m256i *) (ql + 32));
+            const __m256i h = _mm256_loadu_si256((const __m256i *) qh);
+            __m256i q[4];
+            q[0] = _mm256_or_si256(_mm256_and_si256(l0, m4), _mm256_slli_epi16(_mm256_and_si256(h, m3), 4));
+            q[1] = _mm256_or_si256(_mm256_and_si256(l1, m4), _mm256_slli_epi16(_mm256_and_si256(_mm256_srli_epi16(h, 2), m3), 4));
+            q[2] = _mm256_or_si256(_mm256_and_si256(_mm256_srli_epi16(l0, 4), m4), _mm256_slli_epi16(_mm256_and_si256(_mm256_srli_epi16(h, 4), m3), 4));
+            q[3] = _mm256_or_si256(_mm256_and_si256(_mm256_srli_epi16(l1, 4), m4), _mm256_slli_epi16(_mm256_and_si256(_mm256_srli_epi16(h, 6), m3), 4));
+            for (int k = 0; k < 4; ++k) {
+                v[n*4 + k] = be_dotu8(q[k], _mm256_loadu_si256((const __m256i *) a[i*8 + n*4 + k].qs));
+            }
+        }
+        const float d = GGML_CPU_FP16_TO_FP32(x[i].d);
+        acc = be_acc16(acc, v, sc, d, da_ + i*8);
+        const __m128i scb = _mm_loadu_si128((const __m128i *) sc);
+        const __m256 d32 = _mm256_set1_ps(32.0f*d);
+        off = _mm256_fmadd_ps(_mm256_mul_ps(d32, _mm256_cvtepi32_ps(_mm256_cvtepi8_epi32(scb))), _mm256_loadu_ps(ms16 + i*16), off);
+        off = _mm256_fmadd_ps(_mm256_mul_ps(d32, _mm256_cvtepi32_ps(_mm256_cvtepi8_epi32(_mm_srli_si128(scb, 8)))), _mm256_loadu_ps(ms16 + i*16 + 8), off);
+    }
+    return be_hsum(_mm256_sub_ps(acc, off));
+}
+
+// q5_K: q4_K's scales and mins, a fifth bit per value from qh
+static float be_dot_q5_K_q8_0(const block_q5_K * x, const block_q8_0 * a, const float * da_, const float * ms, int64_t nbk) {
+    const __m256i m4 = _mm256_set1_epi8(0xF), m1 = _mm256_set1_epi8(1);
+    __m256 acc = _mm256_setzero_ps(), off = _mm256_setzero_ps();
+    for (int64_t i = 0; i < nbk; ++i) {
+        uint32_t u[4];
+        memcpy(u, x[i].scales, 12);
+        u[3] = ((u[2] >> 4) & 0x0f0f0f0f) | (((u[1] >> 6) & 0x03030303) << 4);
+        const uint32_t ua = u[1] & 0x3f3f3f3f;
+        u[1] = (u[2] & 0x0f0f0f0f) | (((u[0] >> 6) & 0x03030303) << 4);
+        u[2] = ua;
+        u[0] &= 0x3f3f3f3f;
+        const __m256 sc = _mm256_cvtepi32_ps(_mm256_cvtepu8_epi32(_mm_loadl_epi64((const __m128i *) &u[0])));
+        const __m256 mn = _mm256_cvtepi32_ps(_mm256_cvtepu8_epi32(_mm_loadl_epi64((const __m128i *) &u[2])));
+        const block_q8_0 * ab = a + i*8;
+        const __m256i h = _mm256_loadu_si256((const __m256i *) x[i].qh);
+        __m256i v[8];
+        for (int j = 0; j < 4; ++j) {
+            const __m256i raw = _mm256_loadu_si256((const __m256i *) (x[i].qs + 32*j));
+            const __m256i h0 = _mm256_slli_epi16(_mm256_and_si256(_mm256_srli_epi16(h, 2*j), m1), 4);
+            const __m256i h1 = _mm256_slli_epi16(_mm256_and_si256(_mm256_srli_epi16(h, 2*j + 1), m1), 4);
+            v[2*j]     = be_dotu8(_mm256_or_si256(_mm256_and_si256(raw, m4), h0), _mm256_loadu_si256((const __m256i *) ab[2*j].qs));
+            v[2*j + 1] = be_dotu8(_mm256_or_si256(_mm256_and_si256(_mm256_srli_epi16(raw, 4), m4), h1), _mm256_loadu_si256((const __m256i *) ab[2*j + 1].qs));
+        }
+        const __m256 dav = _mm256_loadu_ps(da_ + i*8);
+        const __m256 d = _mm256_set1_ps(GGML_CPU_FP16_TO_FP32(x[i].d)), dmin = _mm256_set1_ps(GGML_CPU_FP16_TO_FP32(x[i].dmin));
+        acc = _mm256_fmadd_ps(_mm256_cvtepi32_ps(be_hsum8(v)), _mm256_mul_ps(_mm256_mul_ps(d, sc), dav), acc);
+        off = _mm256_fmadd_ps(_mm256_mul_ps(dmin, mn), _mm256_loadu_ps(ms + i*8), off);
+    }
+    return be_hsum(_mm256_sub_ps(acc, off));
+}
+// q3_K: 2 low bits from qs, the third from hmask, values kept 0..7 (the 4 taken off through the input's sums per 16),
+// 16 signed 6-bit scales per 256
+static float be_dot_q3_K_q8_0(const block_q3_K * x, const block_q8_0 * a, const float * da_, const float * ms16, int64_t nbk) {
+    const __m256i m3 = _mm256_set1_epi8(3), m1 = _mm256_set1_epi8(1);
+    __m256 acc = _mm256_setzero_ps(), off = _mm256_setzero_ps();
+    for (int64_t i = 0; i < nbk; ++i) {
+        uint32_t aux[4];
+        memcpy(aux, x[i].scales, 12);
+        const uint32_t tmp = aux[2];
+        aux[2] = ((aux[0] >> 4) & 0x0f0f0f0f) | (((tmp >> 4) & 0x03030303) << 4);
+        aux[3] = ((aux[1] >> 4) & 0x0f0f0f0f) | (((tmp >> 6) & 0x03030303) << 4);
+        aux[0] = (aux[0] & 0x0f0f0f0f) | (((tmp >> 0) & 0x03030303) << 4);
+        aux[1] = (aux[1] & 0x0f0f0f0f) | (((tmp >> 2) & 0x03030303) << 4);
+        int8_t sc[16];
+        _mm_storeu_si128((__m128i *) sc, _mm_sub_epi8(_mm_loadu_si128((const __m128i *) aux), _mm_set1_epi8(32)));
+        const __m256i hm = _mm256_loadu_si256((const __m256i *) x[i].hmask);
+        __m256i v[8];
+        for (int n = 0; n < 2; ++n) {
+            const __m256i qv = _mm256_loadu_si256((const __m256i *) (x[i].qs + 32*n));
+            for (int j = 0; j < 4; ++j) {
+                const __m256i lo = _mm256_and_si256(_mm256_srli_epi16(qv, 2*j), m3);
+                const __m256i hb = _mm256_slli_epi16(_mm256_and_si256(_mm256_srli_epi16(hm, 4*n + j), m1), 2);
+                v[n*4 + j] = be_dotu8(_mm256_or_si256(lo, hb), _mm256_loadu_si256((const __m256i *) a[i*8 + n*4 + j].qs));
+            }
+        }
+        const float d = GGML_CPU_FP16_TO_FP32(x[i].d);
+        acc = be_acc16(acc, v, sc, d, da_ + i*8);
+        const __m128i scb = _mm_loadu_si128((const __m128i *) sc);
+        const __m256 d4 = _mm256_set1_ps(4.0f*d);
+        off = _mm256_fmadd_ps(_mm256_mul_ps(d4, _mm256_cvtepi32_ps(_mm256_cvtepi8_epi32(scb))), _mm256_loadu_ps(ms16 + i*16), off);
+        off = _mm256_fmadd_ps(_mm256_mul_ps(d4, _mm256_cvtepi32_ps(_mm256_cvtepi8_epi32(_mm_srli_si128(scb, 8)))), _mm256_loadu_ps(ms16 + i*16 + 8), off);
+    }
+    return be_hsum(_mm256_sub_ps(acc, off));
+}
+// q2_K: 2 bits per value, a 4-bit scale and a 4-bit min per 16
+static float be_dot_q2_K_q8_0(const block_q2_K * x, const block_q8_0 * a, const float * da_, const float * ms16, int64_t nbk) {
+    const __m256i m3 = _mm256_set1_epi8(3);
+    __m256 acc = _mm256_setzero_ps(), off = _mm256_setzero_ps();
+    for (int64_t i = 0; i < nbk; ++i) {
+        const uint8_t * sc = x[i].scales;
+        int8_t sl[16];
+        _mm_storeu_si128((__m128i *) sl, _mm_and_si128(_mm_loadu_si128((const __m128i *) sc), _mm_set1_epi8(0xF)));
+        __m256i v[8];
+        for (int n = 0; n < 2; ++n) {
+            const __m256i qv = _mm256_loadu_si256((const __m256i *) (x[i].qs + 32*n));
+            for (int j = 0; j < 4; ++j) {
+                v[n*4 + j] = be_dotu8(_mm256_and_si256(_mm256_srli_epi16(qv, 2*j), m3), _mm256_loadu_si256((const __m256i *) a[i*8 + n*4 + j].qs));
+            }
+        }
+        const float d = GGML_CPU_FP16_TO_FP32(x[i].d);
+        acc = be_acc16(acc, v, sl, d, da_ + i*8);
+        const __m128i scb = _mm_srli_epi16(_mm_loadu_si128((const __m128i *) sc), 4);
+        const __m128i mb = _mm_and_si128(scb, _mm_set1_epi8(0xF));
+        const __m256 dm = _mm256_set1_ps(GGML_CPU_FP16_TO_FP32(x[i].dmin));
+        off = _mm256_fmadd_ps(_mm256_mul_ps(dm, _mm256_cvtepi32_ps(_mm256_cvtepu8_epi32(mb))), _mm256_loadu_ps(ms16 + i*16), off);
+        off = _mm256_fmadd_ps(_mm256_mul_ps(dm, _mm256_cvtepi32_ps(_mm256_cvtepu8_epi32(_mm_srli_si128(mb, 8)))), _mm256_loadu_ps(ms16 + i*16 + 8), off);
+    }
+    return be_hsum(_mm256_sub_ps(acc, off));
+}
+#endif
