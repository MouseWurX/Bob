+        gguf_set_val_u32(meta, "qwen35.vocab_size", n_vocab);
+        gguf_set_val_str(meta, "tokenizer.ggml.model", "none");
+
+        coded("token_embd", n_embd, n_vocab, GGML_TYPE_COUNT);
+        add("output_norm.weight", GGML_TYPE_F32, {n_embd});
+        add("output.weight", GGML_TYPE_F32, {n_embd, n_vocab});
+
+        // blk.0: gated delta net (one key and one value head of n_ssm)
+        for (const char * name : {"attn_norm", "post_attention_norm"}) {
+            add(std::string("blk.0.") + name + ".weight", GGML_TYPE_F32, {n_embd});
+        }
+        add("blk.0.attn_qkv.weight", GGML_TYPE_F32, {n_embd, 3 * n_ssm});
+        add("blk.0.attn_gate.weight", GGML_TYPE_F32, {n_embd, n_ssm});
+        add("blk.0.ssm_conv1d.weight", GGML_TYPE_F32, {4, 3 * n_ssm});
+        add("blk.0.ssm_dt.bias", GGML_TYPE_F32, {1});
+        add("blk.0.ssm_a", GGML_TYPE_F32, {1});
+        add("blk.0.ssm_beta.weight", GGML_TYPE_F32, {n_embd, 1});
+        add("blk.0.ssm_alpha.weight", GGML_TYPE_F32, {n_embd, 1});
+        add("blk.0.ssm_norm.weight", GGML_TYPE_F32, {n_ssm});
+        add("blk.0.ssm_out.weight", GGML_TYPE_F32, {n_ssm, n_embd});
+
+        // blk.1: the MTP block
+        for (const char * name : {"attn_norm", "post_attention_norm", "nextn.enorm", "nextn.hnorm"}) {
+            add(std::string("blk.1.") + name + ".weight", GGML_TYPE_F32, {n_embd});
+        }
+        add("blk.1.attn_q.weight", GGML_TYPE_F32, {n_embd, 2 * n_head * n_head_dim});
+        add("blk.1.attn_k.weight", GGML_TYPE_F32, {n_embd, n_head * n_head_dim});
+        add("blk.1.attn_v.weight", GGML_TYPE_F32, {n_embd, n_head * n_head_dim});
+        add("blk.1.attn_output.weight", GGML_TYPE_F32, {n_head * n_head_dim, n_embd});
+        add("blk.1.attn_q_norm.weight", GGML_TYPE_F32, {n_head_dim});
+        add("blk.1.attn_k_norm.weight", GGML_TYPE_F32, {n_head_dim});
+        add("blk.1.nextn.eh_proj.weight", GGML_TYPE_F32, {2 * n_embd, n_embd});
+        if (nextn_embd) {
+            add("blk.1.nextn.embed_tokens.weight", GGML_TYPE_F32, {n_embd, n_vocab});
+        }
+
+        for (int il : {0, 1}) {
+            for (const char * name : {"ffn_gate", "ffn_down", "ffn_up"}) {
+                add("blk." + std::to_string(il) + "." + name + ".weight", GGML_TYPE_F32, {n_embd, n_embd});
+            }
+        }
+    }
+};
+
+// loads b; expected: a part of the rejection's message, or nullptr if the model must load
+static void check_load(const char * what, builder & b, const char * expected, bool load_mtp = false) {
+    auto * model = load(b.meta, load_mtp);
+    if (expected == nullptr) {
+        check(model != nullptr, what);
+        llama_model_free(model);
+        return;
+    }
+    check(model == nullptr && messages.find(expected) != std::string::npos, what);
+}
+
+// the logits of tokens 1..6 (a batch, then one more token) on the CPU
+static std::vector<float> run_logits(builder & b) {
+    auto * model = load(b.meta);
+    check(model != nullptr, "the expert fixture must load");
+    auto cparams = llama_context_default_params();
+    cparams.n_ctx = 64;
+    cparams.n_batch = 64;
+    cparams.n_threads = 2;
+    auto * lctx = llama_init_from_model(model, cparams);
+    check(lctx != nullptr, "context failed");
+    std::vector<float> out;
+    llama_token tokens[] = {1, 2, 3, 4, 5, 6};
+    check(llama_decode(lctx, llama_batch_get_one(tokens, 5)) == 0, "decode failed");
+    const int n_vocab = llama_vocab_n_tokens(llama_model_get_vocab(model));
+    const float * l = llama_get_logits_ith(lctx, -1);
+    out.insert(out.end(), l, l + n_vocab);
+    check(llama_decode(lctx, llama_batch_get_one(tokens + 5, 1)) == 0, "decode failed");
+    l = llama_get_logits_ith(lctx, -1);
+    out.insert(out.end(), l, l + n_vocab);
+    llama_free(lctx);
+    llama_model_free(model);
+    return out;
+}
+
+// Lamplight 0136: coded experts load and run as ggml_trellis_mul_mat_id, giving the logits of the same experts
+// dequantized (ggml_trellis_dequantize_expert) into plain F32 ones
+static void check_experts() {
+    fixture coded(false, true);
+    coded.randomize();
+    fixture dense(false, true, GGML_TYPE_I32, fixture::n_vocab, true);
+    dense.randomize();
+    const int64_t K = fixture::n_embd, N = fixture::n_embd, E = fixture::n_expert;
+    for (const char * name : {"ffn_gate_exps", "ffn_down_exps", "ffn_up_exps"}) {
+        const std::string base = std::string("blk.0.") + name;
+        auto * w = ggml_get_tensor(coded.ctx, (base + ".weight").c_str());
+        auto * d = ggml_get_tensor(dense.ctx, (base + ".weight").c_str());
+        const int32_t desc[] = {1, 128, 1, 1, 128, 1, 1, (int32_t) N};
+        for (int64_t e = 0; e < E; ++e) {
+            check(ggml_trellis_dequantize_expert(w->type, w->data, K, N, e,
+                (const ggml_fp16_t *) ggml_get_tensor(coded.ctx, (base + ".trellis_s16").c_str())->data,
+                (const float *) ggml_get_tensor(coded.ctx, (base + ".trellis_pre").c_str())->data,
+                (const float *) ggml_get_tensor(coded.ctx, (base + ".trellis_post").c_str())->data,
+                desc, 8, (float *) d->data + e * K * N), "expert dequantize failed");
+        }
+    }
+    const auto a = run_logits(coded);
+    const auto b = run_logits(dense);
+    check(a.size() == b.size(), "logit counts differ");
+    double err = 0, ref = 0;
+    for (size_t i = 0; i < a.size(); ++i) {
+        check(std::isfinite(a[i]), "coded expert logits not finite");
+        err += double(a[i] - b[i]) * (a[i] - b[i]);
+        ref += double(b[i]) * b[i];
+    }
+    check(ref > 0 && err <= 1e-5 * ref, "coded experts: the logits differ from the dequantized experts'");
+
+    fixture bad(false, true);
+    gguf_remove_key(bad.meta, "trellis.desc.blk.0.ffn_up_exps");
+    check_load("coded experts without their side description must be rejected", bad, "trellis.desc.blk.0.ffn_up_exps");
+}
+
+int main() {
+    ggml_backend_load_all();
+    llama_log_set(log_message, nullptr);
+
+    check_versions();
+
+    {
+        fixture f(false, false);
+        check_load("a valid coded fixture must load", f, nullptr);
+    }
+    {
+        fixture f(false, false);
+        f.pin()[3] = (int32_t) fixture::n_embd;
+        check_load("an out-of-range input gather must be rejected", f, "output.trellis_pin is not a permutation");
+    }
+    {
+        fixture f(false, false);
+        f.pin()[0] = -1;
+        check_load("a negative input gather must be rejected", f, "output.trellis_pin is not a permutation");
+    }
+    {
+        fixture f(false, false);
+        f.pin()[1] = f.pin()[0];
+        check_load("a repeated input gather must be rejected", f, "output.trellis_pin is not a permutation");
+    }
+    {
+        fixture f(false, false, GGML_TYPE_F32);
+        check_load("a gather of the wrong type must be rejected", f, "output.trellis_pin is f32, expected i32");
+    }
+    {
+        fixture f(false, false, GGML_TYPE_I32, 40);
+        check_load("a coded weight whose rows are not a multiple of 16 must be rejected", f,
+                "trellis: unsupported shape for output.weight");
+    }
+    {
+        fixture f(true, false);
+        check_load("a coded tied embedding must be rejected", f, "token_embd.weight is coded and also used as another tensor");
+    }
+    check_experts();
+
+    {
+        fixture f(false, false);
+        gguf_set_val_u32(f.meta, "prism.hadamard.version", 1);
+        gguf_set_val_u32(f.meta, "prism.hadamard.block_size", 256);
+        gguf_set_val_str(f.meta, "prism.hadamard.transform", "normalized-sylvester-walsh-hadamard");
+        gguf_set_val_str(f.meta, "prism.hadamard.axis", "input-last-dimension");
+        gguf_set_val_str(f.meta, "prism.hadamard.sign_mode", "identity");
+        const char * folded[] = {"output.weight"};
+        gguf_set_arr_str(f.meta, "prism.hadamard.weight_names", folded, 1);
+        check_load("a Hadamard-folded coded weight must be rejected", f, "output.weight is coded and Hadamard-folded");
+    }
+    {
+        mtp_fixture f(false);
+        check_load("a coded embedding must load without the MTP block", f, nullptr);
+    }
+    {
+        mtp_fixture f(false);
+        check_load("an MTP block without a plain embedding must be rejected", f,
+                "the MTP block needs a plain token embedding", true);
+    }
+    {
+        mtp_fixture f(true);
+        check_load("an MTP block with its own embedding must load", f, nullptr, true);
+    }
+
+    std::puts("trellis loading: format versions, gathers, tied embeddings, coded experts, Hadamard folds and MTP checked");
+}
diff --git a/tests/test-trellis-model.cpp b/tests/test-trellis-model.cpp
new file mode 100644
index 0000000..5befb84
--- /dev/null
+++ b/tests/test-trellis-model.cpp
@@ -0,0 +1,151 @@
+#include "llama.h"
+#include "ggml-backend.h"
+
+#include <nlohmann/json.hpp>
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <fstream>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+using json = nlohmann::ordered_json;
+using clock_type = std::chrono::steady_clock;
+
+static void check(bool ok, const char * message) {
+    if (!ok) { throw std::runtime_error(message); }
+}
+
+static double seconds(clock_type::time_point start) {
+    return std::chrono::duration<double>(clock_type::now() - start).count();
+}
+
+// Manual, bounded full-model check. Not registered with CTest and never downloads weights.
+int main(int argc, char ** argv) {
+    try {
+        std::string model_path, output, force_path;
+        std::string prompt = "The capital of France is";
+        int ngl = 0, ubatch = 8, predict = 8, threads = 6;
+        for (int i = 1; i < argc; i += 2) {
+            check(i + 1 < argc, "options require values");
+            const std::string key = argv[i], value = argv[i + 1];
+            if (key == "--model") { model_path = value; }
+            else if (key == "--output") { output = value; }
+            else if (key == "--force") { force_path = value; }
+            else if (key == "--prompt") { prompt = value; }
+            else if (key == "--gpu-layers") { ngl = std::stoi(value); }
+            else if (key == "--ubatch") { ubatch = std::stoi(value); }
+            else if (key == "--predict") { predict = std::stoi(value); }
+            else if (key == "--threads") { threads = std::stoi(value); }
+            else { throw std::runtime_error("unknown option: " + key); }
+        }
+        check(!model_path.empty() && !output.empty(), "required: --model PATH --output PREFIX");
+        check(ngl >= 0 && ngl <= 999 && ubatch >= 1 && ubatch <= 32 && predict >= 1 && predict <= 32 && threads >= 1 && threads <= 12, "option outside bounded check limits");
+        std::vector<llama_token> forced;
+        if (!force_path.empty()) {
+            std::ifstream file(force_path);
+            check(bool(file), "cannot open reference metadata");
+            json reference; file >> reference;
+            check(reference.at("complete") == true && reference.at("prompt") == prompt, "incomplete or mismatched reference");
+            forced = reference.at("evaluated_generation_ids").get<std::vector<llama_token>>();
+            check(forced.size() == size_t(predict), "reference generation length mismatch");
+        }
+        ggml_backend_load_all();
+        llama_backend_init();
+        auto mp = llama_model_default_params();
+        mp.n_gpu_layers = ngl;
+        mp.load_mode = LLAMA_LOAD_MODE_MMAP;
+        const auto load_start = clock_type::now();
+        auto * model = llama_model_load_from_file(model_path.c_str(), mp);
+        check(model != nullptr, "model load failed");
+        const double load_s = seconds(load_start);
+        const auto * vocab = llama_model_get_vocab(model);
+        const int nv = llama_vocab_n_tokens(vocab);
+        const int nt = -llama_tokenize(vocab, prompt.data(), prompt.size(), nullptr, 0, true, true);
+        check(nt > 0 && nt <= 64, "prompt must contain 1-64 tokens");
+        std::vector<llama_token> tokens(nt);
+        check(llama_tokenize(vocab, prompt.data(), prompt.size(), tokens.data(), nt, true, true) == nt, "tokenization failed");
+        auto cp = llama_context_default_params();
+        cp.n_ctx = 128; cp.n_batch = 32; cp.n_ubatch = ubatch; cp.n_seq_max = 1;
+        cp.n_threads = cp.n_threads_batch = threads;
+        cp.op_offload = cp.offload_kqv = ngl > 0;
+        cp.flash_attn_type = LLAMA_FLASH_ATTN_TYPE_DISABLED;
+        cp.no_perf = false;
+        auto * ctx = llama_init_from_model(model, cp);
+        check(ctx != nullptr, "context allocation failed");
+        auto * batch = llama_batch_ext_init(ctx);
+        check(batch != nullptr, "batch allocation failed");
+        std::ofstream logits(output + ".f32", std::ios::binary);
+        check(bool(logits), "cannot open logits file");
+        json report = {{"complete", false}, {"model", model_path}, {"prompt", prompt}, {"prompt_ids", tokens},
+            {"gpu_layers", ngl}, {"ubatch", ubatch}, {"threads", threads}, {"n_ctx", cp.n_ctx},
+            {"vocab_size", nv}, {"load_s", load_s}, {"teacher_forced", !forced.empty()}};
+        std::vector<int> top_ids, evaluated;
+        std::string text;
+        int rows = 0;
+        auto save_row = [&](int i) {
+            const float * row = llama_get_logits_ith(ctx, i);
+            check(row != nullptr, "missing logits");
+            for (int j = 0; j < nv; ++j) { check(std::isfinite(row[j]), "nonfinite logits"); }
+            logits.write(reinterpret_cast<const char *>(row), nv*sizeof(float));
+            check(bool(logits), "logits write failed");
+            ++rows;
+            return int(std::max_element(row, row + nv) - row);
+        };
+        auto decode = [&](const llama_token * ids, int count, int pos) {
+            llama_batch_ext_clear(batch);
+            for (int i = 0; i < count; ++i) {
+                const int index = llama_batch_ext_add_token(batch, 0, ids[i]);
+                const llama_pos p = pos + i;
+                check(index >= 0 && llama_batch_ext_set_pos(batch, index, &p), "batch position failed");
+                check(llama_batch_ext_set_output_logits(batch, index, true), "batch output failed");
+            }
+            check(llama_process(ctx, LLAMA_PROCESS_TYPE_DECODE, batch) == 0, "decode failed");
+        };
+        const auto prompt_start = clock_type::now();
+        int top = -1;
+        for (int first = 0; first < nt; first += ubatch) {
+            const int count = std::min(ubatch, nt - first);
+            decode(tokens.data() + first, count, first);
+            for (int i = 0; i < count; ++i) { top = save_row(i); }
+        }
+        report["prompt_s"] = seconds(prompt_start);
+        const auto generation_start = clock_type::now();
+        // Keep evaluating a fixed number of positions, including EOG if selected.
+        for (int i = 0; i < predict; ++i) {
+            top_ids.push_back(top);
+            const llama_token next = forced.empty() ? top : forced[i];
+            check(next >= 0 && next < nv, "forced token outside vocabulary");
+            evaluated.push_back(next);
+            std::vector<char> piece(256);
+            int n = llama_token_to_piece(vocab, next, piece.data(), piece.size(), 0, true);
+            if (n < 0) { piece.resize(-n); n = llama_token_to_piece(vocab, next, piece.data(), piece.size(), 0, true); }
+            check(n >= 0, "token piece conversion failed");
+            text.append(piece.data(), n);
+            if (i + 1 < predict) { decode(&next, 1, nt + i); top = save_row(0); }
+        }
+        report["generation_s"] = seconds(generation_start);
+        report["prompt_tokens_s"] = nt/report["prompt_s"].get<double>();
+        report["decode_tokens_s"] = (predict - 1)/report["generation_s"].get<double>();
+        report["logit_rows"] = rows;
+        report["greedy_ids"] = top_ids;
+        report["evaluated_generation_ids"] = evaluated;
+        report["text"] = text;
+        logits.close();
+        llama_perf_context_print(ctx);
+        llama_batch_ext_free(batch);
+        llama_free(ctx); llama_model_free(model); llama_backend_free();
+        report["complete"] = true;
+        std::ofstream metadata(output + ".json");
+        metadata << report.dump(2) << '\n';
+        check(bool(metadata), "metadata write failed");
+        std::printf("%s\n", report.dump(2).c_str());
+        return 0;
+    } catch (const std::exception & e) {
+        std::fprintf(stderr, "test-trellis-model: %s\n", e.what());
+        return 1;
+    }
+}
diff --git a/tests/test-trellis.cpp b/tests/test-trellis.cpp
new file mode 100644
index 0000000..32c39a8
--- /dev/null
+++ b/tests/test-trellis.cpp
@@ -0,0 +1,544 @@
+#include "ggml.h"
+#include "ggml-backend.h"
+
+#include <algorithm>
+#include <cmath>
+#include <string>
+#include <cstdio>
+#include <cstdlib>
+#include <random>
+#include <vector>
+
+// Lamplight 0136: picks the CPU product (LAMPLIGHT_TRELLIS_CPU; nullptr: the default fast one)
+static void trellis_cpu_mode(const char * mode) {
+#ifdef _WIN32
+    _putenv_s("LAMPLIGHT_TRELLIS_CPU", mode ? mode : "");
+#else
+    if (mode) {
+        setenv("LAMPLIGHT_TRELLIS_CPU", mode, 1);
+    } else {
+        unsetenv("LAMPLIGHT_TRELLIS_CPU");
+    }
+#endif
+}
+
+static void check(bool ok, const char * message) {
+    if (!ok) {
+        std::fprintf(stderr, "%s\n", message);
+        std::exit(1);
+    }
+}
+
+static bool verbose = false;
+
+// Lamplight 0136: the fewest tokens for which CUDA may take its int8 product (see trellis-own.cu)
+static int cuda_q8_min() {
+    const char * e = std::getenv("LAMPLIGHT_TRELLIS_CUDA_Q8_MIN");
+    const char * f = std::getenv("LAMPLIGHT_TRELLIS_CUDA_FUSED_MIN");  // the fused int8 product (sm_80+)
+    int m = e ? std::atoi(e) : 16;
+    if (f && std::atoi(f) > 0) {
+        m = std::min(m, std::atoi(f));
+    }
+    const char * g = std::getenv("LAMPLIGHT_TRELLIS_CUDA_I8_MIN");  // the int8 form of tq_gemm (sm_80+)
+    if (g && std::atoi(g) > 0) {
+        m = std::min(m, std::atoi(g));
+    }
+    return m;
+}
+
+// Lamplight 0136: Vulkan's integer-dot GEMV (int8 inputs, one scale per 16) for short batches and experts
+static bool vk_mvq() {
+    const char * e = std::getenv("LAMPLIGHT_TRELLIS_VK_MVQ");
+    return e != nullptr && std::atoi(e) == 1;
+}
+
+// the bar on the normalized error of a device product: int8-input products as test-backend-ops' MUL_MAT bar
+static double int8_bar(const std::string & name, int columns) {
+    if (name.find("CUDA") == 0 && columns >= cuda_q8_min()) { return 5e-4; }
+    if (name.find("Vulkan") == 0 && vk_mvq() && columns < 32) { return 5e-4; }
+    return 1e-6;
+}
+
+static void check_close(float actual, double expected) {
+    check(std::isfinite(actual) && std::abs(actual - expected) < 2e-4 * (1 + std::abs(expected)), "trellis numerical mismatch");
+}
+
+static void run(ggml_backend_t backend, int bits, int mode, int columns) {
+    constexpr int K = 256, N = 128;
+    auto * ctx = ggml_init({16 * 1024 * 1024, nullptr, false});
+    check(ctx != nullptr, "context allocation failed");
+    auto type = static_cast<ggml_type>(GGML_TYPE_TRL1 + bits - 1);
+    auto * w = ggml_new_tensor_2d(ctx, type, K, N);
+    auto * x = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, K, columns);
+    auto * s = ggml_new_tensor_1d(ctx, GGML_TYPE_F16, K / 16);
+    auto * pre = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, K);
+    auto * post = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, N);
+    auto * pin = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, K);
+    auto * pout = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, N);
+    std::mt19937 rng(1234 + bits);
+    for (size_t i = 0; i < ggml_nbytes(w); ++i) { static_cast<unsigned char *>(w->data)[i] = rng() & 255; }
+    for (int i = 0; i < K * columns; ++i) { static_cast<float *>(x->data)[i] = float(int(rng() % 101) - 50) / 100; }
+    for (int i = 0; i < K / 16; ++i) { static_cast<ggml_fp16_t *>(s->data)[i] = ggml_fp32_to_fp16(0.1f + (i % 7) * 0.01f); }
+    for (int i = 0; i < K; ++i) {
+        static_cast<float *>(pre->data)[i] = (i % 2 ? -1.f : 1.f) * (1.f + (i % 3) * 0.1f);
+        static_cast<int32_t *>(pin->data)[i] = K - 1 - i;
+    }
+    for (int i = 0; i < N; ++i) {
+        static_cast<float *>(post->data)[i] = 0.8f + (i % 5) * 0.1f;
+        static_cast<int32_t *>(pout->data)[i] = N - 1 - i;
+    }
+    int32_t desc[] = {mode ? 1 : 0, mode ? 128 : 0, 1, mode ? 1 : 0, mode ? 128 : 0, 1, 1, N};
+    auto * ip = mode == 2 ? pin : nullptr;
+    auto * op = mode == 2 ? pout : nullptr;
+    auto * y = ggml_trellis_mul_mat(ctx, w, x, s, pre, post, ip, op, desc, 8);
+    auto * graph = ggml_new_graph(ctx);
+    ggml_build_forward_expand(graph, y);
+    check(ggml_backend_graph_compute(backend, graph) == GGML_STATUS_SUCCESS, "trellis graph failed");
+    std::vector<float> dense(K * N);
+    check(ggml_trellis_dequantize(type, w->data, K, N, static_cast<ggml_fp16_t *>(s->data),
+        static_cast<float *>(pre->data), static_cast<float *>(post->data),
+        ip ? static_cast<int32_t *>(ip->data) : nullptr, op ? static_cast<int32_t *>(op->data) : nullptr,
+        desc, 8, dense.data()), "dequantize failed");
+    // Lamplight 0136: the CPU's fast product rounds the rotated inputs to int16 (one scale per 16), as CUDA rounds
+    // them to fp16: checked by normalized error (CUDA's bar in test-backend-ops is 1e-5, this is 1e-6), then the fp32
+    // product (LAMPLIGHT_TRELLIS_CPU=exact) value by value as Nari checks it
+    std::vector<double> want((size_t) columns * N);
+    for (int c = 0; c < columns; ++c) {
+        for (int n = 0; n < N; ++n) {
+            double expected = 0;
+            for (int k = 0; k < K; ++k) { expected += double(dense[n * K + k]) * static_cast<float *>(x->data)[c * K + k]; }
+            want[(size_t) c * N + n] = expected;
+        }
+    }
+    for (int c = 0; c < columns; ++c) {
+        double err = 0, ref = 0;
+        for (int n = 0; n < N; ++n) {
+            const double d = static_cast<float *>(y->data)[c * N + n] - want[(size_t) c * N + n];
+            err += d * d;
+            ref += want[(size_t) c * N + n] * want[(size_t) c * N + n];
+        }
+        check(std::isfinite(err) && err <= 1e-6 * ref, "trellis fast product: normalized error over 1e-6");
+    }
+    trellis_cpu_mode("exact");
+    check(ggml_backend_graph_compute(backend, graph) == GGML_STATUS_SUCCESS, "trellis graph failed");
+    trellis_cpu_mode(nullptr);
+    for (int c = 0; c < columns; ++c) {
+        for (int n = 0; n < N; ++n) {
+            check_close(static_cast<float *>(y->data)[c * N + n], want[(size_t) c * N + n]);
+        }
+    }
+
+    // Embeddings rotate columns only. Include both ordinary and frequency-banded lookups.
+    desc[0] = desc[1] = 0;
+    check(ggml_trellis_dequantize(type, w->data, K, N, static_cast<ggml_fp16_t *>(s->data),
+        static_cast<float *>(pre->data), static_cast<float *>(post->data), nullptr, nullptr,
+        desc, 8, dense.data()), "embedding decode failed");
+    auto * ids = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, 4);
+    const int32_t rows[] = {0, 17, N - 1, 32};
+    for (int i = 0; i < 4; ++i) { static_cast<int32_t *>(ids->data)[i] = rows[i]; }
+    auto * e = ggml_trellis_get_rows(ctx, w, ids, s, pre, post, desc, 8);
+    graph = ggml_new_graph(ctx);
+    ggml_build_forward_expand(graph, e);
+    check(ggml_backend_graph_compute(backend, graph) == GGML_STATUS_SUCCESS, "embedding graph failed");
+    for (int i = 0; i < 4; ++i) {
+        for (int k = 0; k < K; ++k) { check_close(static_cast<float *>(e->data)[i * K + k], dense[rows[i] * K + k]); }
+    }
+    auto * gather = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, 2 * N);
+    auto * post2 = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, N);
+    for (int i = 0; i < N; ++i) { static_cast<float *>(post2->data)[i] = -static_cast<float *>(post->data)[i]; }
+    for (int i = 0; i < 2 * N; ++i) { static_cast<int32_t *>(gather->data)[i] = 2 * N - 1 - i; }
+    const int32_t tokens[] = {0, 17, N + 17, 2 * N - 1};
+    for (int i = 0; i < 4; ++i) { static_cast<int32_t *>(ids->data)[i] = tokens[i]; }
+    auto * band = ggml_trellis_get_rows_band(ctx, nullptr, w, ids, gather, 0, s, pre, post, desc, 8);
+    band = ggml_trellis_get_rows_band(ctx, band, w, ids, gather, N, s, pre, post2, desc, 8);
+    graph = ggml_new_graph(ctx);
+    ggml_build_forward_expand(graph, band);
+    check(ggml_backend_graph_compute(backend, graph) == GGML_STATUS_SUCCESS, "banded embedding graph failed");
+    for (int i = 0; i < 4; ++i) {
+        int row = 2 * N - 1 - tokens[i];
+        for (int k = 0; k < K; ++k) { check_close(static_cast<float *>(band->data)[i * K + k], (row >= N ? -1 : 1) * dense[(row % N) * K + k]); }
+    }
+    ggml_free(ctx);
+}
