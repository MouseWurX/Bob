 "lock": "${LOCK}",
 "stopFile": "${STOP_FILE}",
 "loadTimeoutMs": 900000,
 "wordsRef": "be28-best",
 "baseArgs": [
  "--jinja",
  "-np",
  "1",
  "--no-webui",
  "-fa",
  "on",
  "-c",
  "32768",
  "-ctk",
  "q8_0",
  "-ctv",
  "q8_0",
  "--fit",
  "on"
 ],
 "ways": [
  {
   "id": "be28-best",
   "engine": "be28",
   "args": [
    "--fit-target",
    "1024",
    "-b",
    "4096",
    "-ub",
    "4096",
    "--moe-cache-mib",
    "4096",
    "--moe-cache-cpu-share",
    "0"
   ]
  },
  {
   "id": "avalon-defaults",
