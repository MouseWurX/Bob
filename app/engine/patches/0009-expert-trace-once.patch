diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index cec32c0..24c01e2 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -1411,6 +1411,38 @@ void llama_context::set_eval_callback(ggml_backend_sched_eval_callback cb_eval,
     ggml_backend_sched_set_eval_callback(sched.get(), cb_eval, cb_eval_user_data);
 }
 
+void llama_context::set_keep_expert_ids(bool keep) {
+    synchronize();
+
+    // the graph is rebuilt on the next step (graph reuse compares this), and the scheduler lays out its memory again:
+    // a layout made without the picks kept would let a later layer write over an earlier layer's picks
+    if (cparams.keep_expert_ids != keep) {
+        sched_need_reserve = true;
+    }
+    cparams.keep_expert_ids = keep;
+}
+
+void llama_context::get_tensors(ggml_tensor * const * ts, void * const * dsts, const size_t * sizes, int32_t n) {
+    std::vector<ggml_backend_t> used;
+    for (int32_t i = 0; i < n; i++) {
+        if (!ts[i] || !dsts[i] || sizes[i] == 0) {
+            continue;
+        }
+        ggml_backend_t backend = ggml_backend_sched_get_tensor_backend(sched.get(), ts[i]);
+        if (!backend) {
+            ggml_backend_tensor_get(ts[i], dsts[i], 0, sizes[i]);
+            continue;
+        }
+        ggml_backend_tensor_get_async(backend, ts[i], dsts[i], 0, sizes[i]);
+        if (std::find(used.begin(), used.end(), backend) == used.end()) {
+            used.push_back(backend);
+        }
+    }
+    for (auto * backend : used) {
+        ggml_backend_synchronize(backend);
+    }
+}
+
 void llama_context::set_abort_callback(bool (*abort_callback)(void * data), void * abort_callback_data) {
     LLAMA_LOG_DEBUG("%s: call\n", __func__);
 
@@ -4735,6 +4767,14 @@ void llama_set_eval_callback(llama_context * ctx, ggml_backend_sched_eval_callba
     ctx->set_eval_callback(cb_eval, cb_eval_user_data);
 }
 
+void llama_set_keep_expert_ids(llama_context * ctx, bool keep) {
+    ctx->set_keep_expert_ids(keep);
+}
+
+void llama_get_tensors(llama_context * ctx, ggml_tensor * const * ts, void * const * dsts, const size_t * sizes, int32_t n) {
+    ctx->get_tensors(ts, dsts, sizes, n);
+}
+
 void llama_set_abort_callback(llama_context * ctx, bool (*abort_callback)(void * data), void * abort_callback_data) {
     ctx->set_abort_callback(abort_callback, abort_callback_data);
 }
