diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/gated_delta_net_cm.comp b/ggml/src/ggml-vulkan/vulkan-shaders/gated_delta_net_cm.comp
new file mode 100644
index 000000000..c5b4e4084
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/gated_delta_net_cm.comp
@@ -0,0 +1,437 @@
+#version 450
+
+#extension GL_EXT_control_flow_attributes : enable
+#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
+#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
+#extension GL_EXT_bfloat16 : require
+#extension GL_KHR_memory_scope_semantics : enable
+#extension GL_KHR_shader_subgroup_basic : enable
+#extension GL_KHR_shader_subgroup_arithmetic : enable
+#extension GL_KHR_shader_subgroup_shuffle : enable
+#extension GL_KHR_cooperative_matrix : enable
+#extension GL_EXT_cooperative_matrix_maintenance1 : enable
+
+// Chunked gated-delta-net prefill (non-KDA, S_v == D == 128, K == 1), port of CUDA PR 29353.
+// State in register tiles, mirrored ([D x V]) for the projections.
+// bf16 hi/lo 3x products for ~fp32 accuracy.
+#define OPD bfloat16_t
+
+#define C  16          // chunk size (tokens per step)
+#define D  128         // head dim / value dim
+#define TM 16          // tile rows
+#define TN 16          // tile cols (bf16 cm has only m16n16k16; n8 would pad)
+#ifndef V
+#define V  64          // value columns per workgroup block (V=128 = whole head)
+#endif
+#define NSUB 16        // subgroups per workgroup
+layout(constant_id = 0) const uint WGS = NSUB * 32;   // NSUB * subgroup size
+#define KT 16          // K-tile width for deep (K=D) matmuls (bf16 cm: m16n16k16 only)
+#define PAD 8          // shared padding to break COL-load bank conflicts (keep LDP*2 a multiple of 16B)
+#define LDP (D + PAD)
+
+// GMEM_MIRROR: state mirror in a gmem scratch buffer (too big for shared)
+
+#define STATE_TILES ((D / TM) * (V / TN))
+#define PER_WARP    (STATE_TILES / NSUB)
+#define VT          (V / TN)   // value tiles
+#define CT          (C / TN)   // C-column tiles (gram/pmat halves)
+const uint NQK = C * D / WGS;
+
+#define TILE_R(ti) (((ti) / VT) * TM)
+#define TILE_C(ti) (((ti) % VT) * TN)
+
+layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;
+
+layout(push_constant) uniform Parameters {
+    uint H;
+    uint n_tokens;
+    uint n_seqs;
+    uint s_off;
+    uint sq1, sq2, sq3;
+    uint sk1, sk2, sk3;
+    uint sv1, sv2, sv3;
+    uint sb1, sb2, sb3;
+    uint neq1, rq3;
+    float scale;
+    uint K;
+} p;
+
+layout(binding = 0) readonly  buffer QBuf     { float data_q[];     };
+layout(binding = 1) readonly  buffer KBuf     { float data_k[];     };
+layout(binding = 2) readonly  buffer VBuf     { float data_v[];     };
+layout(binding = 3) readonly  buffer GBuf     { float data_g[];     };
+layout(binding = 4) readonly  buffer BetaBuf  { float data_beta[];  };
+layout(binding = 5) readonly  buffer StateBuf { float data_state[]; };
+layout(binding = 6)           buffer DstBuf   { float data_dst[];   };
+#ifdef GMEM_MIRROR
+layout(binding = 7) coherent  buffer MirrorBuf { OPD data_mirror[]; };
+#endif
+
+shared OPD sh_qh[C * LDP], sh_ql[C * LDP];   // q*scale hi/lo (D padded)
+shared OPD sh_kh[C * LDP], sh_kl[C * LDP];   // k hi/lo (D padded)
+#ifndef GMEM_MIRROR
+shared OPD sh_sh[LDP * V], sh_sl[LDP * V];   // state mirror [D x V] column-major (D padded)
+#endif
+shared OPD sh_dh[C * V], sh_dl[C * V];   // delta (pre-inv) / delta2 [C x V] row-major
+shared OPD sh_soh[C * V], sh_sol[C * V]; // solved [C x V] row-major
+shared OPD sh_ph[C * C], sh_pl[C * C];   // decayed P
+shared OPD sh_ih[C * C], sh_il[C * C];   // (I + L)^-1
+shared float sh_lower[C * C];            // strictly-lower decayed L
+
+shared float sh_prefix[C], sh_beta[C], sh_ep[C], sh_carry[C];
+
+#define SG   gl_ScopeSubgroup
+#define MUA  gl_MatrixUseA
+#define MUB  gl_MatrixUseB
+#define MACC gl_MatrixUseAccumulator
+#define ROW  gl_CooperativeMatrixLayoutRowMajor
+#define COL  gl_CooperativeMatrixLayoutColumnMajor
+
+
+// 3x bf16 product accumulated into acc (hi/lo split for ~fp32 accuracy).
+#define PRODUCT(acc, ah, al, bh, bl) \
+    acc = coopMatMulAdd(al, bh, acc); \
+    acc = coopMatMulAdd(ah, bl, acc); \
+    acc = coopMatMulAdd(ah, bh, acc);
+
+void split(const float x, out OPD h, out OPD l) {
+    h = OPD(x);
+    l = OPD(x - float(h));
+}
+
+#ifdef BF16ACC
+// split through a bf16 accumulator
+#define SPLIT_STORE(m, arr_h, off_h, arr_l, off_l, ld, layout) { \
+    const coopmat<OPD, SG, TM, TN, MACC> h_ = coopmat<OPD, SG, TM, TN, MACC>(m); \
+    const coopmat<OPD, SG, TM, TN, MACC> l_ = coopmat<OPD, SG, TM, TN, MACC>(m - coopmat<float, SG, TM, TN, MACC>(h_)); \
+    coopMatStore(h_, arr_h, off_h, ld, layout); \
+    coopMatStore(l_, arr_l, off_l, ld, layout); \
+}
+
+#ifdef GMEM_MIRROR
+#define STORE_MIRROR(m, off) SPLIT_STORE(m, data_mirror, mir_h + off, data_mirror, mir_l + off, LDP, COL)
+#else
+#define STORE_MIRROR(m, off) SPLIT_STORE(m, sh_sh, off, sh_sl, off, LDP, COL)
+#endif
+#define STORE_DELTA(m, off)  SPLIT_STORE(m, sh_dh, off, sh_dl, off, V, ROW)
+#define STORE_SOLVED(m, off) SPLIT_STORE(m, sh_soh, off, sh_sol, off, V, ROW)
+#else
+// split per element
+#ifdef GMEM_MIRROR
+float SplitColS(const in uint32_t r, const in uint32_t c, const in float elem, const in uint32_t off) {
+    const uint idx = off + c * LDP + r;
+    split(elem, data_mirror[idx], data_mirror[idx + LDP * V]);
+    return elem;
+}
+#define STORE_MIRROR(m, off) coopMatPerElementEXT(m, m, SplitColS, mir_h + off)
+#else
+float SplitColS(const in uint32_t r, const in uint32_t c, const in float elem, const in uint32_t off) {
+    const uint idx = off + c * LDP + r;
+    split(elem, sh_sh[idx], sh_sl[idx]);
+    return elem;
+}
+#define STORE_MIRROR(m, off) coopMatPerElementEXT(m, m, SplitColS, off)
+#endif
+
+float SplitRowD(const in uint32_t r, const in uint32_t c, const in float elem, const in uint32_t off) {
+    const uint idx = off + r * V + c;
+    split(elem, sh_dh[idx], sh_dl[idx]);
+    return elem;
+}
+
+float SplitRowSO(const in uint32_t r, const in uint32_t c, const in float elem, const in uint32_t off) {
+    const uint idx = off + r * V + c;
+    split(elem, sh_soh[idx], sh_sol[idx]);
+    return elem;
+}
+
+#define STORE_DELTA(m, off)  coopMatPerElementEXT(m, m, SplitRowD, off)
+#define STORE_SOLVED(m, off) coopMatPerElementEXT(m, m, SplitRowSO, off)
+#endif
+
+#ifdef GMEM_MIRROR
+#define LOAD_S(h, l, off) \
+    coopMatLoad(h, data_mirror, mir_h + off, LDP, COL); \
+    coopMatLoad(l, data_mirror, mir_l + off, LDP, COL);
+// mirror is workgroup-private
+#define MIRROR_BARRIER() controlBarrier(gl_ScopeWorkgroup, gl_ScopeWorkgroup, \
+                                        gl_StorageSemanticsBuffer | gl_StorageSemanticsShared, \
+                                        gl_SemanticsAcquireRelease)
+#else
+#define LOAD_S(h, l, off) \
+    coopMatLoad(h, sh_sh, off, LDP, COL); \
+    coopMatLoad(l, sh_sl, off, LDP, COL);
+#define MIRROR_BARRIER() barrier()
+#endif
+
+float StoreOut(const in uint32_t r, const in uint32_t c, const in float elem,
+               const in uint32_t out_base, const in uint32_t valid) {
+    if (r < valid) {
+        data_dst[out_base + r * (D * p.H) + c] = elem;
+    }
+    return elem;
+}
+
+float StoreState(const in uint32_t r, const in uint32_t c, const in float elem,
+                 const in uint32_t base) {
+    data_dst[base + c * D + r] = elem;
+    return elem;
+}
+
+float LoadV(const in uint32_t r, const in uint32_t c, const in float elem,
+            const in uint32_t v_base, const in uint32_t sv2, const in uint32_t valid) {
+    return r < valid ? data_v[v_base + r * sv2 + c] : 0.0;
+}
+
+// sh_beta[r] == 0 for r >= valid
+float ComputeDeltaV(const in uint32_t r, const in uint32_t c, const in float ks,
+                    const in float vv) {
+    return sh_beta[r] * (vv - sh_ep[r] * ks);
+}
+
+float ApplyExpPrefix(const in uint32_t r, const in uint32_t c, const in float qs) {
+    return sh_ep[r] * qs;
+}
+
+float StoreLower(const in uint32_t r, const in uint32_t c, const in float elem,
+                 const in uint32_t c_o) {
+    const uint cc = c_o + c;
+    if (cc < r) {
+        sh_lower[r * C + cc] = elem * exp(sh_prefix[r] - sh_prefix[cc]) * sh_beta[r];
+    }
+    return elem;
+}
+
+float StorePmat(const in uint32_t r, const in uint32_t c, const in float elem,
+                const in uint32_t c_o) {
+    const uint cc = c_o + c;
+    float v = 0.0;
+    if (cc <= r) {
+        v = elem * exp(sh_prefix[r] - sh_prefix[cc]);
+    }
+    split(v, sh_ph[r * C + cc], sh_pl[r * C + cc]);
+    return elem;
+}
+
+void prefetch(const uint t0, const uint iq1, const uint iq3, const uint seq_id, const uint head_id,
+              out float q[NQK], out float k[NQK], out float g, out float b) {
+    const uint n = t0 < p.n_tokens ? min(C, p.n_tokens - t0) : 0u;
+    [[unroll]] for (uint j = 0; j < NQK; j++) {
+        const uint i = gl_LocalInvocationID.x + j * WGS;
+        const uint t = i / D;
+        q[j] = 0.0;
+        k[j] = 0.0;
+        if (t < n) {
+            const uint q_off = iq3 * p.sq3 + (t0 + t) * p.sq2 + iq1 * p.sq1 + i % D;
+            const uint k_off = iq3 * p.sk3 + (t0 + t) * p.sk2 + iq1 * p.sk1 + i % D;
+            q[j] = data_q[q_off] * p.scale;
+            k[j] = data_k[k_off];
+        }
+    }
+    g = 0.0;
+    b = 0.0;
+    const uint t = gl_SubgroupInvocationID;
+    if (gl_SubgroupID == 0 && t < n) {
+        const uint gb = seq_id * p.sb3 + (t0 + t) * p.sb2 + head_id * p.sb1;
+        g = data_g[gb];
+        b = data_beta[gb];
+    }
+}
+
+// sg0: gram K@K^T -> L, sg1: pmat Q@K^T -> P
+void gram_pmat(const uint sg) {
+    const bool gram = sg < CT;
+    const uint c_o  = (sg % CT) * TN;
+    coopmat<float, SG, C, TN, MACC> x = coopmat<float, SG, C, TN, MACC>(0);
+    [[unroll]] for (uint kk = 0; kk < D; kk += KT) {
+        coopmat<OPD, SG, C, KT, MUA> ah, al;
+        if (gram) {
+            coopMatLoad(ah, sh_kh, kk, LDP, ROW);
+            coopMatLoad(al, sh_kl, kk, LDP, ROW);
+        } else {
+            coopMatLoad(ah, sh_qh, kk, LDP, ROW);
+            coopMatLoad(al, sh_ql, kk, LDP, ROW);
+        }
+        coopmat<OPD, SG, KT, TN, MUB> bh, bl;
+        coopMatLoad(bh, sh_kh, c_o * LDP + kk, LDP, COL);
+        coopMatLoad(bl, sh_kl, c_o * LDP + kk, LDP, COL);
+        PRODUCT(x, ah, al, bh, bl);
+    }
+    if (gram) {
+        coopMatPerElementEXT(x, x, StoreLower, c_o);
+    } else {
+        coopMatPerElementEXT(x, x, StorePmat, c_o);
+    }
+}
+
+// (I + L)^-1, forward substitution: subgroup per row, lane per column
+void invert(const uint sg) {
+    const uint col = gl_SubgroupInvocationID;
+    [[unroll]] for (uint row = sg; row < C; row += NSUB) {
+        float x = col < C ? (col == row ? 1.0 : (col < row ? -sh_lower[row * C + col] : 0.0)) : 0.0;
+        for (int pivot = int(row) - 1; pivot > 0; pivot--) {
+            const float xp = subgroupShuffle(x, uint(pivot));
+            if (col < uint(pivot)) {
+                x -= xp * sh_lower[uint(pivot) * C + col];
+            }
+        }
+        if (col < C) {
+            split(x, sh_ih[row * C + col], sh_il[row * C + col]);
+        }
+    }
+}
+
+float carry_decay(const uint valid) {
+    const float plast = sh_prefix[valid - 1];
+    if (gl_LocalInvocationID.x < C) {
+        sh_carry[gl_LocalInvocationID.x] = exp(plast - sh_prefix[gl_LocalInvocationID.x]);
+    }
+    return exp(plast);
+}
+
+void main() {
+    const uint head_id = gl_WorkGroupID.z;
+    const uint seq_id  = gl_WorkGroupID.y;
+    const uint sg      = gl_SubgroupID;
+    const uint tid     = gl_LocalInvocationID.x;
+    const uint v0      = gl_WorkGroupID.x * V;
+
+    const uint iq1 = head_id % p.neq1;
+    const uint iq3 = seq_id / p.rq3;
+
+    const uint state_base = (seq_id * p.H + head_id) * (D * D);
+
+#ifdef GMEM_MIRROR
+    const uint mir_stride = uint(LDP) * V;
+    const uint mir_block  = (head_id * p.n_seqs + seq_id) * gl_NumWorkGroups.x + gl_WorkGroupID.x;
+    const uint mir_h      = mir_block * mir_stride * 2u;
+    const uint mir_l      = mir_h + mir_stride;
+#endif
+
+    coopmat<float, SG, TM, TN, MACC> state[PER_WARP];
+    [[unroll]] for (uint j = 0; j < PER_WARP; j++) {
+        const uint ti = sg + j * NSUB;
+        coopMatLoad(state[j], data_state, state_base + (v0 + TILE_C(ti)) * D + TILE_R(ti), D, COL);
+    }
+
+    float qreg[NQK], kreg[NQK], greg, breg;
+    prefetch(0u, iq1, iq3, seq_id, head_id, qreg, kreg, greg, breg);
+
+    for (uint t0 = 0; t0 < p.n_tokens; t0 += C) {
+        const uint valid = min(C, p.n_tokens - t0);
+
+        barrier();
+        if (sg == 0) {
+            const uint t = gl_SubgroupInvocationID;
+            const float acc = subgroupInclusiveAdd(greg);
+            if (t < C) {
+                sh_prefix[t] = acc;
+                sh_ep[t] = exp(acc);
+                sh_beta[t] = breg;
+            }
+        }
+        [[unroll]] for (uint j = 0; j < NQK; j++) {
+            const uint i = tid + j * WGS;
+            const uint pi = (i / D) * LDP + (i % D);
+            split(qreg[j], sh_qh[pi], sh_ql[pi]);
+            split(kreg[j], sh_kh[pi], sh_kl[pi]);
+        }
+
+        [[unroll]] for (uint j = 0; j < PER_WARP; j++) {
+            const uint ti = sg + j * NSUB;
+            STORE_MIRROR(state[j], TILE_C(ti) * LDP + TILE_R(ti));
+        }
+        MIRROR_BARRIER();
+
+        prefetch(t0 + C, iq1, iq3, seq_id, head_id, qreg, kreg, greg, breg);
+        const float cdecay = carry_decay(valid);
+
+        // qs -> base_r and ks -> delta on sg2..2+VT-1
+        coopmat<float, SG, C, TN, MACC> base_r = coopmat<float, SG, C, TN, MACC>(0);
+        if (sg < 2 * CT) {
+            gram_pmat(sg);
+        } else if (sg - 2 * CT < VT) {
+            const uint c_o = (sg - 2 * CT) * TN;
+            const uint v_base = seq_id * p.sv3 + head_id * p.sv1 + v0 + c_o + t0 * p.sv2;
+            coopmat<float, SG, C, TN, MACC> vmat = coopmat<float, SG, C, TN, MACC>(0);
+            coopMatPerElementEXT(vmat, vmat, LoadV, v_base, p.sv2, valid);
+            coopmat<float, SG, C, TN, MACC> qs = coopmat<float, SG, C, TN, MACC>(0);
+            coopmat<float, SG, C, TN, MACC> ks = coopmat<float, SG, C, TN, MACC>(0);
+            [[unroll]] for (uint kk = 0; kk < D; kk += KT) {
+                coopmat<OPD, SG, C, KT, MUA> qh, ql, kh, kl;
+                coopMatLoad(qh, sh_qh, kk, LDP, ROW);
+                coopMatLoad(ql, sh_ql, kk, LDP, ROW);
+                coopMatLoad(kh, sh_kh, kk, LDP, ROW);
+                coopMatLoad(kl, sh_kl, kk, LDP, ROW);
+                coopmat<OPD, SG, KT, TN, MUB> sbh, sbl;
+                LOAD_S(sbh, sbl, c_o * LDP + kk);
+                PRODUCT(qs, qh, ql, sbh, sbl);
+                PRODUCT(ks, kh, kl, sbh, sbl);
+            }
+            coopMatPerElementEXT(base_r, qs, ApplyExpPrefix);
+            coopmat<float, SG, C, TN, MACC> delta;
+            coopMatPerElementEXT(delta, ks, ComputeDeltaV, vmat);
+            STORE_DELTA(delta, c_o);
+        }
+        barrier();
+
+        invert(sg);
+        barrier();
+
+        // solved = (I+L)^-1 @ delta  (sg0..VT-1)
+        if (sg < VT) {
+            const uint c_o = sg * TN;
+            coopmat<float, SG, C, TN, MACC> solved = coopmat<float, SG, C, TN, MACC>(0);
+            coopmat<OPD, SG, C, C, MUA> ih, il;
+            coopMatLoad(ih, sh_ih, 0, C, ROW);
+            coopMatLoad(il, sh_il, 0, C, ROW);
+            coopmat<OPD, SG, C, TN, MUB> dh, dl;
+            coopMatLoad(dh, sh_dh, c_o, V, ROW);
+            coopMatLoad(dl, sh_dl, c_o, V, ROW);
+            PRODUCT(solved, ih, il, dh, dl);
+            STORE_SOLVED(solved, c_o);
+        }
+        barrier();
+
+        // out = base + P@solved  (sg2..2+VT-1)
+        if (sg >= 2 * CT && sg - 2 * CT < VT) {
+            const uint c_o = (sg - 2 * CT) * TN;
+            coopmat<float, SG, C, TN, MACC> O = base_r;
+            coopmat<OPD, SG, C, C, MUA> ph, pl;
+            coopMatLoad(ph, sh_ph, 0, C, ROW);
+            coopMatLoad(pl, sh_pl, 0, C, ROW);
+            coopmat<OPD, SG, C, TN, MUB> svh, svl;
+            coopMatLoad(svh, sh_soh, c_o, V, ROW);
+            coopMatLoad(svl, sh_sol, c_o, V, ROW);
+            PRODUCT(O, ph, pl, svh, svl);
+            const uint out_base = (seq_id * p.n_tokens * p.H + head_id) * D + v0 + c_o + t0 * (D * p.H);
+            coopMatPerElementEXT(O, O, StoreOut, out_base, valid);
+        }
+        // delta2 = solved * carry -> sh_dh/dl (all threads)
+        for (uint i = tid; i < C * V; i += WGS) {
+            const float sv = float(sh_soh[i]) + float(sh_sol[i]);
+            split(sv * sh_carry[i / V], sh_dh[i], sh_dl[i]);
+        }
+        barrier();
+
+        // state = cdecay*state + K^T @ delta2
+        [[unroll]] for (uint j = 0; j < PER_WARP; j++) {
+            const uint ti = sg + j * NSUB;
+            coopmat<OPD, SG, TM, C, MUA> kth, ktl;
+            coopMatLoad(kth, sh_kh, TILE_R(ti), LDP, COL);
+            coopMatLoad(ktl, sh_kl, TILE_R(ti), LDP, COL);
+            coopmat<OPD, SG, C, TN, MUB> dh, dl;
+            coopMatLoad(dh, sh_dh, TILE_C(ti), V, ROW);
+            coopMatLoad(dl, sh_dl, TILE_C(ti), V, ROW);
+            state[j] = state[j] * cdecay;
+            PRODUCT(state[j], kth, ktl, dh, dl);
+        }
+        // no end-of-chunk barrier: covered by the chunk-top barrier
+    }
+
+    [[unroll]] for (uint j = 0; j < PER_WARP; j++) {
+        const uint ti = sg + j * NSUB;
+        coopMatPerElementEXT(state[j], state[j], StoreState,
+                            p.s_off + state_base + (v0 + TILE_C(ti)) * D + TILE_R(ti));
+    }
+}
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/gated_delta_net_cm2.comp b/ggml/src/ggml-vulkan/vulkan-shaders/gated_delta_net_cm2.comp
new file mode 100644
index 000000000..270ef35db
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/gated_delta_net_cm2.comp
@@ -0,0 +1,320 @@
+#version 450
+
+#extension GL_EXT_control_flow_attributes : require
+#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
+#extension GL_EXT_bfloat16 : require
+#extension GL_KHR_memory_scope_semantics : require
+#extension GL_KHR_shader_subgroup_basic : require
+#extension GL_KHR_shader_subgroup_arithmetic : require
+#extension GL_KHR_shader_subgroup_shuffle : require
+#extension GL_KHR_shader_subgroup_shuffle_relative : require
+#extension GL_KHR_cooperative_matrix : require
+#extension GL_NV_cooperative_matrix2 : require
+
+// Chunked gated-delta-net prefill (non-KDA, S_v == D == 128, K == 1).
+// BF16 hi/lo products use FP32 accumulators.
+#define OPD bfloat16_t
+
+#define C  16          // chunk size (tokens per step)
+#define D  128         // head dim / value dim
+#define V  32          // value columns per workgroup block
+#define WGS 128
+#define NSUB (WGS / 32)
+#define KT 32          // K-tile width for deep (K=D) matmuls
+#define PAD 8
+#define LDP (D + PAD)
+#define LDV (V + PAD)
+#define KQ_ROWS (2 * C)
+#define NQK (C * D / WGS)
+
+layout(local_size_x = WGS, local_size_y = 1, local_size_z = 1) in;
+
+layout(push_constant) uniform Parameters {
+    uint H;
+    uint n_tokens;
+    uint n_seqs;
+    uint s_off;
+    uint sq1, sq2, sq3;
+    uint sk1, sk2, sk3;
+    uint sv1, sv2, sv3;
+    uint sb1, sb2, sb3;
+    uint neq1, rq3;
+    float scale;
+    uint K;
+} p;
+
+layout(binding = 0) readonly  buffer QBuf     { float data_q[];     };
+layout(binding = 1) readonly  buffer KBuf     { float data_k[];     };
+layout(binding = 2) readonly  buffer VBuf     { float data_v[];     };
+layout(binding = 3) readonly  buffer GBuf     { float data_g[];     };
+layout(binding = 4) readonly  buffer BetaBuf  { float data_beta[];  };
+layout(binding = 5) readonly  buffer StateBuf { float data_state[]; };
+layout(binding = 6)           buffer DstBuf   { float data_dst[];   };
+
+// K and scaled Q occupy the two row blocks of one 32-row operand.
+shared OPD sh_kqh[2 * C * LDP], sh_kql[2 * C * LDP];
+shared OPD sh_sh[V * LDP], sh_sl[V * LDP]; // state mirror [V x D] row-major (D padded)
+shared OPD sh_ph[C * C], sh_pl[C * C];
+shared OPD sh_ih[C * C], sh_il[C * C];
+shared OPD sh_dh[C * LDV], sh_dl[C * LDV]; // delta / solved [C x V] row-major (V padded)
+shared float sh_lower[C * (C - 1) / 2]; // packed strictly-lower Gram entries
+shared float sh_prefix[C], sh_ep[C], sh_beta[C], sh_carry[C];
+
+#define WG   gl_ScopeWorkgroup
+#define MUA  gl_MatrixUseA
+#define MUB  gl_MatrixUseB
+#define MACC gl_MatrixUseAccumulator
+#define ROW  gl_CooperativeMatrixLayoutRowMajor
+#define COL  gl_CooperativeMatrixLayoutColumnMajor
+
+#define PRODUCT(acc, ah, al, bh, bl) \
+    acc = coopMatMulAdd(ah, bh, acc); \
+    acc = coopMatMulAdd(al, bh, acc); \
+    acc = coopMatMulAdd(ah, bl, acc);
+
+void split(const float x, out OPD h, out OPD l) {
+    h = OPD(x);
+    l = OPD(x - float(h));
+}
+
+float StoreGramPmat(const in uint32_t r, const in uint32_t c, const in float elem) {
+    if (r < C) {
+        if (c < r) {
+            sh_lower[r * (r - 1) / 2 + c] = elem * exp(sh_prefix[r] - sh_prefix[c]) * sh_beta[r];
+        }
+    } else {
+        const uint row = r - C;
+        const float y = c <= row ? elem * exp(sh_prefix[row] - sh_prefix[c]) : 0.0;
+        split(y, sh_ph[row * C + c], sh_pl[row * C + c]);
+    }
+    return elem;
+}
+
+float SplitRowS(const in uint32_t r, const in uint32_t c, const in float elem) {
+    const uint i = r * LDP + c;
+    split(elem, sh_sh[i], sh_sl[i]);
+    return elem;
+}
+
+float ApplyExpPrefix(const in uint32_t r, const in uint32_t c, const in float qs) {
+    return sh_ep[c] * qs;
+}
+
+float LoadV(const in uint32_t r, const in uint32_t c, const in float elem,
+            const in uint32_t v_base, const in uint32_t sv2, const in uint32_t valid) {
+    return c < valid ? data_v[v_base + c * sv2 + r] : 0.0;
+}
+
+float StoreDeltaV(const in uint32_t r, const in uint32_t c, const in float ks, const in float vv) {
+    const float x = sh_beta[c] * (vv - sh_ep[c] * ks);
+    const uint i = c * LDV + r;
+    split(x, sh_dh[i], sh_dl[i]);
+    return ks;
+}
+
+float StoreSolved(const in uint32_t r, const in uint32_t c, const in float elem) {
+    const uint i = c * LDV + r;
+    split(elem, sh_dh[i], sh_dl[i]);
+    // The state mirror is no longer needed after KS/QS.
+    const uint j = r * LDP + c;
+    split(sh_carry[c] * elem, sh_sh[j], sh_sl[j]);
+    return elem;
+}
+
+float StoreOut(const in uint32_t r, const in uint32_t c, const in float elem,
+               const in uint32_t out_base, const in uint32_t valid) {
+    if (c < valid) {
+        data_dst[out_base + c * (p.H * D) + r] = elem;
+    }
+    return elem;
+}
+
+void prefetch(const uint t0, const uint q_base, const uint k_base, const uint gb_base,
+              out float q[NQK], out float k[NQK], out float g, out float b) {
+    const uint valid = t0 < p.n_tokens ? min(C, p.n_tokens - t0) : 0u;
+    const uint r = gl_SubgroupInvocationID;
+    g = 0.0;
+    b = 0.0;
+    if (gl_SubgroupID == 0 && r < valid) {
+        const uint off = gb_base + (t0 + r) * p.sb2;
+        g = data_g[off];
+        b = data_beta[off];
+    }
+    [[unroll]] for (uint j = 0; j < NQK; ++j) {
+        const uint i = gl_LocalInvocationID.x + j * WGS;
+        const uint token = i / D;
+        q[j] = 0.0;
+        k[j] = 0.0;
+        if (token < valid) {
+            const uint q_off = q_base + (t0 + token) * p.sq2 + i % D;
+            const uint k_off = k_base + (t0 + token) * p.sk2 + i % D;
+            q[j] = data_q[q_off];
+            k[j] = data_k[k_off];
+        }
+    }
+}
+
+void stage_inputs(const in float q[NQK], const in float k[NQK]) {
+    [[unroll]] for (uint j = 0; j < NQK; ++j) {
+        const uint i = gl_LocalInvocationID.x + j * WGS;
+        const uint token = i / D;
+        const uint key = i % D;
+        const uint ki = token * LDP + key;
+        const uint qi = (C + token) * LDP + key;
+        split(k[j], sh_kqh[ki], sh_kql[ki]);
+        split(p.scale * q[j], sh_kqh[qi], sh_kql[qi]);
+    }
+}
+
+// [K; Q] * K^T computes Gram and P in one 32-row matrix.
+void gram_pmat() {
+    coopmat<float, WG, KQ_ROWS, C, MACC> x = coopmat<float, WG, KQ_ROWS, C, MACC>(0.0);
+    [[unroll]] for (uint kk = 0; kk < D; kk += KT) {
+        coopmat<OPD, WG, KQ_ROWS, KT, MUA> ah, al;
+        coopmat<OPD, WG, KT, C, MUB> bh, bl;
+        coopMatLoad(ah, sh_kqh, kk, LDP, ROW);
+        coopMatLoad(al, sh_kql, kk, LDP, ROW);
+        coopMatLoad(bh, sh_kqh, kk, LDP, COL);
+        coopMatLoad(bl, sh_kql, kk, LDP, COL);
+        PRODUCT(x, ah, al, bh, bl);
+    }
+    coopMatPerElementNV(x, x, StoreGramPmat);
+}
+
+void invert() {
+    const uint col = gl_SubgroupInvocationID % C;
+    // Each half-subgroup covers all columns of its assigned rows.
+    const uint section = gl_SubgroupInvocationID / C;
+    const uint row_base = (gl_SubgroupID * 2u + section) * (C / (2 * NSUB));
+    // Keep the diagonal zero so pivots at or above the row do nothing.
+    float x[C / (2 * NSUB)];
+    [[unroll]] for (uint j = 0; j < C / (2 * NSUB); ++j) {
+        const uint row = row_base + j;
+        x[j] = col < row ? -sh_lower[row * (row - 1) / 2 + col] : 0.0;
+    }
+    [[dont_unroll]] for (int pivot = C - 2; pivot > 0; --pivot) {
+        const float lower = col < uint(pivot) ? sh_lower[uint(pivot) * uint(pivot - 1) / 2 + col] : 0.0;
+        [[unroll]] for (uint j = 0; j < C / (2 * NSUB); ++j) {
+            const float xp = subgroupShuffle(x[j], uint(pivot) + section * C);
+            x[j] -= xp * lower;
+        }
+    }
+    [[unroll]] for (uint j = 0; j < C / (2 * NSUB); ++j) {
+        const uint row = row_base + j;
+        split(col == row ? 1.0 : x[j], sh_ih[row * C + col], sh_il[row * C + col]);
+    }
+}
+
+void main() {
+    const uint head_id = gl_WorkGroupID.z;
+    const uint seq_id = gl_WorkGroupID.y;
+    const uint v0 = gl_WorkGroupID.x * V;
+    const uint iq1 = head_id % p.neq1;
+    const uint iq3 = seq_id / p.rq3;
+    const uint q_base = iq3 * p.sq3 + iq1 * p.sq1;
+    const uint k_base = iq3 * p.sk3 + iq1 * p.sk1;
+    const uint v_base = seq_id * p.sv3 + head_id * p.sv1 + v0;
+    const uint gb_base = seq_id * p.sb3 + head_id * p.sb1;
+    const uint state_base = (seq_id * p.H + head_id) * (D * D) + v0 * D;
+    const uint out_base = (seq_id * p.n_tokens * p.H + head_id) * D + v0;
+
+    // Transposing the state-side products gives them V=32 rows with C=16 columns.
+    coopmat<float, WG, V, D, MACC> state;
+    coopMatLoad(state, data_state, state_base, D, ROW);
+
+    float qreg[NQK], kreg[NQK], greg, breg;
+    prefetch(0u, q_base, k_base, gb_base, qreg, kreg, greg, breg);
+
+    [[dont_unroll]] for (uint t0 = 0; t0 < p.n_tokens; t0 += C) {
+        const uint valid = min(C, p.n_tokens - t0);
+        barrier();
+        if (gl_SubgroupID == 0) {
+            const uint r = gl_SubgroupInvocationID;
+            // shuffle scan instead of subgroupInclusiveAdd: works around an NVIDIA r620 shader compiler crash
+            float sum = greg;
+            [[unroll]] for (uint d = 1; d < C; d <<= 1) {
+                const float t = subgroupShuffleUp(sum, d);
+                if (r >= d) {
+                    sum += t;
+                }
+            }
+            const float last = subgroupShuffle(sum, valid - 1);
+            if (r < C) {
+                sh_prefix[r] = sum;
+                sh_ep[r] = exp(sum);
+                sh_beta[r] = breg;
+                sh_carry[r] = exp(last - sum);
+            }
+        }
+        stage_inputs(qreg, kreg);
+        coopmat<float, WG, V, C, MACC> vmat;
+        if (valid == C && (v_base % 4u) == 0 && (p.sv2 % 4u) == 0) {
+            coopMatLoad(vmat, data_v, v_base + t0 * p.sv2, p.sv2, COL);
+        } else {
+            vmat = coopmat<float, WG, V, C, MACC>(0.0);
+            coopMatPerElementNV(vmat, vmat, LoadV, v_base + t0 * p.sv2, p.sv2, valid);
+        }
+        barrier();
+        // Current inputs are in shared memory; keep the next chunk in registers.
+        prefetch(t0 + C, q_base, k_base, gb_base, qreg, kreg, greg, breg);
+
+        gram_pmat();
+        barrier();
+        invert();
+        coopMatPerElementNV(state, state, SplitRowS);
+        barrier();
+
+        coopmat<float, WG, V, C, MACC> ks = coopmat<float, WG, V, C, MACC>(0.0), base_r = coopmat<float, WG, V, C, MACC>(0.0);
+        [[unroll]] for (uint kk = 0; kk < D; kk += KT) {
+            coopmat<OPD, WG, V, KT, MUA> ah, al;
+            coopmat<OPD, WG, KT, C, MUB> kh, kl, qh, ql;
+            coopMatLoad(ah, sh_sh, kk, LDP, ROW);
+            coopMatLoad(al, sh_sl, kk, LDP, ROW);
+            coopMatLoad(kh, sh_kqh, kk, LDP, COL);
+            coopMatLoad(kl, sh_kql, kk, LDP, COL);
+            coopMatLoad(qh, sh_kqh, C * LDP + kk, LDP, COL);
+            coopMatLoad(ql, sh_kql, C * LDP + kk, LDP, COL);
+            PRODUCT(ks, ah, al, kh, kl);
+            PRODUCT(base_r, ah, al, qh, ql);
+        }
+        coopMatPerElementNV(base_r, base_r, ApplyExpPrefix);
+        coopMatPerElementNV(ks, ks, StoreDeltaV, vmat);
+        barrier();
+
+        coopmat<float, WG, V, C, MACC> solved = coopmat<float, WG, V, C, MACC>(0.0);
+        {
+            coopmat<OPD, WG, V, C, MUA> rh, rl;
+            coopmat<OPD, WG, C, C, MUB> ih, il;
+            coopMatLoad(rh, sh_dh, 0, LDV, COL);
+            coopMatLoad(rl, sh_dl, 0, LDV, COL);
+            coopMatLoad(ih, sh_ih, 0, C, COL);
+            coopMatLoad(il, sh_il, 0, C, COL);
+            PRODUCT(solved, rh, rl, ih, il);
+        }
+        barrier();
+        coopMatPerElementNV(solved, solved, StoreSolved);
+        barrier();
+
+        {
+            coopmat<OPD, WG, V, C, MUA> xh, xl;
+            coopmat<OPD, WG, C, C, MUB> ph, pl;
+            coopMatLoad(xh, sh_dh, 0, LDV, COL);
+            coopMatLoad(xl, sh_dl, 0, LDV, COL);
+            coopMatLoad(ph, sh_ph, 0, C, COL);
+            coopMatLoad(pl, sh_pl, 0, C, COL);
+            PRODUCT(base_r, xh, xl, ph, pl);
+        }
+        coopMatPerElementNV(base_r, base_r, StoreOut, out_base + t0 * (p.H * D), valid);
+
+        coopmat<OPD, WG, V, C, MUA> xh, xl;
+        coopmat<OPD, WG, C, D, MUB> kh, kl;
+        coopMatLoad(xh, sh_sh, 0, LDP, ROW);
+        coopMatLoad(xl, sh_sl, 0, LDP, ROW);
+        coopMatLoad(kh, sh_kqh, 0, LDP, ROW);
+        coopMatLoad(kl, sh_kql, 0, LDP, ROW);
+        state *= sh_ep[valid - 1];
+        PRODUCT(state, xh, xl, kh, kl);
+    }
+
+    coopMatStore(state, data_dst, p.s_off + state_base, D, ROW);
+}
