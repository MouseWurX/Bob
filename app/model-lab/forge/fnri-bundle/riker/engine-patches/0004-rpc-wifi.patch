-const size_t HASH_THRESHOLD = 10 * 1024 * 1024;
+// Try RPC_CMD_SET_TENSOR_HASH first when data size is larger than this threshold.
+// Brain Engine: 1 MiB instead of 10 MiB, so that with `rpc-server -c` a reload over a slow link (Wi-Fi) re-sends
+// almost nothing: a mixture-of-experts brain has many weights between 1 and 10 MiB (attention, shared experts), and
+// upstream sent all of them again on every load. The server takes a hash for a tensor of any size, so this works
+// with any rpc-server. GGML_RPC_HASH_MIN (bytes) changes it; ggml-rpc-server --seed uses the same value.
+static size_t rpc_hash_threshold() {
+    static const size_t value = [] {
+        const char * env = std::getenv("GGML_RPC_HASH_MIN");
+        if (env && *env) {
+            char * end = nullptr;
+            const unsigned long long v = std::strtoull(env, &end, 10);
+            if (end && *end == '\0') {
+                return (size_t) v;
+            }
+        }
+        return (size_t) 1024 * 1024;
+    }();
+    return value;
+}
 
