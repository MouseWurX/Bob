index 0000000..6088247
--- /dev/null
+++ b/ggml/src/ggml-rpc/scut-seal.h
@@ -0,0 +1,222 @@
+#pragma once
+// SCUT seal, Brain Engine patch 0006: every SCUT datagram signed and scrambled with ChaCha20-Poly1305 (RFC 8439).
+//
+// Header-only and self-contained (no OpenSSL to ship or find on Windows, Mac, Linux and Android). Written straight from
+// RFC 8439: ChaCha20 (section 2.3/2.4), Poly1305 (2.5, 26-bit limbs as in poly1305-donna), the AEAD construction (2.8)
+// and HChaCha20 (draft-irtf-cfrg-xchacha, section 2.2) to make one key per direction per connection.
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+namespace scut_seal {
+
+static inline uint32_t rotl(uint32_t v, int c) { return (v << c) | (v >> (32 - c)); }
+static inline uint32_t ld32(const uint8_t * p) { return (uint32_t) p[0] | ((uint32_t) p[1] << 8) | ((uint32_t) p[2] << 16) | ((uint32_t) p[3] << 24); }
+static inline void st32(uint8_t * p, uint32_t v) { p[0] = (uint8_t) v; p[1] = (uint8_t) (v >> 8); p[2] = (uint8_t) (v >> 16); p[3] = (uint8_t) (v >> 24); }
+static inline void st64(uint8_t * p, uint64_t v) { st32(p, (uint32_t) v); st32(p + 4, (uint32_t) (v >> 32)); }
+static inline uint64_t ld64(const uint8_t * p) { return (uint64_t) ld32(p) | ((uint64_t) ld32(p + 4) << 32); }
+
+#define SCUT_QR(a, b, c, d) \
+    a += b; d ^= a; d = rotl(d, 16); c += d; b ^= c; b = rotl(b, 12); \
+    a += b; d ^= a; d = rotl(d, 8);  c += d; b ^= c; b = rotl(b, 7);
+
+static inline void rounds(uint32_t x[16]) {
+    for (int i = 0; i < 10; i++) {
+        SCUT_QR(x[0], x[4], x[8],  x[12]) SCUT_QR(x[1], x[5], x[9],  x[13])
+        SCUT_QR(x[2], x[6], x[10], x[14]) SCUT_QR(x[3], x[7], x[11], x[15])
+        SCUT_QR(x[0], x[5], x[10], x[15]) SCUT_QR(x[1], x[6], x[11], x[12])
+        SCUT_QR(x[2], x[7], x[8],  x[13]) SCUT_QR(x[3], x[4], x[9],  x[14])
+    }
+}
+#undef SCUT_QR
+
+static inline void setup(uint32_t s[16], const uint8_t key[32], const uint8_t * in16) {
+    s[0] = 0x61707865; s[1] = 0x3320646e; s[2] = 0x79622d32; s[3] = 0x6b206574;
+    for (int i = 0; i < 8; i++) s[4 + i] = ld32(key + 4 * i);
+    for (int i = 0; i < 4; i++) s[12 + i] = ld32(in16 + 4 * i);
+}
+
+// One 64-byte ChaCha20 block: counter, then the 12-byte nonce.
+static inline void block(const uint8_t key[32], uint32_t counter, const uint8_t nonce[12], uint8_t out[64]) {
+    uint8_t in[16]; st32(in, counter); memcpy(in + 4, nonce, 12);
+    uint32_t s[16], x[16];
+    setup(s, key, in);
+    memcpy(x, s, sizeof(x));
+    rounds(x);
+    for (int i = 0; i < 16; i++) st32(out + 4 * i, x[i] + s[i]);
+}
+
+// XORs the ChaCha20 stream (from block `counter`) over data, in place.
+static inline void chacha20_xor(const uint8_t key[32], uint32_t counter, const uint8_t nonce[12], uint8_t * data, size_t n) {
+    uint8_t ks[64];
+    while (n > 0) {
+        block(key, counter++, nonce, ks);
+        size_t take = n < 64 ? n : 64;
+        for (size_t i = 0; i < take; i++) data[i] ^= ks[i];
+        data += take; n -= take;
+    }
+}
+
+// HChaCha20: a new 32-byte key from a key and 16 bytes.
+static inline void hchacha20(const uint8_t key[32], const uint8_t in16[16], uint8_t out[32]) {
+    uint32_t x[16];
+    setup(x, key, in16);
+    rounds(x);
+    for (int i = 0; i < 4; i++) { st32(out + 4 * i, x[i]); st32(out + 16 + 4 * i, x[12 + i]); }
+}
+
+// Poly1305 (poly1305-donna, 32-bit).
+struct poly1305 {
+    uint32_t r[5], h[5] = {0, 0, 0, 0, 0}, pad[4];
+    uint8_t  buf[16];
+    size_t   left = 0;
+
+    explicit poly1305(const uint8_t key[32]) {
+        r[0] = (ld32(key + 0)) & 0x3ffffff;
+        r[1] = (ld32(key + 3) >> 2) & 0x3ffff03;
+        r[2] = (ld32(key + 6) >> 4) & 0x3ffc0ff;
+        r[3] = (ld32(key + 9) >> 6) & 0x3f03fff;
+        r[4] = (ld32(key + 12) >> 8) & 0x00fffff;
+        for (int i = 0; i < 4; i++) pad[i] = ld32(key + 16 + 4 * i);
+    }
+    void blocks(const uint8_t * m, size_t n, uint32_t hibit) {
+        const uint32_t r0 = r[0], r1 = r[1], r2 = r[2], r3 = r[3], r4 = r[4];
+        const uint32_t s1 = r1 * 5, s2 = r2 * 5, s3 = r3 * 5, s4 = r4 * 5;
+        uint32_t h0 = h[0], h1 = h[1], h2 = h[2], h3 = h[3], h4 = h[4];
+        while (n >= 16) {
+            h0 += (ld32(m + 0)) & 0x3ffffff;
+            h1 += (ld32(m + 3) >> 2) & 0x3ffffff;
+            h2 += (ld32(m + 6) >> 4) & 0x3ffffff;
+            h3 += (ld32(m + 9) >> 6) & 0x3ffffff;
+            h4 += (ld32(m + 12) >> 8) | hibit;
+            uint64_t d0 = (uint64_t) h0 * r0 + (uint64_t) h1 * s4 + (uint64_t) h2 * s3 + (uint64_t) h3 * s2 + (uint64_t) h4 * s1;
+            uint64_t d1 = (uint64_t) h0 * r1 + (uint64_t) h1 * r0 + (uint64_t) h2 * s4 + (uint64_t) h3 * s3 + (uint64_t) h4 * s2;
+            uint64_t d2 = (uint64_t) h0 * r2 + (uint64_t) h1 * r1 + (uint64_t) h2 * r0 + (uint64_t) h3 * s4 + (uint64_t) h4 * s3;
+            uint64_t d3 = (uint64_t) h0 * r3 + (uint64_t) h1 * r2 + (uint64_t) h2 * r1 + (uint64_t) h3 * r0 + (uint64_t) h4 * s4;
+            uint64_t d4 = (uint64_t) h0 * r4 + (uint64_t) h1 * r3 + (uint64_t) h2 * r2 + (uint64_t) h3 * r1 + (uint64_t) h4 * r0;
+            uint32_t c;
+            c = (uint32_t) (d0 >> 26); h0 = (uint32_t) d0 & 0x3ffffff; d1 += c;
+            c = (uint32_t) (d1 >> 26); h1 = (uint32_t) d1 & 0x3ffffff; d2 += c;
+            c = (uint32_t) (d2 >> 26); h2 = (uint32_t) d2 & 0x3ffffff; d3 += c;
+            c = (uint32_t) (d3 >> 26); h3 = (uint32_t) d3 & 0x3ffffff; d4 += c;
+            c = (uint32_t) (d4 >> 26); h4 = (uint32_t) d4 & 0x3ffffff; h0 += c * 5;
+            c = h0 >> 26; h0 &= 0x3ffffff; h1 += c;
+            m += 16; n -= 16;
+        }
+        h[0] = h0; h[1] = h1; h[2] = h2; h[3] = h3; h[4] = h4;
+    }
+    void update(const uint8_t * m, size_t n) {
+        if (left) {
+            size_t want = 16 - left; if (want > n) want = n;
+            memcpy(buf + left, m, want); left += want; m += want; n -= want;
+            if (left < 16) return;
+            blocks(buf, 16, 1u << 24); left = 0;
+        }
+        size_t whole = n & ~(size_t) 15;
+        if (whole) { blocks(m, whole, 1u << 24); m += whole; n -= whole; }
+        if (n) { memcpy(buf, m, n); left = n; }
+    }
+    // Pads the message so far to 16 bytes with zeros (the AEAD's layout).
+    void pad16() { if (left) { memset(buf + left, 0, 16 - left); blocks(buf, 16, 1u << 24); left = 0; } }
+    void finish(uint8_t mac[16]) {
+        if (left) { buf[left] = 1; for (size_t i = left + 1; i < 16; i++) buf[i] = 0; blocks(buf, 16, 0); left = 0; }
+        uint32_t h0 = h[0], h1 = h[1], h2 = h[2], h3 = h[3], h4 = h[4], c;
+        c = h1 >> 26; h1 &= 0x3ffffff; h2 += c;
+        c = h2 >> 26; h2 &= 0x3ffffff; h3 += c;
+        c = h3 >> 26; h3 &= 0x3ffffff; h4 += c;
+        c = h4 >> 26; h4 &= 0x3ffffff; h0 += c * 5;
+        c = h0 >> 26; h0 &= 0x3ffffff; h1 += c;
+        uint32_t g0 = h0 + 5; c = g0 >> 26; g0 &= 0x3ffffff;
+        uint32_t g1 = h1 + c; c = g1 >> 26; g1 &= 0x3ffffff;
+        uint32_t g2 = h2 + c; c = g2 >> 26; g2 &= 0x3ffffff;
+        uint32_t g3 = h3 + c; c = g3 >> 26; g3 &= 0x3ffffff;
+        uint32_t g4 = h4 + c - (1u << 26);
+        uint32_t mask = (g4 >> 31) - 1;   // all ones when h >= p
+        g0 &= mask; g1 &= mask; g2 &= mask; g3 &= mask; g4 &= mask;
+        mask = ~mask;
+        h0 = (h0 & mask) | g0; h1 = (h1 & mask) | g1; h2 = (h2 & mask) | g2; h3 = (h3 & mask) | g3; h4 = (h4 & mask) | g4;
+        h0 = (h0) | (h1 << 26);
+        h1 = (h1 >> 6) | (h2 << 20);
+        h2 = (h2 >> 12) | (h3 << 14);
+        h3 = (h3 >> 18) | (h4 << 8);
+        uint64_t f;
+        f = (uint64_t) h0 + pad[0];             h0 = (uint32_t) f;
+        f = (uint64_t) h1 + pad[1] + (f >> 32); h1 = (uint32_t) f;
+        f = (uint64_t) h2 + pad[2] + (f >> 32); h2 = (uint32_t) f;
+        f = (uint64_t) h3 + pad[3] + (f >> 32); h3 = (uint32_t) f;
+        st32(mac, h0); st32(mac + 4, h1); st32(mac + 8, h2); st32(mac + 12, h3);
+    }
+};
+
+static inline void aead_tag(const uint8_t key[32], const uint8_t nonce[12], const uint8_t * aad, size_t aad_n, const uint8_t * ct, size_t ct_n, uint8_t tag[16]) {
+    uint8_t otk[64];
+    block(key, 0, nonce, otk);
+    poly1305 p(otk);
+    p.update(aad, aad_n); p.pad16();
+    p.update(ct, ct_n);   p.pad16();
+    uint8_t lens[16]; st64(lens, aad_n); st64(lens + 8, ct_n);
+    p.update(lens, 16);
+    p.finish(tag);
+    memset(otk, 0, sizeof(otk));
+}
+
+// Scrambles data in place and writes the 16-byte tag over aad + data.
+static inline void seal(const uint8_t key[32], const uint8_t nonce[12], const uint8_t * aad, size_t aad_n, uint8_t * data, size_t n, uint8_t tag[16]) {
+    chacha20_xor(key, 1, nonce, data, n);
+    aead_tag(key, nonce, aad, aad_n, data, n, tag);
+}
+
+// Checks the tag first (in constant time) and only then unscrambles. false = forged or damaged: the data is untouched.
+static inline bool open(const uint8_t key[32], const uint8_t nonce[12], const uint8_t * aad, size_t aad_n, uint8_t * data, size_t n, const uint8_t tag[16]) {
+    uint8_t want[16];
+    aead_tag(key, nonce, aad, aad_n, data, n, want);
+    uint8_t diff = 0;
+    for (int i = 0; i < 16; i++) diff |= (uint8_t) (want[i] ^ tag[i]);
+    if (diff != 0) return false;
+    chacha20_xor(key, 1, nonce, data, n);
+    return true;
+}
+
+// Reads 64 hex digits into a 32-byte key. false when it isn't exactly that.
+static inline bool parse_key(const char * s, size_t n, uint8_t key[32]) {
+    if (!s || n != 64) return false;
+    for (size_t i = 0; i < 32; i++) {
+        int v = 0;
+        for (int k = 0; k < 2; k++) {
+            char c = s[2 * i + k]; int d;
+            if (c >= '0' && c <= '9') d = c - '0';
+            else if (c >= 'a' && c <= 'f') d = c - 'a' + 10;
+            else if (c >= 'A' && c <= 'F') d = c - 'A' + 10;
+            else return false;
+            v = v * 16 + d;
+        }
+        key[i] = (uint8_t) v;
+    }
+    return true;
+}
+
+// Which packets were already seen in one direction: the highest counter and the 2048 before it. Each counter is
+// accepted once, so a recorded packet played back later is dropped.
+struct replay_window {
+    static constexpr uint64_t W = 2048;
+    uint64_t top = 0;
+    uint64_t bits[W / 64] = {0};
+    bool fresh(uint64_t c) const {
+        if (c == 0) return false;
+        if (c > top) return true;
+        if (top - c >= W) return false;
+        return !(bits[(c % W) / 64] >> (c % 64) & 1);
+    }
+    void mark(uint64_t c) {
+        if (c > top) {
+            uint64_t gap = c - top;
+            if (gap >= W) { memset(bits, 0, sizeof(bits)); }
+            else { for (uint64_t k = top + 1; k <= c; k++) bits[(k % W) / 64] &= ~(1ull << (k % 64)); }
+            top = c;
+        }
+        bits[(c % W) / 64] |= 1ull << (c % 64);
+    }
+};
+
+} // namespace scut_seal
