+// Brain Engine 0026: flash_attn_mask_to_KV_max for a position mask: the same tiles, the same answer for every real
+// query row (rows past the last one wrap around, as in the attention kernels, where the table scan read past the end)
+template <int ncols1>
+__launch_bounds__(FATTN_KQ_STRIDE/2, 1)
+static __global__ void flash_attn_pos_to_KV_max(
+        const int * pos_ptr, int * KV_max_ptr, const int ne30, const int n_q, const int64_t s33, const int n_swa) {
+    int * GGML_CUDA_RESTRICT KV_max = KV_max_ptr;
+
+    const int ne31     = gridDim.x;
+    const int tid      = threadIdx.x;
+    const int sequence = blockIdx.y;
+    const int jt       = blockIdx.x;
+
+    const int * GGML_CUDA_RESTRICT qp = pos_ptr + sequence*s33;
+    const int * GGML_CUDA_RESTRICT kp = qp + n_q;
+
+    __shared__ int buf_iw[WARP_SIZE];
+    if (tid < WARP_SIZE) {
+        buf_iw[tid] = 1;
+    }
+    ggml_cuda_pdl_sync();
+    __syncthreads();
+
+    int KV_max_sj = (ne30 - 1) * FATTN_KQ_STRIDE;
+    for (; KV_max_sj >= 0; KV_max_sj -= FATTN_KQ_STRIDE) {
+        int all_inf = 1;
+
+        const int k0 = kp[KV_max_sj + 2*tid + 0];
+        const int k1 = kp[KV_max_sj + 2*tid + 1];
+#pragma unroll
+        for (int j = 0; j < ncols1; ++j) {
+            const int p1 = qp[(jt*ncols1 + j) % n_q];
+            all_inf = all_inf && int(isinf(fattn_pos_mask(k0, p1, n_swa))) && int(isinf(fattn_pos_mask(k1, p1, n_swa)));
+        }
+
+        all_inf = warp_reduce_all(all_inf);
+        if (tid % WARP_SIZE == 0) {
+            buf_iw[tid / WARP_SIZE] = all_inf;
+        }
+        __syncthreads();
+        all_inf = buf_iw[tid % WARP_SIZE];
+        __syncthreads();
+        all_inf = warp_reduce_all(all_inf);
+
+        if (!all_inf) {
+            break;
+        }
+    }
+
+    KV_max_sj += FATTN_KQ_STRIDE;
+
+    if (threadIdx.x != 0) {
+        return;
+    }
+
+    KV_max[sequence*ne31 + jt] = KV_max_sj;
+}
