+    auto cvec_handler = [this](const server_http_req & req, json body) {
+        auto res = create_response();
+        auto & rd = res->rd;
+        {
+            server_task task(SERVER_TASK_TYPE_CVEC);
+            task.id = rd.get_new_id();
+            task.cvec = std::move(body);
+            rd.post_task(std::move(task));
+        }
+        auto result = rd.next(req.should_stop);
+        if (!result) {
+            GGML_ASSERT(req.should_stop());
+            return res;
+        }
+        if (result->is_error()) {
+            res->error(result->to_json());
+            return res;
+        }
+        res->ok(result->to_json());
+        return res;
+    };
+
+    this->get_control_vector = [cvec_handler](const server_http_req & req) {
+        return cvec_handler(req, nullptr);
+    };
+
+    this->post_control_vector = [cvec_handler](const server_http_req & req) {
+        json body = json::parse(req.body);
+        if (body.is_null()) {
+            body = json::object();
+        }
+        return cvec_handler(req, std::move(body));
+    };
