             dst_tmp_meta.alloc(parallel_blocks*ggml_nrows(KQV));
+        } else if (want_lse) {
+            dst_tmp_meta.alloc(ggml_nrows(KQV)); // one block: the kernel writes its [max, sum] when given somewhere to
         }
     }
 
@@ -1571,4 +1601,15 @@ void launch_fattn(
             dst_tmp.ptr, dst_tmp_meta.ptr, (float *) KQV->data, parallel_blocks);
     }
     CUDA_CHECK(cudaGetLastError());
+
+    if (want_lse) {
+        // rows in the order of the result: head fastest, then the query row, then the stream
+        const int nrows = int(Q->ne[1]*Q->ne[2]*Q->ne[3]);
+        float * lse = (float *) ((char *) KQV->data + KQV->nb[3]*Q->ne[3]);
+        const dim3 block_dim_lse(128, 1, 1);
+        const dim3 blocks_num_lse((nrows + 127)/128, 1, 1);
+        const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params(blocks_num_lse, block_dim_lse, 0, main_stream);
+        ggml_cuda_kernel_launch(flash_attn_write_lse, launch_params, (const float2 *) dst_tmp_meta.ptr, lse, nrows, parallel_blocks);
+        CUDA_CHECK(cudaGetLastError());
+    }
