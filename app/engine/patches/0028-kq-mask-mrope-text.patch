 }
 
+bool llama_kv_cache_context::get_has_ext_2d() const {
+    return kv->get_has_ext_2d();
+}
+
+bool llama_kv_cache::get_has_ext_2d() const {
+    // TODO: refactor [TAG_KV_CACHE_SHARE_CELLS]
+    if (other) {
+        return other->get_has_ext_2d();
+    }
+    for (const auto & cells : v_cells) {
+        if (cells.get_has_ext_2d()) {
+            return true;
+        }
+    }
+    return false;
+}
+
 ggml_type llama_kv_cache_context::type_k() const {
     return kv->type_k();
 }
