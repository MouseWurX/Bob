+// Brain Engine 0120: mode-biased accept (mb-MTP), after llamAmpere (github.com/JakeATX/llamAmpere, MIT,
+// common_sampler_verify_pq_impl): a draft token the exact rule rejects is kept anyway when the target rates it at
+// least as likely as the replacement drawn for it, never for an end-of-generation token on either side and never while
+// a grammar shapes the output. Off unless LLAMA_SPEC_MB=1. LLAMA_SPEC_MB_KL=N audits the first N drafted positions of
+// each process: KL(p || the mb law) per position, the drift meter. The audit draws no random numbers.
+bool common_sampler_mb_enabled() {
+    static const bool on = [] {
+        const char * e = getenv("LLAMA_SPEC_MB");
+        return e != nullptr && atoi(e) == 1;
+    }();
+    return on;
+}
+
+static thread_local common_sampler_mb_stats mb_stats_cur;
+
+common_sampler_mb_stats common_sampler_mb_take() {
+    const common_sampler_mb_stats out = mb_stats_cur;
+    mb_stats_cur = {};
+    return out;
+}
+
+static int32_t mb_kl_left() {
+    static int32_t left = [] {
+        const char * e = getenv("LLAMA_SPEC_MB_KL");
+        return e ? std::max(0, std::min(1000000, atoi(e))) : 0;
+    }();
+    return left > 0 ? left-- : 0;
+}
+
+// the law mb draws from at one drafted position (llamAmpere's common_sampler_pq_mode_distribution, kappa = alpha = 1):
+// exact emits p; mb moves each rejected-draft/replacement pair's joint mass excess[d] * residual[y] / total from y to d
+// when p(d) >= p(y). Adds KL(p || law) to the stats. Skipped on candidate lists over 4096 (it is quadratic).
+static void mb_audit(const std::vector<float> & p, const std::vector<float> & q, const std::vector<bool> & ends) {
+    const size_t n = p.size();
+    if (n == 0 || n > 4096) {
+        return;
+    }
+    std::vector<double> law(n), residual(n), excess(n);
+    double total = 0.0;
+    for (size_t k = 0; k < n; ++k) {
+        law[k]      = p[k];
+        residual[k] = std::max(0.0, (double) p[k] - q[k]);
+        excess[k]   = std::max(0.0, (double) q[k] - p[k]);
+        total      += residual[k];
+    }
+    if (total > 0.0) {
+        for (size_t d = 0; d < n; ++d) {
+            if (excess[d] <= 0.0 || p[d] <= 0.0f || ends[d]) {
+                continue;
+            }
+            for (size_t y = 0; y < n; ++y) {
+                if (residual[y] <= 0.0 || p[d] < p[y] || ends[y]) {
+                    continue;
+                }
+                const double moved = excess[d]*residual[y]/total;
+                law[d] += moved;
+                law[y] -= moved;
+            }
+        }
+    }
+    double kl = 0.0;
+    bool   inf = false;
+    for (size_t k = 0; k < n; ++k) {
+        if (p[k] <= 0.0f) {
+            continue;
+        }
+        if (law[k] <= 1e-12) {
+            inf = true;
+            break;
+        }
+        kl += p[k]*std::log(p[k]/law[k]);
+    }
+    mb_stats_cur.kl_n++;
+    if (inf) {
+        mb_stats_cur.kl_inf++;
+    } else {
+        mb_stats_cur.kl_sum += std::max(0.0, kl);
+    }
+}
