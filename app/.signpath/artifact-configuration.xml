<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration for the "Bob-signed-build" artifact (paste into the SignPath project,
     artifact configuration slug "bob-exe"). Signs only Bob.exe, which CI builds from this repository's
     source with electron-builder. Electron's own files inside are left as they are. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="Bob.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
